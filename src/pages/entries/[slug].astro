---
import type { CollectionEntry } from "astro:content"
import Base from "~/layouts/Base.astro"
import IllusionExperience from "~/components/IllusionExperience.astro"
import ArgumentBody from "~/components/entry/ArgumentBody.astro"
import ClaimsBand from "~/components/entry/ClaimsBand.astro"
import EntryHeader from "~/components/entry/EntryHeader.astro"
import EntrySidebar from "~/components/entry/EntrySidebar.astro"
import Sources from "~/components/entry/Sources.astro"
import WhatBreaks from "~/components/entry/WhatBreaks.astro"
import RecommendedEntries from "~/components/RecommendedEntries.astro"
import PathNavigation from "~/components/PathNavigation.astro"
import { readingPaths } from "~/data/reading-paths"
import { chapterById } from "~/data/chapters"
import { getPublishedEntries, relatedEntries } from "~/data/entries"
import { entrySeo } from "~/data/seo"
import { anchorOf } from "~/data/uniqueness"
import { nextEntries } from "~/data/recommendations"

export async function getStaticPaths() {
  const entries = await getPublishedEntries()
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<"entries">
}

const { entry } = Astro.props
const d = entry.data
const all = await getPublishedEntries()
const echoes = relatedEntries(entry, all)
const next = nextEntries(entry, all)
const seo = entrySeo(entry, chapterById(d.chapter), Astro.site)
// `format` is required, so anything that is not an illusion is an argument.
const isIllusion = d.format === "illusion"
---

<Base
  title={seo.title}
  description={seo.description}
  structuredData={seo.structuredData}
  image={seo.image}
  imageAlt={seo.imageAlt}
>
  <main id="main-content" tabindex="-1">
    <EntryHeader entry={entry} anchor={anchorOf(entry, all)} />
    {!isIllusion && <ClaimsBand claimA={d.claimA} claimB={d.claimB} />}

    <div class="px-gutter flex flex-wrap items-start gap-10 pt-8 pb-16 sm:gap-16 sm:pt-16 sm:pb-24">
      <article
        data-entry={entry.id}
        class="flex w-full max-w-190 min-w-0 grow basis-140 flex-col gap-8 text-lg sm:gap-14 leading-relaxed [&>section]:flex [&>section]:flex-col [&>section]:gap-4"
      >
        {isIllusion ? (
          <IllusionExperience slug={entry.id} why={d.why} finePrint={d.finePrint} />
        ) : (
          <ArgumentBody slug={entry.id} data={d} />
        )}
        {!isIllusion && <WhatBreaks data={d} />}
        {d.sources.length > 0 && <Sources sources={d.sources} />}
      </article>

      <EntrySidebar echoes={echoes} url={seo.url} />
      <PathNavigation entry={entry.id} paths={readingPaths(all)} />
      <div class="flex w-full flex-col gap-5 border-t-2 border-ink pt-8">
        <RecommendedEntries id="read-next" heading="Read next" entries={next} />
        <a
          class="inline-flex min-h-11 self-start items-center font-bold underline"
          href={`/chapters/${d.chapter}/`}
        >
          Explore this chapter →
        </a>
      </div>
    </div>
  </main>
</Base>

<script>
  import "~/scripts/track-illustrations"
  import "~/scripts/catalogue-return"
</script>
