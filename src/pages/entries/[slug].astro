---
import type { CollectionEntry } from "astro:content"
import Base from "~/layouts/Base.astro"
import IllusionExperience from "~/components/IllusionExperience.astro"
import ArgumentBody from "~/components/entry/ArgumentBody.astro"
import ClaimsBand from "~/components/entry/ClaimsBand.astro"
import EntryHeader from "~/components/entry/EntryHeader.astro"
import EntrySidebar from "~/components/entry/EntrySidebar.astro"
import Sources from "~/components/entry/Sources.astro"
import WhatBreaks from "~/components/entry/WhatBreaks.astro"
import { chapterById } from "~/data/chapters"
import { getPublishedEntries, relatedEntries } from "~/data/entries"
import { entrySeo } from "~/data/seo"
import { anchorOf } from "~/data/uniqueness"

export async function getStaticPaths() {
  const entries = await getPublishedEntries()
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<"entries">
}

const { entry } = Astro.props
const d = entry.data
const all = await getPublishedEntries()
const { echoes, siblings } = relatedEntries(entry, all)
const seo = entrySeo(entry, chapterById(d.chapter), Astro.site)
// `format` is required, so anything that is not an illusion is an argument.
const isIllusion = d.format === "illusion"
---

<Base
  title={seo.title}
  description={seo.description}
  structuredData={seo.structuredData}
  image={seo.image}
  imageAlt={seo.imageAlt}
>
  <EntryHeader entry={entry} anchor={anchorOf(entry, all)} />
  {!isIllusion && <ClaimsBand claimA={d.claimA} claimB={d.claimB} />}

  <main class="px-gutter flex flex-wrap items-start gap-16 pt-16 pb-24">
    <article
      data-entry={entry.id}
      class="flex w-full max-w-190 min-w-0 grow basis-140 flex-col gap-14 text-lg leading-relaxed [&>section]:flex [&>section]:flex-col [&>section]:gap-4"
    >
      {isIllusion ? (
        <IllusionExperience slug={entry.id} why={d.why} finePrint={d.finePrint} />
      ) : (
        <ArgumentBody slug={entry.id} data={d} />
      )}
      {d.sources.length > 0 && <Sources sources={d.sources} />}
    </article>

    <EntrySidebar echoes={echoes} siblings={siblings} url={seo.url}>
      {!isIllusion && <WhatBreaks data={d} />}
    </EntrySidebar>
  </main>
</Base>

<script>
  import "~/scripts/track-illustrations"
</script>
