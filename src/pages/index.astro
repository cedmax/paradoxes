---
import Base from "~/layouts/Base.astro"
import EntryCard from "~/components/EntryCard.astro"
import { chapters } from "~/data/chapters"
import { statuses, type Status } from "~/data/status"
import { getPublishedEntries } from "~/data/entries"
import { anchorOf } from "~/data/uniqueness"

const all = await getPublishedEntries()
const sorted = all.sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
)
// Every entry is in the page. Variants start hidden; turning the "Hide variants" switch off
// shows them. The count chips follow the switch.
const anchors = new Map(sorted.map((e) => [e.id, anchorOf(e, all)]))
const listed = sorted.filter((e) => e.data.uniqueness !== "variant")
const variantCount = sorted.length - listed.length
const reviewedCount = sorted.filter((e) => e.data.reviewed).length
const byChapter = chapters
  .map((chapter) => ({ chapter, items: sorted.filter((e) => e.data.chapter === chapter.id) }))
  .filter((g) => g.items.length > 0)

const statusKeys = Object.keys(statuses) as Status[]
const counts: Record<string, number> = {
  all: listed.length,
  illusions: listed.filter((e) => e.data.format === "illusion").length,
}
statusKeys.forEach(
  (k) =>
    (counts[k] = listed.filter(
      (e) => e.data.format === "argument" && e.data.status === k,
    ).length),
)
---

<Base title="Paradoxes explained in plain words | Logic Benders">
  <section class="px-gutter flex flex-col gap-7 pt-12 pb-10 sm:pt-18">
    <h1 class="font-display text-[clamp(44px,8.4vw,128px)] leading-none font-extrabold tracking-tighter">
      It can't be true.
      <br />
      <span class="text-accent">It can't be false.</span>
    </h1>
    <p class="max-w-190 text-xl leading-snug sm:text-2xl">
      Paradoxes in plain words. Each one starts with a problem, and two claims that sound right
      but can't possibly be true at the same time. And what happens when you try to fix it.
    </p>
  </section>

  <section
    class="px-gutter border-y-2 border-ink bg-accent py-10"
    aria-label="Search and filter entries"
  >
    <div class="flex flex-wrap items-end gap-x-8 gap-y-4">
      <label class="flex max-w-115 min-w-0 grow basis-80 flex-col gap-2">
        <span class="mono-label">Search</span>
        <input
          type="search"
          id="q"
          placeholder="sand, barber, doors"
          aria-label="Search entries"
          class="h-14 w-full rounded-none border-2 border-ink bg-paper px-4.5 text-lg text-ink"
        />
      </label>
      <div class="flex flex-wrap gap-2" id="chips">
        <button
          type="button"
          class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
          data-filter="all"
          aria-pressed="true"
        >
          All{" "}
          <span class="font-mono text-xs font-medium" data-count>
            {counts.all}
          </span>
        </button>
        {statusKeys.map((k) => (
          <button
            type="button"
            class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
            data-filter={k}
            aria-pressed="false"
          >
            {statuses[k].label}{" "}
            <span class="font-mono text-xs font-medium" data-count>
              {counts[k]}
            </span>
          </button>
        ))}
        <button
          type="button"
          class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
          data-filter="illusions"
          aria-pressed="false"
        >
          Visual illusions{" "}
          <span class="font-mono text-xs font-medium" data-count>
            {counts.illusions}
          </span>
        </button>
      </div>
    </div>
    <!-- The two switches change what is listed, not the kind of paradox, so they sit apart from the status chips. -->
    <div class="mt-5 flex flex-wrap items-center gap-x-8 gap-y-1 border-t-2 border-ink pt-4">
      <label
        class="flex min-h-11 cursor-pointer items-center gap-3 font-bold text-ink has-disabled:cursor-not-allowed"
        title="Variants are the same puzzle as another entry, in a different setting. Searching always includes them."
      >
        <input type="checkbox" role="switch" id="hide-variants" class="peer sr-only" checked />
        <span
          aria-hidden="true"
          class="relative h-7 w-12 shrink-0 border-2 border-ink bg-paper transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:bg-ink after:transition-transform peer-checked:bg-ink peer-checked:after:translate-x-5 peer-checked:after:bg-paper peer-focus-visible:outline-4 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink peer-disabled:opacity-50 motion-reduce:transition-none motion-reduce:after:transition-none"
        ></span>
        <span class="peer-disabled:opacity-50">
          Hide variants <span class="font-mono text-xs font-medium">{variantCount}</span>
        </span>
      </label>
      <label
        class="flex min-h-11 cursor-pointer items-center gap-3 font-bold text-ink"
        title="Show only entries that a person has also reviewed."
      >
        <input type="checkbox" role="switch" id="only-reviewed" class="peer sr-only" />
        <span
          aria-hidden="true"
          class="relative h-7 w-12 shrink-0 border-2 border-ink bg-paper transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:bg-ink after:transition-transform peer-checked:bg-ink peer-checked:after:translate-x-5 peer-checked:after:bg-paper peer-focus-visible:outline-4 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink motion-reduce:transition-none motion-reduce:after:transition-none"
        ></span>
        <span>
          Only reviewed <span class="font-mono text-xs font-medium">{reviewedCount}</span>
        </span>
      </label>
    </div>
  </section>

  <details class="group px-gutter pt-6">
    <summary class="mono-label inline-flex min-h-11 cursor-pointer list-none items-center gap-2">
      How a paradox ends
      <span
        aria-hidden="true"
        class="transition-transform group-open:rotate-180 motion-reduce:transition-none"
      >
        ↓
      </span>
    </summary>
    <div class="flex max-w-225 flex-col gap-1.5 pt-2 text-base">
      {statusKeys.map((k) => (
        <div>
          <strong>{statuses[k].label}</strong>: {statuses[k].definition}
        </div>
      ))}
    </div>
  </details>

  <main class="px-gutter flex flex-col gap-8 pt-6 pb-20 md:gap-18">
    {byChapter.map(({ chapter, items }) => (
      <section
        class="group/chapter flex flex-col gap-5"
        data-chapter={chapter.id}
        data-open={chapter.id === byChapter[0]?.chapter.id ? "" : undefined}
        hidden={!items.some((e) => e.data.uniqueness !== "variant")}
      >
        <h2 class="contents">
          <button
            type="button"
            class="flex w-full cursor-pointer items-center gap-4 text-left max-md:min-h-11 max-md:border-b-2 max-md:border-ink max-md:pb-3 md:hidden"
            aria-expanded="true"
            aria-controls={`chapter-${chapter.id}`}
            data-toggle
          >
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-6 gap-y-2 max-md:flex-col max-md:items-start max-md:gap-1">
              <span class="mono-label text-sm text-accent">{chapter.n}</span>
              <span class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</span>
            </span>
            <span
              class="mono-label flex shrink-0 items-center gap-3 md:hidden"
              aria-hidden="true"
            >
              <span data-chapter-count>
                {items.filter((e) => e.data.uniqueness !== "variant").length}
              </span>
              <span class="text-2xl leading-none transition-transform group-data-open/chapter:rotate-45 motion-reduce:transition-none">
                +
              </span>
            </span>
          </button>
          <!-- From md up the heading links to the chapter page. Below md it is the toggle above. -->
          <a
            class="flex flex-wrap items-baseline gap-x-6 gap-y-2 self-start no-underline hover:text-accent max-md:hidden"
            href={`/chapters/${chapter.id}/`}
          >
            <span class="mono-label text-sm text-accent">{chapter.n}</span>
            <span class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</span>
          </a>
        </h2>
        <!-- Below md the chapters fold up, one open at a time. From md up they are always open. -->
        <div
          id={`chapter-${chapter.id}`}
          data-body
          class="flex flex-col gap-5 max-md:group-not-data-open/chapter:hidden"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <p class="w-full max-w-190 text-lg">{chapter.blurb}</p>
            <a
              class="inline-flex min-h-11 items-center font-bold underline hover:text-accent md:hidden"
              href={`/chapters/${chapter.id}/`}
            >
              Explore this chapter →
            </a>
          </div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,340px),1fr))] gap-5">
            {items.map((e) => (
              <EntryCard entry={e} anchor={anchors.get(e.id)} />
            ))}
          </div>
        </div>
      </section>
    ))}
    <noscript>
      <style>
        [data-body] {
          display: flex !important;
        }
      </style>
    </noscript>
    <p id="none" hidden class="font-display text-4xl font-extrabold tracking-tight">
      Nothing matches. That's not a paradox, just a typo.
    </p>
  </main>
</Base>

<script>
  import { normaliseSearch } from "~/data/search"

  const input = document.getElementById("q") as HTMLInputElement
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("#chips button"))
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"))
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"))
  const none = document.getElementById("none") as HTMLElement
  const hideVariants = document.getElementById("hide-variants") as HTMLInputElement
  const onlyReviewed = document.getElementById("only-reviewed") as HTMLInputElement
  const mobile = window.matchMedia("(max-width: 767.98px)")
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
  const STORE = "open-chapter"
  let status = "all"
  const matchesFilter = (card: HTMLElement, filter: string) =>
    filter === "all" ||
    (filter === "illusions"
      ? card.dataset.format === "illusion"
      : card.dataset.status === filter)
  // What the visitor chose with the switch. While a search is active the switch is forced off
  // and disabled, and this is restored when the search is cleared.
  let hideChoice = input.value.trim() ? true : hideVariants.checked

  // The two switches. "Only reviewed" is independent of the search: it applies to every result.
  const isShownByVariantRule = (card: HTMLElement) =>
    !(hideVariants.checked && card.dataset.variant === "true")
  const isShownByReviewedRule = (card: HTMLElement) =>
    !onlyReviewed.checked || card.dataset.reviewed === "true"
  const isShownBySwitches = (card: HTMLElement) =>
    isShownByVariantRule(card) && isShownByReviewedRule(card)

  // Below md the chapters fold up and only one is open. A search or a filter opens every chapter
  // that has results, and the headings stop toggling until the filter is cleared.
  const readOpen = () => {
    try {
      return sessionStorage.getItem(STORE)
    } catch {
      return null
    }
  }
  const writeOpen = (id: string) => {
    try {
      sessionStorage.setItem(STORE, id)
    } catch {
      // Storage can be blocked. The page still works without it.
    }
  }
  const stored = readOpen()
  let openId: string | null = chapters.some((c) => c.dataset.chapter === stored)
    ? stored
    : (chapters[0]?.dataset.chapter ?? null)
  let filtering = false

  function renderChapters() {
    for (const chapter of chapters) {
      const open = filtering || chapter.dataset.chapter === openId
      const toggle = chapter.querySelector<HTMLButtonElement>("[data-toggle]")
      chapter.toggleAttribute("data-open", open)
      if (!toggle) continue
      // From md up the toggle is hidden: chapters are always open and the heading is a link.
      toggle.tabIndex = mobile.matches ? 0 : -1
      toggle.disabled = mobile.matches && filtering
      if (mobile.matches) toggle.setAttribute("aria-expanded", String(open))
      else toggle.removeAttribute("aria-expanded")
    }
  }

  function apply() {
    const q = normaliseSearch(input.value)
    filtering = q !== "" || status !== "all" || onlyReviewed.checked
    hideVariants.disabled = q !== ""
    hideVariants.checked = q === "" && hideChoice
    let shown = 0
    for (const card of cards) {
      const ok =
        matchesFilter(card, status) &&
        (!q || (card.dataset.text ?? "").includes(q)) &&
        isShownBySwitches(card)
      card.hidden = !ok
      if (ok) shown++
      // The card ends on the question. Reveal the claim or verdict a search matched, unless the
      // match is already in what the card shows.
      const revealed = ok && q !== "" && !(card.dataset.shown ?? "").includes(q)
      const hits = card.querySelectorAll<HTMLElement>("[data-hit]")
      let any = false
      hits.forEach((hit) => {
        const on = revealed && (hit.dataset.text ?? "").includes(q)
        hit.hidden = !on
        any ||= on
      })
      const box = card.querySelector<HTMLElement>("[data-hits]")
      if (box) box.hidden = !any
    }
    for (const chip of chips) {
      const filter = chip.dataset.filter ?? "all"
      const count = cards.filter(
        (card) => matchesFilter(card, filter) && isShownBySwitches(card),
      ).length
      const label = chip.querySelector("[data-count]")
      if (label) label.textContent = String(count)
    }
    for (const chapter of chapters) {
      const visible = chapter.querySelectorAll("[data-card]:not([hidden])").length
      chapter.hidden = visible === 0
      const count = chapter.querySelector("[data-chapter-count]")
      if (count) count.textContent = String(visible)
    }
    none.hidden = shown !== 0
    renderChapters()
  }

  for (const chapter of chapters) {
    chapter.querySelector("[data-toggle]")?.addEventListener("click", () => {
      if (!mobile.matches || filtering) return
      const id = chapter.dataset.chapter ?? null
      openId = openId === id ? null : id
      if (id && openId) writeOpen(id)
      renderChapters()
      // Opening one closes the one above it, which would push the heading off screen.
      if (openId) {
        chapter.scrollIntoView({
          block: "start",
          behavior: reducedMotion.matches ? "auto" : "smooth",
        })
      }
    })
  }
  mobile.addEventListener("change", renderChapters)

  input.addEventListener("input", apply)
  hideVariants.addEventListener("change", () => {
    hideChoice = hideVariants.checked
    apply()
  })
  onlyReviewed.addEventListener("change", apply)
  for (const button of chips) {
    button.addEventListener("click", () => {
      status = button.dataset.filter ?? "all"
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === button)))
      apply()
    })
  }
  // Browsers can restore the switch and the search box on reload, so sync the page to them.
  apply()
</script>
