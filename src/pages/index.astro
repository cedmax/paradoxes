---
import { getCollection } from "astro:content"
import Base from "~/layouts/Base.astro"
import EntryCard from "~/components/EntryCard.astro"
import { chapters } from "~/data/chapters"
import { statuses, type Status } from "~/data/status"

const all = await getCollection("entries")
const sorted = all.sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
)
const byChapter = chapters
  .map((chapter) => ({ chapter, items: sorted.filter((e) => e.data.chapter === chapter.id) }))
  .filter((g) => g.items.length > 0)

const statusKeys = Object.keys(statuses) as Status[]
const counts: Record<string, number> = { all: all.length }
statusKeys.forEach((k) => (counts[k] = all.filter((e) => e.data.status === k).length))

const featured = all.find((e) => e.id === "monty-hall-problem")
---

<Base title="Paradoxes, plainly">
  <section class="px-gutter flex flex-col gap-7 pt-12 pb-10 sm:pt-18">
    <h1 class="font-display text-[clamp(44px,8.4vw,128px)] leading-[0.96] font-extrabold tracking-[-0.04em]">
      It can't be true.
      <br />
      <span class="text-accent">It can't be false.</span>
    </h1>
    <p class="max-w-170 text-xl leading-[1.35] sm:text-2xl">
      Paradoxes in plain words. Each one is a problem, two claims that both seem true but can't
      both stand, and what happens when you try to fix it.
    </p>
    <div class="flex flex-wrap items-end gap-x-8 gap-y-4">
      <label class="flex max-w-115 min-w-0 flex-[1_1_320px] flex-col gap-2">
        <span class="mono-label">Search</span>
        <input
          type="search"
          id="q"
          placeholder="sand, barber, doors"
          aria-label="Search paradoxes"
          class="h-14 w-full rounded-none border-2 border-ink bg-paper px-4.5 text-[19px] text-ink"
        />
      </label>
      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filter by how it ends"
        id="chips"
      >
        <button
          type="button"
          class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
          data-filter="all"
          aria-pressed="true"
        >
          All <span class="font-mono text-[13px] font-medium">{counts.all}</span>
        </button>
        {statusKeys.map((k) => (
          <button
            type="button"
            class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
            data-filter={k}
            aria-pressed="false"
          >
            {statuses[k].label}{" "}
            <span class="font-mono text-[13px] font-medium">{counts[k]}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="flex max-w-225 flex-col gap-1.5 text-base">
      <div class="mono-label">How a paradox ends</div>
      {statusKeys.map((k) => (
        <div>
          <strong>{statuses[k].label}</strong>: {statuses[k].definition}
        </div>
      ))}
    </div>
  </section>

  {featured && (
    <a
      class="px-gutter flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-y-2 border-ink bg-accent py-7 text-ink no-underline hover:bg-paper"
      href={`/entries/${featured.id}/`}
    >
      <span class="font-display flex-[1_1_480px] text-[clamp(26px,3.2vw,44px)] leading-[1.05] font-extrabold tracking-[-0.03em]">
        {featured.data.problem}
      </span>
      <span class="inline-flex min-h-14 items-center bg-ink px-7 font-bold text-paper">
        Commit to an answer →
      </span>
    </a>
  )}

  <main class="px-gutter flex flex-col gap-18 pt-16 pb-20">
    {byChapter.map(({ chapter, items }) => (
      <section class="flex flex-col gap-5" data-chapter>
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <div class="mono-label text-[15px] text-accent">{chapter.n}</div>
          <h2 class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</h2>
        </div>
        <p class="max-w-160 text-[19px]">{chapter.blurb}</p>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,440px),1fr))] gap-6">
          {items.map((e) => (
            <EntryCard entry={e} />
          ))}
        </div>
      </section>
    ))}
    <p id="none" hidden class="font-display text-[40px] font-extrabold tracking-[-0.03em]">
      Nothing matches. That's not a paradox, just a typo.
    </p>
  </main>
</Base>

<script>
  const input = document.getElementById("q") as HTMLInputElement
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("#chips button"))
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"))
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"))
  const none = document.getElementById("none") as HTMLElement
  let status = "all"

  function apply() {
    const q = input.value.trim().toLowerCase()
    let shown = 0
    for (const card of cards) {
      const ok =
        (status === "all" || card.dataset.status === status) &&
        (!q || (card.dataset.text ?? "").includes(q))
      card.hidden = !ok
      if (ok) shown++
    }
    for (const chapter of chapters) {
      chapter.hidden = !chapter.querySelector("[data-card]:not([hidden])")
    }
    none.hidden = shown !== 0
  }

  input.addEventListener("input", apply)
  for (const button of chips) {
    button.addEventListener("click", () => {
      status = button.dataset.filter ?? "all"
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === button)))
      apply()
    })
  }
</script>
