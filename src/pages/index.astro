---
import Base from "~/layouts/Base.astro"
import EntryFilters from "~/components/home/EntryFilters.astro"
import EntryList from "~/components/home/EntryList.astro"
import HomeHero from "~/components/home/HomeHero.astro"
import HowItEnds from "~/components/home/HowItEnds.astro"
import { byOrder, getPublishedEntries } from "~/data/entries"

const entries = (await getPublishedEntries()).sort(byOrder)
---

<Base title="Paradoxes explained in plain words | Logic Benders">
  <HomeHero />
  <EntryFilters entries={entries} />
  <HowItEnds />
  <EntryList entries={entries} />
</Base>

<script>
  import "~/scripts/home-filters"
</script>
