---
import { getCollection } from "astro:content"
import Base from "~/layouts/Base.astro"
import EntryCard from "~/components/EntryCard.astro"
import { chapters } from "~/data/chapters"
import { statuses, type Status } from "~/data/status"
import { anchorOf } from "~/data/uniqueness"

const all = await getCollection("entries")
const sorted = all.sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
)
// Every entry is in the page. Variants start hidden; turning the "Hide variants" switch off
// shows them. The count chips follow the switch.
const anchors = new Map(sorted.map((e) => [e.id, anchorOf(e, all)]))
const listed = sorted.filter((e) => e.data.uniqueness !== "variant")
const variantCount = sorted.length - listed.length
const byChapter = chapters
  .map((chapter) => ({ chapter, items: sorted.filter((e) => e.data.chapter === chapter.id) }))
  .filter((g) => g.items.length > 0)

const statusKeys = Object.keys(statuses) as Status[]
const counts: Record<string, number> = { all: listed.length }
statusKeys.forEach((k) => (counts[k] = listed.filter((e) => e.data.status === k).length))
---

<Base title="Logic Benders. It can't be true. It can't be false.">
  <section class="px-gutter flex flex-col gap-7 pt-12 pb-10 sm:pt-18">
    <h1 class="font-display text-[clamp(44px,8.4vw,128px)] leading-none font-extrabold tracking-tighter">
      It can't be true.
      <br />
      <span class="text-accent">It can't be false.</span>
    </h1>
    <p class="max-w-170 text-xl leading-snug sm:text-2xl">
      Paradoxes in plain words. Each one starts with a problem, and two claims that sound right
      but can't possibly be true at the same time. And what happens when you try to fix it.
    </p>
  </section>

  <section
    class="px-gutter border-y-2 border-ink bg-accent py-10"
    aria-label="Search and filter paradoxes"
  >
    <div class="flex flex-wrap items-end gap-x-8 gap-y-4">
      <label class="flex max-w-115 min-w-0 grow basis-80 flex-col gap-2">
        <span class="mono-label">Search</span>
        <input
          type="search"
          id="q"
          placeholder="sand, barber, doors"
          aria-label="Search paradoxes"
          class="h-14 w-full rounded-none border-2 border-ink bg-paper px-4.5 text-lg text-ink"
        />
      </label>
      <div class="flex flex-wrap gap-2" id="chips">
        <button
          type="button"
          class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
          data-filter="all"
          aria-pressed="true"
        >
          All{" "}
          <span class="font-mono text-xs font-medium" data-count>
            {counts.all}
          </span>
        </button>
        {statusKeys.map((k) => (
          <button
            type="button"
            class="min-h-14 cursor-pointer rounded-none border-2 border-ink bg-paper px-5.5 font-bold text-ink aria-pressed:bg-ink aria-pressed:text-paper"
            data-filter={k}
            aria-pressed="false"
          >
            {statuses[k].label}{" "}
            <span class="font-mono text-xs font-medium" data-count>
              {counts[k]}
            </span>
          </button>
        ))}
        <label
          class="flex min-h-14 cursor-pointer items-center gap-3 border-2 border-ink bg-paper px-5.5 font-bold text-ink has-disabled:cursor-not-allowed"
          title="Variants are the same puzzle as another entry, in a different setting. Searching always includes them."
        >
          <input
            type="checkbox"
            role="switch"
            id="hide-variants"
            class="peer sr-only"
            checked
          />
          <span
            aria-hidden="true"
            class="relative h-7 w-12 shrink-0 border-2 border-ink bg-paper transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:bg-ink after:transition-transform peer-checked:bg-ink peer-checked:after:translate-x-5 peer-checked:after:bg-paper peer-focus-visible:outline-4 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink peer-disabled:opacity-50 motion-reduce:transition-none motion-reduce:after:transition-none"
          ></span>
          <span class="peer-disabled:opacity-50">
            Hide variants <span class="font-mono text-xs font-medium">{variantCount}</span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <details class="group px-gutter pt-6">
    <summary class="mono-label inline-flex min-h-11 cursor-pointer list-none items-center gap-2">
      How a paradox ends
      <span
        aria-hidden="true"
        class="transition-transform group-open:rotate-180 motion-reduce:transition-none"
      >
        ↓
      </span>
    </summary>
    <div class="flex max-w-225 flex-col gap-1.5 pt-2 text-base">
      {statusKeys.map((k) => (
        <div>
          <strong>{statuses[k].label}</strong>: {statuses[k].definition}
        </div>
      ))}
    </div>
  </details>

  <main class="px-gutter flex flex-col gap-18 pt-6 pb-20">
    {byChapter.map(({ chapter, items }) => (
      <section
        class="flex flex-col gap-5"
        data-chapter
        hidden={!items.some((e) => e.data.uniqueness !== "variant")}
      >
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <div class="mono-label text-sm text-accent">{chapter.n}</div>
          <h2 class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</h2>
        </div>
        <p class="max-w-160 text-lg">{chapter.blurb}</p>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,400px),1fr))] gap-6">
          {items.map((e) => (
            <EntryCard entry={e} anchor={anchors.get(e.id)} />
          ))}
        </div>
      </section>
    ))}
    <p id="none" hidden class="font-display text-4xl font-extrabold tracking-tight">
      Nothing matches. That's not a paradox, just a typo.
    </p>
  </main>
</Base>

<script>
  const input = document.getElementById("q") as HTMLInputElement
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("#chips button"))
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"))
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"))
  const none = document.getElementById("none") as HTMLElement
  const hideVariants = document.getElementById("hide-variants") as HTMLInputElement
  let status = "all"
  // What the visitor chose with the switch. While a search is active the switch is forced off
  // and disabled, and this is restored when the search is cleared.
  let hideChoice = input.value.trim() ? true : hideVariants.checked

  const isShownByVariantRule = (card: HTMLElement) =>
    !(hideVariants.checked && card.dataset.variant === "true")

  function apply() {
    const q = input.value.trim().toLowerCase()
    hideVariants.disabled = q !== ""
    hideVariants.checked = q === "" && hideChoice
    let shown = 0
    for (const card of cards) {
      const ok =
        (status === "all" || card.dataset.status === status) &&
        (!q || (card.dataset.text ?? "").includes(q)) &&
        isShownByVariantRule(card)
      card.hidden = !ok
      if (ok) shown++
    }
    for (const chip of chips) {
      const filter = chip.dataset.filter ?? "all"
      const count = cards.filter(
        (card) =>
          (filter === "all" || card.dataset.status === filter) && isShownByVariantRule(card),
      ).length
      const label = chip.querySelector("[data-count]")
      if (label) label.textContent = String(count)
    }
    for (const chapter of chapters) {
      chapter.hidden = !chapter.querySelector("[data-card]:not([hidden])")
    }
    none.hidden = shown !== 0
  }

  input.addEventListener("input", apply)
  hideVariants.addEventListener("change", () => {
    hideChoice = hideVariants.checked
    apply()
  })
  for (const button of chips) {
    button.addEventListener("click", () => {
      status = button.dataset.filter ?? "all"
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === button)))
      apply()
    })
  }
  // Browsers can restore the switch and the search box on reload, so sync the page to them.
  apply()
</script>
