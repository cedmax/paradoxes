---
import Base from "~/layouts/Base.astro"
import EntryGrid from "~/components/EntryGrid.astro"
import ChapterHeader from "~/components/chapter/ChapterHeader.astro"
import OtherChapters from "~/components/chapter/OtherChapters.astro"
import { chapters, type Chapter } from "~/data/chapters"
import { chapterEntries, getPublishedEntries, otherChapters } from "~/data/entries"
import { chapterSeo } from "~/data/seo"

export async function getStaticPaths() {
  const entries = await getPublishedEntries()
  return chapters
    .filter((chapter) => entries.some((entry) => entry.data.chapter === chapter.id))
    .map((chapter) => ({ params: { chapter: chapter.id }, props: { chapter } }))
}

interface Props {
  chapter: Chapter
}

const { chapter } = Astro.props
const all = await getPublishedEntries()
const entries = chapterEntries(chapter, all)
const seo = chapterSeo(chapter, entries, Astro.site)
---

<Base title={seo.title} description={seo.description} structuredData={seo.structuredData}>
  <main class="px-gutter flex flex-col pb-20">
    <ChapterHeader chapter={chapter} />
    <section class="flex flex-col gap-5" aria-labelledby="chapter-entries">
      <h2 class="display text-3xl" id="chapter-entries">
        Explore the puzzles
      </h2>
      <EntryGrid entries={entries} all={all} />
    </section>
    <OtherChapters chapters={otherChapters(chapter, all)} />
  </main>
</Base>
