---
import type { Chapter } from "~/data/chapters"
import Base from "~/layouts/Base.astro"
import EntryCard from "~/components/EntryCard.astro"
import { chapters } from "~/data/chapters"
import { getPublishedEntries } from "~/data/entries"
import { anchorOf } from "~/data/uniqueness"

export async function getStaticPaths() {
  const entries = await getPublishedEntries()
  return chapters
    .filter((chapter) => entries.some((entry) => entry.data.chapter === chapter.id))
    .map((chapter) => ({ params: { chapter: chapter.id }, props: { chapter } }))
}

interface Props {
  chapter: Chapter
}

const { chapter } = Astro.props
const all = await getPublishedEntries()
const entries = all
  .filter((entry) => entry.data.chapter === chapter.id && entry.data.uniqueness !== "variant")
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
const otherChapters = chapters.filter(
  (other) => other.id !== chapter.id && all.some((entry) => entry.data.chapter === other.id),
)
---

<Base title={`${chapter.pageTitle} | Logic Benders`} description={chapter.introduction}>
  <main class="px-gutter flex flex-col gap-10 pt-4 pb-20">
    <nav class="mono-label flex flex-wrap items-center gap-2.5" aria-label="Breadcrumb">
      <a class="inline-flex min-h-11 items-center no-underline hover:text-accent" href="/">
        Index
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{chapter.title}</span>
    </nav>
    <section class="flex flex-col gap-6">
      <p class="mono-label text-accent">
        Chapter {chapter.n}: {chapter.title}
      </p>
      <h1 class="font-display text-[clamp(40px,6vw,80px)] leading-none font-extrabold tracking-tighter">
        {chapter.pageTitle}
      </h1>
      <p class="max-w-190 text-xl leading-relaxed">{chapter.introduction}</p>
    </section>
    <section class="flex flex-col gap-5" aria-labelledby="chapter-entries">
      <h2 class="display text-3xl" id="chapter-entries">
        Explore the puzzles
      </h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,340px),1fr))] gap-5">
        {entries.map((entry) => (
          <EntryCard entry={entry} anchor={anchorOf(entry, all)} />
        ))}
      </div>
    </section>
    <nav class="flex flex-col gap-5 border-t-2 border-ink pt-6" aria-label="Other chapters">
      <h2 class="display text-3xl">Other chapters</h2>
      <ul class="grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {otherChapters.map((other) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center font-bold underline hover:text-accent"
              href={`/chapters/${other.id}/`}
            >
              {other.pageTitle}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</Base>
