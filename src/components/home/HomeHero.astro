---
import PageTitle from "~/components/PageTitle.astro"
import RecommendedEntries from "~/components/RecommendedEntries.astro"
import { starterEntries } from "~/data/recommendations"
import type { CollectionEntry } from "astro:content"

interface Props {
  entries: CollectionEntry<"entries">[]
}

const starters = starterEntries(Astro.props.entries)
---

<section class="px-gutter flex flex-col gap-7 pt-12 pb-10 sm:pt-18">
  <PageTitle size="home">
    It can't be true.
    <br />
    <span class="text-accent">It can't be false.</span>
  </PageTitle>
  <p class="max-w-190 text-xl leading-snug sm:text-2xl">
    Paradoxes in plain words. Explore claims that seem true but clash, and illusions that fool
    the senses. See what resolves each puzzle, or why the answer is still disputed.
  </p>
  <RecommendedEntries
    id="starter-entries"
    heading="Not sure where to start?"
    entries={starters}
  />
</section>
