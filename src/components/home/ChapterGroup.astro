---
import type { CollectionEntry } from "astro:content"
import EntryGrid from "~/components/EntryGrid.astro"
import type { Chapter } from "~/data/chapters"
import { isListed } from "~/data/entries"

interface Props {
  chapter: Chapter
  items: CollectionEntry<"entries">[]
  all: CollectionEntry<"entries">[]
  // Below md only one chapter is open at a time; this is the one open on load.
  open?: boolean
}

const { chapter, items, all, open = false } = Astro.props
---

<section
  class="group/chapter flex flex-col gap-5"
  data-chapter={chapter.id}
  data-open={open ? "" : undefined}
  hidden={!items.some(isListed)}
>
  <h2 class="contents">
    <button
      type="button"
      class="flex w-full cursor-pointer items-center gap-4 text-left max-md:min-h-11 max-md:border-b-2 max-md:border-ink max-md:pb-3 md:hidden"
      aria-expanded="true"
      aria-controls={`chapter-${chapter.id}`}
      data-toggle
    >
      <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-6 gap-y-2 max-md:flex-col max-md:items-start max-md:gap-1">
        <span class="mono-label text-sm text-accent">{chapter.n}</span>
        <span class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</span>
      </span>
      <span class="mono-label flex shrink-0 items-center gap-3 md:hidden" aria-hidden="true">
        <span data-chapter-count>{items.filter(isListed).length}</span>
        <span class="text-2xl leading-none transition-transform group-data-open/chapter:rotate-45 motion-reduce:transition-none">
          +
        </span>
      </span>
    </button>
    <!-- From md up the heading links to the chapter page. Below md it is the toggle above. -->
    <a
      class="flex flex-wrap items-baseline gap-x-6 gap-y-2 self-start no-underline hover:text-accent max-md:hidden"
      href={`/chapters/${chapter.id}/`}
    >
      <span class="mono-label text-sm text-accent">{chapter.n}</span>
      <span class="display text-[clamp(30px,4vw,52px)]">{chapter.title}</span>
    </a>
  </h2>
  <!-- Below md the chapters fold up, one open at a time. From md up they are always open. -->
  <div
    id={`chapter-${chapter.id}`}
    data-body
    class="flex flex-col gap-5 max-md:group-not-data-open/chapter:hidden"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <p class="w-full max-w-190 text-lg">{chapter.blurb}</p>
      <a
        class="inline-flex min-h-11 items-center font-bold underline hover:text-accent md:hidden"
        href={`/chapters/${chapter.id}/`}
      >
        Explore this chapter →
      </a>
    </div>
    <EntryGrid entries={items} all={all} />
  </div>
</section>
