---
import Linked from "~/components/Linked.astro"
import type { ArgumentData } from "~/data/entries"
import { statuses } from "~/data/status"

interface Props {
  data: ArgumentData
}

const { data: d } = Astro.props
const s = statuses[d.status]
---

<section
  aria-labelledby="entry-takeaway"
  class="flex flex-col gap-3 border-2 border-ink p-5 text-lg leading-normal sm:p-6"
>
  <h2 id="entry-takeaway" class="display text-3xl">
    The takeaway
  </h2>
  <p>
    <Linked text={d.whatBreaks} />
  </p>
  <p>
    <strong>{s.label}:</strong> <Linked text={d.statusNote} />
  </p>
</section>
