---
import PuzzleIllustration from "~/components/PuzzleIllustration.astro"
import EntrySection from "~/components/entry/EntrySection.astro"
import Resolution from "~/components/entry/Resolution.astro"
import type { ArgumentData } from "~/data/entries"

interface Props {
  slug: string
  data: ArgumentData
}

// The sections of an entry in the argument format. Illusions have their own body (see
// IllusionExperience). The sections are direct children of the page's <article>.
const { slug, data: d } = Astro.props
---

<EntrySection heading="The setup" paragraphs={[d.setup]}>
  <PuzzleIllustration slug={slug} placement="setup" />
</EntrySection>
<EntrySection heading="Why it feels wrong" paragraphs={[d.whyWrong]} />
{(d.resolution.length > 0 || d.positions.length > 0) && <Resolution slug={slug} data={d} />}
