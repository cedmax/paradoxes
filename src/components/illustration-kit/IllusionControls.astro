---
interface Props {
  name: string
  play?: boolean
  proof?: string
  proofLabel?: string
}
const { name, play = true, proof, proofLabel = "Show measurements" } = Astro.props
---

<div class="flex flex-wrap items-center gap-3">
  {play && (
    <button type="button" id={`${name}-play`} class="btn-ghost" aria-pressed="false">
      Play
    </button>
  )}
  {proof && (
    <button type="button" id={`${name}-guide-toggle`} class="btn-toggle" aria-pressed="false">
      {proofLabel}
    </button>
  )}
  {proof && (
    <p id={`${name}-proof`} class="text-base" aria-live="polite" hidden>
      {proof}
    </p>
  )}
</div>
