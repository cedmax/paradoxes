---
import type { CollectionEntry } from "astro:content"
import { statuses } from "~/data/status"

interface Props {
  entry: CollectionEntry<"entries">
}

const { entry } = Astro.props
const d = entry.data
const s = statuses[d.status]
const haystack = [d.title, d.problem, d.claimA, d.claimB, d.verdict].join(" ").toLowerCase()
---

<a
  class="flex flex-col gap-6 border-2 border-ink bg-paper p-5 text-ink no-underline transition-colors duration-100 hover:bg-ink hover:text-paper focus-visible:-outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none sm:p-7"
  href={`/entries/${entry.id}/`}
  data-card
  data-status={d.status}
  data-text={haystack}
>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2.5">
    <div class="display text-[clamp(28px,2.6vw,36px)]">{d.title}</div>
    <div
      class:list={[
        "inline-flex items-center border-2 border-ink px-3 py-1 text-sm font-bold text-ink",
        s.bg,
      ]}
    >
      {s.label}
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <div class="mono-label opacity-65">The problem</div>
    <div class="font-display text-[clamp(22px,2vw,27px)] leading-[1.18] font-extrabold tracking-[-0.02em]">
      {d.problem}
    </div>
  </div>
  <div class="flex flex-col gap-3.5">
    <div class="flex flex-col gap-1">
      <span class="mono-label opacity-65">Seems true</span>
      <span class="text-xl leading-[1.3] font-semibold">{d.claimA}</span>
    </div>
    <div
      class="font-display flex items-center gap-3 text-xl font-extrabold tracking-[0.02em] text-accent uppercase before:flex-auto before:border-t-2 before:border-current before:opacity-25 before:content-[''] after:flex-auto after:border-t-2 after:border-current after:opacity-25 after:content-['']"
      aria-hidden="true"
    >
      but
    </div>
    <div class="flex flex-col gap-1">
      <span class="mono-label opacity-65">Also seems true</span>
      <span class="text-xl leading-[1.3] font-semibold">{d.claimB}</span>
    </div>
  </div>
  <div class="flex flex-col gap-1 border-t-2 border-current pt-4">
    <span class="mono-label opacity-65">How it ends: {s.label}</span>
    <span class="text-lg leading-[1.35] font-semibold">{d.verdict}</span>
  </div>
</a>
