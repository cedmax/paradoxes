---
import type { CollectionEntry } from "astro:content"
import { statuses } from "~/data/status"
import { uniqueness } from "~/data/uniqueness"

interface Props {
  entry: CollectionEntry<"entries">
  // The entry this one is related to or a variant of. Not set for canonical entries.
  anchor?: CollectionEntry<"entries">
}

const { entry, anchor } = Astro.props
const d = entry.data
const s = statuses[d.status]
const u = uniqueness[d.uniqueness]
// Searching an anchor's title also finds its variants and related entries.
const haystack = [
  d.title,
  ...d.aka,
  anchor?.data.title,
  d.problem,
  d.claimA,
  d.claimB,
  d.verdict,
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase()
---

<!-- The title link covers the whole card, so the anchor link can sit inside it without nesting links. -->
<div
  class="relative flex flex-col gap-6 border-2 border-ink bg-paper p-5 text-ink transition-colors duration-100 hover:bg-ink hover:text-paper has-[[data-main]:focus-visible]:-outline-offset-4 has-[[data-main]:focus-visible]:outline-4 has-[[data-main]:focus-visible]:outline-accent motion-reduce:transition-none sm:p-7"
  data-card
  data-status={d.status}
  data-variant={String(d.uniqueness === "variant")}
  data-reviewed={String(d.reviewed)}
  data-text={haystack}
  hidden={d.uniqueness === "variant"}
>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2.5">
    <div class="flex min-w-0 flex-col gap-2.5">
      <div class="display text-[clamp(28px,2.6vw,36px)]">
        <a
          class="no-underline after:absolute after:inset-0 focus-visible:outline-none"
          href={`/entries/${entry.id}/`}
          data-main
        >
          {d.title}
        </a>
      </div>
      {anchor && (
        <div class="mono-label">
          {u.relation}{" "}
          <a class="relative z-10 underline" href={`/entries/${anchor.id}/`}>
            {anchor.data.title}
          </a>
        </div>
      )}
    </div>
    <div
      class:list={[
        "inline-flex items-center border-2 border-ink px-3 py-1 text-sm font-bold text-ink",
        s.bg,
      ]}
    >
      {s.label}
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <div class="mono-label opacity-65">The problem</div>
    <div class="font-display text-[clamp(22px,2vw,27px)] leading-tight font-extrabold tracking-tight">
      {d.problem}
    </div>
  </div>
  <!-- The face-off is on every entry page; on phones the index card skips it to keep the list scannable. -->
  <div class="hidden flex-col gap-3.5 sm:flex">
    <div class="flex flex-col gap-1">
      <span class="mono-label opacity-65">Seems true</span>
      <span class="text-xl leading-snug font-semibold">{d.claimA}</span>
    </div>
    <div
      class="font-display flex items-center gap-3 text-xl font-extrabold tracking-wide text-accent uppercase before:flex-auto before:border-t-2 before:border-current before:opacity-25 after:flex-auto after:border-t-2 after:border-current after:opacity-25"
      aria-hidden="true"
    >
      but
    </div>
    <div class="flex flex-col gap-1">
      <span class="mono-label opacity-65">Also seems true</span>
      <span class="text-xl leading-snug font-semibold">{d.claimB}</span>
    </div>
  </div>
  <div class="flex flex-col gap-1 border-t-2 border-current pt-4">
    <span class="mono-label opacity-65">How it ends: {s.label}</span>
    <span class="text-lg leading-snug font-semibold">{d.verdict}</span>
  </div>
</div>
