---
import type { CollectionEntry } from "astro:content"
import { statuses } from "~/data/status"
import { uniqueness } from "~/data/uniqueness"

interface Props {
  entry: CollectionEntry<"entries">
  // The entry this one is related to or a variant of. Not set for canonical entries.
  anchor?: CollectionEntry<"entries">
}

const { entry, anchor } = Astro.props
const d = entry.data
const s = statuses[d.status]
const u = uniqueness[d.uniqueness]
// Searching an anchor's title also finds its variants and related entries.
const lower = (...parts: (string | undefined)[]) =>
  parts.filter(Boolean).join(" ").toLowerCase()
// What the card shows, and what it keeps back. The index card ends on the question, so a search
// that only matches claimA, claimB or verdict reveals that text on the card (see index.astro).
const shown = lower(d.title, ...d.aka, anchor?.data.title, d.problem)
const hits = [
  { label: "Seems true", text: d.claimA },
  { label: "Also seems true", text: d.claimB },
  { label: `How it ends: ${s.label}`, text: d.verdict },
]
const haystack = lower(shown, ...hits.map((h) => h.text))
---

<!-- The title link covers the whole card, so the anchor link can sit inside it without nesting links. -->
<div
  class="relative flex flex-col gap-4 border-2 border-ink bg-paper p-5 text-ink transition-colors duration-100 hover:bg-ink hover:text-paper has-[[data-main]:focus-visible]:-outline-offset-4 has-[[data-main]:focus-visible]:outline-4 has-[[data-main]:focus-visible]:outline-accent motion-reduce:transition-none"
  data-card
  data-status={d.status}
  data-variant={String(d.uniqueness === "variant")}
  data-reviewed={String(d.reviewed)}
  data-text={haystack}
  data-shown={shown}
  hidden={d.uniqueness === "variant"}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 flex-col gap-2.5">
      <div class="display text-[clamp(24px,2vw,30px)]">
        <a
          class="no-underline after:absolute after:inset-0 focus-visible:outline-none"
          href={`/entries/${entry.id}/`}
          data-main
        >
          {d.title}
        </a>
      </div>
      {anchor && (
        <div class="mono-label">
          {u.relation}{" "}
          <a class="relative z-10 underline" href={`/entries/${anchor.id}/`}>
            {anchor.data.title}
          </a>
        </div>
      )}
    </div>
    <div
      class:list={[
        "inline-flex shrink-0 items-center border-2 border-ink px-3 py-1 text-sm font-bold text-ink",
        s.bg,
      ]}
    >
      {s.label}
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <div class="mono-label opacity-65">The problem</div>
    <div class="font-display text-[clamp(20px,1.7vw,24px)] leading-tight font-extrabold tracking-tight">
      {d.problem}
    </div>
  </div>
  <!-- The face-off and the verdict are on the entry page. The card ends on the question. -->
  <div class="flex flex-col gap-3 border-t-2 border-current pt-4" data-hits hidden>
    {hits.map((h) => (
      <div class="flex flex-col gap-1" data-hit data-text={h.text.toLowerCase()} hidden>
        <span class="mono-label opacity-65">{h.label}</span>
        <span class="text-lg leading-snug font-semibold">{h.text}</span>
      </div>
    ))}
  </div>
</div>
