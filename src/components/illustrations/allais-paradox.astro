---
import ComparisonTable from "~/components/illustration-kit/ComparisonTable.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SideBySide from "~/components/illustration-kit/SideBySide.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import Disclosure from "~/components/illustration-kit/Disclosure.astro"

const tickets = Array.from({ length: 100 }, (_, i) => i)
const gambles = [
  {
    pair: "First pair",
    rows: [
      ["A", "$1m", "$1m", "$1m"],
      ["B", "$5m", "$0", "$1m"],
    ],
  },
  {
    pair: "Second pair",
    rows: [
      ["A", "$1m", "$1m", "$0"],
      ["B", "$5m", "$0", "$0"],
    ],
  },
]
---

<IllustrationFigure
  name="allais-paradox"
  lead="Only 89 tickets change. Why do people's choices flip?"
>
  <p class="text-base leading-normal">
    Imagine 100 equally likely tickets. Each small square is one ticket. Both bets use the same
    tickets, but offer different prizes. Switch between the two choices.
  </p>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Choose the Allais gamble pair">
    <button type="button" class="btn-toggle" data-allais-pair="0" aria-pressed="true">
      First pair
    </button>
    <button type="button" class="btn-toggle" data-allais-pair="1" aria-pressed="false">
      Second pair
    </button>
  </div>

  <SideBySide>
    <Panel title="Option A" class="flex min-w-0 flex-col gap-2">
      <div
        data-allais-grid-a
        class="grid grid-cols-10 gap-0.5"
        role="img"
        aria-label="Option A: all 100 tickets pay one million dollars"
      >
        {tickets.map(() => (
          <span
            data-allais-ticket-a
            class="aspect-square min-w-0 bg-series-green ring-1 ring-inset ring-ink/20"
            aria-hidden="true"
          ></span>
        ))}
      </div>
      <p id="allais-a-payout" class="text-sm leading-normal">
        All 100 tickets pay $1m.
      </p>
    </Panel>
    <Panel title="Option B" class="flex min-w-0 flex-col gap-2">
      <div
        data-allais-grid-b
        class="grid grid-cols-10 gap-0.5"
        role="img"
        aria-label="Option B: ten tickets pay five million dollars, one pays nothing, and eighty-nine pay one million"
      >
        {tickets.map((i) => (
          <span
            data-allais-ticket-b
            class:list={[
              "aspect-square min-w-0 ring-1 ring-inset ring-ink/20",
              i < 10 ? "bg-series-gold" : i === 10 ? "bg-paper" : "bg-series-green",
            ]}
            aria-hidden="true"
          ></span>
        ))}
      </div>
      <p id="allais-b-payout" class="text-sm leading-normal">
        10 pay $5m, 1 pays $0, 89 pay $1m.
      </p>
    </Panel>
  </SideBySide>

  <div class="flex flex-wrap gap-3 text-sm">
    <span class="flex items-center gap-2">
      <span
        class="size-4 bg-series-green ring-1 ring-inset ring-ink/20"
        aria-hidden="true"
      ></span>
      $1m
    </span>
    <span class="flex items-center gap-2">
      <span
        class="size-4 bg-series-gold ring-1 ring-inset ring-ink/20"
        aria-hidden="true"
      ></span>
      $5m
    </span>
    <span class="flex items-center gap-2">
      <span class="size-4 bg-paper ring-1 ring-inset ring-ink/40" aria-hidden="true"></span>$0
    </span>
  </div>

  <Callout>
    <p id="allais-explanation" class="text-base leading-normal" aria-live="polite">
      In the first pair, A guarantees $1m. Many people choose A. Look at the big green block of
      89 shared tickets: both options pay $1m on those.
    </p>
  </Callout>
  <p class="text-base leading-normal">
    The first row of 10 tickets and the next single ticket never change. Only the remaining 89
    tickets switch from $1m to $0 {" "}<strong>for both options</strong>. Many people then choose B
    instead of A.
  </p>
  <Fragment slot="caption">
    The usual choices are A in the first pair and B in the second, even though only a shared
    outcome changes. $1m means $1 million. The puzzle is whether that switch can be rational.
  </Fragment>

  <Disclosure slot="after" summary="See the exact payouts in tables">
    <div class="mt-3 flex flex-col gap-4">
      {gambles.map(({ pair, rows }) => (
        <ComparisonTable
          dense
          caption={`${pair}: 100 equally likely tickets`}
          columns={["Option", "10 tickets", "1 ticket", "89 shared tickets"]}
          rows={rows}
          highlight={[3]}
        />
      ))}
    </div>
  </Disclosure>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("allais-paradox")
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-allais-pair]"))
    const gridA = find<HTMLElement>(root, "[data-allais-grid-a]")
    const gridB = find<HTMLElement>(root, "[data-allais-grid-b]")
    const tilesA = Array.from(root.querySelectorAll<HTMLElement>("[data-allais-ticket-a]"))
    const tilesB = Array.from(root.querySelectorAll<HTMLElement>("[data-allais-ticket-b]"))
    const descriptionA = find<HTMLElement>(root, "#allais-a-payout")
    const descriptionB = find<HTMLElement>(root, "#allais-b-payout")
    const explanation = find<HTMLElement>(root, "#allais-explanation")

    const colour = (tile: HTMLElement, outcome: 0 | 1 | 5) => {
      tile.classList.remove("bg-paper", "bg-series-green", "bg-series-gold")
      tile.classList.add(
        outcome === 0 ? "bg-paper" : outcome === 1 ? "bg-series-green" : "bg-series-gold",
      )
    }
    const render = (pair: number) => {
      const first = pair === 0
      tilesA.forEach((tile, i) => colour(tile, first || i < 11 ? 1 : 0))
      tilesB.forEach((tile, i) => colour(tile, i < 10 ? 5 : first && i >= 11 ? 1 : 0))
      descriptionA.textContent = first ? "All 100 tickets pay $1m." : "11 pay $1m, 89 pay $0."
      descriptionB.textContent = first
        ? "10 pay $5m, 1 pays $0, 89 pay $1m."
        : "10 pay $5m, 90 pay $0."
      gridA.setAttribute(
        "aria-label",
        first
          ? "Option A: all 100 tickets pay one million dollars"
          : "Option A: eleven tickets pay one million dollars, eighty-nine pay nothing",
      )
      gridB.setAttribute(
        "aria-label",
        first
          ? "Option B: ten tickets pay five million dollars, one pays nothing, eighty-nine pay one million"
          : "Option B: ten tickets pay five million dollars, ninety pay nothing",
      )
      explanation.textContent = first
        ? "In the first pair, A guarantees $1m. Many people choose A. The same 89 tickets pay $1m on both options."
        : "In the second pair, those same 89 tickets now pay $0 on both options. Many people switch to B, although the part that differs between A and B has not changed."
      buttons.forEach((button, i) => button.setAttribute("aria-pressed", String(i === pair)))
    }
    buttons.forEach((button, i) => button.addEventListener("click", () => render(i)))
    render(0)
  }
</script>
