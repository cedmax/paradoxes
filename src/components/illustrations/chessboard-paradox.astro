---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { seriesList, stroke } from "~/data/palette"

const layouts = [
  ["0,0 8,0 8,3", "0,0 0,3 8,3", "3,3 8,3 8,8 5,8", "0,3 3,3 5,8 0,8"],
  ["0,0 8,0 8,3", "5,2 5,5 13,5", "0,0 0,5 5,5 5,2", "8,0 13,0 13,5 8,3"],
]
---

<IllustrationFigure>
  <div class="grid gap-6">
    {layouts.map((pieces, i) => (
      <div class="flex flex-col gap-2">
        <p class="font-bold">
          {i === 0 ? "8 × 8: 64 squares" : "13 × 5: an outline of 65 squares"}
        </p>
        <SvgFigure
          name={`board-${i}`}
          class="mx-auto w-full max-w-80"
          viewBox={i === 0 ? "-2.7 -0.2 13.4 8.4" : "-0.2 -0.2 13.4 5.4"}
          title={
            i === 0
              ? "An 8 by 8 square divided into two triangles and two trapezoids"
              : "The same four pieces rearranged into an apparent 13 by 5 rectangle"
          }
        >
          <g
            transform={`translate(0 ${i === 0 ? 8 : 5}) scale(1 -1)`}
            stroke={stroke}
            stroke-width="0.035"
            stroke-linejoin="round"
          >
            {pieces.map((points, j) => (
              <polygon points={points} fill={seriesList[j]} stroke="none" />
            ))}
            {Array.from({ length: i === 0 ? 9 : 14 }, (_, x) => (
              <path d={`M${x},0 V${i === 0 ? 8 : 5}`} fill="none" opacity="0.25" />
            ))}
            {Array.from({ length: i === 0 ? 9 : 6 }, (_, y) => (
              <path d={`M0,${y} H${i === 0 ? 8 : 13}`} fill="none" opacity="0.25" />
            ))}
            <g fill="none" stroke-width="0.16">
              <rect x="0" y="0" width={i === 0 ? 8 : 13} height={i === 0 ? 8 : 5} />
              <path
                d={i === 0 ? "M0,0 L8,3 M0,3 H8 M3,3 L5,8" : "M0,0 L13,5 M5,2 V5 M8,0 V3"}
              />
            </g>
          </g>
        </SvgFigure>
      </div>
    ))}
  </div>
  <Fragment slot="caption">
    The same colours mark the same pieces. Each grid square represents one square unit, and both
    drawings use the same scale.
  </Fragment>
  <Disclosure slot="after" summary="See the gap highlighted">
    <SvgFigure
      name="board-gap"
      class="mt-4 w-full"
      viewBox="-0.2 -0.2 13.4 5.4"
      title="The exact parallelogram gap highlighted in gold"
    >
      <g transform="translate(0 5) scale(1 -1)" stroke={stroke} stroke-width="0.015">
        {layouts[1].map((points, j) => (
          <polygon points={points} fill={seriesList[j]} fill-opacity="0.25" />
        ))}
        <polygon points="0,0 5,2 13,5 8,3" fill={seriesList[2]} />
      </g>
    </SvgFigure>
    <p class="mt-2 text-base">
      Gold marks the gap, whose total area is one square. The drawing keeps its true
      proportions.
    </p>
  </Disclosure>
</IllustrationFigure>
