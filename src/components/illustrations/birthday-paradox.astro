---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import { series, stroke } from "~/data/palette"

const startingPeople = 23
const matchChance = (n: number) => {
  let noMatch = 1
  for (let i = 0; i < n; i++) noMatch *= (365 - i) / 365
  return (1 - noMatch) * 100
}
const firstChance = matchChance(startingPeople)
const existingPeople = [48, 116, 184, 252]
---

<IllustrationFigure
  name="birthday-paradox"
  lead="You are not looking for someone who shares your birthday. Any two people can match."
>
  <p class="text-base leading-normal">
    Each new person can match everyone already in the room. That makes the number
    of possible pairs grow much faster than the number of people.
  </p>

  <SvgFigure
    name="birthday-pairs-example"
    class="mx-auto w-full max-w-xs"
    viewBox="0 0 300 160"
    title="The fifth person creates four new possible pairs"
    desc="Four existing people are shown across the top. Four lines connect them to a fifth person below. Each new person can pair with everyone already in the room."
  >
    <g stroke={series.gold} stroke-width="2.5">
      {existingPeople.map((x) => <line x1={x} y1="40" x2="150" y2="110" />)}
    </g>
    {existingPeople.map((x, i) => (
      <g>
        <circle cx={x} cy="40" r="17" fill="var(--color-paper)"
          stroke={stroke} stroke-width="1.5" />
        <text x={x} y="46" font-size="16" font-weight="700"
          fill="currentColor" text-anchor="middle">{i + 1}</text>
      </g>
    ))}
    <circle cx="150" cy="110" r="19" fill={series.blue} />
    <text x="150" y="116" font-size="16" font-weight="700"
      fill="var(--color-paper)" text-anchor="middle">5</text>
    <text x="150" y="154" font-size="14" font-weight="700"
      fill="currentColor" text-anchor="middle">The fifth person adds 4 new pairs</text>
  </SvgFigure>

  <Slider
    id="birthday-people"
    label="People in the room"
    min={2}
    max={70}
    step={1}
    value={startingPeople}
    startLabel="2 people"
    endLabel="70 people"
    valuetext="23 people"
    describedby="birthday-readout"
  >
    <p id="birthday-readout" class="text-base font-bold" aria-live="polite">
      23 people make 253 possible pairs.
    </p>
  </Slider>

  <p id="birthday-new-pairs" class="text-base leading-normal">
    The 23rd person alone adds 22 new possible pairs.
  </p>

  <SvgFigure
    name="birthday-chance"
    class="w-full max-w-md"
    viewBox="0 0 340 104"
    title="Chance that at least two people share a birthday"
    desc="With 23 people there are 253 different pairs, and the chance of at least one shared birthday is 50.7 percent. Use the slider to change the group size and probability."
  >
    <g fill="currentColor" font-size="15">
      <text x="10" y="18" font-weight="700">Chance of a shared birthday</text>
      <rect x="10" y="29" width="320" height="24" fill="var(--color-paper)"
        stroke={stroke} stroke-width="1.5" />
      <rect id="birthday-chance-fill" x="10" y="29"
        width={(firstChance * 320) / 100} height="24" fill={series.green} />
      <line x1="170" x2="170" y1="25" y2="60" stroke={series.red}
        stroke-width="2.5" stroke-dasharray="4 3" />
      <text x="10" y="74" font-size="13">0%</text>
      <text x="170" y="74" text-anchor="middle" font-size="13" font-weight="700">50% threshold</text>
      <text x="330" y="74" text-anchor="end" font-size="13">100%</text>
      <text id="birthday-chance-label" x="10" y="98" font-weight="700">
        23 people: 50.7% chance
      </text>
    </g>
  </SvgFigure>

  <Callout class="flex flex-col gap-2">
    <p id="birthday-threshold-heading" class="font-bold" aria-live="polite">
      23 people: the first group above 50%
    </p>
    <p id="birthday-threshold-explanation" class="text-base leading-normal">
      With 22 people the chance is 47.6%. Add one person and 22 new pairs:
      at 23 people it is 50.7%, so a shared birthday becomes more likely than not.
    </p>
  </Callout>

  <Fragment slot="caption">
    Try moving the slider. The count includes every possible pair, not just pairs
    involving you. The probabilities assume 365 equally likely birthdays, with no leap day.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("birthday-paradox")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#birthday-people")
    const readout = find<HTMLElement>(root, "#birthday-readout")
    const newPairs = find<HTMLElement>(root, "#birthday-new-pairs")
    const fill = find<SVGRectElement>(root, "#birthday-chance-fill")
    const chanceLabel = find<SVGTextElement>(root, "#birthday-chance-label")
    const chanceDesc = find<SVGDescElement>(root, "#birthday-chance-desc")
    const thresholdHeading = find<HTMLElement>(root, "#birthday-threshold-heading")
    const thresholdExplanation = find<HTMLElement>(root, "#birthday-threshold-explanation")

    const matchChance = (n: number) => {
      let noMatch = 1
      for (let i = 0; i < n; i++) noMatch *= (365 - i) / 365
      return (1 - noMatch) * 100
    }

    bindSlider(slider, (n) => {
      const pairs = (n * (n - 1)) / 2
      const probability = matchChance(n)
      const formattedChance = probability.toFixed(1)
      readout.textContent = `${n} people make ${pairs.toLocaleString("en-GB")} possible pairs.`
      newPairs.textContent = `Person ${n} adds ${n - 1} new possible pairs.`
      fill.setAttribute("width", String((probability * 320) / 100))
      fill.setAttribute("fill", n >= 23 ? "var(--color-series-green)" : "var(--color-series-blue)")
      chanceLabel.textContent = `${n} people: ${formattedChance}% chance`
      const threshold = n >= 23 ? "above" : "below"
      chanceDesc.textContent = `With ${n} people there are ${pairs} possible pairs and a ${formattedChance} percent chance of at least one shared birthday, ${threshold} the marked 50 percent threshold.`

      if (n === 23) {
        thresholdHeading.textContent = "23 people: the first group above 50%"
        thresholdExplanation.textContent = "With 22 people the chance is 47.6%. Add one person and 22 new pairs: at 23 people it is 50.7%, so a shared birthday becomes more likely than not."
      } else if (n === 22) {
        thresholdHeading.textContent = "22 people: just below 50%"
        thresholdExplanation.textContent = "The chance is 47.6%. One more person adds 22 new pairs, crossing 50% for the first time at 23 people (50.7%)."
      } else if (n < 23) {
        thresholdHeading.textContent = `${n} people: still below 50%`
        thresholdExplanation.textContent = `There are ${pairs.toLocaleString("en-GB")} possible pairs, but a match is only ${formattedChance}% likely. At 23 people the chance first passes 50%.`
      } else {
        thresholdHeading.textContent = `${n} people: above 50%`
        thresholdExplanation.textContent = `With ${pairs.toLocaleString("en-GB")} possible pairs, the chance of a match is ${formattedChance}%. The 50% threshold was first crossed at 23 people.`
      }
      return `${n} people; ${pairs} possible pairs; ${formattedChance} percent chance of a match, ${threshold} 50 percent`
    })
  }
</script>
