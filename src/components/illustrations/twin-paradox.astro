      </text>
      <text x="4" y="139">
        5 years
      </text>
      <text x="4" y="236">
        0 years
      </text>
      <text x="80" y="254" text-anchor="middle">
        Earth
      </text>
      <text x="214" y="254" text-anchor="middle">
        Star
      </text>
      <text x="88" y="124" font-weight="bold">
        Terence
      </text>
      <text x="88" y="144">
        10 years
      </text>
      <text x="158" y="62" font-weight="bold">
