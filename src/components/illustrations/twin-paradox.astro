<figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6" data-twin-journey>
  <p class="font-bold">One round trip, two clocks</p>
  <p class="text-base leading-normal">
    Stella flies to a star four light-years away at 80% of light speed, then returns.
    Terence stays on Earth. Move through the journey and watch how much time each clock records.
  </p>

  <div class="grid gap-3 sm:grid-cols-2" aria-label="Time elapsed on each twin's clock">
    <div class="flex flex-col gap-2 border-2 border-ink p-3 sm:p-4">
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 shrink-0 rounded-full" style="background: #387a91;" aria-hidden="true"></span>
        <p class="font-bold">Terence · Earth</p>
      </div>
      <p class="font-mono text-3xl font-bold tabular-nums">
        <span id="twin-earth-clock">0.0</span> <span class="text-base font-normal">years</span>
      </p>
      <div class="h-3 border border-ink" aria-hidden="true">
        <div id="twin-earth-bar" class="h-full" style="width: 0%; background: #387a91;"></div>
      </div>
      <p class="text-sm">Stays on Earth for the whole journey.</p>
    </div>
    <div class="flex flex-col gap-2 border-2 border-ink p-3 sm:p-4">
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 shrink-0 rounded-full" style="background: #bd4b37;" aria-hidden="true"></span>
        <p class="font-bold">Stella · spaceship</p>
      </div>
      <p class="font-mono text-3xl font-bold tabular-nums">
        <span id="twin-ship-clock">0.0</span> <span class="text-base font-normal">years</span>
      </p>
      <div class="h-3 border border-ink" aria-hidden="true">
        <div id="twin-ship-bar" class="h-full" style="width: 0%; background: #bd4b37;"></div>
      </div>
      <p class="text-sm">Travels out, turns, and returns.</p>
    </div>
  </div>
  <p class="text-sm">Both bars use the same scale: 0 to 10 years.</p>

  <svg
    class="mx-auto w-full max-w-2xl"
    viewBox="0 0 560 190"
    role="img"
    aria-labelledby="twin-route-title twin-route-desc"
  >
    <title id="twin-route-title">Stella's round trip between Earth and a star</title>
    <desc id="twin-route-desc">
      In Earth's frame the star is four light-years away. Stella's red spaceship travels
      from Earth to the star and back. Terence stays on Earth. Both clocks update
      as the journey slider moves.
    </desc>
    <text x="280" y="28" text-anchor="middle" font-size="17" font-weight="700" fill="currentColor">
      4 light-years · measured from Earth
    </text>
    <line x1="65" y1="88" x2="495" y2="88" stroke="currentColor" stroke-width="2"
      stroke-dasharray="6 8" opacity=".45" />
    <line id="twin-distance-travelled" x1="65" y1="88" x2="65" y2="88"
      stroke="#bd4b37" stroke-width="3.5" opacity=".5" />
    <circle cx="65" cy="88" r="12" fill="#387a91" />
    <circle cx="65" cy="88" r="5" fill="var(--color-paper)" />
    <path d="M495 72 L499 83 L511 83 L501 91 L505 103 L495 96 L485 103 L489 91 L479 83 L491 83 Z"
      fill="#d7a13d" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
    <g id="twin-ship" transform="translate(65 88)">
      <circle r="21" fill="var(--color-paper)" opacity=".95" />
      <path id="twin-ship-arrow" d="M-14 -12 L14 0 L-14 12 L-7 0 Z"
        fill="#bd4b37" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
    </g>
    <g font-size="17" fill="currentColor">
      <text x="65" y="139" text-anchor="middle" font-weight="700">Earth</text>
      <text x="65" y="160" text-anchor="middle" font-size="14">Terence</text>
      <text x="495" y="139" text-anchor="middle" font-weight="700">Star</text>
      <text x="495" y="160" text-anchor="middle" font-size="14">Turn here</text>
      <text id="twin-ship-caption" x="280" y="184" text-anchor="middle" font-size="14">
        Stella starts at Earth
      </text>
    </g>
  </svg>

  <div class="flex flex-col gap-3">
    <label for="twin-time-slider" class="font-bold">
      Journey time in Earth's frame:
      <span id="twin-slider-readout" class="font-mono tabular-nums">0.0</span> years
    </label>
    <input
      id="twin-time-slider"
      type="range"
      min="0"
      max="10"
      step="0.1"
      value="0"
      class="h-11 w-full accent-ink"
      aria-describedby="twin-journey-status"
      aria-valuetext="Departure, 0 Earth years and 0 ship years"
    />
    <div class="flex flex-wrap gap-2">
      <button id="twin-play" class="btn-ghost" type="button">Play journey</button>
      <button type="button" class="btn-ghost" data-twin-jump="0">Departure</button>
      <button type="button" class="btn-ghost" data-twin-jump="5">Turnaround</button>
      <button type="button" class="btn-ghost" data-twin-jump="10">Reunion</button>
    </div>
    <div class="border-l-4 border-ink pl-4">
      <p id="twin-journey-status" class="font-bold" aria-live="polite">Departure · both clocks read zero.</p>
      <p id="twin-journey-note" class="text-base leading-normal">
        Terence stays still relative to Earth. Stella is about to travel out and back.
      </p>
    </div>
  </div>

  <figcaption class="text-base leading-normal">
    This is the journey as measured in Earth's frame. Each leg takes five Earth years,
    but Stella's moving clock records only three. At the reunion, Terence has aged
    10 years and Stella 6. Stella changes direction at the star, so the twins' journeys
    are not mirror images. The turn does not itself make her clock lose time:
    the age difference comes from their different paths through space and time.
    The example treats the turn as instantaneous.
  </figcaption>
</figure>

<script>
  const twinDemo = document.querySelector<HTMLElement>("[data-twin-journey]")
  if (twinDemo) {
    const find = <T extends Element>(selector: string) => twinDemo.querySelector<T>(selector)
    const slider = find<HTMLInputElement>("#twin-time-slider")!
    const sliderReadout = find<HTMLElement>("#twin-slider-readout")!
    const earthClock = find<HTMLElement>("#twin-earth-clock")!
    const shipClock = find<HTMLElement>("#twin-ship-clock")!
    const earthBar = find<HTMLElement>("#twin-earth-bar")!
    const shipBar = find<HTMLElement>("#twin-ship-bar")!
    const ship = find<SVGGElement>("#twin-ship")!
    const travelled = find<SVGLineElement>("#twin-distance-travelled")!
    const shipCaption = find<SVGTextElement>("#twin-ship-caption")!
    const status = find<HTMLElement>("#twin-journey-status")!
    const note = find<HTMLElement>("#twin-journey-note")!
    const playButton = find<HTMLButtonElement>("#twin-play")!
    const jumps = Array.from(twinDemo.querySelectorAll<HTMLButtonElement>("[data-twin-jump]"))

    // In Earth's frame Stella travels at 0.8c.
    // The time-dilation factor sqrt(1 - 0.8^2) is 0.6.
    const shipClockRate = 0.6
    const totalEarthYears = 10
    const turnEarthYears = 5
    const earthX = 65
    const starX = 495
    const animationDuration = 14000
    let time = 0
    let frame: number | null = null
    let animationStart: number | null = null
    let startingTime = 0
    let lastStage = ""

    const stageFor = (t: number) =>
      t === 0 ? "Departure" : t < 5 ? "Outbound" : t === 5 ? "Turnaround" : t < 10 ? "Returning" : "Reunion"

    const render = (earthYears: number) => {
      time = Math.max(0, Math.min(totalEarthYears, earthYears))
      const shipYears = shipClockRate * time
      const stage = stageFor(time)
      const progress = time <= turnEarthYears
        ? time / turnEarthYears
        : (totalEarthYears - time) / turnEarthYears
      const x = earthX + (starX - earthX) * progress
      const direction = time > turnEarthYears ? 180 : 0

      ship.setAttribute("transform", `translate(${x} 88) rotate(${direction})`)
      travelled.setAttribute("x2", String(x))
      earthClock.textContent = time.toFixed(1)
      shipClock.textContent = shipYears.toFixed(1)
      earthBar.style.width = `${(time / totalEarthYears) * 100}%`
      shipBar.style.width = `${(shipYears / totalEarthYears) * 100}%`
      slider.value = String(time)
      sliderReadout.textContent = time.toFixed(1)
      slider.setAttribute(
        "aria-valuetext",
        `${stage}: ${time.toFixed(1)} Earth years, ${shipYears.toFixed(1)} ship years`,
      )

      shipCaption.textContent =
        stage === "Departure" ? "Stella starts at Earth"
        : stage === "Turnaround" ? "Stella reaches the star and turns"
        : stage === "Reunion" ? "Stella returns to Earth"
        : stage === "Outbound" ? "Stella is flying away from Earth"
        : "Stella is flying back to Earth"

      // Only announce the stage transition during playback, not every animation frame.
      if (stage !== lastStage) {
        lastStage = stage
        status.textContent =
          stage === "Departure" ? "Departure · both clocks read zero."
          : stage === "Outbound" ? "Outward journey · Stella's clock gains less time."
          : stage === "Turnaround" ? "At the star · 5 Earth years, 3 ship years."
          : stage === "Returning" ? "Return journey · Stella's clock keeps ticking normally for her."
          : "Reunion · Terence aged 10 years; Stella aged 6."
        note.textContent =
          stage === "Departure" ? "Terence stays still relative to Earth. Stella is about to travel out and back."
          : stage === "Outbound" ? "As measured from Earth, one year passes on Stella's clock for every 1⅔ years on Terence's."
          : stage === "Turnaround" ? "Stella changes direction. Neither clock jumps or resets at the turn."
          : stage === "Returning" ? "Stella is travelling at the same speed in the opposite direction. Her clock still records three years over this leg."
          : "They meet again, but their clocks disagree by four years. Their routes through spacetime were different."
      }
    }

    const stop = () => {
      if (frame !== null) cancelAnimationFrame(frame)
      frame = null
      animationStart = null
      playButton.textContent = time >= totalEarthYears ? "Replay journey" : "Play journey"
    }

    const animate = (timestamp: number) => {
      if (animationStart === null) animationStart = timestamp
      const elapsed = ((timestamp - animationStart) / animationDuration) * totalEarthYears
      render(Math.min(totalEarthYears, startingTime + elapsed))
      if (time >= totalEarthYears) {
        stop()
      } else {
        frame = requestAnimationFrame(animate)
      }
    }

    slider.addEventListener("input", () => {
      stop()
      render(Number(slider.value))
    })

    for (const button of jumps) {
      button.addEventListener("click", () => {
        stop()
        render(Number(button.dataset.twinJump))
      })
    }

    playButton.addEventListener("click", () => {
      if (frame !== null) {
        stop()
        return
      }
      if (time >= totalEarthYears) render(0)
      startingTime = time
      animationStart = null
      playButton.textContent = "Pause"
      frame = requestAnimationFrame(animate)
    })

    // Avoid running an animation while the page is hidden.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && frame !== null) stop()
    })

    render(0)
  }
</script>
