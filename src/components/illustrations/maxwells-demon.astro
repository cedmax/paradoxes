<g fill="#387a91"><circle cx="97" cy="124" r="5"/><circle cx="305" cy="145" r="5"/><circle cx="390" cy="126" r="5"/></g>
<path d="M181 101 H225 M217 95 L225 101 L217 107" fill="none" stroke="#bd4b37" stroke-width="3"/>
