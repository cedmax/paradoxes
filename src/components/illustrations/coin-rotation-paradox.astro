---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import SideBySide from "~/components/illustration-kit/SideBySide.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
---

<IllustrationFigure
  name="coin-rotation"
  lead="Move the coin around the fixed one. Watch it turn as its centre travels along the dotted path."
>
  <SvgFigure
    name="coin-rotation"
    class="mx-auto w-full max-w-sm"
    viewBox="0 0 300 260"
    title="A coin rolling around an equal coin"
    desc="One moving coin follows a circle of twice the radius of the fixed coin. Moving the slider through a full orbit makes the coin rotate twice around its own centre."
  >
    <circle
      cx="150"
      cy="130"
      r="72"
      stroke="currentColor"
      stroke-width="2"
      stroke-dasharray="7 6"
      fill="none"
      opacity=".4"
    />
    <circle
      cx="150"
      cy="130"
      r="36"
      fill="var(--color-series-gold)"
      fill-opacity=".45"
      stroke="currentColor"
      stroke-width="2"
    />
    <text x="150" y="136" text-anchor="middle" font-size="16" fill="currentColor">
      Fixed
    </text>
    <g id="rolling-coin" transform="translate(222 130)">
      <circle
        r="36"
        fill="var(--color-series-blue)"
        fill-opacity=".16"
        stroke="var(--color-series-blue)"
        stroke-width="2"
      />
      <g id="rolling-coin-marker">
        <path
          d="M0 0 V-28"
          stroke="var(--color-series-red)"
          stroke-width="4"
          stroke-linecap="round"
        />
        <circle r="4" fill="var(--color-series-red)" />
      </g>
    </g>
    <g fill="currentColor" font-size="16">
      <text x="8" y="22">
        Each coin: r
      </text>
      <text x="8" y="44">
        Orbit: 2r
      </text>
    </g>
  </SvgFigure>
  <Slider
    id="coin-rotation-slider"
    label="Move the coin"
    describedby="coin-rotation-readout"
    valuetext="0 percent of orbit, 0 turns"
    startLabel="Start"
    endLabel="One complete orbit"
  >
    <p id="coin-rotation-readout" class="text-base" aria-live="off">
      <span id="coin-orbit-progress">0%</span>{"\u0020"}of the orbit ·{" "}
      <strong>
        <span id="coin-turns">0.00</span>{"\u0020"}turns
      </strong>
    </p>
  </Slider>
  <SideBySide>
    <Panel title="Moving coin circumference">
      <p>2πr</p>
    </Panel>
    <Panel title="Path of its centre">
      <p>4πr</p>
    </Panel>
  </SideBySide>
  <Fragment slot="caption">
    The moving coin's centre travels a circle of radius 2r, so the path is 4πr long. Its own
    circumference is 2πr. One trip around the fixed coin therefore produces{" "}
    <strong>two full turns</strong>.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("coin-rotation")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#coin-rotation-slider")
    const rollingCoin = find<SVGGElement>(root, "#rolling-coin")
    const marker = find<SVGGElement>(root, "#rolling-coin-marker")
    const orbitProgress = find<HTMLElement>(root, "#coin-orbit-progress")
    const turnsOutput = find<HTMLElement>(root, "#coin-turns")

    const cx = 150
    const cy = 130
    const orbitRadius = 72

    bindSlider(slider, (value) => {
      const progress = value / 100
      const angle = 2 * Math.PI * progress
      const x = cx + orbitRadius * Math.cos(angle)
      const y = cy + orbitRadius * Math.sin(angle)
      // An equal coin rolling without slipping makes two turns for one orbit.
      const spin = 720 * progress

      rollingCoin.setAttribute("transform", `translate(${x} ${y})`)
      marker.setAttribute("transform", `rotate(${spin})`)
      const percent = Math.round(progress * 100)
      const turns = (spin / 360).toFixed(2)
      orbitProgress.textContent = `${percent}%`
      turnsOutput.textContent = turns
      return `${percent} percent of orbit, ${turns} turns`
    })
  }
</script>
