---
import Callout from "~/components/illustration-kit/Callout.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
---

<IllustrationFigure name="staircase">
  <Slider
    id="staircase-step-count"
    label="Make the steps smaller"
    min={0}
    max={5}
    value={2}
    describedby="staircase-step-description"
  >
    <p id="staircase-step-description" class="text-base" aria-live="polite">
      <span id="staircase-step-label">4 steps</span>{" "}along each side
    </p>
    <Callout class="flex flex-col gap-1">
      <p class="font-bold">Staircase length: 2</p>
      <p id="staircase-length-breakdown">4 × 1/4 across + 4 × 1/4 up = 2</p>
      <p>Diagonal length: √2 ≈ 1.4142</p>
    </Callout>
  </Slider>
  <SvgFigure
    name="staircase"
    class="mx-auto w-full max-w-lg"
    viewBox="0 0 430 265"
    title="A staircase approaching a straight diagonal"
    desc="The staircase runs from the bottom left to the top right corner of a unit square. Its steps become smaller as the slider moves. Each path still covers one unit horizontally and one vertically, for a total length of two. The diagonal is about 1.414 units long."
  >
    <rect
      x="60"
      y="10"
      width="220"
      height="220"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      opacity="0.35"
    />
    <path
      d="M60 230 L280 10"
      fill="none"
      stroke="var(--color-series-red)"
      stroke-width="3"
      stroke-dasharray="7 6"
    />
    <path
      id="staircase-path"
      d="M60 230 H115 V175 H170 V120 H225 V65 H280 V10"
      fill="none"
      stroke="var(--color-series-blue)"
      stroke-width="3"
      stroke-linejoin="round"
    />
    <g fill="currentColor" font-size="18" font-family="sans-serif">
      <text x="294" y="28">
        Diagonal
      </text>
      <text x="294" y="51">
        ≈ 1.414
      </text>
      <text x="294" y="198">
        Staircase
      </text>
      <text x="294" y="221">
        = 2
      </text>
      <text x="54" y="252" text-anchor="middle">
        0
      </text>
      <text x="282" y="252" text-anchor="middle">
        1
      </text>
    </g>
  </SvgFigure>
  <Fragment slot="caption">
    The path always goes one unit right and one unit up. Making the steps smaller changes its
    shape, not its length. The dashed diagonal takes a shorter route.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("staircase")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#staircase-step-count")
    const path = find<SVGPathElement>(root, "#staircase-path")
    const label = find<HTMLElement>(root, "#staircase-step-label")
    const breakdown = find<HTMLElement>(root, "#staircase-length-breakdown")
    const stepCounts = [1, 2, 4, 8, 16, 32]

    bindSlider(slider, (index) => {
      const n = stepCounts[index] ?? 4
      let d = "M60 230"
      for (let i = 1; i <= n; i++) {
        const x = 60 + (220 * i) / n
        const y = 230 - (220 * i) / n
        d += ` H${x} V${y}`
      }
      path.setAttribute("d", d)
      const stepText = `${n} ${n === 1 ? "step" : "steps"}`
      label.textContent = stepText
      const segmentLength = n === 1 ? "1" : `1/${n}`
      breakdown.textContent = `${n} × ${segmentLength} across + ${n} × ${segmentLength} up = 2`
      return stepText
    })
  }
</script>
