---
const methods = [
  {
    rule: "Two points on the circle's edge",
    explanation: "Choose two edge points independently and uniformly, then join them.",
    probability: "1/3",
  },
  {
    rule: "Distance from the centre",
    explanation: "Choose a direction and a distance uniformly from zero to the radius.",
    probability: "1/2",
  },
  {
    rule: "Midpoint by area",
    explanation: "Choose the chord's midpoint uniformly from the area of the circle.",
    probability: "1/4",
  },
]
---

<figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6">
  <p class="font-bold">
    Which chords are longer than a side of the triangle fitted inside the circle?
  </p>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Explore the three answers">
    <button
      id="bertrand-distance-mode"
      type="button"
      class="btn-ghost aria-pressed:bg-ink aria-pressed:text-paper"
      aria-pressed="true"
    >
      Move a chord (1/2)
    </button>
    <button
      id="bertrand-edge-mode"
      type="button"
      class="btn-ghost aria-pressed:bg-ink aria-pressed:text-paper"
      aria-pressed="false"
    >
      Two edge points (1/3)
    </button>
    <button
      id="bertrand-area-mode"
      type="button"
      class="btn-ghost aria-pressed:bg-ink aria-pressed:text-paper"
      aria-pressed="false"
    >
      Random midpoint (1/4)
    </button>
  </div>
  <svg
    class="mx-auto w-full max-w-xl"
    viewBox="0 0 380 245"
    role="img"
    aria-labelledby="bertrand-title bertrand-desc"
  >
    <title id="bertrand-title">Compare a moving chord with a side of a fitted equilateral triangle</title>
    <desc id="bertrand-desc">
      An equilateral triangle fits exactly inside a circle. Its lower horizontal side is highlighted in orange.
      In the distance view, move a horizontal blue chord away from the centre. The dotted circle
      has half the outer radius; longer chords have midpoints inside it. In the edge-points view,
      the top endpoint is fixed and the other moves around the rim. The highlighted lower arc
      is one third of the circumference and produces chords longer than the triangle side.
      In the midpoint-by-area view, sample points uniformly from the whole disc. Points within
      the dotted half-radius circle make longer chords; that region covers one quarter of the area.
    </desc>

    <circle cx="130" cy="112" r="86" fill="none" stroke="currentColor" stroke-width="2" />
    <polygon
      points="130,26 55.52,155 204.48,155"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      opacity=".6"
    />
    <line
      x1="55.52"
      y1="155"
      x2="204.48"
      y2="155"
      stroke="var(--color-accent)"
      stroke-width="4"
      stroke-linecap="round"
    />
    <circle
      id="bertrand-inner-circle"
      cx="130"
      cy="112"
      r="43"
      fill="#d7a13d"
      fill-opacity=".12"
      stroke="#d7a13d"
      stroke-width="2"
      stroke-dasharray="5 5"
    />
    <g id="bertrand-distance-art">
      <line
        id="bertrand-chord"
        x1="49.44"
        y1="142.1"
        x2="210.56"
        y2="142.1"
        stroke="#387a91"
        stroke-width="4"
        stroke-linecap="round"
      />
      <circle id="bertrand-midpoint" cx="130" cy="142.1" r="5" fill="#387a91" />
    </g>
    <g id="bertrand-edge-art" visibility="hidden">
      <path
        d="M204.48 155 A86 86 0 0 1 55.52 155"
        fill="none"
        stroke="#387a91"
        stroke-width="9"
        stroke-linecap="round"
        opacity=".6"
      />
      <line
        id="bertrand-edge-chord"
        x1="130"
        y1="26"
        x2="130"
        y2="198"
        stroke="#387a91"
        stroke-width="4"
        stroke-linecap="round"
      />
      <circle cx="130" cy="26" r="5" fill="#387a91" />
      <circle id="bertrand-edge-point" cx="130" cy="198" r="5" fill="#387a91" />
    </g>
    <g id="bertrand-area-art" visibility="hidden">
      <g id="bertrand-area-dots"></g>
      <line
        id="bertrand-area-chord"
        x1="130"
        y1="26"
        x2="130"
        y2="198"
        stroke="#387a91"
        stroke-width="4"
        stroke-linecap="round"
        visibility="hidden"
      />
      <circle
        id="bertrand-area-point"
        cx="130"
        cy="112"
        r="5"
        fill="#387a91"
        visibility="hidden"
      />
    </g>
    <circle cx="130" cy="112" r="2.5" fill="currentColor" />

    <g font-size="15" fill="currentColor">
      <line x1="236" y1="43" x2="254" y2="43" stroke="var(--color-accent)" stroke-width="4" />
      <text x="262" y="48">Triangle side</text>
      <line x1="236" y1="79" x2="254" y2="79" stroke="#387a91" stroke-width="4" />
      <text x="262" y="84">Moving chord</text>
      <g id="bertrand-distance-legend">
        <text x="236" y="128">Dotted circle:</text>
        <text x="236" y="148">half the radius</text>
        <text x="236" y="178">Midpoint inside</text>
        <text x="236" y="198">means longer</text>
        <text x="236" y="218">than triangle side</text>
      </g>
      <g id="bertrand-edge-legend" visibility="hidden">
        <text x="236" y="128">Top point fixed</text>
        <text x="236" y="158">Lower blue arc:</text>
        <text x="236" y="178">1/3 of the edge</text>
        <text x="236" y="208">A long chord</text>
      </g>
      <g id="bertrand-area-legend" visibility="hidden">
        <text x="236" y="128">Midpoints chosen</text>
        <text x="236" y="148">across the circle</text>
        <text x="236" y="178">Inner disc:</text>
        <text x="236" y="198">1/4 of the area</text>
        <text x="236" y="218">Green = long</text>
      </g>
    </g>
  </svg>

  <div id="bertrand-slider-controls" class="flex flex-col gap-2">
    <label id="bertrand-slider-label" for="bertrand-chord-slider" class="font-bold">
      Move the chord away from the centre
    </label>
    <input
      id="bertrand-chord-slider"
      class="h-11 w-full accent-ink"
      type="range"
      min="0"
      max="100"
      step="1"
      value="35"
      aria-describedby="bertrand-chord-readout bertrand-mode-explanation"
      aria-valuetext="35 percent of the radius, longer than the triangle side"
    />
    <p id="bertrand-chord-readout" class="text-base" aria-live="polite">
      <span id="bertrand-chord-distance">35%</span>
      <span id="bertrand-position-description">of the radius from the centre.</span>
      <strong id="bertrand-chord-comparison">Longer than the triangle side.</strong>
    </p>
    <p id="bertrand-mode-explanation" class="border-l-4 border-ink pl-3 text-base leading-normal">
      The dotted inner circle shows the halfway mark. Move the chord's midpoint inside it to
      make a longer chord.
    </p>
  </div>
  <div id="bertrand-area-controls" class="flex flex-col gap-3" hidden>
    <p class="text-base leading-normal">
      Each click chooses a midpoint equally likely to fall anywhere in the circle.
      Only the shaded inner quarter of its area makes a chord longer than the triangle side.
    </p>
    <div class="flex flex-wrap gap-2">
      <button id="bertrand-pick-one" class="btn-ghost" type="button">Pick one midpoint</button>
      <button id="bertrand-pick-hundred" class="btn-ghost" type="button">Pick 100 midpoints</button>
      <button id="bertrand-clear-samples" class="btn-ghost" type="button">Clear</button>
    </div>
    <p id="bertrand-area-readout" class="text-base" aria-live="polite">
      Long chords: <strong id="bertrand-area-long">0</strong> of
      <strong id="bertrand-area-total">0</strong> samples
      <span id="bertrand-area-rate"></span>
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-base">
      <caption class="pb-2 text-left font-bold">
        Three ways to pick a random chord, three different answers
      </caption>
      <thead>
        <tr class="border-b border-ink">
          <th class="p-2 text-left" scope="col">What is chosen uniformly?</th>
          <th class="p-2 text-right" scope="col">Chance of a long chord</th>
        </tr>
      </thead>
      <tbody>
        {methods.map((method) => (
          <tr class="border-b border-ink last:border-0">
            <td class="p-2">
              <strong>{method.rule}</strong>
              <p class="mt-1">{method.explanation}</p>
            </td>
            <td class="p-2 text-right font-bold">{method.probability}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <figcaption class="text-base leading-normal">
    Half the possible distances produce long chords (1/2). With a fixed endpoint, a third of
    the circumference gives long chords (1/3). With midpoints chosen uniformly by area, the
    favourable inner disc is a quarter of the circle's area (1/4).
  </figcaption>
</figure>

<script>
  const distanceButton = document.querySelector<HTMLButtonElement>("#bertrand-distance-mode")
  const edgeButton = document.querySelector<HTMLButtonElement>("#bertrand-edge-mode")
  const areaButton = document.querySelector<HTMLButtonElement>("#bertrand-area-mode")
  const sliderControls = document.querySelector<HTMLElement>("#bertrand-slider-controls")
  const areaControls = document.querySelector<HTMLElement>("#bertrand-area-controls")
  const pickOne = document.querySelector<HTMLButtonElement>("#bertrand-pick-one")
  const pickHundred = document.querySelector<HTMLButtonElement>("#bertrand-pick-hundred")
  const clearSamples = document.querySelector<HTMLButtonElement>("#bertrand-clear-samples")
  const areaDots = document.querySelector<SVGGElement>("#bertrand-area-dots")
  const areaArt = document.querySelector<SVGGElement>("#bertrand-area-art")
  const areaChord = document.querySelector<SVGLineElement>("#bertrand-area-chord")
  const areaPoint = document.querySelector<SVGCircleElement>("#bertrand-area-point")
  const areaLegend = document.querySelector<SVGGElement>("#bertrand-area-legend")
  const areaLongLabel = document.querySelector<HTMLElement>("#bertrand-area-long")
  const areaTotalLabel = document.querySelector<HTMLElement>("#bertrand-area-total")
  const areaRate = document.querySelector<HTMLElement>("#bertrand-area-rate")
  const slider = document.querySelector<HTMLInputElement>("#bertrand-chord-slider")
  const sliderLabel = document.querySelector<HTMLElement>("#bertrand-slider-label")
  const positionDescription = document.querySelector<HTMLElement>("#bertrand-position-description")
  const distanceLabel = document.querySelector<HTMLElement>("#bertrand-chord-distance")
  const comparison = document.querySelector<HTMLElement>("#bertrand-chord-comparison")
  const explanation = document.querySelector<HTMLElement>("#bertrand-mode-explanation")
  const chord = document.querySelector<SVGLineElement>("#bertrand-chord")
  const midpoint = document.querySelector<SVGCircleElement>("#bertrand-midpoint")
  const innerCircle = document.querySelector<SVGCircleElement>("#bertrand-inner-circle")
  const distanceArt = document.querySelector<SVGGElement>("#bertrand-distance-art")
  const edgeArt = document.querySelector<SVGGElement>("#bertrand-edge-art")
  const distanceLegend = document.querySelector<SVGGElement>("#bertrand-distance-legend")
  const edgeLegend = document.querySelector<SVGGElement>("#bertrand-edge-legend")
  const edgeChord = document.querySelector<SVGLineElement>("#bertrand-edge-chord")
  const edgePoint = document.querySelector<SVGCircleElement>("#bertrand-edge-point")

  if (
    distanceButton &&
    edgeButton &&
    areaButton &&
    sliderControls &&
    areaControls &&
    pickOne &&
    pickHundred &&
    clearSamples &&
    areaDots &&
    areaArt &&
    areaChord &&
    areaPoint &&
    areaLegend &&
    areaLongLabel &&
    areaTotalLabel &&
    areaRate &&
    slider &&
    sliderLabel &&
    positionDescription &&
    distanceLabel &&
    comparison &&
    explanation &&
    chord &&
    midpoint &&
    innerCircle &&
    distanceArt &&
    edgeArt &&
    distanceLegend &&
    edgeLegend &&
    edgeChord &&
    edgePoint
  ) {
    const centreX = 130
    const centreY = 112
    const radius = 86
    let mode: "distance" | "edge" | "area" = "distance"
    let distanceValue = 35
    let edgeValue = 180
    let totalSamples = 0
    let longSamples = 0

    const sampleMidpoints = (count: number) => {
      // sqrt(U) produces a point uniformly by AREA, not uniformly by radius.
      for (let i = 0; i < count; i++) {
        const distance = radius * Math.sqrt(Math.random())
        const angle = 2 * Math.PI * Math.random()
        const dx = distance * Math.cos(angle)
        const dy = distance * Math.sin(angle)
        const x = centreX + dx
        const y = centreY + dy
        const longChord = distance < radius / 2
        totalSamples++
        if (longChord) longSamples++

        const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle")
        dot.setAttribute("cx", String(x))
        dot.setAttribute("cy", String(y))
        dot.setAttribute("r", "2.5")
        dot.setAttribute("fill", longChord ? "#5d8560" : "#387a91")
        dot.setAttribute("opacity", ".75")
        areaDots.appendChild(dot)
        // Keep the plotted points readable after many batches.
        if (areaDots.childElementCount > 200) areaDots.firstElementChild?.remove()

        const chordHalfLength = Math.sqrt(radius * radius - distance * distance)
        const ux = distance === 0 ? 0 : -dy / distance
        const uy = distance === 0 ? 1 : dx / distance
        areaChord.setAttribute("x1", String(x - ux * chordHalfLength))
        areaChord.setAttribute("y1", String(y - uy * chordHalfLength))
        areaChord.setAttribute("x2", String(x + ux * chordHalfLength))
        areaChord.setAttribute("y2", String(y + uy * chordHalfLength))
        areaPoint.setAttribute("cx", String(x))
        areaPoint.setAttribute("cy", String(y))
        areaPoint.setAttribute("fill", longChord ? "#5d8560" : "#387a91")
      }
      areaChord.setAttribute("visibility", "visible")
      areaPoint.setAttribute("visibility", "visible")
      areaLongLabel.textContent = String(longSamples)
      areaTotalLabel.textContent = String(totalSamples)
      areaRate.textContent = totalSamples
        ? `(${Math.round((100 * longSamples) / totalSamples)}% so far; expected about 25%)`
        : ""
    }

    const update = () => {
      if (mode === "distance") {
        const fraction = Number(slider.value) / 100
        const distance = radius * fraction
        const halfLength = Math.sqrt(Math.max(0, radius * radius - distance * distance))
        const y = centreY + distance

        chord.setAttribute("x1", String(centreX - halfLength))
        chord.setAttribute("x2", String(centreX + halfLength))
        chord.setAttribute("y1", String(y))
        chord.setAttribute("y2", String(y))
        midpoint.setAttribute("cy", String(y))

        const result =
          fraction < 0.5
            ? "Longer than the triangle side."
            : fraction === 0.5
              ? "Exactly as long as the triangle side."
              : "Shorter than the triangle side."
        distanceLabel.textContent = `${slider.value}%`
        comparison.textContent = result
        slider.setAttribute(
          "aria-valuetext",
          `${slider.value} percent of the radius, ${result.toLowerCase()}`,
        )
      } else if (mode === "edge") {
        // The first endpoint is fixed at the triangle's top vertex.
        // The other point traverses the whole circumference in 360 degrees.
        const degrees = Number(slider.value)
        const angle = ((degrees - 90) * Math.PI) / 180
        const x = centreX + radius * Math.cos(angle)
        const y = centreY + radius * Math.sin(angle)
        edgeChord.setAttribute("x2", String(x))
        edgeChord.setAttribute("y2", String(y))
        edgePoint.setAttribute("cx", String(x))
        edgePoint.setAttribute("cy", String(y))

        // The favourable arc spans 120 degrees, one third of a full circle.
        const result =
          degrees === 0 || degrees === 360
            ? "The two points coincide."
            : degrees > 120 && degrees < 240
              ? "Longer than the triangle side."
              : degrees === 120 || degrees === 240
                ? "Exactly as long as the triangle side."
                : "Shorter than the triangle side."
        distanceLabel.textContent = `${degrees}°`
        comparison.textContent = result
        slider.setAttribute(
          "aria-valuetext",
          `${degrees} degrees around the circle, ${result.toLowerCase()}`,
        )
      }
    }

    const setMode = (next: "distance" | "edge" | "area") => {
      mode = next
      const isDistance = mode === "distance"
      const isEdge = mode === "edge"
      const isArea = mode === "area"
      sliderControls.hidden = isArea
      areaControls.hidden = !isArea
      distanceButton.setAttribute("aria-pressed", String(isDistance))
      edgeButton.setAttribute("aria-pressed", String(isEdge))
      areaButton.setAttribute("aria-pressed", String(isArea))
      for (const element of [distanceArt, distanceLegend]) {
        element.setAttribute("visibility", isDistance ? "visible" : "hidden")
      }
      for (const element of [edgeArt, edgeLegend]) {
        element.setAttribute("visibility", isEdge ? "visible" : "hidden")
      }
      for (const element of [areaArt, areaLegend]) {
        element.setAttribute("visibility", isArea ? "visible" : "hidden")
      }
      innerCircle.setAttribute("visibility", isEdge ? "hidden" : "visible")
      innerCircle.setAttribute("fill-opacity", isArea ? ".35" : ".12")

      if (!isArea) {
        slider.min = "0"
        slider.max = isDistance ? "100" : "360"
        slider.value = String(isDistance ? distanceValue : edgeValue)
        sliderLabel.textContent = isDistance
          ? "Move the chord away from the centre"
          : "Move the second endpoint around the edge"
        positionDescription.textContent = isDistance
          ? "of the radius from the centre."
          : "around the circle from the top."
        explanation.textContent = isDistance
          ? "The dotted inner circle shows the halfway mark. Move the chord's midpoint inside it to make a longer chord."
          : "The top endpoint stays fixed. Move the other point onto the thick blue arc at the bottom. That arc is one third of the circle's edge, so one third of equally likely endpoints produce a longer chord."
        update()
      }
    }

    slider.addEventListener("input", () => {
      if (mode === "distance") distanceValue = Number(slider.value)
      else edgeValue = Number(slider.value)
      update()
    })
    distanceButton.addEventListener("click", () => setMode("distance"))
    edgeButton.addEventListener("click", () => setMode("edge"))
    areaButton.addEventListener("click", () => setMode("area"))
    pickOne.addEventListener("click", () => sampleMidpoints(1))
    pickHundred.addEventListener("click", () => sampleMidpoints(100))
    clearSamples.addEventListener("click", () => {
      totalSamples = 0
      longSamples = 0
      areaDots.replaceChildren()
      areaChord.setAttribute("visibility", "hidden")
      areaPoint.setAttribute("visibility", "hidden")
      areaLongLabel.textContent = "0"
      areaTotalLabel.textContent = "0"
      areaRate.textContent = ""
    })
    setMode("distance")
  }
</script>
