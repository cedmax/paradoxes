---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
---

<IllustrationFigure
  name="prisoners-dilemma"
  lead="What's best for each prisoner can be worse for them both."
>
  <div class="flex flex-col gap-3">
    <p class="font-bold">1. Suppose B chooses to...</p>
    <div class="flex flex-wrap gap-2" role="group" aria-label="B's hypothetical choice">
      <button
        id="prisoners-dilemma-b-silent"
        type="button"
        class="btn-toggle"
        aria-pressed="true"
        aria-controls="prisoners-dilemma-results"
      >
        Stay silent
      </button>
      <button
        id="prisoners-dilemma-b-testify"
        type="button"
        class="btn-toggle"
        aria-pressed="false"
        aria-controls="prisoners-dilemma-results"
      >
        Testify
      </button>
    </div>

    <p class="text-base">What should A do in that case?</p>
    <div id="prisoners-dilemma-results" class="grid gap-4 sm:grid-cols-2">
      <Panel title="A stays silent">
        <p id="prisoners-dilemma-a-silent" class="mt-2 text-2xl font-bold">
          1 year
        </p>
      </Panel>
      <Panel accent="blue" title="A testifies">
        <p id="prisoners-dilemma-a-testify" class="mt-2 text-2xl font-bold">
          0 years
        </p>
        <p class="mt-1 text-base font-bold">Better for A</p>
      </Panel>
    </div>
    <p id="prisoners-dilemma-announcement" class="sr-only" aria-live="polite"></p>
    <p class="text-base">
      Testifying gives A one year less, whichever choice B makes. The same reasoning works for
      B.
    </p>
  </div>

  <div class="flex flex-col gap-3">
    <p class="font-bold">2. But what if both follow that reasoning?</p>
    <div class="grid gap-4 sm:grid-cols-2">
      <Panel accent="red" title="Both testify">
        <p class="mt-2 text-xl font-bold">2 years each</p>
      </Panel>
      <Panel accent="green" title="Both stay silent">
        <p class="mt-2 text-xl font-bold">1 year each</p>
      </Panel>
    </div>
    <p class="text-base">
      Both would spend less time in prison by staying silent. So why does the individually
      better choice leave them both worse off?
    </p>
  </div>

  <Fragment slot="caption">
    Both sides agree on the sentences. Some argue that each prisoner should testify because it
    is better against either fixed choice. Others argue that two people who reason alike should
    stay silent. The disagreement is about what rational choice requires.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("prisoners-dilemma")
  if (root) {
    const silentButton = find<HTMLButtonElement>(root, "#prisoners-dilemma-b-silent")
    const testifyButton = find<HTMLButtonElement>(root, "#prisoners-dilemma-b-testify")
    const aSilent = find<HTMLElement>(root, "#prisoners-dilemma-a-silent")
    const aTestify = find<HTMLElement>(root, "#prisoners-dilemma-a-testify")
    const announcement = find<HTMLElement>(root, "#prisoners-dilemma-announcement")

    const choose = (bTestifies: boolean) => {
      silentButton.setAttribute("aria-pressed", String(!bTestifies))
      testifyButton.setAttribute("aria-pressed", String(bTestifies))
      aSilent.textContent = bTestifies ? "3 years" : "1 year"
      aTestify.textContent = bTestifies ? "2 years" : "0 years"
      announcement.textContent = bTestifies
        ? "If B testifies, A gets 3 years by staying silent or 2 years by testifying. Testifying is better for A."
        : "If B stays silent, A gets 1 year by staying silent or 0 years by testifying. Testifying is better for A."
    }

    silentButton.addEventListener("click", () => choose(false))
    testifyButton.addEventListener("click", () => choose(true))
  }
</script>
