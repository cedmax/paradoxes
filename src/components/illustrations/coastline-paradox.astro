---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"

const coast =
  "M12 78 L35 52 L52 68 L70 30 L87 54 L109 45 L132 82 L153 60 L170 88 L188 40 L205 61 L224 48 L242 80 L262 57 L280 71 L308 45"
const coarse = "M12 78 L70 30 L132 82 L188 40 L242 80 L308 45"
const coarseCorners = [
  [12, 78],
  [70, 30],
  [132, 82],
  [188, 40],
  [242, 80],
  [308, 45],
]
const fineCorners = [
  [12, 78],
  [35, 52],
  [52, 68],
  [70, 30],
  [87, 54],
  [109, 45],
  [132, 82],
  [153, 60],
  [170, 88],
  [188, 40],
  [205, 61],
  [224, 48],
  [242, 80],
  [262, 57],
  [280, 71],
  [308, 45],
]
---

<IllustrationFigure
  name="coastline-paradox"
  lead="The same shore, measured in bigger and smaller steps"
>
  <SvgFigure
    name="coastline-paradox"
    class="mx-auto w-full max-w-sm"
    viewBox="0 0 320 239"
    title="Two ways to measure the same jagged shoreline"
    desc="The first drawing joins six points along a jagged coastline using five long straight steps, cutting across many small bends. The second joins sixteen points on the same coastline using fifteen shorter steps that follow every illustrated bend. Its route is longer although the start and finish stay the same. This is a schematic, not a map or a measurement of Britain."
  >
    <g fill="currentColor" font-size="15" font-weight="bold">
      <text x="12" y="16">Bigger steps: cut across bends</text>
      <text x="12" y="134">Smaller steps: follow more bends</text>
    </g>
    <g fill="none" stroke-linejoin="round" stroke-linecap="round">
      <path d={coast} stroke="currentColor" stroke-width="2" opacity=".25" />
      <path d={coarse} stroke="var(--color-series-blue)" stroke-width="3" />
      <g fill="var(--color-series-blue)" stroke="none">
        {coarseCorners.map(([x, y]) => <circle cx={x} cy={y} r="3.5" />)}
      </g>
      <g transform="translate(0 118)">
        <path d={coast} stroke="currentColor" stroke-width="2" opacity=".25" />
        <path d={coast} stroke="var(--color-series-red)" stroke-width="3" />
        <g fill="var(--color-series-red)" stroke="none">
          {fineCorners.map(([x, y]) => <circle cx={x} cy={y} r="2.5" />)}
        </g>
      </g>
    </g>
  </SvgFigure>
  <Fragment slot="caption">
    Both routes start and finish at the same points. Smaller steps include bends that larger
    steps skip, so the measured distance grows.
  </Fragment>
</IllustrationFigure>
