---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SideBySide from "~/components/illustration-kit/SideBySide.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import { series, stroke } from "~/data/palette"

const tested = 10000
const ill = 100
const truePositives = 90
const falsePositives = 891
const positives = truePositives + falsePositives
const genuinePercent = ((truePositives / positives) * 100).toFixed(1)
const barWidth = 320
---

<IllustrationFigure
  name="base-rate-fallacy"
  lead="The test catches 90% of cases. But most positive results are false alarms."
>
  <p class="text-base leading-normal">
    Imagine testing 10,000 people for a condition that only 1 in 100 has. Count positive results
    in both groups.
  </p>

  <SideBySide>
    <Panel title="100 have it" accent="blue" class="flex min-w-0 flex-col gap-2">
      <p class="text-base leading-normal">90% test positive.</p>
      <p class="font-bold">90 real positives</p>
    </Panel>
    <Panel title="9,900 do not" accent="red" class="flex min-w-0 flex-col gap-2">
      <p class="text-base leading-normal">9% test positive.</p>
      <p class="font-bold">891 false alarms</p>
    </Panel>
  </SideBySide>

  <SvgFigure
    name="base-rate-groups"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 360 180"
    title="A rare condition produces far more false alarms than real positive tests"
    desc="Of 10,000 people tested, only 100 have the condition: the small blue slice of the first bar. Of 981 positive tests, 90 are genuine (blue) and 891 are false alarms (red). The second bar is mostly red, meaning only 9.2 percent of people who test positive have the condition."
  >
    <g fill="currentColor" font-size="15">
      <text x="10" y="18" font-weight="700">
        Out of 10,000 people
      </text>
      <rect
        x="10"
        y="29"
        width={barWidth}
        height="24"
        fill="var(--color-paper)"
        stroke={stroke}
        stroke-width="1.5"
      />
      <rect x="10" y="29" width={(barWidth * ill) / tested} height="24" fill={series.blue} />
      <text x="10" y="72" font-size="14">
        100 have it (1%)
      </text>
      <text x="330" y="72" text-anchor="end" font-size="14">
        9,900 do not
      </text>

      <text x="10" y="104" font-weight="700">
        Out of 981 positive tests
      </text>
      <rect x="10" y="115" width={barWidth} height="24" fill={series.red} />
      <rect
        x="10"
        y="115"
        width={(barWidth * truePositives) / positives}
        height="24"
        fill={series.blue}
      />
      <rect
        x="10"
        y="115"
        width={barWidth}
        height="24"
        fill="none"
        stroke={stroke}
        stroke-width="1.5"
      />
      <text x="10" y="158" font-size="14">
        90 real
      </text>
      <text x="330" y="158" text-anchor="end" font-size="14">
        891 false alarms
      </text>
    </g>
  </SvgFigure>

  <Callout class="flex flex-col gap-2">
    <p class="font-bold">Only {genuinePercent}% of positive tests are genuine.</p>
    <p class="text-base leading-normal">
      The small healthy-group error rate still produces 891 false alarms because there are so
      many more healthy people to begin with.
    </p>
  </Callout>

  <Fragment slot="caption">
    Blue represents people who have the condition; red represents false positive results. The
    numbers come from the entry's invented example, not a real screening programme.
  </Fragment>
</IllustrationFigure>
