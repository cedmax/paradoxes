---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"

// Illustrative model: L(t) = 1 + t, and the ant walks at half the rope's growth speed.
// The fraction crossed is f(t) = ln(1 + t) / 2; it reaches the end at t = e² - 1.
const times = [0, 1, 3, Math.exp(2) - 1]
const stages = times.map((time, index) => {
  const length = 1 + time
  return {
    label: ["Start", "Later", "Later still", "Eventually"][index],
    width: (296 * length) / Math.exp(2),
    fraction: Math.min(1, Math.log(length) / 2),
    y: 38 + index * 59,
  }
})
---

<IllustrationFigure
  name="ant-on-a-rubber-rope"
  lead="The rope grows, but the ant's share of it keeps increasing."
>
  <SvgFigure
    name="ant-on-a-rubber-rope"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 320 254"
    title="Four stages of an ant crossing a uniformly stretching rope"
    desc="Four rows show the same rope getting longer, with the ant marked by a circle. At the start the ant has crossed zero percent. As the rope doubles and then quadruples in length, the ant has crossed about 35 and 69 percent. Eventually the rope is about 7.4 times its starting length and the ant reaches the end. The fractions follow a model in which the rope length grows at a constant rate and the ant walks at half that rate relative to the rope."
  >
    {stages.map((stage) => (
      <g>
        <text x="12" y={stage.y - 15} fill="currentColor" font-size="14" font-weight="bold">
          {stage.label}
        </text>
        <text x="308" y={stage.y - 15} text-anchor="end" fill="currentColor" font-size="14">
          {Math.round(stage.fraction * 100)}% crossed
        </text>
        <line
          x1="12"
          y1={stage.y}
          x2={12 + stage.width}
          y2={stage.y}
          stroke="currentColor"
          stroke-opacity=".3"
          stroke-width="8"
          stroke-linecap="round"
        />
        <line
          x1="12"
          y1={stage.y}
          x2={12 + stage.width * stage.fraction}
          y2={stage.y}
          stroke="var(--color-series-blue)"
          stroke-width="8"
          stroke-linecap="round"
        />
        <circle
          cx={12 + stage.width * stage.fraction}
          cy={stage.y}
          r="7"
          fill="var(--color-series-red)"
          stroke="currentColor"
          stroke-width="1"
        />
        <line
          x1={12 + stage.width}
          y1={stage.y - 8}
          x2={12 + stage.width}
          y2={stage.y + 8}
          stroke="currentColor"
          stroke-width="2"
        />
      </g>
    ))}
  </SvgFigure>
  <Fragment slot="caption">
    <strong>The grey rope stretches, carrying the ant along.</strong> Walking adds to the blue
    portion, which marks the fraction crossed. Each gain gets smaller, but the gains keep adding
    up. These snapshots use a simplified, consistent model: the rope's far end moves twice as
    fast as the ant walks relative to the rope. The ant still arrives, although the final stage
    can take an extraordinarily long time in a real example.
  </Fragment>
</IllustrationFigure>
