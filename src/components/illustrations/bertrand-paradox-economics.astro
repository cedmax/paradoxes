---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
---

<IllustrationFigure>
  <SvgFigure
    name="bertrand-fig"
    class="w-full"
    viewBox="0 0 420 200"
    title="Two shops undercutting one another"
    desc="Shop A and Shop B start at 12 pounds with a unit cost of 8 pounds. One cuts to 11, the other to 10, and competition continues until both charge 8 pounds. Prices are illustrative, not an exact model of every price step."
  >
    <g fill="none" stroke="currentColor" stroke-width="2">
      <rect x="10" y="12" width="190" height="136" />
      <rect x="220" y="12" width="190" height="136" />
      <path d="M10 168 H410" stroke-dasharray="7 6" />
    </g>
    <g fill="currentColor" font-size="18" font-family="sans-serif" text-anchor="middle">
      <text x="105" y="44">
        Shop A
      </text>
      <text x="315" y="44">
        Shop B
      </text>
      <text x="105" y="88">
        £12 → £11 → £9
      </text>
      <text x="315" y="88">
        £12 → £10 → £8
      </text>
      <text x="105" y="128" font-weight="bold">
        Final: £8
      </text>
      <text x="315" y="128" font-weight="bold">
        Final: £8
      </text>
      <text x="210" y="192">
        Unit cost: £8
      </text>
    </g>
  </SvgFigure>
  <Fragment slot="caption">
    Illustrative price cuts. In the model, any price above cost can be undercut. At £8, a
    further cut would make a loss.
  </Fragment>
</IllustrationFigure>
