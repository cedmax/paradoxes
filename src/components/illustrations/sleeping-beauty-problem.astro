---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"
---

<IllustrationFigure lead="A fair coin, but not the same number of wakings.">
  <SvgFigure
    name="sleeping-beauty-counts"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 360 216"
    title="Each coin outcome is equally likely, but tails produces two wakings"
    desc="Two equally likely coin outcomes. Heads leads to one Monday waking. Tails leads to a Monday waking and a Tuesday waking after Sleeping Beauty's memory is erased. Over many fair tosses, half the tosses come up heads, but just one third of the wakings occur after heads."
  >
    <g fill="currentColor" font-size="16" font-weight="700">
      <text x="10" y="19">
        Coin toss
      </text>
      <text x="163" y="19">
        Wakings produced
      </text>
    </g>

    <rect
      x="10"
      y="34"
      width="115"
      height="62"
      fill={series.blue}
      fill-opacity=".13"
      stroke={series.blue}
      stroke-width="1.5"
    />
    <rect
      x="10"
      y="115"
      width="115"
      height="75"
      fill={series.red}
      fill-opacity=".13"
      stroke={series.red}
      stroke-width="1.5"
    />
    <g fill="currentColor" text-anchor="middle">
      <text x="67.5" y="57" font-size="18" font-weight="700">
        Heads
      </text>
      <text x="67.5" y="81" font-size="15">
        1 in 2 tosses
      </text>
      <text x="67.5" y="144" font-size="18" font-weight="700">
        Tails
      </text>
      <text x="67.5" y="169" font-size="15">
        1 in 2 tosses
      </text>
    </g>

    <g
      fill="none"
      stroke={stroke}
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M130 65 H155 m-6 -5 6 5 -6 5" />
      <path d="M130 153 H155 m-6 -5 6 5 -6 5" />
    </g>

    <rect x="164" y="34" width="184" height="62" fill={series.blue} fill-opacity=".18" />
    <rect x="164" y="115" width="88" height="75" fill={series.red} fill-opacity=".18" />
    <rect x="260" y="115" width="88" height="75" fill={series.red} fill-opacity=".18" />

    <g fill="currentColor" text-anchor="middle">
      <text x="256" y="59" font-size="18" font-weight="700">
        Monday
      </text>
      <text x="256" y="81" font-size="15">
        1 waking
      </text>
      <text x="208" y="146" font-size="16" font-weight="700">
        Monday
      </text>
      <text x="304" y="146" font-size="16" font-weight="700">
        Tuesday
      </text>
      <text x="208" y="169" font-size="15">
        wakes
      </text>
      <text x="304" y="169" font-size="15">
        wakes
      </text>
    </g>
    <text x="180" y="209" text-anchor="middle" fill="currentColor" font-size="14">
      Tuesday feels just like Monday.
    </text>
  </SvgFigure>

  <p class="text-base leading-normal">
    <strong>Count coin tosses:</strong> half are heads.{" "}
    <strong>Count wakings over many tosses:</strong> one in three follows heads.
  </p>
  <Fragment slot="caption">
    Both counts are correct. Halfers say waking gives Sleeping Beauty no new information about
    the coin, so her belief stays at one half. Thirders say the indistinguishable wakings
    support one third. The diagram shows why the answers differ, but does not decide which
    belief she should hold.
  </Fragment>
</IllustrationFigure>
