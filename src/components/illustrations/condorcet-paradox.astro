---
import ComparisonTable from "~/components/illustration-kit/ComparisonTable.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"

const rankings = [
  [1, "A", "B", "C"],
  [2, "B", "C", "A"],
  [3, "C", "A", "B"],
]

const comparisons = [
  { left: "A", right: "B" },
  { left: "B", right: "C" },
  { left: "C", right: "A" },
]
---

<IllustrationFigure
  name="condorcet-paradox"
  lead="Every voter has a consistent ranking. But what happens when they vote in pairs?"
>
  <div role="group" aria-label="Choose which pair to compare" class="grid grid-cols-3 gap-2">
    {comparisons.map(({ left, right }, i) => (
      <button
        type="button"
        class="btn-toggle min-w-0 px-2 text-sm sm:text-base"
        data-condorcet-step={i}
        aria-pressed={i === 0 ? "true" : "false"}
        aria-controls="condorcet-result"
      >
        {left} vs {right}
      </button>
    ))}
  </div>

  <SvgFigure
    name="condorcet-majorities"
    class="mx-auto w-full max-w-sm"
    viewBox="0 0 300 168"
    title="The majority comparisons can form a cycle"
    desc="A beats B, B beats C, and C beats A, each by two votes to one. Select each comparison to see its majority, then the complete cycle."
  >
    <defs>
      <marker
        id="condorcet-arrowhead"
        markerWidth="7"
        markerHeight="7"
        refX="6"
        refY="3"
        orient="auto"
      >
        <path d="M0 0 L6 3 L0 6" fill="none" stroke="var(--color-stroke)" />
      </marker>
    </defs>
    <g
      fill="none"
      stroke="var(--color-stroke)"
      stroke-width="2.5"
      marker-end="url(#condorcet-arrowhead)"
    >
      <path data-condorcet-edge="0" d="M62 36 H236" />
      <path data-condorcet-edge="1" d="M252 54 L168 122" opacity="0" />
      <path data-condorcet-edge="2" d="M132 122 L48 54" opacity="0" />
    </g>
    <g fill="currentColor" font-size="22" text-anchor="middle" font-weight="bold">
      <text x="40" y="44">A</text>
      <text x="260" y="44">B</text>
      <text x="150" y="152">C</text>
    </g>
    <g fill="currentColor" font-size="16" text-anchor="middle">
      <text data-condorcet-score="0" x="150" y="26">2–1</text>
      <text data-condorcet-score="1" x="236" y="94" opacity="0">2–1</text>
      <text data-condorcet-score="2" x="64" y="94" opacity="0">2–1</text>
    </g>
  </SvgFigure>

  <p id="condorcet-result" class="font-bold" aria-live="polite" aria-atomic="true">
    Voters 1 and 3 prefer A to B. A wins, 2–1.
  </p>

  <ComparisonTable
    caption="How each voter ranks the options"
    columns={["Voter", "First", "Second", "Third"]}
    rows={rankings}
    align="center"
    dense
  />
  <p id="condorcet-highlight-note" class="text-sm">
    Yellow cells show the two options being compared. The underlined option is
    each voter's preference; green rows show who supports the majority winner.
  </p>

  <p id="condorcet-cycle" class="font-bold" hidden>
    The cycle is complete: A beats B, B beats C, and C beats A. There is no single
    majority favourite.
  </p>

  <Fragment slot="caption">
    Different pairs of voters form each 2–1 majority. Each person has a consistent
    ranking, but the group's choices can go round in a circle.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("condorcet-paradox")
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-condorcet-step]")
    const rows = root.querySelectorAll<HTMLTableRowElement>("tbody tr")
    const edges = root.querySelectorAll<SVGPathElement>("[data-condorcet-edge]")
    const scores = root.querySelectorAll<SVGTextElement>("[data-condorcet-score]")
    const result = find<HTMLElement>(root, "#condorcet-result")
    const cycle = find<HTMLElement>(root, "#condorcet-cycle")
    const comparisons = [
      { left: "A", right: "B", supporters: [0, 2], result: "Voters 1 and 3 prefer A to B. A wins, 2–1." },
      { left: "B", right: "C", supporters: [0, 1], result: "Voters 1 and 2 prefer B to C. B wins, 2–1." },
      { left: "C", right: "A", supporters: [1, 2], result: "Voters 2 and 3 prefer C to A. C wins, 2–1." },
    ]

    const show = (selected: number) => {
      const comparison = comparisons[selected]
      for (const [i, button] of buttons.entries()) {
        button.setAttribute("aria-pressed", String(i === selected))
      }
      for (const [i, row] of rows.entries()) {
        row.classList.toggle("bg-explained", comparison.supporters.includes(i))
        const rankCells = Array.from(row.querySelectorAll<HTMLTableCellElement>("td"))
        const preferred = rankCells
          .map((cell) => cell.textContent?.trim())
          .find((candidate) => candidate === comparison.left || candidate === comparison.right)
        for (const cell of rankCells) {
          const candidate = cell.textContent?.trim()
          const inPair = candidate === comparison.left || candidate === comparison.right
          const preferredInPair = inPair && candidate === preferred
          cell.classList.toggle("bg-disputed", inPair)
          cell.classList.toggle("font-bold", preferredInPair)
          cell.classList.toggle("underline", preferredInPair)
          cell.classList.toggle("decoration-2", preferredInPair)
          cell.classList.toggle("underline-offset-4", preferredInPair)
        }
      }
      for (const [i, edge] of edges.entries()) {
        edge.setAttribute("opacity", i > selected ? "0" : i === selected ? "1" : ".55")
        edge.setAttribute("stroke-width", i === selected ? "3.5" : "2.5")
      }
      for (const [i, score] of scores.entries()) {
        score.setAttribute("opacity", i > selected ? "0" : i === selected ? "1" : ".55")
      }
      result.textContent = comparison.result
      cycle.hidden = selected !== 2
    }

    for (const [i, button] of buttons.entries()) {
      button.addEventListener("click", () => show(i))
    }
    show(0)
  }
</script>
