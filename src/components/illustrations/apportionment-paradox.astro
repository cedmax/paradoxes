---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import { series } from "~/data/palette"

const states = ["A", "B", "C"]
const colours = [series.blue, series.gold, series.red]
const examples = [
  {
    seats: 10,
    left: 1,
    fractions: [2 / 7, 2 / 7, 3 / 7],
    winners: [false, false, true],
    result: "A gets 4, B gets 4, C gets 2.",
    explanation: "C has the biggest leftover fraction, so C gets the one remaining seat.",
    desc: "For 10 seats, A and B each have about 0.29 left over, while C has about 0.43. C wins the one extra seat, resulting in A 4, B 4, C 2.",
  },
  {
    seats: 11,
    left: 2,
    fractions: [5 / 7, 5 / 7, 4 / 7],
    winners: [true, true, false],
    result: "A gets 5, B gets 5, C gets 1.",
    explanation:
      "A and B now have the biggest leftover fractions, so they take the two remaining seats.",
    desc: "For 11 seats, A and B each have about 0.71 left over, while C has about 0.57. A and B win the two extra seats, resulting in A 5, B 5, C 1.",
  },
]
---

<IllustrationFigure
  name="apportionment-paradox"
  lead="Adding one seat changes who wins the leftover seats."
>
  <p class="text-base leading-normal">
    States A, B and C have populations in the fixed ratio 6 : 6 : 2. In both examples, first
    give them their whole shares: 4 seats for A, 4 for B and 1 for C. Then award the remaining
    seats to the largest leftover fractions.
  </p>

  <div class="flex flex-col gap-4">
    {examples.map(({ seats, left, fractions, winners, result, explanation, desc }) => (
      <Panel title={`${seats} seats in total`} class="flex flex-col gap-2">
        <p class="text-base leading-normal">
          After the first 9 seats are assigned,{" "}
          <strong>
            {left} {left === 1 ? "seat is" : "seats are"} left.
          </strong>
        </p>
        <SvgFigure
          name={`apportionment-remainders-${seats}`}
          class="w-full max-w-md"
          viewBox="0 0 360 157"
          title={`Leftover fractions when sharing ${seats} seats`}
          desc={desc}
        >
          <text x="10" y="17" font-size="15" font-weight="700" fill="currentColor">
            Leftover fraction for each state
          </text>
          {states.map((state, i) => (
            <g>
              <text x="10" y={45 + i * 36} font-size="16" font-weight="700" fill="currentColor">
                {state}
              </text>
              <rect
                x="37"
                y={29 + i * 36}
                width={fractions[i] * 208}
                height="20"
                fill={colours[i]}
              />
              <text
                x="200"
                y={45 + i * 36}
                font-size="14"
                font-weight="700"
                fill="currentColor"
              >
                {fractions[i].toFixed(2)}
              </text>
              {winners[i] && (
                <text
                  x="269"
                  y={45 + i * 36}
                  font-size="14"
                  font-weight="700"
                  fill="currentColor"
                >
                  +1 seat
                </text>
              )}
            </g>
          ))}
        </SvgFigure>
        <p class="text-base leading-normal">{explanation}</p>
        <p class="font-bold">{result}</p>
      </Panel>
    ))}
  </div>

  <Callout>
    <strong>State C goes from 2 seats to 1</strong>, even though the parliament grows from 10
    seats to 11. Its population has not changed: the ranking of the leftover fractions has.
  </Callout>

  <Fragment slot="caption">
    The bars show the fractions left after assigning whole seats, not the states' population
    sizes. The largest-remainder rule produces this result without any change in population.
  </Fragment>
</IllustrationFigure>
