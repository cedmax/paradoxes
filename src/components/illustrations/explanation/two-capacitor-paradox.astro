---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"

const quarters = [0, 1, 2, 3]
const stages = [
  {
    title: "Before connecting",
    capacitors: [
      { name: "A", charge: "Q", voltage: "V", filled: 4, energy: "100%" },
      { name: "B", charge: "0", voltage: "0", filled: 0, energy: "0%" },
    ],
  },
  {
    title: "After settling",
    capacitors: [
      { name: "A", charge: "Q/2", voltage: "V/2", filled: 1, energy: "25%" },
      { name: "B", charge: "Q/2", voltage: "V/2", filled: 1, energy: "25%" },
    ],
  },
]
---

<IllustrationFigure
  name="two-capacitor-paradox"
  lead="The charge divides equally. The stored energy does not."
>
  {stages.map((stage, index) => (
    <div class="flex flex-col gap-3">
      {index === 1 && (
        <p class="flex items-center justify-center gap-2 text-base font-bold">
          <span aria-hidden="true">↓</span>
          Connect the capacitors and let the charge settle
        </p>
      )}
      <p class="font-bold">{stage.title}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {stage.capacitors.map((capacitor) => (
          <Panel title={`Capacitor ${capacitor.name}`}>
            <p class="mt-2 text-base">
              Charge: <strong>{capacitor.charge}</strong> · Voltage:{" "}
              <strong>{capacitor.voltage}</strong>
            </p>
            <div class="mt-3 grid grid-cols-4 gap-1.5" aria-hidden="true">
              {quarters.map((quarter) => (
                <span
                  class:list={[
                    "h-6",
                    quarter < capacitor.filled ? "bg-series-blue" : "border border-ink",
                  ]}
                ></span>
              ))}
            </div>
            <p class="mt-2 text-base font-bold">{capacitor.energy} of initial energy</p>
          </Panel>
        ))}
      </div>
    </div>
  ))}

  <Fragment slot="caption">
    Each square represents a quarter of the initial stored energy, not charge. The total charge
    stays Q, split equally between A and B. But only half the starting energy remains stored in
    the capacitors.
  </Fragment>

  <Fragment slot="after">
    <Disclosure summary="Where did the other half go?">
      <Panel accent="gold" title="Energy transferred elsewhere">
        <div class="mt-3 grid grid-cols-4 gap-1.5" aria-hidden="true">
          {quarters.map((quarter) => (
            <span
              class:list={["h-6", quarter < 2 ? "bg-series-gold" : "border border-ink"]}
            ></span>
          ))}
        </div>
        <p class="mt-2 text-base">
          <strong>50% of the initial energy</strong> leaves the capacitors' electric fields
          during the current flow, for example as heat or electromagnetic radiation.
        </p>
        <p class="mt-2 text-base">
          A perfectly lossless circuit cannot simply be assumed to settle into this final state
          without accounting for its changing currents and fields.
        </p>
      </Panel>
    </Disclosure>
  </Fragment>
</IllustrationFigure>
