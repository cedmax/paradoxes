---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"

type Room = { n: number; guest: string; free?: boolean }
const rooms = [1, 2, 3, 4, 5]
const before: Room[] = rooms.map((n) => ({ n, guest: `Guest ${n}` }))
const afterMove: Room[] = rooms.map((n) =>
  n === 1 ? { n, guest: "Empty", free: true } : { n, guest: `Guest ${n - 1}` },
)
const afterDoubling: Room[] = rooms.map((n) =>
  n % 2 === 1
    ? { n, guest: `New ${Math.ceil(n / 2)}`, free: true }
    : { n, guest: `Guest ${n / 2}` },
)
const steps = [
  {
    title: "Before: every room is occupied",
    rooms: before,
    note: "…and so on, without a last room.",
  },
  {
    title: "Ask every guest to move up one room",
    rooms: afterMove,
    note: "Room 1 is now free.",
  },
]
const cell =
  "flex min-w-0 flex-col items-center gap-1 border-2 border-ink p-1.5 text-center sm:p-3"
---

<IllustrationFigure name="hilberts-hotel">
  {steps.map(({ title, rooms: row, note }) => (
    <div class="flex flex-col gap-2">
      <p class="font-bold">{title}</p>
      <div class="grid grid-cols-5 gap-1.5 sm:gap-3">
        {row.map(({ n, guest, free }) => (
          <div class={cell}>
            <span class="text-xs font-bold sm:text-base">Room {n}</span>
            <span class:list={["text-xs sm:text-base", free && "font-bold text-accent"]}>
              {guest}
            </span>
          </div>
        ))}
      </div>
      <p class="text-base">{note}</p>
    </div>
  ))}
  <Disclosure summary="What if infinitely many new guests arrive?">
    <p class="mt-3 text-base leading-normal">
      Original guests take the even rooms. All the odd rooms are free.
    </p>
    <div class="mt-3 grid grid-cols-5 gap-1.5 sm:gap-3">
      {afterDoubling.map(({ n, guest, free }) => (
        <div class={cell}>
          <span class="text-xs font-bold sm:text-base">Room {n}</span>
          <span class:list={["text-xs sm:text-base", free && "font-bold text-accent"]}>
            {guest}
          </span>
        </div>
      ))}
    </div>
    <p class="mt-3 text-base leading-normal">
      The picture shows only the first five rooms. The rearrangement goes on forever.
    </p>
  </Disclosure>
  <Fragment slot="caption">
    A full infinite hotel can take one more guest, or infinitely many more. The trick works
    because its numbered rooms have no end.
  </Fragment>
</IllustrationFigure>
