---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series } from "~/data/palette"
---

<IllustrationFigure
  name="tea-leaf-paradox"
  lead="The spinning surface is not the whole story. Water creeps inward along the bottom."
>
  <SvgFigure
    name="tea-leaf-paradox-flow"
    viewBox="0 0 300 226"
    class="mx-auto w-full max-w-sm"
    title="Cross-section of a teacup showing its slower circulation"
    desc="Water moves outwards near the surface, down the cup walls, inwards along the bottom and up in the middle. Tea leaves gather at the centre of the bottom."
  >
    <defs>
      <marker
        id="tea-leaf-paradox-arrow"
        markerWidth="12"
        markerHeight="12"
        refX="10"
        refY="6"
        orient="auto"
      >
        <path d="M0 0 L12 6 L0 12" fill="none" stroke={series.red} stroke-width="2" />
      </marker>
    </defs>
    <g transform="translate(2 34) scale(.62)">
      <path
        d="M55 35 Q50 210 135 237 H345 Q430 210 425 35"
        fill="none"
        stroke="currentColor"
        stroke-width="7"
        stroke-linecap="round"
      />
      <path d="M65 65 H415" stroke={series.blue} stroke-width="3" stroke-dasharray="6 6" />
      <g
        fill="none"
        stroke={series.red}
        stroke-width="5"
        marker-end="url(#tea-leaf-paradox-arrow)"
      >
        <path d="M83 95 Q85 185 195 218" />
        <path d="M397 95 Q395 185 285 218" />
        <path d="M232 203 V105" />
        <path d="M250 103 Q320 66 360 75" />
        <path d="M229 102 Q160 65 116 75" />
      </g>
      <g fill={series.gold} stroke="currentColor" stroke-width="1.5">
        <circle cx="218" cy="229" r="6" />
        <circle cx="231" cy="232" r="6" />
        <circle cx="244" cy="229" r="6" />
        <circle cx="257" cy="232" r="6" />
      </g>
    </g>
    <g fill="currentColor" font-size="16">
      <text x="150" y="22" text-anchor="middle">
        Outwards near the surface
      </text>
      <text x="150" y="218" text-anchor="middle">
        Inwards along the bottom
      </text>
    </g>
  </SvgFigure>

  <Fragment slot="caption">
    Spinning water piles up near the rim, creating pressure that pushes towards the centre.
    Friction slows the spin near the bottom, so this inward push wins there. Water flows towards
    the middle, carrying the leaves with it. Arrows show this slow circulation, not the main
    spin.
  </Fragment>
</IllustrationFigure>
