---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import { series, stroke } from "~/data/palette"

const views = [
  {
    name: "bell-launch-site",
    heading: "1. From the launch site",
    accent: "blue" as const,
    intro: "The ships move to the right together. Their distance apart stays the same.",
    takeaway: "Same gap, even after speeding up.",
    desc: "Two rows show the rockets before and after accelerating. In the later row both rockets have moved right by the same distance, so the gap between them is unchanged. The connecting string is gold at first and red later to show that it becomes strained.",
    later: { rear: 77, front: 277 },
    measurement: "Same gap",
    arrow: true,
  },
  {
    name: "bell-moving-with-ships",
    heading: "2. Moving alongside the ships",
    accent: "red" as const,
    intro: "Now compare their separation in frames momentarily moving at the ships' speed.",
    takeaway: "The gap grows. The string has to stretch to reach.",
    desc: "The first row shows the starting separation between the ships. The second shows a larger separation when measured in a frame momentarily moving with the now faster ships. The string spanning the larger gap is red, showing strain. The sketch exaggerates the increase and is not to scale.",
    later: { rear: 17, front: 277 },
    measurement: "Wider gap",
    arrow: false,
  },
]

const start = { rear: 37, front: 237 }
const rows = [
  { label: "At the start", y: 34 },
  { label: "Later", y: 112 },
]
---

<IllustrationFigure
  name="bells-spaceship-paradox"
  lead="The rockets speed up together. Does their connecting string stay safe?"
>
  <p class="text-base leading-normal">
    Two spaceships are joined by a taut string. They speed up in exactly the same way,
    as measured from their launch site.
  </p>

  {views.map(({ name, heading, accent, intro, takeaway, desc, later, measurement, arrow }) => (
    <Panel title={heading} accent={accent} class="flex flex-col gap-2">
      <p class="text-base leading-normal">{intro}</p>
      <SvgFigure
        name={name}
        class="mx-auto w-full max-w-md"
        viewBox="0 0 360 178"
        title={heading}
        desc={desc}
      >
        {rows.map(({ label, y }, index) => {
          const positions = index === 0 ? start : later
          const cableY = y + 13
          const endRear = positions.rear + 45
          const cableColour = index === 0 ? series.gold : series.red
          return (
            <g>
              <text x="8" y={y - 15} fill="currentColor" font-size="15" font-weight="700">
                {label}
              </text>
              <line
                x1={endRear}
                y1={cableY}
                x2={positions.front}
                y2={cableY}
                stroke={cableColour}
                stroke-width="4.5"
                stroke-linecap="round"
              />
              {[positions.rear, positions.front].map((x) => (
                <g>
                  <rect
                    x={x}
                    y={y}
                    width="34"
                    height="26"
                    rx="3"
                    fill={series.blue}
                    fill-opacity=".22"
                    stroke={stroke}
                    stroke-width="2"
                  />
                  <path
                    d={`M${x + 34} ${y + 3} L${x + 45} ${y + 13} L${x + 34} ${y + 23} Z`}
                    fill={series.blue}
                    fill-opacity=".55"
                    stroke={stroke}
                    stroke-width="2"
                    stroke-linejoin="round"
                  />
                  <circle cx={x + 16} cy={y + 13} r="4" fill={series.blue} />
                </g>
              ))}
              <path
                d={`M${endRear} ${y + 32} V${y + 37} H${positions.front} V${y + 32}`}
                stroke={stroke}
                stroke-width="1.3"
                stroke-opacity=".7"
                fill="none"
              />
              {index === 1 && arrow && (
                <path
                  d={`M330 ${cableY} H349 M342 ${cableY - 6} L349 ${cableY} L342 ${cableY + 6}`}
                  fill="none"
                  stroke={stroke}
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              )}
            </g>
          )
        })}
        <text
          x="180"
          y="174"
          font-size="15"
          text-anchor="middle"
          font-weight="700"
          fill="currentColor"
        >
          {measurement}
        </text>
      </SvgFigure>
      <p class="text-base font-bold">{takeaway}</p>
    </Panel>
  ))}

  <p class="text-base leading-normal">
    The string's natural length has not increased, but the distance it must span
    in the ships' moving view has. It becomes strained and, if the ships keep
    accelerating, eventually breaks.
  </p>

  <Fragment slot="caption">
    The views use different ways of deciding which distant moments happen
    together. The second picture compares successive frames moving at the ships'
    changing speed, not one fixed viewpoint. Positions and stretching are
    schematic, not to scale; a small speed increase need not snap the string.
  </Fragment>
</IllustrationFigure>
