---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Callout from "~/components/illustration-kit/Callout.astro"

/**
 * Schematic of the classic returning-bomber selection effect.
 * Deliberately illustrative: dots are not historical bullet-hole measurements.
 */
const leftWingHoles = [
  [76, 298],
  [105, 294],
  [134, 306],
  [161, 292],
  [189, 308],
  [217, 297],
  [246, 311],
  [273, 305],
  [303, 319],
  [336, 315],
  [368, 326],
  [55, 323],
  [88, 334],
  [117, 321],
  [144, 335],
  [172, 325],
  [200, 347],
  [228, 334],
  [255, 343],
  [283, 348],
  [312, 359],
  [347, 358],
  [375, 372],
  [110, 346],
  [161, 350],
  [220, 368],
  [275, 369],
  [332, 378],
]
const centreHoles = [
  [430, 267],
  [469, 294],
  [426, 319],
  [459, 326],
  [481, 344],
  [414, 357],
  [449, 371],
  [485, 395],
  [422, 414],
  [470, 432],
  [438, 456],
  [480, 480],
  [449, 507],
]
const tailHoles = [
  [308, 594],
  [330, 592],
  [357, 584],
  [380, 576],
  [520, 576],
  [544, 585],
  [570, 591],
  [596, 595],
]
const holes = [
  ...leftWingHoles,
  ...leftWingHoles.map(([x, y]) => [900 - x, y] as [number, number]),
  ...centreHoles,
  ...tailHoles,
]
---

<IllustrationFigure name="survivorship-bias" lead="Where should the armour go?">
  <SvgFigure
    name="survivor-bomber"
    viewBox="0 0 900 660"
    class="mx-auto w-full max-w-3xl"
    xmlns="http://www.w3.org/2000/svg"
    title="Bullet holes recorded on returning bombers"
    desc="Top-down view of a four-engine bomber. Red dots show holes recorded on planes that returned. The holes cluster on the wings, body and tail, with few visible near the engines and cockpit. An optional reveal identifies areas to reinforce."
  >
    <!-- One continuous, recognisable silhouette: wings, fuselage, tail. -->
    <path
      d="M450 30
         C431 31 417 78 410 132
         L401 232 75 271
         Q29 276 29 310
         L33 330 Q34 346 75 348
         L401 412 414 537
         L285 581 Q257 591 273 608
         Q278 617 295 618
         L419 592 430 644
         Q450 662 470 644
         L481 592 605 618
         Q622 617 627 608
         Q643 591 615 581
         L486 537 499 412
         L825 348 Q866 346 867 330
         L871 310 Q871 276 825 271
         L499 232 490 132
         C483 78 469 31 450 30 Z"
      fill="var(--color-paper)"
      stroke="var(--color-stroke)"
      stroke-width="3.5"
      stroke-linejoin="round"
    />

    <!-- Panel seams make the silhouette readable without decorative shading. -->
    <g fill="none" stroke="var(--color-stroke)" stroke-width="1.3" opacity="0.45">
      <path d="M55 303 L397 277 M55 331 L402 382" />
      <path d="M845 303 L503 277 M845 331 L498 382" />
      <path d="M145 282 L141 359 M238 270 L238 368 M330 252 L332 395" />
      <path d="M755 282 L759 359 M662 270 L662 368 M570 252 L568 395" />
      <path d="M408 247 L492 247 M405 387 L495 387 M413 493 L487 493" />
      <path d="M297 605 L419 570 M603 605 L481 570" />
      <path d="M450 223 V609" stroke-dasharray="5 8" />
    </g>

    <!-- Four propeller engines, the vulnerable areas with few observed holes. -->
    {[270, 348, 552, 630].map((x) => (
      <g>
        <rect
          x={x - 24}
          y="177"
          width="48"
          height="112"
          rx="22"
          fill="var(--color-paper)"
          stroke="var(--color-stroke)"
          stroke-width="2.5"
        />
        <path
          d={`M${x - 22} 193 H${x + 22} M${x - 20} 263 H${x + 20}`}
          fill="none"
          stroke="var(--color-stroke)"
          stroke-width="1.3"
          opacity="0.55"
        />
        <path
          d={`M${x - 40} 181 H${x + 40}`}
          fill="none"
          stroke="var(--color-stroke)"
          stroke-width="5"
          stroke-linecap="round"
        />
        <circle cx={x} cy="181" r="5" fill="var(--color-stroke)" />
      </g>
    ))}

    <!-- Cockpit and forward fuselage. -->
    <path
      d="M425 111 Q450 61 475 111 L477 170 Q450 178 423 170 Z"
      fill="var(--color-paper)"
      stroke="var(--color-stroke)"
      stroke-width="2.5"
    />
    <path
      d="M450 76 V172 M428 109 H472 M424 132 H476 M425 152 H475"
      fill="none"
      stroke="var(--color-stroke)"
      stroke-width="1.8"
    />
    <path
      d="M434 39 Q450 22 466 39 M440 56 H460"
      fill="none"
      stroke="var(--color-stroke)"
      stroke-width="2"
    />

    <!-- The only sample is the returning aircraft. -->
    {holes.map(([x, y]) => (
      <circle
        cx={x}
        cy={y}
        r="7"
        fill="var(--color-series-red)"
        stroke="var(--color-stroke)"
        stroke-width="1.2"
      />
    ))}

    <!-- The answer stays hidden until the reader chooses to reveal it. -->
    <g
      data-survivorship-targets
      visibility="hidden"
      aria-hidden="true"
      fill="none"
      stroke="var(--color-series-blue)"
      stroke-width="4"
      stroke-dasharray="9 7"
      stroke-linejoin="round"
    >
      <rect x="408" y="20" width="84" height="210" rx="7" />
      <rect x="239" y="160" width="149" height="136" rx="7" />
      <rect x="512" y="160" width="149" height="136" rx="7" />
      <rect x="410" y="521" width="80" height="110" rx="7" />
    </g>
  </SvgFigure>

  <div class="flex flex-wrap items-center gap-3 text-base">
    <span class="flex items-center gap-2">
      <span class="h-4 w-4 rounded-full bg-series-red" aria-hidden="true"></span>
      Holes on returning planes
    </span>
    <span data-survivorship-key class="hidden items-center gap-2">
      <span class="h-4 w-6 border-2 border-dashed border-series-blue" aria-hidden="true"></span>
      Areas to reinforce
    </span>
  </div>
  <button
    data-survivorship-reveal
    class="btn-toggle self-start"
    type="button"
    aria-pressed="false"
    aria-controls="survivorship-reason"
  >
    Show where to reinforce
  </button>
  <Callout id="survivorship-reason" class="hidden" data-survivorship-reason>
    The blue outlines mark parts with relatively few holes on returning planes, especially the
    engines and cockpit. Hits there could have stopped other planes from returning. The
    important evidence is what's {"\u0020"}<strong>missing</strong>{"\u0020"}from this sample.
  </Callout>

  <Fragment slot="caption">
    These are holes recorded on planes that {"\u0020"}<strong>came back</strong>. Choose where to add
    armour, then reveal the suggested locations. This is a schematic illustration, not
    historical bullet-hole data.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("survivorship-bias")
  if (root) {
    const button = find<HTMLButtonElement>(root, "[data-survivorship-reveal]")
    const targets = find<SVGGElement>(root, "[data-survivorship-targets]")
    const key = find<HTMLElement>(root, "[data-survivorship-key]")
    const reason = find<HTMLElement>(root, "[data-survivorship-reason]")
    button.addEventListener("click", () => {
      const revealed = button.getAttribute("aria-pressed") !== "true"
      button.setAttribute("aria-pressed", String(revealed))
      button.textContent = revealed ? "Hide reinforcement areas" : "Show where to reinforce"
      targets.setAttribute("visibility", revealed ? "visible" : "hidden")
      targets.setAttribute("aria-hidden", String(!revealed))
      key.classList.toggle("hidden", !revealed)
      key.classList.toggle("flex", revealed)
      reason.classList.toggle("hidden", !revealed)
    })
  }
</script>
