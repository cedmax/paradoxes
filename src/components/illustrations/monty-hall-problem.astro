---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import SideBySide from "~/components/illustration-kit/SideBySide.astro"

const doors = [1, 2, 3]
---

<IllustrationFigure
  name="monty-hall-problem"
  lead="You are the presenter. Which door can you open?"
>
  <p class="text-base leading-normal">
    The player has already picked <strong>door 1</strong>. You know where the car is; the player
    does not. You must reveal a goat, but you cannot open the player's door or the door with the
    car.
  </p>

  <p id="monty-round" class="font-bold" aria-live="polite">
    Case 1 of 3 — the car is behind door 1.
  </p>
  <p class="text-base leading-normal">
    <strong>Presenter's view:</strong> the prizes are shown to you. Tap an allowed goat door to
    reveal it to the player.
  </p>

  <div
    class="grid grid-cols-3 gap-2"
    role="group"
    aria-label="Choose which goat door to open as presenter"
  >
    {doors.map((door) => (
      <button
        type="button"
        class:list={[
          "btn-ghost flex min-w-0 flex-col items-center gap-2 px-2 py-3 text-center",
          door === 1 && "opacity-50",
        ]}
        data-monty-open={door}
        disabled={door === 1}
        aria-label={
          door === 1
            ? "Door 1: car, player's original pick; cannot open"
            : `Door ${door}: goat, allowed to open`
        }
      >
        <strong class="text-base">Door {door}</strong>
        <span data-monty-prize={door} class="text-lg font-bold">
          {door === 1 ? "Car" : "Goat"}
        </span>
        <span data-monty-role={door} class="text-xs leading-normal">
          {door === 1 ? "Player's pick" : "Open goat"}
        </span>
      </button>
    ))}
  </div>

  <Callout class="flex flex-col gap-2">
    <p id="monty-hint" class="text-base leading-normal" aria-live="polite">
      Here you can open either door 2 or door 3: both hide goats.
    </p>
    <p class="text-base leading-normal">
      The host knows the prizes. Opening the car or the player's door is never allowed.
    </p>
  </Callout>

  <div id="monty-result" class="hidden flex-col gap-3">
    <p id="monty-reveal" class="font-bold" aria-live="polite">
      The host reveals a goat.
    </p>
    <SideBySide>
      <Panel title="Player stays" accent="blue" class="flex min-w-0 flex-col gap-1">
        <p id="monty-stay-result" class="text-base leading-normal">
          —
        </p>
      </Panel>
      <Panel title="Player switches" accent="green" class="flex min-w-0 flex-col gap-1">
        <p id="monty-switch-result" class="text-base leading-normal">
          —
        </p>
      </Panel>
    </SideBySide>
    <p id="monty-reason" class="text-base leading-normal">
      —
    </p>
  </div>

  <div class="flex flex-wrap gap-2">
    <button id="monty-again" type="button" class="btn-ghost hidden">
      Try this car location again
    </button>
    <button id="monty-next" type="button" class="btn-ghost hidden">
      Next car location
    </button>
  </div>

  <div class="flex flex-col gap-2">
    <p class="font-bold">What happens across all three car locations?</p>
    <div
      class="grid grid-cols-3 gap-2 text-center text-xs"
      aria-label="Results as you try each case"
    >
      {doors.map((door) => (
        <div class="flex flex-col gap-1">
          <span class="font-bold">Car: door {door}</span>
          <span data-monty-case={door} class="border border-ink p-2">
            Try it
          </span>
        </div>
      ))}
    </div>
    <p id="monty-summary" class="text-base leading-normal" aria-live="polite">
      Try each car location once. We will compare staying and switching after every reveal.
    </p>
  </div>

  <Fragment slot="caption">
    The player always starts at door 1. The three car locations are equally likely; we visit
    them in order to show every possibility, not as a random game. The presenter always reveals
    a goat and always offers a switch.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("monty-hall-problem")
  if (root) {
    const doors = [1, 2, 3]
    const firstPick = 1
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-monty-open]"))
    const prizes = Array.from(root.querySelectorAll<HTMLElement>("[data-monty-prize]"))
    const roles = Array.from(root.querySelectorAll<HTMLElement>("[data-monty-role]"))
    const caseResults = Array.from(root.querySelectorAll<HTMLElement>("[data-monty-case]"))
    const roundLabel = find<HTMLElement>(root, "#monty-round")
    const hint = find<HTMLElement>(root, "#monty-hint")
    const result = find<HTMLElement>(root, "#monty-result")
    const reveal = find<HTMLElement>(root, "#monty-reveal")
    const stayResult = find<HTMLElement>(root, "#monty-stay-result")
    const switchResult = find<HTMLElement>(root, "#monty-switch-result")
    const reason = find<HTMLElement>(root, "#monty-reason")
    const again = find<HTMLButtonElement>(root, "#monty-again")
    const next = find<HTMLButtonElement>(root, "#monty-next")
    const summary = find<HTMLElement>(root, "#monty-summary")

    let round = 0
    let openedDoor: number | null = null
    const completed = [false, false, false]

    const render = () => {
      const car = doors[round]
      const legalDoors = doors.filter((door) => door !== firstPick && door !== car)
      const revealed = openedDoor !== null

      roundLabel.textContent = `Case ${round + 1} of 3 — the car is behind door ${car}.`
      buttons.forEach((button, i) => {
        const door = doors[i]
        const chosen = door === firstPick
        const carDoor = door === car
        const legal = legalDoors.includes(door)
        const isOpened = revealed && door === openedDoor
        button.disabled = revealed || !legal
        button.classList.toggle("opacity-50", !legal || revealed)
        button.classList.toggle("bg-series-gold/20", isOpened)
        prizes[i].textContent = carDoor ? "Car" : "Goat"
        roles[i].textContent = isOpened
          ? "You opened"
          : chosen
            ? "Player's pick"
            : carDoor
              ? "Cannot open"
              : "Open goat"
        button.setAttribute(
          "aria-label",
          `Door ${door}: ${carDoor ? "car" : "goat"}, ${isOpened ? "opened by you" : chosen ? "player's pick; cannot open" : carDoor ? "cannot open the car" : revealed ? "not opened" : "allowed to open"}`,
        )
      })

      hint.textContent = revealed
        ? car === firstPick
          ? "You had two goat doors to choose from. Neither reveal could move the car from the player's original door."
          : `You were forced to open door ${openedDoor}. You could not open the player's pick or the car.`
        : legalDoors.length === 2
          ? "You can open either door 2 or door 3: both hide goats."
          : `Only door ${legalDoors[0]} can be opened. The other doors are the player's pick and the car.`

      result.classList.toggle("hidden", !revealed)
      result.classList.toggle("flex", revealed)
      again.classList.toggle("hidden", !revealed)
      next.classList.toggle("hidden", !revealed)
      next.textContent = round === 2 ? "Return to the first car location" : "Next car location"

      if (revealed) {
        const alternative = doors.find((door) => door !== firstPick && door !== openedDoor)!
        const stayWins = firstPick === car
        reveal.textContent = `You opened door ${openedDoor}, revealing a goat. Door ${alternative} stays closed.`
        stayResult.textContent = `Door 1: ${stayWins ? "car — wins" : "goat — loses"}`
        switchResult.textContent = `Door ${alternative}: ${stayWins ? "goat — loses" : "car — wins"}`
        reason.textContent = stayWins
          ? "The player's first pick was right. You had two goat doors to choose from; switching would lose."
          : "The player's first pick was wrong. You had just one goat door you could open, leaving the car behind the only other closed door."
        completed[round] = true
      }

      caseResults.forEach((cell, i) => {
        cell.textContent = completed[i] ? (i === 0 ? "Stay wins" : "Switch wins") : "Try it"
        cell.classList.toggle("bg-series-blue/20", completed[i] && i === 0)
        cell.classList.toggle("bg-series-green/20", completed[i] && i !== 0)
      })
      const finished = completed.filter(Boolean).length
      summary.textContent =
        finished === 3
          ? "Across the three equally likely car locations, staying wins only once; switching wins twice. The host's informed reveal is what makes the remaining doors unequal."
          : `${finished} of 3 car locations tried. Switching wins whenever the player's original pick was wrong.`
    }

    buttons.forEach((button, i) =>
      button.addEventListener("click", () => {
        const car = doors[round]
        const door = doors[i]
        if (openedDoor !== null || door === firstPick || door === car) return
        openedDoor = door
        render()
      }),
    )

    again.addEventListener("click", () => {
      openedDoor = null
      render()
    })

    next.addEventListener("click", () => {
      round = (round + 1) % doors.length
      openedDoor = null
      render()
    })

    render()
  }
</script>
