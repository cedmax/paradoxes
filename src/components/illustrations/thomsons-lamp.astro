---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"

const switches = Array.from({ length: 12 }, (_, index) => ({
  number: index + 1,
  x: 24 + 292 * (1 - Math.pow(2, -index)),
}))
---

<IllustrationFigure
  name="thomsons-lamp"
  lead="Each switch halves the wait to the next switch."
>
  <p class="text-base leading-normal">
    The lamp starts off. Switch it on at 0 minutes, then off at 1 minute, then on at
    1½ minutes. Keep halving the wait. Every switch happens before 2 minutes.
  </p>

  <Slider
    id="thomsons-lamp-switches"
    label="Show the first switches"
    min={1}
    max={12}
    step={1}
    value={1}
    valuetext="1 switch, lamp on, 2 minutes remaining"
    describedby="thomsons-lamp-readout"
    startLabel="1 switch"
    endLabel="12 switches"
  >
    <p id="thomsons-lamp-readout" class="text-base" aria-live="off">
      Switch 1 at 0 minutes. Lamp on.
    </p>
  </Slider>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    <Panel title="Switches">
      <p id="thomsons-lamp-count" class="text-lg font-bold">1</p>
    </Panel>
    <Panel title="Lamp after last switch">
      <p id="thomsons-lamp-state" class="text-lg font-bold">On</p>
    </Panel>
    <Panel title="Time still to go" class="col-span-2 sm:col-span-1">
      <p id="thomsons-lamp-remaining" class="text-lg font-bold">2 minutes</p>
    </Panel>
  </div>

  <SvgFigure
    name="thomsons-lamp-timeline"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 340 124"
    title="Switching times crowd towards two minutes"
    desc="A linear timeline from zero to two minutes. Each switch is halfway between the previous switch and the two-minute boundary, so later switches crowd together. The slider reveals up to twelve switches. The boundary at exactly two minutes is not another switch."
  >
    <line x1="24" y1="59" x2="316" y2="59" stroke={stroke} stroke-width="2" />
    <line
      id="thomsons-lamp-progress"
      x1="24"
      y1="59"
      x2="24"
      y2="59"
      stroke={series.blue}
      stroke-width="5"
    />
    <line
      x1="316"
      y1="27"
      x2="316"
      y2="81"
      stroke={series.red}
      stroke-width="2"
      stroke-dasharray="5 4"
    />
    {switches.map(({ number, x }) => (
      <circle
        data-switch={number}
        cx={x}
        cy="59"
        r="3"
        fill={series.blue}
        hidden={number > 1}
      />
    ))}
    <circle
      id="thomsons-lamp-current"
      cx="24"
      cy="59"
      r="7"
      fill="none"
      stroke={series.red}
      stroke-width="3"
    />
    <g fill="currentColor" font-size="15">
      <text x="24" y="101" text-anchor="middle">
        0
      </text>
      <text x="170" y="101" text-anchor="middle">
        1 min
      </text>
      <text x="316" y="101" text-anchor="end">
        2 min
      </text>
      <text x="316" y="17" text-anchor="end" font-size="13">
        No switch here
      </text>
    </g>
  </SvgFigure>

  <Panel title="What happens at exactly 2 minutes?">
    <p class="text-base">
      The switching instructions never give the lamp a state at this exact moment.
      Try either ending.
    </p>
    <div class="mt-3 flex flex-wrap gap-3" role="group" aria-label="Choose the lamp's state at two minutes">
      <button
        id="thomsons-lamp-end-on"
        type="button"
        class="btn-toggle"
        aria-pressed="false"
      >
        On at 2 minutes
      </button>
      <button
        id="thomsons-lamp-end-off"
        type="button"
        class="btn-toggle"
        aria-pressed="false"
      >
        Off at 2 minutes
      </button>
    </div>
    <p id="thomsons-lamp-ending" class="mt-3 text-base" aria-live="polite">
      Choose an ending to test it.
    </p>
  </Panel>

  <Fragment slot="caption">
    There is no last switch before two minutes. The dots bunch together because each
    wait is half the one before, but the red boundary is not itself a switching event.
    Either ending fits the earlier switches. The instructions never say which ending occurs.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("thomsons-lamp")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#thomsons-lamp-switches")
    const readout = find<HTMLElement>(root, "#thomsons-lamp-readout")
    const count = find<HTMLElement>(root, "#thomsons-lamp-count")
    const lampState = find<HTMLElement>(root, "#thomsons-lamp-state")
    const remaining = find<HTMLElement>(root, "#thomsons-lamp-remaining")
    const progress = find<SVGLineElement>(root, "#thomsons-lamp-progress")
    const current = find<SVGCircleElement>(root, "#thomsons-lamp-current")
    const marks = Array.from(root.querySelectorAll<SVGCircleElement>("[data-switch]"))
    const onButton = find<HTMLButtonElement>(root, "#thomsons-lamp-end-on")
    const offButton = find<HTMLButtonElement>(root, "#thomsons-lamp-end-off")
    const ending = find<HTMLElement>(root, "#thomsons-lamp-ending")

    const timeRemaining = (number: number) => {
      if (number === 1) return "2 minutes"
      if (number === 2) return "1 minute"
      if (number === 3) return "½ minute"
      if (number === 4) return "¼ minute"
      if (number === 5) return "⅛ minute"
      return "1/" + Math.pow(2, number - 2) + " minute"
    }

    const switchTime = (number: number) => {
      if (number === 1) return "0 minutes"
      if (number === 2) return "1 minute"
      if (number === 3) return "1½ minutes"
      if (number === 4) return "1¾ minutes"
      if (number === 5) return "1⅞ minutes"
      return "2 minutes minus " + timeRemaining(number)
    }

    bindSlider(slider, (number) => {
      const state = number % 2 === 1 ? "On" : "Off"
      const remainingTime = timeRemaining(number)
      const x = 24 + 292 * (1 - Math.pow(2, 1 - number))

      count.textContent = String(number)
      lampState.textContent = state
      remaining.textContent = remainingTime
      readout.textContent =
        "Switch " + number + " at " + switchTime(number) + ". Lamp " + state.toLowerCase() + "."
      progress.setAttribute("x2", String(x))
      current.setAttribute("cx", String(x))
      for (const mark of marks) {
        mark.toggleAttribute("hidden", Number(mark.dataset.switch) > number)
      }

      return (
        number +
        (number === 1 ? " switch, lamp " : " switches, lamp ") +
        state.toLowerCase() +
        ", " +
        remainingTime +
        " until two minutes"
      )
    })

    const chooseEnding = (state: "on" | "off") => {
      onButton.setAttribute("aria-pressed", String(state === "on"))
      offButton.setAttribute("aria-pressed", String(state === "off"))
      ending.textContent =
        "The lamp can be " +
        state +
        " at exactly two minutes without changing any earlier switch. " +
        "The instructions do not choose this ending."
    }

    onButton.addEventListener("click", () => chooseEnding("on"))
    offButton.addEventListener("click", () => chooseEnding("off"))
  }
</script>
