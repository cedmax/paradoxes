---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import Callout from "~/components/illustration-kit/Callout.astro"
import { series, stroke } from "~/data/palette"
---

<IllustrationFigure name="lighthouse-paradox" lead="Turn the lighthouse beam. Watch where it lands.">
  <p class="text-base leading-normal">
    The light travels outwards from the lighthouse. The bright spot appears to move along the wall,
    but nothing travels sideways between the two spots.
  </p>
  <div class="flex flex-wrap gap-2" role="group" aria-label="How far away is the wall?">
    <button type="button" class="btn-toggle" data-lighthouse-distance="near" aria-pressed="true">
      Near wall
    </button>
    <button type="button" class="btn-toggle" data-lighthouse-distance="far" aria-pressed="false">
      Far wall
    </button>
  </div>
  <SvgFigure
    name="lighthouse-sweep"
    class="mx-auto w-full max-w-xl"
    viewBox="0 0 520 355"
    title="A lighthouse beam turns towards a wall"
    desc="A lighthouse on the left sends an outward-pointing beam to a vertical wall. Move the slider to change the beam angle. Switching between near and far walls shows that the same angular turn sweeps across more of a distant wall. Each spot is lit by a different outward ray, not by a sideways-moving object."
  >
    <text x="60" y="43" font-size="17" font-weight="700" fill="currentColor" text-anchor="middle">
      Lighthouse
    </text>
    <text id="lighthouse-wall-label" x="255" y="43" font-size="17" font-weight="700" fill="currentColor" text-anchor="middle">
      Near wall
    </text>
    <path d="M 35 215 H 85 L 79 231 H 41 Z" fill={series.gold} stroke={stroke} stroke-width="2" />
    <rect x="48" y="180" width="24" height="35" fill={series.gold} stroke={stroke} stroke-width="2" />
    <circle cx="60" cy="190" r="7" fill={series.gold} stroke={stroke} stroke-width="2" />

    <g fill="none" stroke={stroke} stroke-width="1.5" stroke-dasharray="5 6" opacity=".35">
      <line id="lighthouse-upper-guide" x1="60" y1="190" x2="255" y2="149" />
      <line id="lighthouse-lower-guide" x1="60" y1="190" x2="255" y2="231" />
    </g>
    <line id="lighthouse-wall" x1="255" y1="65" x2="255" y2="315" stroke={stroke} stroke-width="6" />
    <line id="lighthouse-sweep-range" x1="255" y1="149" x2="255" y2="231"
      stroke={series.blue} stroke-width="13" opacity=".45" />
    <line id="lighthouse-beam" x1="60" y1="190" x2="255" y2="190" stroke={series.red} stroke-width="4" />
    <circle id="lighthouse-spot" cx="255" cy="190" r="9" fill={series.red}
      stroke="var(--color-paper)" stroke-width="2" />
    <text id="lighthouse-range-label" x="260" y="335" text-anchor="middle" fill="currentColor" font-size="15">
      Sweep across the near wall
    </text>
  </SvgFigure>

  <Slider
    id="lighthouse-angle"
    label="Turn the beam"
    min={-12}
    max={12}
    step={1}
    value={0}
    startLabel="Up"
    endLabel="Down"
    describedby="lighthouse-readout"
    valuetext="Pointing straight ahead"
  >
    <p class="text-base" id="lighthouse-readout" aria-live="off">
      <span id="lighthouse-angle-readout">Pointing straight ahead</span>
    </p>
  </Slider>
  <Callout>
    <p id="lighthouse-explanation">
      Try the same turn with the far wall. The illuminated spot crosses a greater distance,
      although each ray still travels straight out from the lighthouse.
    </p>
  </Callout>
  <Fragment slot="caption">
    The blue band shows the range of places the beam can hit. On a sufficiently distant wall,
    the spot can sweep faster than light. It is a pattern of separate arriving rays, not
    light or a message travelling sideways along the wall. This diagram is schematic.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("lighthouse-paradox")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#lighthouse-angle")
    const beam = find<SVGLineElement>(root, "#lighthouse-beam")
    const spot = find<SVGCircleElement>(root, "#lighthouse-spot")
    const wall = find<SVGLineElement>(root, "#lighthouse-wall")
    const sweepRange = find<SVGLineElement>(root, "#lighthouse-sweep-range")
    const upper = find<SVGLineElement>(root, "#lighthouse-upper-guide")
    const lower = find<SVGLineElement>(root, "#lighthouse-lower-guide")
    const wallLabel = find<SVGTextElement>(root, "#lighthouse-wall-label")
    const rangeLabel = find<SVGTextElement>(root, "#lighthouse-range-label")
    const angleReadout = find<HTMLElement>(root, "#lighthouse-angle-readout")
    const explanation = find<HTMLElement>(root, "#lighthouse-explanation")
    const distanceButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-lighthouse-distance]"))

    const lightX = 60
    const lightY = 190
    const wallPositions = { near: 255, far: 455 }
    let distance: keyof typeof wallPositions = "near"
    const angleToY = (angle: number, wallX: number) =>
      lightY + Math.tan((angle * Math.PI) / 180) * (wallX - lightX)
    const setLine = (line: SVGLineElement, x: number, y: number) => {
      line.setAttribute("x2", String(x))
      line.setAttribute("y2", String(y))
    }

    const update = bindSlider(slider, (angle) => {
      const wallX = wallPositions[distance]
      const spotY = angleToY(angle, wallX)
      wall.setAttribute("x1", String(wallX))
      wall.setAttribute("x2", String(wallX))
      sweepRange.setAttribute("x1", String(wallX))
      sweepRange.setAttribute("x2", String(wallX))
      sweepRange.setAttribute("y1", String(angleToY(-12, wallX)))
      sweepRange.setAttribute("y2", String(angleToY(12, wallX)))
      setLine(upper, wallX, angleToY(-12, wallX))
      setLine(lower, wallX, angleToY(12, wallX))
      setLine(beam, wallX, spotY)
      spot.setAttribute("cx", String(wallX))
      spot.setAttribute("cy", String(spotY))
      wallLabel.setAttribute("x", String(wallX))
      wallLabel.textContent = distance === "near" ? "Near wall" : "Far wall"
      rangeLabel.setAttribute("x", String(wallX))
      rangeLabel.textContent = distance === "near"
        ? "Shorter sweep across the near wall"
        : "Longer sweep across the far wall"
      angleReadout.textContent = angle === 0
        ? "Pointing straight ahead"
        : `${Math.abs(angle)}° ${angle < 0 ? "up" : "down"}`
      explanation.textContent = distance === "near"
        ? "Try the same turn with the far wall. The illuminated spot crosses a greater distance, although each ray still travels straight out from the lighthouse."
        : "The same angle now moves the spot farther along the wall. At a great enough distance its apparent sideways speed can exceed light speed, without anything travelling sideways."
      return angleReadout.textContent
    })
    for (const button of distanceButtons) {
      button.addEventListener("click", () => {
        if (button.dataset.lighthouseDistance !== "near" && button.dataset.lighthouseDistance !== "far") return
        distance = button.dataset.lighthouseDistance
        for (const other of distanceButtons) other.setAttribute("aria-pressed", String(other === button))
        update()
      })
    }
  }
</script>
