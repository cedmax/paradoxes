---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import { series, stroke } from "~/data/palette"

const turns = [
  { player: "Alice", take: "Alice 4 · Bob 1", y: 41 },
  { player: "Bob", take: "Alice 2 · Bob 8", y: 101 },
  { player: "Alice", take: "Alice 16 · Bob 4", y: 161 },
  { player: "Bob", take: "Alice 8 · Bob 32", y: 221 },
]
---

<IllustrationFigure
  name="centipede-game"
  lead="Passing grows the coins. Why does reasoning backward say to take immediately?"
>
  <SvgFigure
    name="centipede-backward-tree"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 360 292"
    title="Four-turn centipede game: passing moves down the tree, but the decision argument runs backward"
    desc="Alice can take 4 coins and leave Bob 1, or pass. If she passes, Bob can take 8 and leave Alice 2, or pass. Next Alice can take 16 and leave Bob 4, or pass. Finally Bob can take 32 and leave Alice 8, or pass and get 16 while Alice gets 64. At the last move Bob prefers 32 to 16. Working backward, Alice would prefer 16 to 8, Bob would prefer 8 to 4, and Alice would prefer 4 to 2. Under the game's strong shared-rationality assumptions, Alice takes immediately."
  >
    <path
      d="M33 242 V32 M27 40 L33 32 L39 40"
      fill="none"
      stroke={series.red}
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <text
      x="19"
      y="138"
      fill="currentColor"
      font-size="12"
      text-anchor="middle"
      transform="rotate(-90 19 138)"
    >
      Reason backward
    </text>
    {turns.map(({ player, take, y }, i) => (
      <g>
        <circle
          cx="91"
          cy={y}
          r="21"
          fill={i % 2 === 0 ? series.blue : series.gold}
          fill-opacity=".25"
          stroke={stroke}
          stroke-width="1.5"
        />
        <text
          x="91"
          y={y + 4}
          fill="currentColor"
          font-size="12"
          font-weight="700"
          text-anchor="middle"
        >
          {i + 1}
        </text>
        <text x="119" y={y - 7} fill="currentColor" font-size="13" font-weight="700">
          {player}
        </text>
        <text x="119" y={y + 10} fill="currentColor" font-size="13">
          Take →
        </text>
        <text x="185" y={y + 10} fill="currentColor" font-size="13">
          {take}
        </text>
        {i < 3 && (
          <g>
            <path
              d={`M91 ${y + 22} V${y + 39} m-4 -5 4 5 4 -5`}
              fill="none"
              stroke={stroke}
              stroke-width="1.5"
            />
            <text x="104" y={y + 36} fill="currentColor" font-size="12">
              Pass
            </text>
          </g>
        )}
      </g>
    ))}
    <path d="M91 243 V257" fill="none" stroke={stroke} stroke-width="1.5" />
    <text x="105" y="255" fill="currentColor" font-size="12">
      Pass →
    </text>
    <text x="105" y="273" fill="currentColor" font-size="13">
      Alice 64 · Bob 16
    </text>
  </SvgFigure>

  <Panel title="Start at the last move" class="flex flex-col gap-2">
    <p class="text-base leading-normal">
      Bob takes 32 rather than pass and get 16. So Alice takes 16 rather than pass and get 8.
      Working backward, Bob takes 8 rather than get 4, and Alice takes 4 rather than get 2.
    </p>
  </Panel>

  <Fragment slot="caption">
    A four-turn example with two coin piles that double after each pass. The backward calculation
    is agreed; whether its strong assumptions about what each player knows are justified remains
    disputed.
  </Fragment>
</IllustrationFigure>
