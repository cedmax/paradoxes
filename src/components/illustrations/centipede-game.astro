---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"
import { series, stroke } from "~/data/palette"
---

<IllustrationFigure
  name="centipede-game"
  lead="Passing grows the money. Reasoning backward says to take it now."
>
  <SvgFigure
    name="centipede-two-paths"
    class="mx-auto w-full max-w-md"
    viewBox="0 0 360 211"
    title="Two contrasting paths through the centipede game"
    desc="The upper path, labelled What looks tempting, shows three passes leading to much bigger piles of coins for both players. The lower path, labelled What backward reasoning predicts, shows Alice taking immediately at the first turn. The diagram contrasts the attraction of cooperation with the outcome predicted by backward reasoning, not two equally rational outcomes under the same assumptions."
  >
    <text x="8" y="20" fill="currentColor" font-size="16" font-weight="700">
      What looks tempting
    </text>
    <g stroke={stroke} stroke-width="1.5" fill="none" stroke-linecap="round">
      <path d="M33 73 H325" />
      <path d="M317 67 L325 73 L317 79" />
    </g>
    {[45, 122, 199].map((x) => (
      <g>
        <circle cx={x} cy="73" r="22" fill={series.blue} fill-opacity=".2" stroke={stroke} />
        <text x={x} y="77" text-anchor="middle" font-size="13" fill="currentColor">
          Pass
        </text>
      </g>
    ))}
    <circle cx="304" cy="73" r="30" fill={series.green} fill-opacity=".25" stroke={stroke} />
    <text
      x="304"
      y="68"
      text-anchor="middle"
      font-size="13"
      font-weight="700"
      fill="currentColor"
    >
      Bigger
    </text>
    <text x="304" y="83" text-anchor="middle" font-size="13" fill="currentColor">
      piles
    </text>

    <path d="M8 113 H352" stroke={stroke} stroke-opacity=".35" stroke-width="1" />

    <text x="8" y="139" fill="currentColor" font-size="16" font-weight="700">
      What backward reasoning predicts
    </text>
    <circle cx="45" cy="179" r="22" fill={series.gold} fill-opacity=".3" stroke={stroke} />
    <text
      x="45"
      y="183"
      text-anchor="middle"
      font-size="13"
      font-weight="700"
      fill="currentColor"
    >
      Take
    </text>
    <path d="M72 179 H193" stroke={series.red} stroke-width="2.5" />
    <path
      d="M185 173 L193 179 L185 185"
      fill="none"
      stroke={series.red}
      stroke-width="2.5"
    />
    <text x="204" y="183" fill="currentColor" font-size="15" font-weight="700">
      Game ends
    </text>
  </SvgFigure>
  <Panel title="Why take immediately?">
    <p class="text-base leading-normal">
      At the last turn, taking pays better than passing. That makes taking better on the turn
      before it, too. Repeat the argument backward to the first move.
    </p>
  </Panel>
  <Fragment slot="caption">
    Passing could make both players richer. The immediate-taking prediction depends on strong
    assumptions about what each player knows.
  </Fragment>
</IllustrationFigure>
