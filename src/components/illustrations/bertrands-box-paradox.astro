---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"

const boxes = [
  {
    name: "Box 1",
    coins: ["G", "G"],
    revealLabel: "2 leave gold",
    description: "Both possible coin draws are gold.",
  },
  {
    name: "Box 2",
    coins: ["G", "S"],
    revealLabel: "1 leaves silver",
    description: "One coin draw is gold; one is silver.",
  },
  {
    name: "Box 3",
    coins: ["S", "S"],
    revealLabel: "0 gold draws",
    description: "Both possible coin draws are silver.",
  },
]
---

<IllustrationFigure name="bertrands-box" lead="You drew gold. Which box did it come from?">
  <p class="text-base leading-normal">
    Pick a box, then a coin. Every path is equally likely. G means gold; S means silver.
  </p>

  <div
    class="mx-auto grid w-full max-w-xl grid-cols-1 justify-items-center gap-1 sm:grid-cols-3 sm:gap-3"
  >
    {boxes.map((box, index) => (
      <SvgFigure
        name={`bertrands-box-${index + 1}`}
        title={`${box.name}, with two possible coin draws`}
        desc={`${box.name}. ${box.description}`}
        viewBox="0 0 180 173"
        class="w-full max-w-40 sm:max-w-48"
      >
        <rect
          x="18"
          y="8"
          width="144"
          height="48"
          fill="var(--color-paper)"
          stroke={stroke}
          stroke-width="2.5"
        />
        <text
          x="90"
          y="38"
          fill="currentColor"
          font-size="18"
          font-weight="700"
          text-anchor="middle"
        >
          {box.name}
        </text>

        {box.coins.map((coin, coinIndex) => {
          const x = coinIndex === 0 ? 45 : 135
          return (
            <g
              data-bertrand-branch
              data-metal={coin}
              data-other-metal={box.coins[1 - coinIndex]}
            >
              <path
                d={`M90 56 L${x} 93`}
                fill="none"
                stroke={stroke}
                stroke-width="2.5"
                stroke-linecap="round"
              />
              <circle
                cx={x}
                cy="115"
                r="22"
                fill={coin === "G" ? series.gold : "var(--color-paper)"}
                stroke={stroke}
                stroke-width="2.5"
              />
              <text
                x={x}
                y="121"
                fill="currentColor"
                font-size="18"
                font-weight="700"
                text-anchor="middle"
              >
                {coin}
              </text>
            </g>
          )
        })}

        <text
          data-bertrand-count
          x="90"
          y="162"
          fill="currentColor"
          font-size="14"
          font-weight="700"
          text-anchor="middle"
          visibility="hidden"
        >
          {box.revealLabel}
        </text>
      </SvgFigure>
    ))}
  </div>

  <button
    id="bertrand-reveal"
    type="button"
    class="btn-ghost self-center"
    aria-expanded="false"
    aria-controls="bertrand-result"
  >
    Show the possible gold draws
  </button>

  <div id="bertrand-result" class="space-y-2 border-t-2 border-ink pt-3" hidden>
    <p class="text-base font-bold">Chance the other coin in your box is gold</p>
    <p class="text-3xl font-bold">2 out of 3</p>
    <p class="text-base leading-normal">
      There are three equally likely ways to draw a gold coin. In two of them, the other coin
      is gold too. The third leaves silver.
    </p>
  </div>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("bertrands-box")
  if (root) {
    const button = find<HTMLButtonElement>(root, "#bertrand-reveal")
    const result = find<HTMLElement>(root, "#bertrand-result")
    const branches = root.querySelectorAll<SVGGElement>("[data-bertrand-branch]")
    const counts = root.querySelectorAll<SVGTextElement>("[data-bertrand-count]")
    let revealed = false

    const render = () => {
      branches.forEach((branch) => {
        const isGold = branch.dataset.metal === "G"
        const path = find<SVGPathElement>(branch, "path")
        const circle = find<SVGCircleElement>(branch, "circle")
        const strokeColor = revealed && isGold
          ? branch.dataset.otherMetal === "G"
            ? "var(--color-series-green)"
            : "var(--color-series-red)"
          : "var(--color-stroke)"
        branch.setAttribute("opacity", revealed && !isGold ? ".15" : "1")
        path.setAttribute("stroke", strokeColor)
        path.setAttribute("stroke-width", revealed && isGold ? "4" : "2.5")
        circle.setAttribute("stroke", strokeColor)
        circle.setAttribute("stroke-width", revealed && isGold ? "3.5" : "2.5")
      })
      counts.forEach((count) => {
        count.setAttribute("visibility", revealed ? "visible" : "hidden")
      })
      result.hidden = !revealed
      button.setAttribute("aria-expanded", String(revealed))
      button.textContent = revealed ? "Show all six draws" : "Show the possible gold draws"
    }

    button.addEventListener("click", () => {
      revealed = !revealed
      render()
    })
    render()
  }
</script>
