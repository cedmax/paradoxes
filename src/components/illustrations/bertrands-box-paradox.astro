---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"

const boxes = [
  { name: "Box 1", coins: ["G", "G"], label: "Gold + gold", count: "2 gold draws" },
  { name: "Box 2", coins: ["G", "S"], label: "Gold + silver", count: "1 gold draw" },
  { name: "Box 3", coins: ["S", "S"], label: "Silver + silver", count: "0 gold draws" },
]

const coinClass = (coin: string) => [
  "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-ink text-sm font-bold sm:h-10 sm:w-10 sm:text-lg",
  coin === "G" ? "bg-series-gold" : "bg-paper",
]
---

<IllustrationFigure name="bertrands-box" lead="You drew gold. Which box did it come from?">
  <p class="text-base leading-normal">
    One of three boxes is chosen at random, then one of its two coins. G means gold; S means
    silver.
  </p>

  <div class="grid grid-cols-3 gap-2 sm:gap-3">
    {boxes.map((box) => (
      <Panel class="min-w-0 space-y-3 p-2! sm:p-3!">
        <div class="space-y-1 text-center">
          <p class="font-bold">{box.name}</p>
          <p class="text-xs leading-tight sm:text-sm">{box.label}</p>
        </div>
        <div class="flex items-start justify-center gap-1 sm:gap-2" aria-label={box.label}>
          {box.coins.map((coin) => (
            <div class="flex min-w-0 flex-col items-center gap-1">
              <span
                data-bertrand-coin
                data-metal={coin}
                class:list={coinClass(coin)}
                role="img"
                aria-label={coin === "G" ? "Gold coin" : "Silver coin"}
              >
                {coin}
              </span>
              <span data-bertrand-chance class="text-xs" hidden>1/6</span>
            </div>
          ))}
        </div>
        <div class="min-h-5 text-center">
          <p data-bertrand-count class="text-xs font-bold leading-tight sm:text-sm" hidden>
            {box.count}
          </p>
        </div>
      </Panel>
    ))}
  </div>

  <p id="bertrand-step-text" class="text-base leading-normal" aria-live="polite">
    The three boxes are equally likely. Either coin in each box could be drawn.
  </p>

  <button id="bertrand-next" type="button" class="btn-ghost">
    Count the six possible draws
  </button>

  <div id="bertrand-result" class="space-y-2" hidden>
    <p class="text-3xl font-bold">2 out of 3</p>
    <p class="text-base leading-normal">
      Of the three equally likely ways to draw gold, two come from the gold-gold box.
      So the other coin is gold two times out of three.
    </p>
  </div>

  <Fragment slot="caption">
    Seeing gold leaves two possible boxes, but not two equally likely boxes. The gold-gold box
    has twice as many ways to produce the coin you saw.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("bertrands-box")
  if (root) {
    const next = find<HTMLButtonElement>(root, "#bertrand-next")
    const stepText = find<HTMLElement>(root, "#bertrand-step-text")
    const result = find<HTMLElement>(root, "#bertrand-result")
    const coins = root.querySelectorAll<HTMLElement>("[data-bertrand-coin]")
    const chances = root.querySelectorAll<HTMLElement>("[data-bertrand-chance]")
    const counts = root.querySelectorAll<HTMLElement>("[data-bertrand-count]")
    let step = 0

    const render = () => {
      chances.forEach((chance) => {
        chance.hidden = step !== 1
      })
      counts.forEach((count) => {
        count.hidden = step !== 2
      })
      coins.forEach((coin) => {
        coin.classList.toggle("opacity-25", step === 2 && coin.dataset.metal === "S")
        coin.classList.toggle("outline-2", step === 2 && coin.dataset.metal === "G")
        coin.classList.toggle("outline-offset-2", step === 2 && coin.dataset.metal === "G")
        coin.classList.toggle("outline-series-green", step === 2 && coin.dataset.metal === "G")
      })
      result.hidden = step !== 2
      stepText.textContent = [
        "The three boxes are equally likely. Either coin in each box could be drawn.",
        "There are six equally likely draws. Each individual coin has a 1 in 6 chance of being drawn.",
        "You drew gold, so the three silver draws fade away. Three equally likely draws remain: two from Box 1, one from Box 2.",
      ][step]
      next.textContent = [
        "Count the six possible draws",
        "Keep only the gold draws",
        "Start again",
      ][step]
    }

    next.addEventListener("click", () => {
      step = (step + 1) % 3
      render()
    })
    render()
  }
</script>
