---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"

const boxes = [
  {
    name: "Box 1",
    contents: ["G", "G"],
    goldDraws: ["G", "G"],
    otherCoins: ["G", "G"],
  },
  {
    name: "Box 2",
    contents: ["G", "S"],
    goldDraws: ["G"],
    otherCoins: ["S"],
  },
  {
    name: "Box 3",
    contents: ["S", "S"],
    goldDraws: [],
    otherCoins: [],
  },
]

const coinClass = (metal: string) => [
  "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-ink text-xs font-bold sm:h-10 sm:w-10 sm:text-base",
  metal === "G" ? "bg-series-gold" : "bg-paper",
]
---

<IllustrationFigure
  name="bertrands-box"
  lead="You drew gold. What is the chance the other coin is gold too?"
>
  <p class="text-base leading-normal">
    Follow each box down: which gold coin could you have drawn, and what would be left?
  </p>

  <div
    class="mx-auto grid w-full max-w-xl grid-cols-[4.5rem_repeat(3,minmax(0,1fr))] gap-x-1 sm:grid-cols-[7rem_repeat(3,minmax(0,1fr))] sm:gap-x-3"
    aria-label="Three boxes, the ways to draw gold, and the other coin for each possible gold draw"
  >
    <div aria-hidden="true"></div>
    {boxes.map((box) => (
      <p class="border-b-2 border-ink pb-2 text-center text-sm font-bold sm:text-base">
        {box.name}
      </p>
    ))}

    <p class="flex items-center border-b border-ink/30 py-5 pr-1 text-xs font-bold leading-tight sm:text-base">
      In the box
    </p>
    {boxes.map((box) => (
      <div class="flex min-w-0 items-center justify-center border-b border-ink/30 py-4">
        <div
          class="flex min-h-14 items-center justify-center gap-1 border-2 border-ink px-1 sm:gap-2 sm:px-3"
          aria-label={box.contents.map((metal) => metal === "G" ? "Gold" : "Silver").join(" and ")}
        >
          {box.contents.map((metal) => (
            <span class:list={coinClass(metal)} aria-hidden="true">{metal}</span>
          ))}
        </div>
      </div>
    ))}

    <p class="flex items-center border-b border-ink/30 py-5 pr-1 text-xs font-bold leading-tight sm:text-base">
      You drew gold
    </p>
    {boxes.map((box) => (
      <div class="flex min-w-0 flex-col items-center justify-center gap-2 border-b border-ink/30 py-4">
        {box.goldDraws.length > 0 ? (
          <>
            <div class="flex items-center justify-center gap-1 sm:gap-2">
              {box.goldDraws.map((metal) => (
                <span class:list={coinClass(metal)} aria-label="Gold draw">{metal}</span>
              ))}
            </div>
            <p class="text-center text-xs leading-tight sm:text-sm">
              {box.goldDraws.length} {box.goldDraws.length === 1 ? "option" : "options"}
            </p>
          </>
        ) : (
          <p class="text-center text-xs leading-tight sm:text-sm">No options</p>
        )}
      </div>
    ))}

    <p class="flex items-center py-5 pr-1 text-xs font-bold leading-tight sm:text-base">
      Other coin
    </p>
    {boxes.map((box) => (
      <div class="flex min-w-0 flex-col items-center justify-center gap-2 py-4">
        {box.otherCoins.length > 0 ? (
          <>
            <div class="flex items-center justify-center gap-1 sm:gap-2">
              {box.otherCoins.map((metal) => (
                <span
                  class:list={coinClass(metal)}
                  aria-label={metal === "G" ? "Gold remaining" : "Silver remaining"}
                >
                  {metal}
                </span>
              ))}
            </div>
            <p class="text-center text-xs font-bold leading-tight sm:text-sm">
              {box.otherCoins.length} {box.otherCoins[0] === "G" ? "gold" : "silver"}
            </p>
          </>
        ) : (
          <p class="text-center text-xs leading-tight sm:text-sm">No options</p>
        )}
      </div>
    ))}
  </div>

  <div class="flex items-center gap-4 border-t-2 border-ink pt-4">
    <p class="text-4xl font-bold">2/3</p>
    <p class="text-base leading-normal">
      Chance the other coin is gold. Two of the three possible gold draws leave a gold coin behind.
    </p>
  </div>
</IllustrationFigure>
