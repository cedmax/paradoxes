---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import ComparisonTable from "~/components/illustration-kit/ComparisonTable.astro"

const columns = ["", "Box 1", "Box 2", "Box 3"]
const rows = [
  ["In the box", "Gold + gold", "Gold + silver", "Silver + silver"],
  ["You drew gold", "2 options", "1 option", "No options"],
  ["Other coin", "2 gold", "1 silver", "No options"],
]
---

<IllustrationFigure
  name="bertrands-box"
  lead="You drew gold. What is the chance the other coin is gold too?"
>
  <ComparisonTable
    caption="Start with the three boxes. Then count which gold coin you could have drawn."
    columns={columns}
    rows={rows}
    align="center"
    dense
  />

  <div class="space-y-2 border-t-2 border-ink pt-3">
    <p class="text-base leading-normal">
      There are three possible gold draws: two from Box 1 and one from Box 2.
      In Box 1, the other coin is also gold.
    </p>
    <p class="text-xl font-bold">
      Chance the other coin is gold: 2/3
    </p>
  </div>
</IllustrationFigure>
