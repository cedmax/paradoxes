---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"

const boxes = [
  { name: "Box 1", coins: ["gold", "gold"] },
  { name: "Box 2", coins: ["gold", "silver"] },
  { name: "Box 3", coins: ["silver", "silver"] },
]

const possibleDraws = [
  { box: "Box 1", draw: "First gold coin", other: "gold" },
  { box: "Box 1", draw: "Second gold coin", other: "gold" },
  { box: "Box 2", draw: "Gold coin", other: "silver" },
]

const coinClass = (metal: string) => [
  "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink text-sm font-bold sm:h-10 sm:w-10 sm:text-base",
  metal === "gold" ? "bg-series-gold" : "bg-ink/15",
]
---

<IllustrationFigure
  name="bertrands-box"
  lead="You drew gold. What is the chance the other coin is gold too?"
>
  <div class="grid grid-cols-3 gap-2 sm:gap-3" aria-label="The three boxes and their coins">
    {boxes.map((box) => (
      <div class="flex min-w-0 flex-col items-center gap-2 border border-ink p-2 sm:p-3">
        <p class="text-sm font-bold">{box.name}</p>
        <div class="flex items-center justify-center gap-1 sm:gap-2">
          {box.coins.map((metal) => (
            <span class:list={coinClass(metal)}>
              <span aria-hidden="true">{metal === "gold" ? "G" : "S"}</span>
              <span class="sr-only">{metal} coin</span>
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="text-sm">
    G = gold, S = silver. Each box is equally likely to be picked, then each coin
    inside it is equally likely to be drawn.
  </p>

  <Disclosure summary="Show the possible gold draws">
    <div class="flex flex-col gap-3 pt-3">
      <p class="text-base leading-normal">
        You drew gold, so Box 3 is ruled out. But the two remaining boxes
        are not equally likely: Box 1 offers two possible gold draws.
      </p>

      <div class="grid grid-cols-3 gap-2 sm:gap-3">
        {possibleDraws.map((draw) => (
          <div class="flex min-w-0 flex-col items-center gap-2 border border-ink p-2 text-center sm:p-3">
            <p class="text-sm font-bold">{draw.box}</p>
            <p class="text-xs leading-tight">{draw.draw}</p>
            <span class:list={coinClass("gold")}>
              <span aria-hidden="true">G</span>
              <span class="sr-only">Gold coin drawn</span>
            </span>
            <span aria-hidden="true" class="text-sm">↓</span>
            <span class:list={coinClass(draw.other)}>
              <span aria-hidden="true">{draw.other === "gold" ? "G" : "S"}</span>
              <span class="sr-only">{draw.other} coin left in the box</span>
            </span>
            <p class="text-xs leading-tight">Other coin: {draw.other}</p>
          </div>
        ))}
      </div>

      <p class="text-base leading-normal">
        These are the three equally likely gold draws. In two of them, the
        other coin is gold.
      </p>
      <p class="text-xl font-bold">Chance the other coin is gold: 2/3</p>
    </div>
  </Disclosure>
</IllustrationFigure>
