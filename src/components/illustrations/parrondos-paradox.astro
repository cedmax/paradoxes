---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Panel from "~/components/illustration-kit/Panel.astro"

const chanceA = 0.495
const chanceBadB = 0.095
const chanceGoodB = 0.745

// Each position is the chance that the player's money is 0, 1 or 2 above a multiple of 3.
// A win adds £1 and a loss subtracts £1, so both games change the position.
function move(states: number[], game: string) {
  const next = [0, 0, 0]
  for (let state = 0; state < 3; state++) {
    const win =
      game === "A" ? chanceA : state === 0 ? chanceBadB : chanceGoodB
    next[(state + 1) % 3] += states[state] * win
    next[(state + 2) % 3] += states[state] * (1 - win)
  }
  return next
}

// Start with equal chances, repeat the cycle until its long-run distribution settles,
// then record the chances before each play. No random simulation or lucky example.
function calculate(sequence: string) {
  let states = [1 / 3, 1 / 3, 1 / 3]
  for (let repeat = 0; repeat < 400; repeat++) {
    for (const game of sequence) states = move(states, game)
  }

  const steps = []
  let totalPence = 0
  let badShare = 0
  let bPlays = 0
  for (const game of sequence) {
    const win =
      game === "A"
        ? chanceA
        : states[0] * chanceBadB + (1 - states[0]) * chanceGoodB
    const expectedPence = (2 * win - 1) * 100
    steps.push({ game, states, expectedPence })
    totalPence += expectedPence
    if (game === "B") {
      badShare += states[0]
      bPlays++
    }
    states = move(states, game)
  }

  return {
    steps,
    averagePence: totalPence / sequence.length,
    badCoinPercent: (badShare / bPlays) * 100,
  }
}

const results = {
  AABB: calculate("AABB"),
  ABAB: calculate("ABAB"),
}
const first = results.AABB.steps[0]
const stateLabels = [
  "Multiple of three (bad coin in B)",
  "One above a multiple of three",
  "Two above a multiple of three",
]
const percent = (value: number) => (value * 100).toFixed(1) + "%"
const pence = (value: number) => (value >= 0 ? "+" : "−") + Math.abs(value).toFixed(2) + "p"
---

<IllustrationFigure
  name="parrondos-paradox"
  lead="The order changes which coin Game B has to use."
>
  <p class="text-base leading-normal">
    Game A wins £1 with a 49.5% chance. Game B also wins or loses £1, but uses a 9.5% coin
    when your money is a multiple of three and a 74.5% coin otherwise. Both games lose when
    played alone.
  </p>

  <div id="parrondos-controls" data-results={JSON.stringify(results)} class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <p class="font-bold">Repeat which pattern?</p>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Repeating game pattern">
        <button
          id="parrondos-aabb"
          type="button"
          class="btn-toggle flex-1"
          aria-pressed="true"
        >
          AABB
        </button>
        <button
          id="parrondos-abab"
          type="button"
          class="btn-toggle flex-1"
          aria-pressed="false"
        >
          ABAB
        </button>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <p class="font-bold">Choose a play in the repeating pattern</p>
      <div class="grid grid-cols-4 gap-2" role="group" aria-label="Play in the pattern">
        {first && results.AABB.steps.map((step, index) => (
          <button
            type="button"
            data-parrondos-step={index}
            class="btn-toggle min-w-0 px-2 text-base"
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {index + 1}. {step.game}
          </button>
        ))}
      </div>
    </div>

    <p id="parrondos-turn" class="font-bold" aria-live="polite">
      Before play 1: Game A
    </p>

    <Panel title="Where could your money be before this play?">
      <p class="mb-3 text-base">
        These are the long-run chances after repeating the selected pattern many times.
        A win adds £1; a loss subtracts £1.
      </p>
      <div class="flex flex-col gap-4">
        {stateLabels.map((label, index) => (
          <div class="flex flex-col gap-1">
            <div class="flex items-baseline justify-between gap-3 text-base">
              <span>{label}</span>
              <strong class="shrink-0 tabular-nums" data-parrondos-value={index}>
                {percent(first.states[index])}
              </strong>
            </div>
            <div class="h-5 w-full bg-ink/10">
              <div
                data-parrondos-bar={index}
                class:list={[
                  "h-full transition-[width] duration-300 motion-reduce:transition-none",
                  index === 0
                    ? "bg-series-red"
                    : index === 1
                      ? "bg-series-blue"
                      : "bg-series-gold",
                ]}
                style={"width: " + first.states[index] * 100 + "%"}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </Panel>

    <Panel accent="blue">
      <p id="parrondos-coin" class="text-base">
        Game A uses its 49.5% coin regardless of how much money you have.
      </p>
      <p id="parrondos-turn-profit" class="mt-2 font-bold">
        Expected change on this play: −1.00p
      </p>
    </Panel>

    <button id="parrondos-next" type="button" class="btn-ghost w-full sm:w-auto">
      Next play
    </button>

    <div class="grid gap-4 sm:grid-cols-2">
      <Panel accent="green" title="AABB repeated">
        <p class="text-base">
          Bad coin on {results.AABB.badCoinPercent.toFixed(1)}% of B plays.
        </p>
        <p class="font-bold">Average {pence(results.AABB.averagePence)} per play.</p>
      </Panel>
      <Panel accent="red" title="ABAB repeated">
        <p class="text-base">
          Bad coin on {results.ABAB.badCoinPercent.toFixed(1)}% of B plays.
        </p>
        <p class="font-bold">Average {pence(results.ABAB.averagePence)} per play.</p>
      </Panel>
    </div>
  </div>

  <Fragment slot="caption">
    Neither game wins on its own. The order of play changes how often Game B encounters the
    bad coin. AABB avoids it more often, enough to turn an average loss into an average gain.
    The bars show calculated long-run chances, not the outcome of any one person's four plays.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  type Step = { game: string; states: number[]; expectedPence: number }
  type Result = {
    steps: Step[]
    averagePence: number
    badCoinPercent: number
  }

  const root = illustrationRoot("parrondos-paradox")
  if (root) {
    const controls = find<HTMLElement>(root, "#parrondos-controls")
    const results = JSON.parse(controls.dataset.results || "{}") as Record<
      "AABB" | "ABAB",
      Result
    >
    const aabb = find<HTMLButtonElement>(root, "#parrondos-aabb")
    const abab = find<HTMLButtonElement>(root, "#parrondos-abab")
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-parrondos-step]"))
    const values = Array.from(root.querySelectorAll<HTMLElement>("[data-parrondos-value]"))
    const bars = Array.from(root.querySelectorAll<HTMLElement>("[data-parrondos-bar]"))
    const turn = find<HTMLElement>(root, "#parrondos-turn")
    const coin = find<HTMLElement>(root, "#parrondos-coin")
    const turnProfit = find<HTMLElement>(root, "#parrondos-turn-profit")
    const next = find<HTMLButtonElement>(root, "#parrondos-next")

    let pattern: "AABB" | "ABAB" = "AABB"
    let play = 0

    const signedPence = (amount: number) =>
      (amount >= 0 ? "+" : "−") + Math.abs(amount).toFixed(2) + "p"

    const render = () => {
      const result = results[pattern]
      const step = result.steps[play]
      aabb.setAttribute("aria-pressed", String(pattern === "AABB"))
      abab.setAttribute("aria-pressed", String(pattern === "ABAB"))

      steps.forEach((button, index) => {
        button.textContent = String(index + 1) + ". " + result.steps[index].game
        button.setAttribute("aria-pressed", String(play === index))
      })

      turn.textContent = "Before play " + String(play + 1) + ": Game " + step.game
      step.states.forEach((chance, index) => {
        values[index].textContent = (chance * 100).toFixed(1) + "%"
        bars[index].style.width = String(chance * 100) + "%"
      })
      coin.textContent =
        step.game === "A"
          ? "Game A uses its 49.5% coin regardless of how much money you have."
          : "Game B uses the bad 9.5% coin " +
            (step.states[0] * 100).toFixed(1) +
            "% of the time and the good 74.5% coin " +
            ((1 - step.states[0]) * 100).toFixed(1) +
            "% of the time."
      turnProfit.textContent =
        "Expected change on this play: " + signedPence(step.expectedPence)
    }

    aabb.addEventListener("click", () => {
      pattern = "AABB"
      play = 0
      render()
    })
    abab.addEventListener("click", () => {
      pattern = "ABAB"
      play = 0
      render()
    })
    steps.forEach((button, index) => {
      button.addEventListener("click", () => {
        play = index
        render()
      })
    })
    next.addEventListener("click", () => {
      play = (play + 1) % 4
      render()
    })
  }
</script>
