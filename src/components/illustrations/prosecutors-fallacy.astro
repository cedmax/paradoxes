---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"

const matchX = 432
const matchY = 192
---

<IllustrationFigure
  name="prosecutors-fallacy"
  lead="A rare match does not mean guilt is nearly certain."
>
  <div>
    <p class="text-xl font-bold">100,000 possible suspects</p>
    <p class="text-base">
      Each little block represents 100 people. They are grouped by their test result, not where
      they live. The highlighted block contains about 100 people who match the evidence.
    </p>
  </div>

  <SvgFigure
    id="prosecutors-fallacy-pool"
    name="prosecutors-fallacy-pool"
    class="mx-auto w-full max-w-2xl"
    viewBox="0 0 640 400"
    title="Zoomable pool of one hundred thousand possible suspects"
    desc="A grid of one thousand blocks, each standing for one hundred people. Nine hundred and ninety-nine grey blocks represent people who do not match. One highlighted block represents about one hundred matching people. Zooming into that same block reveals ninety-nine innocent matches in gold and one culprit in blue."
  >
    <defs>
      <pattern
        id="prosecutors-fallacy-pattern"
        width="16"
        height="16"
        patternUnits="userSpaceOnUse"
      >
        <rect width="14" height="14" fill={stroke} fill-opacity="0.16" />
      </pattern>
    </defs>
    <rect width="640" height="400" fill="url(#prosecutors-fallacy-pattern)" />

    <!-- The only matching block: its hundred individual cells are already inside the overview. -->
    <rect x={matchX} y={matchY} width="14" height="14" fill={series.gold} />
    {Array.from({ length: 100 }, (_, i) => (
      <rect
        x={matchX + 0.55 + (i % 10) * 1.3}
        y={matchY + 0.55 + Math.floor(i / 10) * 1.3}
        width="1.05"
        height="1.05"
        fill={i === 0 ? series.blue : series.gold}
      />
    ))}
    <rect
      x={matchX - 2}
      y={matchY - 2}
      width="18"
      height="18"
      fill="none"
      stroke={stroke}
      stroke-width="2.5"
      vector-effect="non-scaling-stroke"
    />
  </SvgFigure>

  <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p id="prosecutors-fallacy-readout" class="text-base" aria-live="polite">
      One block out of 1,000 matches. Zoom in to examine the people inside.
    </p>
    <button
      id="prosecutors-fallacy-zoom"
      type="button"
      class="btn-toggle w-full shrink-0 sm:w-auto"
      aria-pressed="false"
      aria-controls="prosecutors-fallacy-pool"
    >
      Zoom into matches
    </button>
  </div>

  <ul
    id="prosecutors-fallacy-key"
    class="flex flex-wrap gap-x-6 gap-y-2 text-base"
    hidden
  >
    <li class="flex items-center gap-2">
      <span
        class="size-4 shrink-0 border-2 border-ink bg-series-blue"
        aria-hidden="true"
      ></span>
      1 actual culprit
    </li>
    <li class="flex items-center gap-2">
      <span class="size-4 shrink-0 bg-series-gold" aria-hidden="true"></span>
      About 99 innocent matches
    </li>
  </ul>

  <Fragment slot="caption">
    Suppose the trace matches 1 in 1,000 innocent people. If 100,000 people are equally likely
    suspects and there are no other clues, about 100 would match, including the culprit. Among
    those matches, the chance of guilt is roughly 1%, not 99.9%. The match is useful evidence,
    but it does not settle guilt on its own. This is a simplified example, not a real DNA study.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("prosecutors-fallacy")
  if (root) {
    const svg = find<SVGSVGElement>(root, "#prosecutors-fallacy-pool")
    const zoomButton = find<HTMLButtonElement>(root, "#prosecutors-fallacy-zoom")
    const readout = find<HTMLElement>(root, "#prosecutors-fallacy-readout")
    const key = find<HTMLElement>(root, "#prosecutors-fallacy-key")

    const overview = [0, 0, 640, 400]
    const closeup = [424, 189.625, 30, 18.75]
    let current = [...overview]
    let zoomed = false
    let frame = 0

    const setView = (view: number[]) => {
      current = view
      svg.setAttribute("viewBox", view.join(" "))
    }

    zoomButton.addEventListener("click", () => {
      zoomed = !zoomed
      zoomButton.setAttribute("aria-pressed", String(zoomed))
      zoomButton.textContent = zoomed ? "Zoom back out" : "Zoom into matches"
      readout.textContent = zoomed
        ? "Close up: one actual culprit, about 99 innocent matches."
        : "One block out of 1,000 matches. Zoom in to examine the people inside."
      key.hidden = !zoomed

      cancelAnimationFrame(frame)
      const from = [...current]
      const target = zoomed ? closeup : overview

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        setView(target)
        return
      }

      const start = performance.now()
      const duration = 1100
      const draw = (now: number) => {
        const t = Math.min(1, (now - start) / duration)
        const eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2
        setView(from.map((value, i) => value + (target[i] - value) * eased))
        if (t < 1) frame = requestAnimationFrame(draw)
      }
      frame = requestAnimationFrame(draw)
    })
  }
</script>
