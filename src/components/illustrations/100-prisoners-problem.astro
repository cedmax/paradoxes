---
const boxes = [1, 2, 3, 4, 5, 6, 7, 8]
---

<figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6" data-prisoner-cycles>
  <p class="font-bold">The hidden pattern: loops of numbers</p>
  <p class="text-base leading-normal">
    Each circle is a numbered box. An arrow shows which box its contents point to.
    Everyone in the same loop succeeds or fails together.
  </p>

  <div class="flex flex-wrap gap-2" role="group" aria-label="Choose an arrangement">
    <button type="button" class="btn-ghost" data-preset="short" aria-pressed="true">
      Two short loops
    </button>
    <button type="button" class="btn-ghost" data-preset="long" aria-pressed="false">
      One long loop
    </button>
    <button type="button" class="btn-ghost" id="prisoners-reset">
      Reset
    </button>
  </div>

  <div class="border-l-4 border-ink pl-4" aria-live="polite" aria-atomic="true">
    <p class="text-sm font-bold" id="prisoners-arrangement">Two short loops</p>
    <p id="prisoners-group-result" class="font-bold">All 8 prisoners succeed.</p>
    <p class="text-base" id="prisoners-why">
      Longest loop: 4 boxes. Each prisoner may open four, so nobody runs out of tries.
    </p>
  </div>

  <p class="text-base leading-normal">
    <strong>Try changing the loops:</strong> select any two numbered circles to swap
    the numbers inside those boxes. The arrows and results update immediately.
    Try swapping boxes 1 and 2 in the short-loop example.
  </p>
  <p id="prisoners-swap-message" class="text-base" aria-live="polite">
    Select a box to start a swap.
  </p>

  <div id="prisoners-cycle-diagrams" class="grid gap-3 sm:grid-cols-2">
    <div class="border-2 border-ink p-3">
      <p class="font-bold">Loop of 4 · all four succeed</p>
      <p class="text-base">1 → 5 → 3 → 7 → 1</p>
    </div>
    <div class="border-2 border-ink p-3">
      <p class="font-bold">Loop of 4 · all four succeed</p>
      <p class="text-base">2 → 8 → 4 → 6 → 2</p>
    </div>
  </div>

  <figcaption class="text-base leading-normal">
    Here, eight prisoners can each open four boxes. Every prisoner follows the arrows
    starting from their own box, and must complete their loop to find their number.
    The group survives only if no loop is longer than four. In the real problem,
    100 prisoners may open 50 boxes each. A random arrangement has no loop longer
    than 50 about 31% of the time.
  </figcaption>
</figure>

<style>
  [data-prisoner-cycles] button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  [data-prisoner-cycles] .cycle-node {
    cursor: pointer;
    outline: none;
  }

  [data-prisoner-cycles] .cycle-node:focus-visible circle {
    stroke: var(--color-ink);
    stroke-width: 5;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-prisoner-cycles]")
  if (root) {
    const presets = {
      short: [5, 8, 7, 6, 3, 2, 1, 4],
      long: [5, 8, 7, 1, 3, 2, 4, 6],
    }
    type Preset = keyof typeof presets
    const ns = "http://www.w3.org/2000/svg"
    const cycleRegion = root.querySelector<HTMLElement>("#prisoners-cycle-diagrams")!
    const presetButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-preset]"),
    )
    const resetButton = root.querySelector<HTMLButtonElement>("#prisoners-reset")!
    const arrangementLabel = root.querySelector<HTMLElement>("#prisoners-arrangement")!
    const resultLabel = root.querySelector<HTMLElement>("#prisoners-group-result")!
    const whyLabel = root.querySelector<HTMLElement>("#prisoners-why")!
    const swapMessage = root.querySelector<HTMLElement>("#prisoners-swap-message")!

    let basePreset: Preset = "short"
    let customised = false
    let values = [...presets.short]
    let selected: number | null = null

    const cyclesFrom = (numbers: number[]): number[][] => {
      const visited = new Set<number>()
      const cycles: number[][] = []
      for (let start = 1; start <= 8; start++) {
        if (visited.has(start)) continue
        const cycle: number[] = []
        let position = start
        while (!visited.has(position)) {
          visited.add(position)
          cycle.push(position)
          position = numbers[position - 1]
        }
        cycles.push(cycle)
      }
      return cycles
    }

    const svgElement = <T extends SVGElement>(tag: string): T =>
      document.createElementNS(ns, tag) as T

    const textElement = (tag: string, text: string, className: string) => {
      const element = document.createElement(tag)
      element.textContent = text
      element.className = className
      return element
    }

    const chooseBox = (box: number) => {
      if (selected === null) {
        selected = box
        swapMessage.textContent = `Box ${box} selected. Select another box to swap its contents.`
      } else if (selected === box) {
        selected = null
        swapMessage.textContent = "Selection cancelled. Select a box to start a swap."
      } else {
        const first = selected
        // Swapping two destinations preserves a permutation: each number occurs once.
        ;[values[first - 1], values[box - 1]] = [values[box - 1], values[first - 1]]
        customised = true
        selected = null
        swapMessage.textContent = `Swapped the contents of boxes ${first} and ${box}.`
      }
      render()
    }

    const cycleDiagram = (cycle: number[], index: number, allSucceed: boolean) => {
      const card = document.createElement("section")
      card.className = "flex flex-col gap-2 border-2 border-ink p-3"
      const succeeds = cycle.length <= 4
      const colour = succeeds ? "#387a91" : "#bd4b37"
      const verdict = succeeds
        ? `All ${cycle.length} ${cycle.length === 1 ? "prisoner succeeds" : "prisoners succeed"}`
        : `All ${cycle.length} prisoners fail`
      card.append(
        textElement("h3", `Loop of ${cycle.length} · ${verdict}`, "font-bold"),
      )

      const svg = svgElement<SVGSVGElement>("svg")
      svg.setAttribute("viewBox", "0 0 300 240")
      svg.setAttribute("class", "mx-auto w-full max-w-xs")
      svg.setAttribute("role", "group")
      svg.setAttribute(
        "aria-label",
        `Loop: ${[...cycle, cycle[0]].join(" to ")}. ${verdict}. Select numbered circles to swap their box contents.`,
      )
      const defs = svgElement<SVGDefsElement>("defs")
      const marker = svgElement<SVGMarkerElement>("marker")
      const markerId = `prisoners-arrow-${index}`
      marker.setAttribute("id", markerId)
      marker.setAttribute("viewBox", "0 0 10 10")
      marker.setAttribute("refX", "8")
      marker.setAttribute("refY", "5")
      marker.setAttribute("markerWidth", "6")
      marker.setAttribute("markerHeight", "6")
      marker.setAttribute("orient", "auto")
      const arrow = svgElement<SVGPathElement>("path")
      arrow.setAttribute("d", "M 0 0 L 10 5 L 0 10 z")
      arrow.setAttribute("fill", colour)
      marker.appendChild(arrow)
      defs.appendChild(marker)
      svg.appendChild(defs)

      const radius = cycle.length <= 2 ? 68 : 83
      const points = cycle.map((number, position) => {
        const angle = -Math.PI / 2 + (position * 2 * Math.PI) / cycle.length
        return {
          number,
          x: 150 + (cycle.length === 1 ? 0 : radius * Math.cos(angle)),
          y: 120 + (cycle.length === 1 ? 0 : radius * Math.sin(angle)),
        }
      })

      for (let j = 0; j < points.length; j++) {
        const from = points[j]
        const to = points[(j + 1) % points.length]
        const edge = svgElement<SVGPathElement>("path")
        let d: string
        if (points.length === 1) {
          d = "M 169 107 C 223 45, 95 45, 131 107"
        } else {
          const dx = to.x - from.x
          const dy = to.y - from.y
          const distance = Math.hypot(dx, dy)
          const ux = dx / distance
          const uy = dy / distance
          const startX = from.x + ux * 25
          const startY = from.y + uy * 25
          const endX = to.x - ux * 27
          const endY = to.y - uy * 27
          if (points.length === 2) {
            const bend = j === 0 ? -50 : 50
            d = `M ${startX} ${startY} Q ${(startX + endX) / 2 + bend} ${(startY + endY) / 2} ${endX} ${endY}`
          } else {
            d = `M ${startX} ${startY} L ${endX} ${endY}`
          }
        }
        edge.setAttribute("d", d)
        edge.setAttribute("fill", "none")
        edge.setAttribute("stroke", colour)
        edge.setAttribute("stroke-width", "3")
        edge.setAttribute("stroke-linecap", "round")
        edge.setAttribute("marker-end", `url(#${markerId})`)
        svg.appendChild(edge)
      }

      for (const point of points) {
        const node = svgElement<SVGGElement>("g")
        node.setAttribute("class", "cycle-node")
        node.setAttribute("role", "button")
        node.setAttribute("tabindex", "0")
        node.setAttribute(
          "aria-label",
          `Box ${point.number} contains ${values[point.number - 1]}. Select to swap contents.`,
        )
        node.setAttribute("aria-pressed", String(selected === point.number))
        const circle = svgElement<SVGCircleElement>("circle")
        circle.setAttribute("cx", String(point.x))
        circle.setAttribute("cy", String(point.y))
        circle.setAttribute("r", "22")
        circle.setAttribute("stroke", selected === point.number ? "#d7a13d" : colour)
        circle.setAttribute("stroke-width", selected === point.number ? "5" : "3")
        circle.setAttribute("fill", selected === point.number ? "#d7a13d" : "var(--color-paper)")
        node.appendChild(circle)

        const label = svgElement<SVGTextElement>("text")
        label.setAttribute("x", String(point.x))
        label.setAttribute("y", String(point.y + 6))
        label.setAttribute("text-anchor", "middle")
        label.setAttribute("font-size", "19")
        label.setAttribute("font-weight", "700")
        label.setAttribute("fill", "var(--color-ink)")
        label.setAttribute("pointer-events", "none")
        label.textContent = String(point.number)
        node.appendChild(label)

        node.addEventListener("click", () => chooseBox(point.number))
        node.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault()
            chooseBox(point.number)
          }
        })
        svg.appendChild(node)
      }
      card.append(
        svg,
        textElement(
          "p",
          `Follow the arrows: ${[...cycle, cycle[0]].join(" → ")}`,
          "text-base",
        ),
      )
      return card
    }

    const render = () => {
      const cycles = cyclesFrom(values)
      const longest = Math.max(...cycles.map((cycle) => cycle.length))
      const successfulPrisoners = cycles
        .filter((cycle) => cycle.length <= 4)
        .reduce((count, cycle) => count + cycle.length, 0)
      const allSucceed = successfulPrisoners === 8

      arrangementLabel.textContent = customised
        ? "Your arrangement"
        : basePreset === "short"
          ? "Two short loops"
          : "One long loop"
      resultLabel.textContent = allSucceed
        ? "All 8 prisoners succeed. The group survives."
        : `Only ${successfulPrisoners} of 8 prisoners succeed. The group loses.`
      whyLabel.textContent = allSucceed
        ? `Longest loop: ${longest} ${longest === 1 ? "box" : "boxes"}. Every loop fits within four openings.`
        : `Longest loop: ${longest} boxes. Everyone in a loop longer than four fails, even if the other prisoners succeed.`
      presetButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(!customised && button.dataset.preset === basePreset),
        )
      })
      cycleRegion.replaceChildren(
        ...cycles.map((cycle, i) => cycleDiagram(cycle, i, allSucceed)),
      )
    }

    const selectPreset = (name: Preset) => {
      basePreset = name
      customised = false
      values = [...presets[name]]
      selected = null
      swapMessage.textContent = "Select any two boxes to swap their contents."
      render()
    }

    presetButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const name = button.dataset.preset
        if (name === "short" || name === "long") selectPreset(name)
      })
    })
    resetButton.addEventListener("click", () => selectPreset(basePreset))
    render()
  }
</script>
