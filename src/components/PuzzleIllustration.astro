---
import OlderPuzzleIllustration from "./OlderPuzzleIllustration.astro"
import NewPuzzleIllustration from "./NewPuzzleIllustration.astro"
import VanishingWheel from "./VanishingWheel.astro"

interface Props {
  slug: string
}

const { slug } = Astro.props
const illustrationModules = import.meta.glob<{ default: typeof OlderPuzzleIllustration }>(
  "./illustrations/*.astro",
  { eager: true },
)
const ExtraIllustration = illustrationModules[`./illustrations/${slug}.astro`]?.default
const colours = ["#bd4b37", "#387a91", "#d7a13d", "#5d8560"]
const missingLayouts = [
  [
    "0,0 8,0 8,3",
    "8,3 13,3 13,5",
    "8,2 10,2 10,1 13,1 13,3 8,3",
    "8,0 13,0 13,1 10,1 10,2 8,2",
  ],
  ["5,2 13,2 13,5", "0,0 5,0 5,2", "8,1 10,1 10,0 13,0 13,2 8,2", "5,0 10,0 10,1 7,1 7,2 5,2"],
]
const boardLayouts = [
  ["0,0 8,0 8,3", "0,0 0,3 8,3", "3,3 8,3 8,8 5,8", "0,3 3,3 5,8 0,8"],
  ["0,0 8,0 8,3", "5,2 5,5 13,5", "0,0 0,5 5,5 5,2", "8,0 13,0 13,5 8,3"],
]
const gambles = [
  {
    pair: "First pair",
    rows: [
      ["A", "$1m", "$1m", "$1m"],
      ["B", "$5m", "$0", "$1m"],
    ],
  },
  {
    pair: "Second pair",
    rows: [
      ["A", "$1m", "$1m", "$0"],
      ["B", "$5m", "$0", "$0"],
    ],
  },
]
---

<OlderPuzzleIllustration slug={slug} />
<NewPuzzleIllustration slug={slug} />
{ExtraIllustration && <ExtraIllustration />}

{slug === "staircase-paradox" && (
  <figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6">
    <div class="flex flex-col gap-2">
      <label for="staircase-step-count" class="font-bold">
        Make the steps smaller
      </label>
      <input
        id="staircase-step-count"
        class="h-11 w-full accent-ink"
        type="range"
        min="0"
        max="5"
        step="1"
        value="2"
        aria-describedby="staircase-step-description"
      />
      <p id="staircase-step-description" class="text-base" aria-live="polite">
        <span id="staircase-step-label">4 steps</span> along each side
      </p>
      <div class="flex flex-col gap-1 border-l-4 border-ink pl-4 text-base">
        <p class="font-bold">Staircase length: 2</p>
        <p id="staircase-length-breakdown">4 × 1/4 across + 4 × 1/4 up = 2</p>
        <p>Diagonal length: √2 ≈ 1.4142</p>
      </div>
    </div>
    <svg
      class="mx-auto w-full max-w-lg"
      viewBox="0 0 430 265"
      role="img"
      aria-labelledby="staircase-title staircase-desc"
    >
      <title id="staircase-title">A staircase approaching a straight diagonal</title>
      <desc id="staircase-desc">
        The staircase runs from the bottom left to the top right corner of a unit square. Its
        steps become smaller as the slider moves. Each path still covers one unit horizontally
        and one vertically, for a total length of two. The diagonal is about 1.414 units long.
      </desc>
      <rect
        x="60"
        y="10"
        width="220"
        height="220"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        opacity="0.35"
      />
      <path
        d="M60 230 L280 10"
        fill="none"
        stroke="#bd4b37"
        stroke-width="3"
        stroke-dasharray="7 6"
      />
      <path
        id="staircase-path"
        d="M60 230 H115 V175 H170 V120 H225 V65 H280 V10"
        fill="none"
        stroke="#387a91"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <g fill="currentColor" font-size="18" font-family="sans-serif">
        <text x="294" y="28">
          Diagonal
        </text>
        <text x="294" y="51">
          ≈ 1.414
        </text>
        <text x="294" y="198">
          Staircase
        </text>
        <text x="294" y="221">
          = 2
        </text>
        <text x="54" y="252" text-anchor="middle">
          0
        </text>
        <text x="282" y="252" text-anchor="middle">
          1
        </text>
      </g>
    </svg>
    <figcaption class="text-base leading-normal">
      The path always goes one unit right and one unit up. Making the steps smaller changes its
      shape, not its length. The dashed diagonal takes a shorter route.
    </figcaption>
  </figure>
)}
<script>
  const stairSlider = document.querySelector<HTMLInputElement>("#staircase-step-count")
  const stairPath = document.querySelector<SVGPathElement>("#staircase-path")
  const stairLabel = document.querySelector<HTMLElement>("#staircase-step-label")
  const stairBreakdown = document.querySelector<HTMLElement>("#staircase-length-breakdown")
  if (stairSlider && stairPath && stairLabel && stairBreakdown) {
    const stepCounts = [1, 2, 4, 8, 16, 32]
    const updateStaircase = () => {
      const n = stepCounts[Number(stairSlider.value)] ?? 4
      let d = "M60 230"
      for (let i = 1; i <= n; i++) {
        const x = 60 + (220 * i) / n
        const y = 230 - (220 * i) / n
        d += ` H${x} V${y}`
      }
      stairPath.setAttribute("d", d)
      const stepText = `${n} ${n === 1 ? "step" : "steps"}`
      stairLabel.textContent = stepText
      stairSlider.setAttribute("aria-valuetext", stepText)
      const segmentLength = n === 1 ? "1" : `1/${n}`
      stairBreakdown.textContent = `${n} × ${segmentLength} across + ${n} × ${segmentLength} up = 2`
    }
    stairSlider.addEventListener("input", updateStaircase)
    updateStaircase()
  }
</script>

{slug === "missing-square-puzzle" && (
  <figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6">
    <div class="grid gap-6">
      {missingLayouts.map((pieces, i) => (
        <div class="flex flex-col gap-2">
          <p class="font-bold">{i === 0 ? "Filled outline" : "Rearranged: one square empty"}</p>
          <svg viewBox="-0.2 -0.2 13.4 5.4" role="img" aria-labelledby={`missing-title-${i}`}>
            <title id={`missing-title-${i}`}>
              {i === 0 ? "Four pieces fill a bent 13 by 5 outline" : "The same four pieces leave a one-square hole in a different bent outline"}
            </title>
            <g
              transform="translate(0 5) scale(1 -1)"
              stroke="#272622"
              stroke-width="0.035"
              stroke-linejoin="round"
            >
              {pieces.map((points, j) => (
                <polygon points={points} fill={colours[j]} />
              ))}
              {Array.from({ length: 14 }, (_, x) => (
                <path d={`M${x},0 V5`} fill="none" opacity="0.25" />
              ))}
              {Array.from({ length: 6 }, (_, y) => (
                <path d={`M0,${y} H13`} fill="none" opacity="0.25" />
              ))}
              {i === 1 && (
                <rect x="7" y="1" width="1" height="1" fill="none" stroke-width="0.08" />
              )}
            </g>
          </svg>
        </div>
      ))}
    </div>
    <figcaption class="text-base leading-normal">
      The same colours mark the same pieces. Both outlines are 13 squares wide and 5 tall. Their
      long edges are drawn with the actual tiny bends.
    </figcaption>
    <details class="group border-t-2 border-ink pt-3">
      <summary class="flex min-h-11 cursor-pointer items-center gap-2 font-bold">
        <span aria-hidden="true" class="text-sm transition-transform group-open:rotate-90">
          ▶
        </span>
        Compare the two long edges
      </summary>
      <svg
        class="mt-4"
        viewBox="-0.2 -0.2 13.4 5.4"
        role="img"
        aria-labelledby="missing-edge-title"
      >
        <title id="missing-edge-title">The two bent edges enclose a sliver of area one square</title>
        <g transform="translate(0 5) scale(1 -1)" stroke-width="0.07" fill="none">
          <polygon points="0,0 8,3 13,5 5,2" fill="#d7a13d" stroke="#272622" />
          <path d="M0,0 L13,5" stroke="#272622" stroke-dasharray="0.2 0.15" />
        </g>
      </svg>
      <p class="mt-2 text-base">
        The dashed line is straight. The two bent edges enclose exactly one square of area.
      </p>
    </details>
  </figure>
)}

{slug === "chessboard-paradox" && (
  <figure class="flex flex-col gap-4 border-2 border-ink p-4 sm:p-6">
    <div class="grid gap-6">
      {boardLayouts.map((pieces, i) => (
        <div class="flex flex-col gap-2">
          <p class="font-bold">
            {i === 0 ? "8 × 8: 64 squares" : "13 × 5: an outline of 65 squares"}
          </p>
          <svg
            class="mx-auto w-full max-w-80"
            viewBox={i === 0 ? "-2.7 -0.2 13.4 8.4" : "-0.2 -0.2 13.4 5.4"}
            role="img"
            aria-labelledby={`board-title-${i}`}
          >
            <title id={`board-title-${i}`}>
              {i === 0 ? "An 8 by 8 square divided into two triangles and two trapezoids" : "The same four pieces rearranged into an apparent 13 by 5 rectangle"}
            </title>
            <g
              transform={`translate(0 ${i === 0 ? 8 : 5}) scale(1 -1)`}
              stroke="#272622"
              stroke-width="0.035"
              stroke-linejoin="round"
            >
              {pieces.map((points, j) => (
                <polygon points={points} fill={colours[j]} stroke="none" />
              ))}
              {Array.from({ length: i === 0 ? 9 : 14 }, (_, x) => (
                <path d={`M${x},0 V${i === 0 ? 8 : 5}`} fill="none" opacity="0.25" />
              ))}
              {Array.from({ length: i === 0 ? 9 : 6 }, (_, y) => (
                <path d={`M0,${y} H${i === 0 ? 8 : 13}`} fill="none" opacity="0.25" />
              ))}
              <g fill="none" stroke-width="0.16">
                <rect x="0" y="0" width={i === 0 ? 8 : 13} height={i === 0 ? 8 : 5} />
                <path
                  d={i === 0 ? "M0,0 L8,3 M0,3 H8 M3,3 L5,8" : "M0,0 L13,5 M5,2 V5 M8,0 V3"}
                />
              </g>
            </g>
          </svg>
        </div>
      ))}
    </div>
    <figcaption class="text-base leading-normal">
      The same colours mark the same pieces. Each grid square represents one square unit, and
      both drawings use the same scale.
    </figcaption>
    <details class="group border-t-2 border-ink pt-3">
      <summary class="flex min-h-11 cursor-pointer items-center gap-2 font-bold">
        <span aria-hidden="true" class="text-sm transition-transform group-open:rotate-90">
          ▶
        </span>
        See the gap highlighted
      </summary>
      <svg
        class="mt-4 w-full"
        viewBox="-0.2 -0.2 13.4 5.4"
        role="img"
        aria-labelledby="board-gap-title"
      >
        <title id="board-gap-title">The exact parallelogram gap highlighted in gold</title>
        <g transform="translate(0 5) scale(1 -1)" stroke="#272622" stroke-width="0.015">
          {boardLayouts[1].map((points, j) => (
            <polygon points={points} fill={colours[j]} fill-opacity="0.25" />
          ))}
          <polygon points="0,0 5,2 13,5 8,3" fill="#d7a13d" />
        </g>
      </svg>
      <p class="mt-2 text-base">
        Gold marks the gap, whose total area is one square. The drawing keeps its true
        proportions.
      </p>
    </details>
  </figure>
)}

{slug === "vanishing-puzzle" && <VanishingWheel />}

{slug === "allais-paradox" && (
  <div class="flex flex-col gap-4">
    {gambles.map(({ pair, rows }) => (
      <div class="overflow-x-auto border-2 border-ink">
        <table class="w-full text-base leading-normal">
          <caption class="border-b-2 border-ink p-3 text-left font-bold">
            {pair}: imagine 100 equally likely tickets
          </caption>
          <thead>
            <tr>
              <th class="px-2 py-3 text-left sm:px-3" scope="col">
                Option
              </th>
              <th class="px-2 py-3 text-left sm:px-3" scope="col">
                10 tickets
              </th>
              <th class="px-2 py-3 text-left sm:px-3" scope="col">
                1 ticket
              </th>
              <th class="bg-disputed px-2 py-3 text-left sm:px-3" scope="col">
                89 shared tickets
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(([option, ten, one, shared]) => (
              <tr class="border-t border-ink">
                <th class="px-2 py-3 text-left sm:px-3" scope="row">
                  {option}
                </th>
                <td class="px-2 py-3 sm:px-3">{ten}</td>
                <td class="px-2 py-3 sm:px-3">{one}</td>
                <td class="bg-disputed px-2 py-3 sm:px-3">{shared}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
    <p class="text-base leading-normal">
      $1m means $1 million. Only the shared column changes. The usual choices are A in the first
      pair and B in the second.
    </p>
  </div>
)}

{slug === "hilberts-hotel" && (
  <figure class="flex flex-col gap-5 border-2 border-ink p-4 sm:p-6">
    <div class="flex flex-col gap-2">
      <p class="font-bold">Before: every room is occupied</p>
      <div class="grid grid-cols-5 gap-1.5 sm:gap-3">
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="flex min-w-0 flex-col items-center gap-1 border-2 border-ink p-1.5 text-center sm:p-3">
            <span class="text-xs font-bold sm:text-base">Room {n}</span>
            <span class="text-xs sm:text-base">Guest {n}</span>
          </div>
        ))}
      </div>
      <p class="text-base">…and so on, without a last room.</p>
    </div>
    <div class="flex flex-col gap-2">
      <p class="font-bold">Ask every guest to move up one room</p>
      <div class="grid grid-cols-5 gap-1.5 sm:gap-3">
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="flex min-w-0 flex-col items-center gap-1 border-2 border-ink p-1.5 text-center sm:p-3">
            <span class="text-xs font-bold sm:text-base">Room {n}</span>
            {n === 1 ? (
              <span class="text-xs font-bold text-accent sm:text-base">Empty</span>
            ) : (
              <span class="text-xs sm:text-base">Guest {n - 1}</span>
            )}
          </div>
        ))}
      </div>
      <p class="text-base">
        Guest 1 moves to room 2, guest 2 to room 3, and so on. Room 1 is now free.
        Every original guest still has a room.
      </p>
    </div>
    <details class="group border-t-2 border-ink pt-3">
      <summary class="flex min-h-11 cursor-pointer items-center gap-2 font-bold">
        <span aria-hidden="true" class="text-sm transition-transform group-open:rotate-90">
          ▶
        </span>
        What if infinitely many new guests arrive?
      </summary>
      <p class="mt-3 text-base leading-normal">
        Move each original guest to twice their old room number: 1 goes to 2, 2 goes to 4,
        3 goes to 6, and so on. Every even room holds an original guest.
        All the odd rooms are free for the newcomers.
      </p>
      <div class="mt-3 grid grid-cols-5 gap-1.5 sm:gap-3">
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="flex min-w-0 flex-col items-center gap-1 border-2 border-ink p-1.5 text-center sm:p-3">
            <span class="text-xs font-bold sm:text-base">Room {n}</span>
            {n % 2 === 1 ? (
              <span class="text-xs font-bold text-accent sm:text-base">
                New {Math.ceil(n / 2)}
              </span>
            ) : (
              <span class="text-xs sm:text-base">Guest {n / 2}</span>
            )}
          </div>
        ))}
      </div>
      <p class="mt-3 text-base leading-normal">
        The picture shows only the first five rooms. The rearrangement goes on forever.
      </p>
    </details>
    <figcaption class="text-base leading-normal">
      A full infinite hotel can take one more guest, or infinitely many more.
      The trick works because its numbered rooms have no end.
    </figcaption>
  </figure>
)}
