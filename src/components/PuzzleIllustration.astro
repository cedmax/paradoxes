---
import type { AstroComponentFactory } from "astro/runtime/server/index.js"

interface Props {
  slug: string
}

// An illustration is the file src/components/illustrations/<slug>.astro, where <slug> is the
// entry id. Each page loads only its own file.
const { slug } = Astro.props
const loaders = import.meta.glob<{ default: AstroComponentFactory }>("./illustrations/*.astro")
const load = loaders[`./illustrations/${slug}.astro`]
const Illustration = load && (await load()).default
---

{Illustration && <Illustration />}
