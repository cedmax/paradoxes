---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, stroke } from "~/data/palette"

// A fixed-seed sample of points on a sphere; these coordinates are serialised into the SVG
// and read back by the browser, so the still frame and moving frame cannot drift apart.
let seed = 0x51a7
const random = () => {
  seed = (1664525 * seed + 1013904223) >>> 0
  return seed / 4294967296
}
const points = Array.from({ length: 108 }, () => {
  const y = 126 * (2 * random() - 1)
  const longitude = 2 * Math.PI * random()
  const radius = Math.sqrt(126 * 126 - y * y)
  return { x: radius * Math.cos(longitude), y, z: radius * Math.sin(longitude) }
})
---

<IllustrationFigure
  name="kinetic-depth-effect"
  lead="Look at the dots while they are still. What shape appears when they rotate?"
>
  <SvgFigure
    name="kinetic-depth-effect"
    viewBox="0 0 600 380"
    class="mx-auto w-full max-w-xl"
    title="A field of dots projected from a sphere rotating around its vertical axis"
    desc="There are 108 fixed dots on a mathematically defined sphere. At rest their two-dimensional positions do not reveal a solid object. When played, their changing positions can suggest a rotating three-dimensional sphere. Colour cues for nearer and farther dots can be shown after inspection."
  >
    <rect x="30" y="15" width="540" height="350" fill={illusionSurface.neutral} />
    <g id="kinetic-depth-effect-dots">
      {points.map((point, index) => (
        <circle
          cx={300 + point.x}
          cy={190 + point.y}
          r="3.7"
          fill={stroke}
          data-index={index}
          data-x={point.x}
          data-y={point.y}
          data-z={point.z}
        />
      ))}
    </g>
  </SvgFigure>
  <Slider
    id="kinetic-depth-effect-angle"
    label="Rotate by hand"
    min={0}
    max={359}
    step={1}
    value={0}
    startLabel="Start"
    endLabel="Full turn"
    describedby="kinetic-depth-effect-readout"
    valuetext="0 degrees"
  >
    <p id="kinetic-depth-effect-readout" class="text-base" aria-live="polite">
      Rotation 0 degrees. All dots remain at fixed locations on one sphere.
    </p>
  </Slider>
  <IllusionControls
    name="kinetic-depth-effect"
    proof="Each dot stays at a fixed point on the same invisible sphere. Red marks points on the nearer half and blue marks points on the farther half of the mathematical construction. The uncoloured motion, not a change in screen depth, creates the impression."
    proofLabel="Show depth cues"
  />
  <Fragment slot="caption">
    Original orthographic dot projection, after Mather (1989) and Rogers (2021). The same fixed
    set of points is displayed in every frame.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSliderLoopPlayback, find, illustrationRoot } from "~/scripts/illustration"

  const name = "kinetic-depth-effect"
  const root = illustrationRoot(name)
  if (root) {
    const slider = find<HTMLInputElement>(root, `#${name}-angle`)
    const play = find<HTMLButtonElement>(root, `#${name}-play`)
    const proof = find<HTMLButtonElement>(root, `#${name}-guide-toggle`)
    const proofText = find<HTMLElement>(root, `#${name}-proof`)
    const readout = find<HTMLElement>(root, `#${name}-readout`)
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>("[data-index]"))
    // The same fixed coordinates used for the first SVG render.
    const points = dots.map((dot) => ({
      x: Number(dot.dataset.x),
      y: Number(dot.dataset.y),
      z: Number(dot.dataset.z),
    }))
    let angle = 0
    const draw = () => {
      const theta = (angle * Math.PI) / 180
      for (const [index, point] of points.entries()) {
        const x = point.x * Math.cos(theta) + point.z * Math.sin(theta)
        const depth = point.z * Math.cos(theta) - point.x * Math.sin(theta)
        dots[index].setAttribute("cx", String(300 + x))
        dots[index].setAttribute("cy", String(190 + point.y))
        dots[index].setAttribute(
          "fill",
          proof.getAttribute("aria-pressed") === "true"
            ? depth > 0
              ? "var(--color-series-red)"
              : "var(--color-series-blue)"
            : "var(--color-stroke)",
        )
      }
    }
    bindSliderLoopPlayback(
      slider,
      play,
      (value) => {
        angle = value
        draw()
        readout.textContent = `Rotation ${value} degrees. All dots stay on the same sphere.`
        return `Rotation ${value} degrees`
      },
      25,
    )
    proof.addEventListener("click", () => {
      const shown = proof.getAttribute("aria-pressed") !== "true"
      proof.setAttribute("aria-pressed", String(shown))
      proof.textContent = shown ? "Hide depth cues" : "Show depth cues"
      proofText.hidden = !shown
      draw()
    })
  }
</script>
