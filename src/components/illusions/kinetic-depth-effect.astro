---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import ListenerChoice from "~/components/illustration-kit/ListenerChoice.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, stroke } from "~/data/palette"

// Fixed-seed, softly clustered points inside a spherical volume. Sampling its surface
// instead produces an obvious circular rim before the dots move. These 3D coordinates are
// serialised into the SVG and reused in every frame.
let seed = 0x51a7
const random = () => {
  seed = (1664525 * seed + 1013904223) >>> 0
  return seed / 4294967296
}
const gaussian = () => Math.sqrt(-2 * Math.log(1 - random())) * Math.cos(2 * Math.PI * random())
const points: { x: number; y: number; z: number }[] = []
while (points.length < 108) {
  const candidate = { x: 65 * gaussian(), y: 65 * gaussian(), z: 65 * gaussian() }
  // Keep the cloud within the drawing, without putting every dot on its perimeter.
  if (candidate.x ** 2 + candidate.y ** 2 + candidate.z ** 2 >= 160 ** 2) continue
  // Avoid overlapping dots in the opening view, without adding latitude rows.
  const overlaps = points.some(({ x, y }) => {
    const dx = candidate.x - x
    const dy = candidate.y - y
    return dx * dx + dy * dy < 64
  })
  if (overlaps) continue
  points.push(candidate)
}
---

<IllustrationFigure
  name="kinetic-depth-effect"
  lead="Look at the dots while they are still. What shape appears when they rotate?"
>
  <SvgFigure
    name="kinetic-depth-effect"
    viewBox="0 0 600 380"
    class="mx-auto w-full max-w-xl"
    title="A scattered cloud of fixed dots rotating together in three dimensions"
    desc="There are 108 dots scattered inside a three-dimensional spherical volume. At rest they form an irregular two-dimensional cloud. When they rotate together, their motion can suggest a sphere. Colour cues can identify nearer and farther dots after a judgement."
  >
    <rect x="30" y="15" width="540" height="350" fill={illusionSurface.neutral} />
    <g id="kinetic-depth-effect-dots">
      {points.map((point, index) => (
        <circle
          cx={300 + point.x}
          cy={190 + point.y}
          r="3.7"
          fill={stroke}
          data-index={index}
          data-x={point.x}
          data-y={point.y}
          data-z={point.z}
        />
      ))}
    </g>
  </SvgFigure>
  <Slider
    id="kinetic-depth-effect-angle"
    label="Rotate by hand"
    min={0}
    max={359}
    step={1}
    value={0}
    startLabel="Start"
    endLabel="Full turn"
    describedby="kinetic-depth-effect-readout"
    valuetext="0 degrees"
  >
    <p id="kinetic-depth-effect-readout" class="text-base">
      Rotation 0 degrees. The dots stay fixed inside one three-dimensional volume.
    </p>
  </Slider>
  <p id="kinetic-depth-effect-status" class="text-base" aria-live="polite">
    Play or rotate the dots by hand, then record what shape you saw.
  </p>
  <ListenerChoice
    name="kinetic-depth-effect"
    question="What did the moving dots seem to form?"
    options={[
      { value: "sphere", label: "A rotating sphere" },
      { value: "flat", label: "A flat pattern" },
      { value: "unsure", label: "Couldn't tell" },
    ]}
    skipLabel="I cannot see or follow the motion"
  />
  <IllusionControls
    name="kinetic-depth-effect"
    proof="The dots have fixed positions inside a spherical volume. Red marks the nearer half of this model and blue the farther half, but this is only one possible interpretation of the uncoloured motion. Without depth cues, the perceived rotation can go either way and may reverse. The dot paths never change."
    proofLabel="Show depth cues"
  />
  <Fragment slot="caption">
    Original orthographic dot projection, after Mather (1989) and Rogers (2021). The same fixed
    set of points is displayed in every frame.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindListenerChoice, find, illustrationRoot } from "~/scripts/illustration"

  const name = "kinetic-depth-effect"
  const root = illustrationRoot(name)
  if (root) {
    const slider = find<HTMLInputElement>(root, `#${name}-angle`)
    const play = find<HTMLButtonElement>(root, `#${name}-play`)
    const proof = find<HTMLButtonElement>(root, `#${name}-guide-toggle`)
    const proofText = find<HTMLElement>(root, `#${name}-proof`)
    const readout = find<HTMLElement>(root, `#${name}-readout`)
    const status = find<HTMLElement>(root, `#${name}-status`)
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>("[data-index]"))
    const points = dots.map((dot) => ({
      x: Number(dot.dataset.x),
      y: Number(dot.dataset.y),
      z: Number(dot.dataset.z),
    }))
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    const degreesPerMs = 360 / 12000
    const answerAfterDegrees = 90
    let angle = 0
    let observedDegrees = 0
    let canAnswer = false
    let running = false
    let frame = 0
    let previousFrame: number | null = null

    const draw = () => {
      const theta = (angle * Math.PI) / 180
      const showingDepth = proof.getAttribute("aria-pressed") === "true"
      for (const [index, point] of points.entries()) {
        const x = point.x * Math.cos(theta) + point.z * Math.sin(theta)
        const depth = point.z * Math.cos(theta) - point.x * Math.sin(theta)
        dots[index].setAttribute("cx", String(300 + x))
        dots[index].setAttribute("cy", String(190 + point.y))
        dots[index].setAttribute(
          "fill",
          showingDepth
            ? depth > 0
              ? "var(--color-series-red)"
              : "var(--color-series-blue)"
            : "var(--color-stroke)",
        )
      }
      const degrees = Math.round(angle) % 360
      if (Number(slider.value) !== degrees) {
        slider.value = String(degrees)
        slider.setAttribute("aria-valuetext", `Rotation ${degrees} degrees`)
        readout.textContent = `Rotation ${degrees} degrees. All dots stay within the same volume.`
      }
    }

    const stop = () => {
      running = false
      cancelAnimationFrame(frame)
      previousFrame = null
      play.textContent = "Play"
      play.setAttribute("aria-pressed", "false")
    }

    const showDepth = (shown: boolean) => {
      proof.setAttribute("aria-pressed", String(shown))
      proof.textContent = shown ? "Hide depth cues" : "Show depth cues"
      proofText.hidden = !shown
      draw()
    }

    const choices = bindListenerChoice(root, name, (value) => {
      proof.disabled = false
      if (value === "skip") {
        stop()
        showDepth(true)
        status.textContent = "The mathematical explanation is shown below."
        return "The text explains the dot paths without recreating the visual experience."
      }
      status.textContent = "Judgement recorded. You can now show the depth cues."
      return "Show the depth cues to compare what you saw with one possible depth arrangement."
    })
    proof.disabled = true

    const recordMotion = (degrees: number) => {
      if (canAnswer) return
      observedDegrees += Math.abs(degrees)
      if (observedDegrees >= answerAfterDegrees) {
        canAnswer = true
        choices.enable()
        status.textContent = "The dots have rotated. Record what shape you saw."
      }
    }

    const tick = (now: number) => {
      if (!running) return
      if (previousFrame !== null) {
        const advance = Math.max(0, now - previousFrame) * degreesPerMs
        angle = (angle + advance) % 360
        draw()
        recordMotion(advance)
      }
      previousFrame = now
      frame = requestAnimationFrame(tick)
    }

    play.addEventListener("click", () => {
      if (running) {
        stop()
        if (!canAnswer) status.textContent = "Paused. Rotate farther to record your impression."
        return
      }
      if (reducedMotion.matches) return
      running = true
      previousFrame = null
      play.textContent = "Pause"
      play.setAttribute("aria-pressed", "true")
      frame = requestAnimationFrame(tick)
    })

    slider.addEventListener("input", () => {
      stop()
      const next = Number(slider.value)
      const distance = Math.abs(((next - angle + 540) % 360) - 180)
      angle = next
      draw()
      slider.setAttribute("aria-valuetext", `Rotation ${next} degrees`)
      readout.textContent = `Rotation ${next} degrees. All dots stay within the same volume.`
      recordMotion(distance)
    })

    proof.addEventListener("click", () => {
      showDepth(proof.getAttribute("aria-pressed") !== "true")
    })
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop()
    })
    const motionChanged = () => {
      if (reducedMotion.matches) stop()
      play.disabled = reducedMotion.matches
      play.title = reducedMotion.matches ? "Use the slider without animation" : ""
    }
    reducedMotion.addEventListener("change", motionChanged)
    motionChanged()
    draw()
  }
</script>
