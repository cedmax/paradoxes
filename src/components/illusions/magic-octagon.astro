---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Coin from "./magic-octagon/Coin.astro"

const labels = [
  "up",
  "up-right",
  "right",
  "down-right",
  "down",
  "down-left",
  "left",
  "up-left",
] as const
const symbols = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"] as const
const corners = labels.map((label, index) => {
  const direction = -Math.PI / 2 + (index * Math.PI) / 4
  return {
    label,
    symbol: symbols[index],
    // The targets sit precisely on the octagon's eight vertices (radius 112).
    // Coordinates correspond to the coin's 360 × 310 SVG viewBox.
    left: (((180 + 112 * Math.cos(direction)) / 360) * 100).toFixed(3),
    top: (((145 + 112 * Math.sin(direction)) / 310) * 100).toFixed(3),
  }
})
const previewAngles = [0, 45, 90, 135, 180, 225, 270, 315]
---

<IllustrationFigure name="magic-octagon" lead="Where will the arrow point when flipped?">
  <section class="flex flex-col gap-3" aria-labelledby="magic-octagon-coin-heading">
    <h2 id="magic-octagon-coin-heading" class="text-xl font-bold">
      The coin
    </h2>
    <p class="text-base">
      One face has an up arrow; the other has a left arrow. The dashed red line marks the
      vertical flip axis.
    </p>

    <div class="mx-auto w-full max-w-xs">
      <Coin
        id="inspect"
        title="A thick octagonal coin that can be turned over"
        desc="A blue up arrow is on one face, and a gold left arrow is on the opposite face. A red dashed line shows the fixed vertical axis. The slider turns the solid coin between its two sides."
      />
    </div>
    <div class="mx-auto flex w-full max-w-sm flex-col gap-2">
      <label for="magic-octagon-inspect-slider" class="font-bold text-base">
        Turn the coin over
      </label>
      <input
        id="magic-octagon-inspect-slider"
        class="w-full accent-current"
        type="range"
        min="0"
        max="180"
        step="1"
        value="0"
        aria-describedby="magic-octagon-inspect-state"
        aria-valuetext="Front, 0 degrees"
      />
      <div class="flex justify-between text-sm">
        <span>Front</span>
        <span>Flipped</span>
      </div>
      <p id="magic-octagon-inspect-state" class="text-center text-base">
        Front · 0°
      </p>
    </div>
  </section>

  <section
    class="flex flex-col gap-4 border-t-2 border-ink pt-6"
    aria-labelledby="magic-octagon-puzzle-heading"
  >
    <h2 id="magic-octagon-puzzle-heading" tabindex="-1" class="text-xl font-bold">
      Try the puzzle
    </h2>
    <p class="text-base">
      The front is turned <strong>45° clockwise</strong>. After a flip about the red Y axis,
      which corner will the arrow on the other face point to?
    </p>
    <div class="relative mx-auto w-full max-w-xs">
      <Coin
        id="puzzle"
        title="Octagonal coin turned 45 degrees clockwise"
        desc="The blue arrow is already pointing up-right, after a 45-degree clockwise turn. A fixed red dashed Y axis marks how the coin will flip. Choose one of the eight corners to predict the hidden arrow."
        initialTurn={45}
      />
      <div
        id="magic-octagon-selectors"
        class="absolute inset-0"
        role="group"
        aria-label="Predict the hidden arrow by choosing a corner of the coin"
      >
        {corners.map(({ label, symbol, left, top }) => (
          <button
            type="button"
            data-magic-guess={label}
            data-selected="false"
            aria-pressed="false"
            aria-label={"Choose the " + label + " corner"}
            class="absolute z-10 grid size-8 -translate-x-1/2 -translate-y-1/2 cursor-pointer place-items-center rounded-full border-2 border-ink bg-paper text-sm font-bold text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink data-[selected=true]:bg-ink data-[selected=true]:text-paper"
            style={"left:" + left + "%;top:" + top + "%"}
          >
            <span aria-hidden="true">{symbol}</span>
          </button>
        ))}
      </div>
    </div>
    <p id="magic-octagon-choice" class="text-center text-base" aria-live="polite">
      No corner selected.
    </p>
    <button
      id="magic-octagon-reveal"
      type="button"
      aria-controls="magic-octagon-puzzle-scrub magic-octagon-variations"
      class="btn self-center disabled:cursor-not-allowed disabled:opacity-50"
      disabled
    >
      Show answer and explanation
    </button>
    <div id="magic-octagon-puzzle-scrub" class="flex flex-col gap-3" hidden>
      <div class="mx-auto flex w-full max-w-sm flex-col gap-2">
        <label for="magic-octagon-puzzle-slider" class="text-base font-bold">
          Flip the rotated coin
        </label>
        <input
          id="magic-octagon-puzzle-slider"
          class="w-full accent-current"
          type="range"
          min="0"
          max="180"
          step="1"
          value="0"
          aria-describedby="magic-octagon-puzzle-slider-state"
          disabled
        />
        <div class="flex justify-between text-sm">
          <span>Front</span>
          <span>Flipped</span>
        </div>
        <p id="magic-octagon-puzzle-slider-state" class="text-center text-base">
          Front · 0°
        </p>
      </div>
      <p id="magic-octagon-answer" class="text-base" aria-live="polite"></p>
      <button type="button" class="btn-link self-start" id="magic-octagon-reset">
        Try again
      </button>
    </div>
  </section>

  <section
    id="magic-octagon-variations"
    class="flex flex-col gap-4 border-t-2 border-ink pt-6"
    aria-labelledby="magic-octagon-variations-heading"
    hidden
  >
    <h2 id="magic-octagon-variations-heading" class="text-xl font-bold">
      Turn it at different angles
    </h2>
    <div class="flex flex-col gap-6">
      {[previewAngles.slice(0, 4), previewAngles.slice(4)].map((angles, rowIndex) => (
        <Fragment>
          {rowIndex === 1 && (
            <div class="hidden w-full flex-col items-center gap-2 md:flex">
              <label for="magic-octagon-variants-shared" class="text-base font-bold">
                Flip all eight coins
              </label>
              <input
                id="magic-octagon-variants-shared"
                class="w-full max-w-md accent-current"
                type="range"
                min="0"
                max="180"
                step="1"
                value="0"
                aria-describedby="magic-octagon-variants-shared-state"
                aria-valuetext="Front · 0°"
              />
              <div class="flex w-full max-w-md justify-between text-sm">
                <span>Front</span>
                <span>Flipped</span>
              </div>
              <p id="magic-octagon-variants-shared-state" class="text-center text-sm">
                Front · 0°
              </p>
            </div>
          )}
          <div
            id={rowIndex === 1 ? "magic-octagon-more-rotations" : undefined}
            class:list={[
              "grid-cols-2 gap-x-3 gap-y-6 sm:gap-x-4 md:grid-cols-4",
              rowIndex === 1 ? "hidden md:grid" : "grid",
            ]}
          >
            {angles.map((angle) => (
              <div class="flex min-w-0 flex-col gap-2">
                <p class="text-center text-base font-bold">{angle}° rotation</p>
                <Coin
                  id={"variant-" + angle}
                  title={"Octagonal coin rotated " + angle + " degrees, with adjustable flip"}
                  desc={
                    "A solid octagonal coin rotated " +
                    angle +
                    " degrees around its centre, with a fixed red Y flip axis."
                  }
                  initialTurn={angle}
                  oversized
                />
                <div class="flex flex-col gap-2 md:hidden">
                  <label for={"magic-octagon-variant-" + angle} class="text-sm font-bold">
                    Flip this coin
                  </label>
                  <input
                    id={"magic-octagon-variant-" + angle}
                    data-magic-variant={angle}
                    class="w-full accent-current"
                    type="range"
                    min="0"
                    max="180"
                    step="1"
                    value="0"
                    aria-describedby={"magic-octagon-variant-state-" + angle}
                    aria-valuetext="Front · 0°"
                  />
                  <p id={"magic-octagon-variant-state-" + angle} class="text-center text-sm">
                    Front · 0°
                  </p>
                </div>
              </div>
            ))}
          </div>
        </Fragment>
      ))}
      <button
        id="magic-octagon-show-more"
        type="button"
        class="btn-ghost self-center md:hidden"
        aria-controls="magic-octagon-more-rotations"
        aria-expanded="false"
      >
        Show four more rotations
      </button>
    </div>
  </section>

  <Fragment slot="caption">
    Redrawn for this site after the Magic Octagon demonstrated by David Masunaga in
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      Dan Meyer's 2013 account
    </ExternalLink>
    The two arrows are fixed on opposite faces of one coin.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"
  import {
    directionIndexes,
    drawCoin,
    inspectionLabel,
    labels,
  } from "~/scripts/magic-octagon-coin"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const inspect = find<SVGSVGElement>(root, '[data-magic-coin="inspect"]')
    const puzzle = find<SVGSVGElement>(root, '[data-magic-coin="puzzle"]')
    const inspectSlider = find<HTMLInputElement>(root, "#magic-octagon-inspect-slider")
    const inspectState = find<HTMLElement>(root, "#magic-octagon-inspect-state")
    const guesses = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-magic-guess]"))
    const choice = find<HTMLElement>(root, "#magic-octagon-choice")
    const selectors = find<HTMLElement>(root, "#magic-octagon-selectors")
    const puzzleScrub = find<HTMLElement>(root, "#magic-octagon-puzzle-scrub")
    const puzzleSlider = find<HTMLInputElement>(root, "#magic-octagon-puzzle-slider")
    const puzzleSliderState = find<HTMLElement>(root, "#magic-octagon-puzzle-slider-state")
    const puzzleHeading = find<HTMLElement>(root, "#magic-octagon-puzzle-heading")
    const variations = find<HTMLElement>(root, "#magic-octagon-variations")
    const variantSliders = Array.from(
      root.querySelectorAll<HTMLInputElement>("[data-magic-variant]"),
    )
    const sharedVariantsSlider = find<HTMLInputElement>(root, "#magic-octagon-variants-shared")
    const sharedVariantsState = find<HTMLElement>(root, "#magic-octagon-variants-shared-state")
    const reveal = find<HTMLButtonElement>(root, "#magic-octagon-reveal")
    const answer = find<HTMLElement>(root, "#magic-octagon-answer")
    const showMore = find<HTMLButtonElement>(root, "#magic-octagon-show-more")
    const moreRotations = find<HTMLElement>(root, "#magic-octagon-more-rotations")
    const resetButton = find<HTMLButtonElement>(root, "#magic-octagon-reset")

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    const updateInspection = () => {
      const degrees = Number(inspectSlider.value)
      drawCoin(inspect, 0, degrees)
      inspectState.textContent = inspectionLabel(degrees)
      inspectSlider.setAttribute("aria-valuetext", inspectionLabel(degrees))
    }

    const puzzleAngle = 45
    let guess = ""
    let puzzleFrame = 0

    for (const option of guesses) {
      option.addEventListener("click", () => {
        guess = option.dataset.magicGuess ?? ""
        for (const button of guesses) {
          const selected = button === option
          button.dataset.selected = String(selected)
          button.setAttribute("aria-pressed", String(selected))
        }
        choice.textContent = "Selected: " + guess + "."
        reveal.disabled = false
      })
    }

    const updatePuzzleFlip = (degrees: number) => {
      drawCoin(puzzle, puzzleAngle, degrees)
      const rounded = Math.round(degrees)
      puzzleSlider.value = String(rounded)
      const label = inspectionLabel(rounded)
      puzzleSliderState.textContent = label
      puzzleSlider.setAttribute("aria-valuetext", label)
    }

    // The answer animation flips the SAME puzzle coin, then leaves the slider
    // available for direct inspection; it does not switch to a different image.
    const animatePuzzleReveal = () => {
      cancelAnimationFrame(puzzleFrame)
      puzzleSlider.disabled = true
      if (reducedMotion.matches) {
        updatePuzzleFlip(180)
        puzzleSlider.disabled = false
        return
      }
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const progress = Math.min(1, (now - started) / 1800)
        const eased = progress * progress * (3 - 2 * progress)
        updatePuzzleFlip(180 * eased)
        if (progress < 1) {
          puzzleFrame = requestAnimationFrame(tick)
        } else {
          puzzleSlider.disabled = false
        }
      }
      puzzleFrame = requestAnimationFrame(tick)
    }

    const variantUpdates: Array<(degrees: number) => void> = []
    for (const slider of variantSliders) {
      const turn = Number(slider.dataset.magicVariant)
      const svg = find<SVGSVGElement>(root, '[data-magic-coin="variant-' + turn + '"]')
      const state = find<HTMLElement>(root, "#magic-octagon-variant-state-" + turn)
      const update = (degrees: number) => {
        slider.value = String(degrees)
        drawCoin(svg, turn, degrees)
        const label = inspectionLabel(degrees)
        state.textContent = label
        slider.setAttribute("aria-valuetext", label)
      }
      slider.addEventListener("input", () => update(Number(slider.value)))
      variantUpdates.push(update)
      update(0)
    }

    const updateSharedVariants = (degrees: number) => {
      sharedVariantsSlider.value = String(degrees)
      const label = inspectionLabel(degrees)
      sharedVariantsState.textContent = label
      sharedVariantsSlider.setAttribute("aria-valuetext", label)
      for (const update of variantUpdates) update(degrees)
    }
    sharedVariantsSlider.addEventListener("input", () => {
      updateSharedVariants(Number(sharedVariantsSlider.value))
    })

    // When switching from independently adjusted mobile coins to desktop,
    // synchronise all four with the visible shared control.
    const desktopVariants = window.matchMedia("(min-width: 48rem)")
    desktopVariants.addEventListener("change", (event) => {
      if (event.matches) updateSharedVariants(Number(sharedVariantsSlider.value))
    })
    updateSharedVariants(0)

    let moreExpanded = false
    const updateMore = () => {
      moreRotations.classList.toggle("hidden", !moreExpanded)
      moreRotations.classList.toggle("grid", moreExpanded)
      showMore.setAttribute("aria-expanded", String(moreExpanded))
      showMore.textContent = moreExpanded ? "Show fewer rotations" : "Show four more rotations"
    }
    showMore.addEventListener("click", () => {
      moreExpanded = !moreExpanded
      updateMore()
    })
    updateMore()

    puzzleSlider.addEventListener("input", () => {
      cancelAnimationFrame(puzzleFrame)
      updatePuzzleFlip(Number(puzzleSlider.value))
    })

    reveal.addEventListener("click", () => {
      if (!guess) return
      const expected = labels[directionIndexes(puzzleAngle).flipped]
      answer.textContent =
        "You chose " +
        guess +
        ". When flipped, the hidden arrow points " +
        expected +
        (guess === expected ? " — correct." : ".")
      selectors.hidden = true
      choice.hidden = true
      reveal.hidden = true
      puzzleScrub.hidden = false
      variations.hidden = false
      puzzleHeading.focus()
      animatePuzzleReveal()
    })

    resetButton.addEventListener("click", () => {
      cancelAnimationFrame(puzzleFrame)
      variations.hidden = true
      puzzleScrub.hidden = true
      selectors.hidden = false
      choice.hidden = false
      reveal.hidden = false
      puzzleSlider.disabled = true
      guess = ""
      for (const option of guesses) {
        option.dataset.selected = "false"
        option.setAttribute("aria-pressed", "false")
      }
      choice.textContent = "No corner selected."
      reveal.disabled = true
      updatePuzzleFlip(0)
      updateSharedVariants(0)
      moreExpanded = false
      updateMore()
      guesses[0]?.focus()
    })

    inspectSlider.addEventListener("input", updateInspection)
    updateInspection()
    drawCoin(puzzle, puzzleAngle, 0)
  }
</script>
