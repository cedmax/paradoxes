---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Coin from "./magic-octagon/Coin.astro"

const labels = [
  "up",
  "up-right",
  "right",
  "down-right",
  "down",
  "down-left",
  "left",
  "up-left",
] as const
const symbols = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"] as const
const corners = labels.map((label, index) => {
  const direction = -Math.PI / 2 + (index * Math.PI) / 4
  return {
    label,
    symbol: symbols[index],
    // The targets sit precisely on the octagon's eight vertices (radius 112).
    // Coordinates correspond to the coin's 360 × 310 SVG viewBox.
    left: (((180 + 112 * Math.cos(direction)) / 360) * 100).toFixed(3),
    top: (((145 + 112 * Math.sin(direction)) / 310) * 100).toFixed(3),
  }
})
const previewAngles = [0, 45, 90, 135]
---

<IllustrationFigure name="magic-octagon" lead="Where will the arrow point when flipped?">
  <section class="flex flex-col gap-3" aria-labelledby="magic-octagon-coin-heading">
    <h2 id="magic-octagon-coin-heading" class="text-xl font-bold">The coin</h2>
    <p class="text-base">
      One arrow points up, the other points left. Move the slider to inspect
      both sides of the coin. The red dashed line is the fixed vertical (Y) axis:
      the coin turns over around it, like a page.
    </p>

    <div class="mx-auto w-full max-w-xs">
      <Coin
        id="inspect"
        title="A thick octagonal coin that can be turned over"
        desc="A blue up arrow is on one face, and a gold left arrow is on the opposite face. A red dashed line shows the fixed vertical axis. The slider turns the solid coin between its two sides."
      />
    </div>
    <div class="mx-auto flex w-full max-w-sm flex-col gap-2">
      <label for="magic-octagon-inspect-slider" class="font-bold text-base">
        Turn the coin over
      </label>
      <input
        id="magic-octagon-inspect-slider"
        class="w-full accent-current"
        type="range"
        min="0"
        max="180"
        step="1"
        value="0"
        aria-describedby="magic-octagon-inspect-state"
        aria-valuetext="Front, 0 degrees"
      />
      <div class="flex justify-between text-sm">
        <span>Front</span>
        <span>Flipped</span>
      </div>
      <p id="magic-octagon-inspect-state" class="text-center text-base" aria-live="polite">
        Front · 0°
      </p>
    </div>
  </section>

  <section
    class="flex flex-col gap-4 border-t-2 border-ink pt-6"
    aria-labelledby="magic-octagon-puzzle-heading"
  >
    <h2 id="magic-octagon-puzzle-heading" class="text-xl font-bold">Try the puzzle</h2>
    <p class="text-base">
      The front has already been turned <strong>45° clockwise</strong>.
      Imagine flipping the coin about the fixed red Y axis. Which corner
      will the hidden arrow point to? Choose your answer on the coin.
    </p>
    <div class="relative mx-auto w-full max-w-xs">
      <Coin
        id="puzzle"
        title="Octagonal coin turned 45 degrees clockwise"
        desc="The blue arrow is already pointing up-right, after a 45-degree clockwise turn. A fixed red dashed Y axis marks how the coin will flip. Choose one of the eight corners to predict the hidden arrow."
        initialTurn={45}
      />
      <div
        id="magic-octagon-selectors"
        class="absolute inset-0"
        role="group"
        aria-label="Predict the hidden arrow by choosing a corner of the coin"
      >
        {corners.map(({ label, symbol, left, top }) => (
          <button
            type="button"
            data-magic-guess={label}
            data-selected="false"
            aria-pressed="false"
            aria-label={"Choose the " + label + " corner"}
            class="absolute z-10 grid size-8 -translate-x-1/2 -translate-y-1/2 cursor-pointer place-items-center rounded-full border-2 border-ink bg-paper text-sm font-bold text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink data-[selected=true]:bg-ink data-[selected=true]:text-paper"
            style={"left:" + left + "%;top:" + top + "%"}
          >
            <span aria-hidden="true">{symbol}</span>
          </button>
        ))}
      </div>
    </div>
    <p id="magic-octagon-choice" class="text-center text-base" aria-live="polite">
      Select a corner of the coin to predict where the arrow will point.
    </p>
    <button
      id="magic-octagon-reveal"
      type="button"
      class="btn self-center disabled:cursor-not-allowed disabled:opacity-50"
      disabled
    >
      Show answer and explanation
    </button>
    <div id="magic-octagon-puzzle-scrub" class="flex flex-col gap-3" hidden>
      <h3 id="magic-octagon-scrub-heading" tabindex="-1" class="text-center font-bold">
        Turn the coin over to check
      </h3>
      <div class="mx-auto flex w-full max-w-sm flex-col gap-2">
        <label for="magic-octagon-puzzle-slider" class="text-base font-bold">
          Flip the rotated coin
        </label>
        <input
          id="magic-octagon-puzzle-slider"
          class="w-full accent-current"
          type="range"
          min="0"
          max="180"
          step="1"
          value="0"
          aria-describedby="magic-octagon-puzzle-slider-state"
          disabled
        />
        <div class="flex justify-between text-sm">
          <span>Front</span>
          <span>Flipped</span>
        </div>
        <p
          id="magic-octagon-puzzle-slider-state"
          class="text-center text-base"
          aria-live="polite"
        >
          Front · 0°
        </p>
      </div>
      <p id="magic-octagon-answer" class="text-base" aria-live="polite"></p>
    </div>
  </section>

  <section
    id="magic-octagon-variations"
    class="flex flex-col gap-4 border-t-2 border-ink pt-6"
    aria-labelledby="magic-octagon-variations-heading"
    hidden
  >
    <h2 id="magic-octagon-variations-heading" class="text-xl font-bold">
      Turn it at different angles
    </h2>
    <p class="text-base">
      Each coin starts at a different rotation. Slide each one around the same
      fixed red Y axis to compare how its outline changes as it turns edge-on.
    </p>
    <div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:gap-x-8">
      {previewAngles.map((angle) => (
        <div class="flex min-w-0 flex-col gap-2">
          <p class="text-center text-base font-bold">{angle}° rotation</p>
          <Coin
            id={"variant-" + angle}
            title={"Octagonal coin rotated " + angle + " degrees, with adjustable flip"}
            desc={"A solid octagonal coin pre-rotated " + angle + " degrees. Drag its slider to turn it around the fixed red Y axis and see the changing outline and thickness."}
            initialTurn={angle}
          />
          <label
            for={"magic-octagon-variant-" + angle}
            class="text-sm font-bold"
          >
            Flip this coin
          </label>
          <input
            id={"magic-octagon-variant-" + angle}
            data-magic-variant={angle}
            class="w-full accent-current"
            type="range"
            min="0"
            max="180"
            step="1"
            value="0"
            aria-describedby={"magic-octagon-variant-state-" + angle}
            aria-valuetext="Front · 0°"
          />
          <p
            id={"magic-octagon-variant-state-" + angle}
            class="text-center text-sm"
          >
            Front · 0°
          </p>
        </div>
      ))}
    </div>
  </section>

  <section
    id="magic-octagon-explanation"
    class="flex flex-col gap-4 border-t-2 border-ink pt-6"
    aria-labelledby="magic-octagon-explanation-heading"
    hidden
  >
    <h2 id="magic-octagon-explanation-heading" tabindex="-1" class="text-xl font-bold">
      What happens
    </h2>
    <p class="text-base">
      The black dots now reveal the same physical corner on each face.
      Watch the shaded edge while the coin turns slowly around the fixed red Y axis.
      The two views rotate in opposite apparent directions because they show one coin
      from opposite sides.
    </p>

    <div
      id="magic-octagon-proof-views"
      class="mx-auto flex w-full max-w-2xl flex-col items-center justify-center gap-2 md:flex-row md:items-start md:gap-5"
    >
      <div class="w-full max-w-xs md:min-w-0 md:flex-1">
        <p class="text-center text-base font-bold">
          Front <span id="magic-octagon-proof-front-direction">↗</span>
        </p>
        <Coin
          id="proof-front"
          title="Front view of the physically linked coin, with its marked corner"
          desc="The front-facing view of the solid coin, with a black dot on one corner and a fixed red Y-axis. Both faces and the shaded edge move together when the coin is flipped."
          showMarker
        />
      </div>
      <div id="magic-octagon-proof-other" class="w-full max-w-xs md:min-w-0 md:flex-1">
        <p class="text-center text-base font-bold">
          Flipped <span id="magic-octagon-proof-flipped-direction">↙</span>
        </p>
        <Coin
          id="proof-flipped"
          title="Flipped view of the same coin, with the same marked corner"
          desc="The opposite view of the same solid octagonal coin, showing its marked corner, gold arrow, shaded thickness and fixed Y-axis. Rotation appears reversed relative to the front."
          flipped
          showMarker
        />
      </div>
    </div>

    <div
      class="mx-auto grid w-full max-w-lg grid-cols-[1fr_1.5fr_1fr] gap-2 sm:gap-3"
      role="group"
      aria-label="Rotate or flip the coin during the explanation"
    >
      <button
        type="button"
        class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
        id="magic-octagon-left"
        aria-label="Turn the visible front view 45 degrees anticlockwise"
      >↶ 45°</button>
      <button
        type="button"
        class="btn min-w-0 px-2 text-sm sm:px-5 sm:text-base"
        id="magic-octagon-flip-button"
        aria-label="Flip the coin about the Y axis"
        aria-pressed="false"
      >Flip the coin</button>
      <button
        type="button"
        class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
        id="magic-octagon-right"
        aria-label="Turn the visible front view 45 degrees clockwise"
      >45° ↷</button>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        class="btn-toggle"
        id="magic-octagon-compare"
        aria-controls="magic-octagon-proof-other"
        aria-pressed="true"
      >
        Hide comparison
      </button>
      <button type="button" class="btn-link" id="magic-octagon-reset">Try again</button>
    </div>
    <p id="magic-octagon-state" class="text-base" aria-live="polite"></p>
  </section>

  <Fragment slot="caption">
    Redrawn for this site after the Magic Octagon demonstrated by David Masunaga in
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      Dan Meyer's 2013 account
    </ExternalLink>
    The two arrows are fixed on opposite faces of one coin.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const inspect = find<SVGSVGElement>(root, '[data-magic-coin="inspect"]')
    const puzzle = find<SVGSVGElement>(root, '[data-magic-coin="puzzle"]')
    const proofFront = find<SVGSVGElement>(root, '[data-magic-coin="proof-front"]')
    const proofFlipped = find<SVGSVGElement>(root, '[data-magic-coin="proof-flipped"]')
    const inspectSlider = find<HTMLInputElement>(root, "#magic-octagon-inspect-slider")
    const inspectState = find<HTMLElement>(root, "#magic-octagon-inspect-state")
    const guesses = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-magic-guess]"))
    const choice = find<HTMLElement>(root, "#magic-octagon-choice")
    const selectors = find<HTMLElement>(root, "#magic-octagon-selectors")
    const puzzleScrub = find<HTMLElement>(root, "#magic-octagon-puzzle-scrub")
    const puzzleSlider = find<HTMLInputElement>(root, "#magic-octagon-puzzle-slider")
    const puzzleSliderState = find<HTMLElement>(root, "#magic-octagon-puzzle-slider-state")
    const scrubHeading = find<HTMLElement>(root, "#magic-octagon-scrub-heading")
    const variations = find<HTMLElement>(root, "#magic-octagon-variations")
    const variantSliders = Array.from(
      root.querySelectorAll<HTMLInputElement>("[data-magic-variant]"),
    )
    const reveal = find<HTMLButtonElement>(root, "#magic-octagon-reveal")
    const explanation = find<HTMLElement>(root, "#magic-octagon-explanation")
    const answer = find<HTMLElement>(root, "#magic-octagon-answer")
    const proofViews = find<HTMLElement>(root, "#magic-octagon-proof-views")
    const proofOther = find<HTMLElement>(root, "#magic-octagon-proof-other")
    const proofFrontDirection = find<HTMLElement>(root, "#magic-octagon-proof-front-direction")
    const proofFlippedDirection = find<HTMLElement>(
      root,
      "#magic-octagon-proof-flipped-direction",
    )
    const left = find<HTMLButtonElement>(root, "#magic-octagon-left")
    const right = find<HTMLButtonElement>(root, "#magic-octagon-right")
    const flipButton = find<HTMLButtonElement>(root, "#magic-octagon-flip-button")
    const compareButton = find<HTMLButtonElement>(root, "#magic-octagon-compare")
    const resetButton = find<HTMLButtonElement>(root, "#magic-octagon-reset")

    const labels = [
      "up",
      "up-right",
      "right",
      "down-right",
      "down",
      "down-left",
      "left",
      "up-left",
    ]
    const symbols = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
    const wrap = (value: number) => ((value % 8) + 8) % 8
    const vertices = Array.from({ length: 8 }, (_, index) => {
      const angle = -Math.PI / 2 + (index * Math.PI) / 4
      return { x: 180 + 112 * Math.cos(angle), y: 145 + 112 * Math.sin(angle) }
    })
    const halfThickness = 16
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    // Rotate the octagon in its own plane first, then turn the entire object
    // about the *fixed picture-space Y axis*. Both surfaces and all eight edge
    // facets share exactly these rotations.
    const projection = (x: number, y: number, z: number, turn: number, flip: number) => {
      const inPlane = (turn * Math.PI) / 180
      const aboutY = (flip * Math.PI) / 180
      const dx = x - 180
      const dy = y - 145
      const localX = dx * Math.cos(inPlane) - dy * Math.sin(inPlane)
      const localY = dx * Math.sin(inPlane) + dy * Math.cos(inPlane)
      return {
        x: 180 + localX * Math.cos(aboutY) + z * Math.sin(aboutY),
        y: 145 + localY,
      }
    }

    const faceTransform = (turn: number, flip: number, z: number) => {
      const inPlane = (turn * Math.PI) / 180
      const aboutY = (flip * Math.PI) / 180
      const cosTurn = Math.cos(inPlane)
      const sinTurn = Math.sin(inPlane)
      const cosFlip = Math.cos(aboutY)
      const a = cosFlip * cosTurn
      const b = sinTurn
      const c = -cosFlip * sinTurn
      const d = cosTurn
      const e = 180 - a * 180 - c * 145 + z * Math.sin(aboutY)
      const f = 145 - b * 180 - d * 145
      return "matrix(" + [a, b, c, d, e, f].join(" ") + ")"
    }

    const drawCoin = (svg: SVGSVGElement, turn: number, flip: number) => {
      const front = svg.querySelector<SVGGElement>("[data-coin-front]")
      const flipped = svg.querySelector<SVGGElement>("[data-coin-flipped]")
      const facets = Array.from(svg.querySelectorAll<SVGPolygonElement>("[data-coin-side]"))
      if (!front || !flipped || facets.length !== 8) return

      front.setAttribute("transform", faceTransform(turn, flip, halfThickness))
      flipped.setAttribute("transform", faceTransform(turn, flip, -halfThickness))

      const faceWidth = Math.cos((flip * Math.PI) / 180)
      front.setAttribute("visibility", faceWidth > 0.015 ? "visible" : "hidden")
      flipped.setAttribute("visibility", faceWidth < -0.015 ? "visible" : "hidden")

      const spin = (turn * Math.PI) / 180
      const flipSin = Math.sin((flip * Math.PI) / 180)
      for (const [index, facet] of facets.entries()) {
        const a = vertices[index]
        const b = vertices[(index + 1) % 8]
        const midX = (a.x + b.x) / 2 - 180
        const midY = (a.y + b.y) / 2 - 145
        const outwardX = midX * Math.cos(spin) - midY * Math.sin(spin)
        // A facet is visible only when its outward normal faces the viewer.
        const visible = outwardX * flipSin < -0.01
        facet.setAttribute("visibility", visible ? "visible" : "hidden")
        if (!visible) continue
        const quad = [
          projection(a.x, a.y, halfThickness, turn, flip),
          projection(b.x, b.y, halfThickness, turn, flip),
          projection(b.x, b.y, -halfThickness, turn, flip),
          projection(a.x, a.y, -halfThickness, turn, flip),
        ]
        facet.setAttribute(
          "points",
          quad.map((point) => point.x.toFixed(3) + "," + point.y.toFixed(3)).join(" "),
        )
      }
    }

    const inspectionLabel = (degrees: number) => {
      if (degrees === 0) return "Front · 0°"
      if (degrees === 180) return "Flipped · 180°"
      if (degrees >= 85 && degrees <= 95) return "Edge-on · " + degrees + "°"
      return "Turning over · " + degrees + "°"
    }
    const updateInspection = () => {
      const degrees = Number(inspectSlider.value)
      drawCoin(inspect, 0, degrees)
      inspectState.textContent = inspectionLabel(degrees)
      inspectSlider.setAttribute("aria-valuetext", inspectionLabel(degrees))
    }

    const puzzleAngle = 45
    let guess = ""
    let proofAngle = 0
    let proofFlip = 0
    let shownAngle = 0
    let shownFlip = 0
    let comparing = true
    let frame = 0
    let puzzleFrame = 0

    const directionIndexes = (angle: number) => {
      const steps = Math.round(angle / 45)
      return { front: wrap(steps), flipped: wrap(6 - steps) }
    }

    const drawProof = () => {
      drawCoin(proofFront, shownAngle, shownFlip)
      drawCoin(proofFlipped, shownAngle, 180 - shownFlip)
    }

    const describeProof = () => {
      const result = directionIndexes(proofAngle)
      const main = proofFlip === 180 ? result.flipped : result.front
      const opposite = proofFlip === 180 ? result.front : result.flipped
      proofFrontDirection.textContent = symbols[main]
      proofFlippedDirection.textContent = symbols[opposite]
      flipButton.setAttribute("aria-pressed", String(proofFlip === 180))
      compareButton.setAttribute("aria-pressed", String(comparing))
      compareButton.textContent = comparing ? "Hide comparison" : "Compare both sides"
      proofOther.hidden = !comparing
      proofViews.classList.toggle("max-w-2xl", comparing)
      proofViews.classList.toggle("max-w-xs", !comparing)
      const frontDirection = labels[main]
      const otherDirection = labels[opposite]
      find<HTMLElement>(root, "#magic-octagon-state").textContent =
        comparing
          ? "Front: " + frontDirection + ". Flipped: " + otherDirection +
            ". The two views rotate in opposite apparent directions."
          : "Visible arrow: " + frontDirection + ". Flip or compare to inspect the other side."
    }

    const animateProof = () => {
      cancelAnimationFrame(frame)
      const startAngle = shownAngle
      const startFlip = shownFlip
      const duration = startFlip !== proofFlip ? 1800 : 320
      describeProof()
      if (reducedMotion.matches) {
        shownAngle = proofAngle
        shownFlip = proofFlip
        drawProof()
        return
      }
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const progress = Math.min(1, (now - started) / duration)
        const eased = progress * progress * (3 - 2 * progress)
        shownAngle = startAngle + (proofAngle - startAngle) * eased
        shownFlip = startFlip + (proofFlip - startFlip) * eased
        drawProof()
        if (progress < 1) frame = requestAnimationFrame(tick)
      }
      frame = requestAnimationFrame(tick)
    }

    for (const option of guesses) {
      option.addEventListener("click", () => {
        guess = option.dataset.magicGuess ?? ""
        for (const button of guesses) {
          const selected = button === option
          button.dataset.selected = String(selected)
          button.setAttribute("aria-pressed", String(selected))
        }
        choice.textContent = "Selected: " + guess + "."
        reveal.disabled = false
      })
    }

    const updatePuzzleFlip = (degrees: number) => {
      drawCoin(puzzle, puzzleAngle, degrees)
      const rounded = Math.round(degrees)
      puzzleSlider.value = String(rounded)
      const label = inspectionLabel(rounded)
      puzzleSliderState.textContent = label
      puzzleSlider.setAttribute("aria-valuetext", label)
    }

    // The answer animation flips the SAME puzzle coin, then leaves the slider
    // available for direct inspection; it does not switch to a different image.
    const animatePuzzleReveal = () => {
      cancelAnimationFrame(puzzleFrame)
      puzzleSlider.disabled = true
      if (reducedMotion.matches) {
        updatePuzzleFlip(180)
        puzzleSlider.disabled = false
        return
      }
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const progress = Math.min(1, (now - started) / 1800)
        const eased = progress * progress * (3 - 2 * progress)
        updatePuzzleFlip(180 * eased)
        if (progress < 1) {
          puzzleFrame = requestAnimationFrame(tick)
        } else {
          puzzleSlider.disabled = false
        }
      }
      puzzleFrame = requestAnimationFrame(tick)
    }

    for (const slider of variantSliders) {
      const turn = Number(slider.dataset.magicVariant)
      const svg = find<SVGSVGElement>(
        root,
        '[data-magic-coin="variant-' + turn + '"]',
      )
      const state = find<HTMLElement>(
        root,
        "#magic-octagon-variant-state-" + turn,
      )
      const update = () => {
        const degrees = Number(slider.value)
        drawCoin(svg, turn, degrees)
        const label = inspectionLabel(degrees)
        state.textContent = label
        slider.setAttribute("aria-valuetext", label)
      }
      slider.addEventListener("input", update)
      update()
    }

    puzzleSlider.addEventListener("input", () => {
      cancelAnimationFrame(puzzleFrame)
      updatePuzzleFlip(Number(puzzleSlider.value))
    })

    reveal.addEventListener("click", () => {
      if (!guess) return
      cancelAnimationFrame(frame)
      proofAngle = puzzleAngle
      proofFlip = 0
      shownAngle = proofAngle
      shownFlip = 0
      comparing = true
      const expected = labels[directionIndexes(puzzleAngle).flipped]
      answer.textContent =
        "You chose " + guess + ". When flipped, the hidden arrow points " +
        expected + (guess === expected ? " — correct." : ".")
      selectors.hidden = true
      choice.hidden = true
      reveal.hidden = true
      puzzleScrub.hidden = false
      variations.hidden = false
      explanation.hidden = false
      drawProof()
      describeProof()
      scrubHeading.focus()
      animatePuzzleReveal()
    })

    const turnProof = (amount: number) => {
      answer.hidden = true
      proofAngle += proofFlip === 180 ? -amount : amount
      animateProof()
    }
    left.addEventListener("click", () => turnProof(-45))
    right.addEventListener("click", () => turnProof(45))
    flipButton.addEventListener("click", () => {
      answer.hidden = true
      proofFlip = proofFlip === 180 ? 0 : 180
      animateProof()
    })
    compareButton.addEventListener("click", () => {
      comparing = !comparing
      describeProof()
    })
    resetButton.addEventListener("click", () => {
      cancelAnimationFrame(frame)
      cancelAnimationFrame(puzzleFrame)
      explanation.hidden = true
      variations.hidden = true
      puzzleScrub.hidden = true
      selectors.hidden = false
      choice.hidden = false
      reveal.hidden = false
      puzzleSlider.disabled = true
      guess = ""
      for (const option of guesses) {
        option.dataset.selected = "false"
        option.setAttribute("aria-pressed", "false")
      }
      choice.textContent = "Select a corner of the coin to predict where the arrow will point."
      reveal.disabled = true
      updatePuzzleFlip(0)
      guesses[0]?.focus()
    })

    inspectSlider.addEventListener("input", updateInspection)
    updateInspection()
    drawCoin(puzzle, puzzleAngle, 0)
    drawProof()
    describeProof()
  }
</script>
