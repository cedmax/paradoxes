---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, series, stroke } from "~/data/palette"

const corners = Array.from({ length: 8 }, (_, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI) / 4
  return (
    (180 + 112 * Math.cos(angle)).toFixed(2) + "," + (145 + 112 * Math.sin(angle)).toFixed(2)
  )
}).join(" ")
---

<IllustrationFigure name="magic-octagon" lead="Where will the arrow point when flipped?">
  <p id="magic-octagon-stage-label" class="mono-label">Step 1 of 2 · The puzzle</p>
  <p id="magic-octagon-setup-note" class="text-base">
    First, study both views of the coin. The front arrow points up; the flipped
    arrow points left. Remember both before trying the puzzle.
  </p>

  <div
    id="magic-octagon-views"
    class="mx-auto flex w-full max-w-2xl flex-col items-center justify-center gap-2 md:flex-row md:items-start md:gap-5"
  >
    <div class="w-full max-w-xs md:min-w-0 md:flex-1">
      <p class="text-center text-base font-bold">
        Front <span id="magic-octagon-face">↑</span>
      </p>
      <SvgFigure
        name="magic-octagon-main"
        viewBox="0 0 360 290"
        class="w-full"
        title="A two-sided octagonal coin"
        desc="A two-sided octagon with a blue arrow pointing up on one side. A red dashed vertical line marks the fixed axis about which the coin is flipped. The opposite side can be shown alongside it."
      >
        <g id="magic-octagon-flip">
          <g id="magic-octagon-turn">
            <polygon
              points={corners}
              fill={illusionSurface.paper}
              stroke={stroke}
              stroke-width="3"
              stroke-linejoin="round"
            />
            <g
              id="magic-octagon-front"
              fill="none"
              stroke={series.blue}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-back"
              visibility="hidden"
              fill="none"
              stroke={series.gold}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <circle
              id="magic-octagon-marker"
              cx="180"
              cy="47"
              r="5"
              fill={stroke}
              visibility="hidden"
            />
          </g>
        </g>
        <!-- Fixed to the picture; unlike the coin, this axis never rotates. -->
        <g aria-hidden="true">
          <line
            x1="180"
            y1="10"
            x2="180"
            y2="277"
            stroke={series.red}
            stroke-width="2.5"
            stroke-dasharray="7 6"
          />
          <text x="192" y="277" fill={series.red} font-size="15" font-weight="600">
            Y · flip axis
          </text>
        </g>
      </SvgFigure>
    </div>

    <div id="magic-octagon-other" class="w-full max-w-xs md:min-w-0 md:flex-1">
      <p class="text-center text-base font-bold">
        Flipped <span id="magic-octagon-other-face">←</span>
      </p>
      <SvgFigure
        name="magic-octagon-other-svg"
        viewBox="0 0 360 290"
        class="w-full"
        title="The flipped view of the same octagonal coin"
        desc="The same octagon viewed from the flipped side, with a gold arrow pointing left. A red dashed vertical line marks the fixed flip axis."
      >
        <g
          id="magic-octagon-other-mirror"
          transform="translate(180 145) scale(-1 1) translate(-180 -145)"
        >
          <g id="magic-octagon-other-turn">
            <polygon
              points={corners}
              fill={illusionSurface.paper}
              stroke={stroke}
              stroke-width="3"
              stroke-linejoin="round"
            />
            <g
              id="magic-octagon-other-front"
              visibility="hidden"
              fill="none"
              stroke={series.blue}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-other-back"
              fill="none"
              stroke={series.gold}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <circle
              id="magic-octagon-other-marker"
              cx="180"
              cy="47"
              r="5"
              fill={stroke}
              visibility="hidden"
            />
          </g>
        </g>
        <!-- Fixed to the picture; unlike the coin, this axis never rotates. -->
        <g aria-hidden="true">
          <line
            x1="180"
            y1="10"
            x2="180"
            y2="277"
            stroke={series.red}
            stroke-width="2.5"
            stroke-dasharray="7 6"
          />
          <text x="192" y="277" fill={series.red} font-size="15" font-weight="600">
            Y · flip axis
          </text>
        </g>
      </SvgFigure>
    </div>
  </div>

  <p class="text-base">
    The <span class="font-bold text-series-red">red dashed line</span> marks
    the vertical (Y) axis. Flipping means turning the coin over around this
    line, like turning a page. The line stays upright even after a 45° turn.
  </p>

  <div id="magic-octagon-start-controls" class="flex flex-wrap items-center gap-3">
    <button id="magic-octagon-start" type="button" class="btn">
      Try the puzzle
    </button>
  </div>

  <div id="magic-octagon-challenge" class="flex flex-col gap-4" hidden>
    <p class="text-base">
      Now only the front is visible. Turn it 45° in either direction. Then imagine
      turning the coin over around the red dashed Y axis, like turning a page.
      Which way will the hidden arrow point?
    </p>
    <div
      class="flex flex-wrap gap-3"
      role="group"
      aria-label="Choose a 45-degree turn"
    >
      <button
        type="button"
        class="btn-toggle"
        id="magic-octagon-puzzle-left"
        aria-pressed="false"
      >
        ↶ 45° anticlockwise
      </button>
      <button
        type="button"
        class="btn-toggle"
        id="magic-octagon-puzzle-right"
        aria-pressed="false"
      >
        45° clockwise ↷
      </button>
    </div>
    <p id="magic-octagon-puzzle-status" class="text-base" aria-live="polite">
      Choose a turn to begin.
    </p>
    <div id="magic-octagon-prediction" class="flex flex-col gap-3" hidden>
      <p class="font-bold">
        After the flip, where will the arrow point?
      </p>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Predict the arrow direction">
        <button type="button" class="btn-toggle" data-magic-guess="up-left" aria-pressed="false">
          ↖ Up-left
        </button>
        <button type="button" class="btn-toggle" data-magic-guess="up-right" aria-pressed="false">
          ↗ Up-right
        </button>
        <button type="button" class="btn-toggle" data-magic-guess="down-left" aria-pressed="false">
          ↙ Down-left
        </button>
        <button type="button" class="btn-toggle" data-magic-guess="down-right" aria-pressed="false">
          ↘ Down-right
        </button>
      </div>
      <button
        id="magic-octagon-reveal"
        type="button"
        class="btn self-start disabled:cursor-not-allowed disabled:opacity-50"
        disabled
      >
        Show answer and explanation
      </button>
    </div>
    <button id="magic-octagon-challenge-reset" type="button" class="btn-link self-start">
      Start again
    </button>
  </div>

  <div id="magic-octagon-explanation" class="flex flex-col gap-4" hidden>
    <h2 id="magic-octagon-explanation-heading" tabindex="-1" class="font-bold">
      What happens
    </h2>
    <p id="magic-octagon-answer" class="text-base" aria-live="polite"></p>
    <p class="text-base">
      Both views now show the same turned coin. The black dots mark the same
      physical corner, making the reversal easier to follow. The red Y axis
      stays fixed as the coin turns. Use the controls to rotate or flip it.
    </p>
    <div
      class="mx-auto grid w-full max-w-lg grid-cols-[1fr_1.5fr_1fr] gap-2 sm:gap-3"
      role="group"
    aria-label="Turn or flip the coin"
  >
    <button
      type="button"
      class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-left"
      aria-label="Turn the visible face 45 degrees anticlockwise"
    >
      ↶ 45°
    </button>
    <button
      type="button"
      class="btn min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-flip-button"
      aria-label="Flip the coin to the other face"
      aria-pressed="false"
    >
      Flip the coin
    </button>
    <button
      type="button"
      class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-right"
      aria-label="Turn the visible face 45 degrees clockwise"
    >
      45° ↷
    </button>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        class="btn-toggle"
        id="magic-octagon-compare"
      aria-controls="magic-octagon-other"
      aria-pressed="false"
    >
      Compare both sides
    </button>
    <button type="button" class="btn-link" id="magic-octagon-reset">
      Try again
    </button>
    </div>

    <p id="magic-octagon-state" class="text-base" aria-live="polite">
    Front arrow: up. Turn, predict, then flip the coin.
  </p>
  <p id="magic-octagon-compare-note" class="text-base" hidden>
    Front and Flipped name two opposite viewpoints of the same coin, not the colour of the arrow
    currently visible. Turn clockwise in Front and it looks anticlockwise in Flipped. Flip the
    coin to exchange which arrow each view sees.
  </p>

  </div>

  <Fragment slot="caption">
    Redrawn for this site after the Magic Octagon demonstrated by David Masunaga in
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      Dan Meyer's 2013 account
    </ExternalLink>
    The two arrows are fixed on opposite faces of one coin.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const stageLabel = find<HTMLElement>(root, "#magic-octagon-stage-label")
    const views = find<HTMLElement>(root, "#magic-octagon-views")
    const other = find<HTMLElement>(root, "#magic-octagon-other")
    const setupNote = find<HTMLElement>(root, "#magic-octagon-setup-note")
    const startControls = find<HTMLElement>(root, "#magic-octagon-start-controls")
    const startButton = find<HTMLButtonElement>(root, "#magic-octagon-start")
    const challenge = find<HTMLElement>(root, "#magic-octagon-challenge")
    const puzzleLeft = find<HTMLButtonElement>(root, "#magic-octagon-puzzle-left")
    const puzzleRight = find<HTMLButtonElement>(root, "#magic-octagon-puzzle-right")
    const prediction = find<HTMLElement>(root, "#magic-octagon-prediction")
    const puzzleStatus = find<HTMLElement>(root, "#magic-octagon-puzzle-status")
    const guesses = Array.from(
      root.querySelectorAll<HTMLButtonElement>("button[data-magic-guess]"),
    )
    const revealButton = find<HTMLButtonElement>(root, "#magic-octagon-reveal")
    const challengeReset = find<HTMLButtonElement>(root, "#magic-octagon-challenge-reset")
    const explanation = find<HTMLElement>(root, "#magic-octagon-explanation")
    const explanationHeading = find<HTMLElement>(root, "#magic-octagon-explanation-heading")
    const answer = find<HTMLElement>(root, "#magic-octagon-answer")
    const left = find<HTMLButtonElement>(root, "#magic-octagon-left")
    const right = find<HTMLButtonElement>(root, "#magic-octagon-right")
    const flipButton = find<HTMLButtonElement>(root, "#magic-octagon-flip-button")
    const compareButton = find<HTMLButtonElement>(root, "#magic-octagon-compare")
    const resetButton = find<HTMLButtonElement>(root, "#magic-octagon-reset")
    const faceLabel = find<HTMLElement>(root, "#magic-octagon-face")
    const otherFaceLabel = find<HTMLElement>(root, "#magic-octagon-other-face")
    const status = find<HTMLElement>(root, "#magic-octagon-state")
    const compareNote = find<HTMLElement>(root, "#magic-octagon-compare-note")
    const flipGroup = find<SVGGElement>(root, "#magic-octagon-flip")
    const turnGroup = find<SVGGElement>(root, "#magic-octagon-turn")
    const front = find<SVGGElement>(root, "#magic-octagon-front")
    const back = find<SVGGElement>(root, "#magic-octagon-back")
    const otherMirror = find<SVGGElement>(root, "#magic-octagon-other-mirror")
    const otherTurn = find<SVGGElement>(root, "#magic-octagon-other-turn")
    const otherFront = find<SVGGElement>(root, "#magic-octagon-other-front")
    const otherBack = find<SVGGElement>(root, "#magic-octagon-other-back")
    const marker = find<SVGCircleElement>(root, "#magic-octagon-marker")
    const otherMarker = find<SVGCircleElement>(root, "#magic-octagon-other-marker")

    const directions = [
      "up",
      "up-right",
      "right",
      "down-right",
      "down",
      "down-left",
      "left",
      "up-left",
    ]
    const symbols = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
    const wrap = (value: number) => ((value % 8) + 8) % 8
    const scaleAroundCentre = (factor: number) =>
      "translate(180 145) scale(" + factor + " 1) translate(-180 -145)"

    type Stage = "setup" | "challenge" | "explanation"
    let stage: Stage = "setup"
    let angle = 0
    let flipped = false
    let comparing = false
    let guess = ""
    let displayedAngle = 0
    let displayedFlip = 0
    let frame = 0
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    const faces = () => {
      const steps = Math.round(angle / 45)
      return { front: wrap(steps), flipped: wrap(6 - steps) }
    }

    const showStage = () => {
      stageLabel.textContent = stage === "explanation"
        ? "Step 2 of 2 · The explanation"
        : "Step 1 of 2 · The puzzle"
      setupNote.hidden = stage !== "setup"
      startControls.hidden = stage !== "setup"
      challenge.hidden = stage !== "challenge"
      explanation.hidden = stage !== "explanation"
      // The corner dots are the proof, so don't reveal them during the puzzle.
      const markerVisibility = stage === "explanation" ? "visible" : "hidden"
      marker.setAttribute("visibility", markerVisibility)
      otherMarker.setAttribute("visibility", markerVisibility)
      // The initial pair is only a reference. Hide the answer in the puzzle.
      const showOther = stage === "setup" || (stage === "explanation" && comparing)
      other.hidden = !showOther
      views.classList.toggle("max-w-xs", !showOther)
      views.classList.toggle("max-w-2xl", showOther)
      compareNote.hidden = !(stage === "explanation" && comparing)
    }

    const draw = () => {
      const width = Math.cos((displayedFlip * Math.PI) / 180)
      const showingBack = displayedFlip > 90
      flipGroup.setAttribute("transform", scaleAroundCentre(width))
      turnGroup.setAttribute("transform", "rotate(" + displayedAngle + " 180 145)")
      front.setAttribute("visibility", showingBack ? "hidden" : "visible")
      back.setAttribute("visibility", showingBack ? "visible" : "hidden")

      // The second view is the SAME physical coin, seen from the other side.
      // Its complementary flip angle makes both drawings animate together.
      const otherFlip = 180 - displayedFlip
      const otherWidth = Math.cos((otherFlip * Math.PI) / 180)
      const otherShowingBack = otherFlip > 90
      otherMirror.setAttribute("transform", scaleAroundCentre(otherWidth))
      otherTurn.setAttribute("transform", "rotate(" + displayedAngle + " 180 145)")
      otherFront.setAttribute("visibility", otherShowingBack ? "hidden" : "visible")
      otherBack.setAttribute("visibility", otherShowingBack ? "visible" : "hidden")
    }

    const describe = () => {
      const result = faces()
      const mainIndex = flipped ? result.flipped : result.front
      const otherIndex = flipped ? result.front : result.flipped
      // These headings refer to viewpoints and never swap their names.
      faceLabel.textContent = symbols[mainIndex]
      otherFaceLabel.textContent = symbols[otherIndex]

      if (stage !== "explanation") return
      flipButton.setAttribute("aria-pressed", String(flipped))
      compareButton.setAttribute("aria-pressed", String(comparing))
      compareButton.textContent = comparing ? "Hide comparison" : "Compare both sides"

      const difference = wrap(result.flipped - result.front)
      const relation =
        difference === 0
          ? "The two arrows appear aligned."
          : difference === 4
            ? "The arrows appear to point in opposite directions."
            : difference === 2 || difference === 6
              ? "The arrows appear at right angles."
              : "The arrows point in different directions."
      if (comparing) {
        status.textContent =
          "Front view: " + directions[mainIndex] +
          ". Flipped view: " + directions[otherIndex] + ". " + relation
      } else {
        status.textContent =
          "Visible arrow: " + directions[mainIndex] +
          ". Flip the coin or compare both sides to check the other arrow."
      }
    }

    const animate = () => {
      cancelAnimationFrame(frame)
      const targetFlip = flipped ? 180 : 0
      const initialAngle = displayedAngle
      const initialFlip = displayedFlip
      describe()
      if (reducedMotion.matches) {
        displayedAngle = angle
        displayedFlip = targetFlip
        draw()
        return
      }
      const duration = initialFlip !== targetFlip ? 500 : 250
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const t = Math.min(1, (now - started) / duration)
        const eased = t * t * (3 - 2 * t)
        displayedAngle = initialAngle + (angle - initialAngle) * eased
        displayedFlip = initialFlip + (targetFlip - initialFlip) * eased
        draw()
        if (t < 1) frame = requestAnimationFrame(tick)
      }
      frame = requestAnimationFrame(tick)
    }

    const chooseTurn = (nextAngle: number) => {
      angle = nextAngle
      flipped = false
      guess = ""
      for (const button of guesses) button.setAttribute("aria-pressed", "false")
      puzzleLeft.setAttribute("aria-pressed", String(nextAngle === -45))
      puzzleRight.setAttribute("aria-pressed", String(nextAngle === 45))
      prediction.hidden = false
      revealButton.disabled = true
      puzzleStatus.textContent =
        "The front now points " + directions[faces().front] + ". Make your prediction."
      animate()
    }

    const startOver = () => {
      cancelAnimationFrame(frame)
      stage = "setup"
      angle = 0
      flipped = false
      comparing = false
      guess = ""
      displayedAngle = 0
      displayedFlip = 0
      puzzleLeft.setAttribute("aria-pressed", "false")
      puzzleRight.setAttribute("aria-pressed", "false")
      for (const button of guesses) button.setAttribute("aria-pressed", "false")
      prediction.hidden = true
      revealButton.disabled = true
      answer.hidden = false
      answer.textContent = ""
      puzzleStatus.textContent = "Choose a turn to begin."
      showStage()
      draw()
      describe()
      startButton.focus()
    }

    startButton.addEventListener("click", () => {
      stage = "challenge"
      showStage()
      puzzleLeft.focus()
    })
    puzzleLeft.addEventListener("click", () => chooseTurn(-45))
    puzzleRight.addEventListener("click", () => chooseTurn(45))
    for (const button of guesses) {
      button.addEventListener("click", () => {
        guess = button.dataset.magicGuess ?? ""
        for (const option of guesses)
          option.setAttribute("aria-pressed", String(option === button))
        revealButton.disabled = false
      })
    }
    revealButton.addEventListener("click", () => {
      if (!guess) return
      stage = "explanation"
      comparing = true
      flipped = false
      const result = faces()
      const expected = directions[result.flipped]
      answer.hidden = false
      answer.textContent =
        "You predicted " + guess + ". After the vertical flip, the arrow points " +
        expected + (guess === expected ? " — correct." : ". The prediction was different.")
      showStage()
      describe()
      explanationHeading.focus()
    })

    // The explanation keeps the existing linked front/flipped interaction.
    const turn = (amount: number) => {
      answer.hidden = true
      angle += flipped ? -amount : amount
      animate()
    }
    left.addEventListener("click", () => turn(-45))
    right.addEventListener("click", () => turn(45))
    flipButton.addEventListener("click", () => {
      answer.hidden = true
      flipped = !flipped
      animate()
    })
    compareButton.addEventListener("click", () => {
      comparing = !comparing
      showStage()
      describe()
    })
    resetButton.addEventListener("click", startOver)
    challengeReset.addEventListener("click", startOver)
    showStage()
    draw()
    describe()
  }
</script>
