---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import MeasurementGuides from "~/components/illustration-kit/MeasurementGuides.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, series, stroke } from "~/data/palette"

const cx = 240
const cy = 157
const radius = 106
const corners = Array.from({ length: 8 }, (_, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI) / 4
  return `${(cx + radius * Math.cos(angle)).toFixed(2)},${(cy + radius * Math.sin(angle)).toFixed(2)}`
}).join(" ")
---

<IllustrationFigure
  name="magic-octagon"
  lead="Where will the arrow on the back point after a 45° turn and a flip?"
>
  <p class="text-base">
    The front arrow points up. When the coin is flipped about its vertical axis, the back
    arrow points left. Choose a turn, then predict what that back arrow will do.
  </p>
  <SvgFigure
    name="magic-octagon"
    viewBox="0 0 480 320"
    class="mx-auto w-full max-w-md"
    title="Two-sided octagon that can turn and flip"
    desc="The front has an arrow pointing up at the starting position. Flipping about a vertical axis reveals an arrow on the back that initially points left. Select a clockwise or anticlockwise 45-degree turn, choose a prediction, then move the flip slider. The back arrow moves with the same coin and is reflected across the vertical flip axis."
  >
    <text
      id="magic-octagon-face-label"
      x="240"
      y="25"
      font-size="17"
      fill={stroke}
      text-anchor="middle"
    >
      Front
    </text>
    <g id="magic-octagon-flip">
      <g id="magic-octagon-turn">
        <polygon
          points={corners}
          fill={illusionSurface.paper}
          stroke={stroke}
          stroke-width="3"
          stroke-linejoin="round"
        />
        <g
          id="magic-octagon-front"
          fill="none"
          stroke={series.blue}
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M240 200 V107 M219 128 L240 107 L261 128" />
          <circle cx="240" cy="57" r="5" fill={series.blue} stroke="none" />
        </g>
        <g
          id="magic-octagon-back"
          visibility="hidden"
          fill="none"
          stroke={series.gold}
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M195 157 H289 M267 135 L289 157 L267 179" />
        </g>
      </g>
    </g>
    <MeasurementGuides name="magic-octagon" d="M240 35 V280" />
    <text
      id="magic-octagon-turn-label"
      x="240"
      y="304"
      font-size="16"
      fill={stroke}
      text-anchor="middle"
    >
      Starting position
    </text>
  </SvgFigure>
  <div id="magic-octagon-start" class="flex flex-wrap items-center gap-3">
    <button id="magic-octagon-start-flip" type="button" class="btn-ghost" aria-pressed="false">
      Check the starting back
    </button>
    <p id="magic-octagon-start-note" class="text-base" aria-live="polite">
      Start with the front arrow pointing up.
    </p>
  </div>

  <div role="group" aria-label="Choose the direction of the 45-degree turn" class="flex flex-wrap gap-3">
    <button type="button" class="btn-toggle" data-turn="45" aria-pressed="false">
      45° clockwise
    </button>
    <button type="button" class="btn-toggle" data-turn="-45" aria-pressed="false">
      45° anticlockwise
    </button>
  </div>

  <div id="magic-octagon-prediction" class="flex flex-col gap-3" hidden>
    <p class="font-bold">
      After flipping about the vertical axis, where will the back arrow point?
    </p>
    <div role="group" aria-label="Predict the back arrow's direction" class="flex flex-wrap gap-3">
      <button class="btn-toggle" type="button" data-answer="up-left" aria-pressed="false">
        Up-left
      </button>
      <button class="btn-toggle" type="button" data-answer="up-right" aria-pressed="false">
        Up-right
      </button>
      <button class="btn-toggle" type="button" data-answer="down-left" aria-pressed="false">
        Down-left
      </button>
      <button class="btn-toggle" type="button" data-answer="down-right" aria-pressed="false">
        Down-right
      </button>
    </div>
  </div>

  <div id="magic-octagon-reveal" class="flex flex-col gap-4" hidden>
    <Slider
      id="magic-octagon-flip-slider"
      label="Flip the octagon"
      min={0}
      max={100}
      step={1}
      value={0}
      startLabel="Front"
      endLabel="Back"
      describedby="magic-octagon-flip-readout"
      valuetext="Front face, not yet flipped"
    >
      <p id="magic-octagon-flip-readout" class="text-base" aria-live="polite">
        The front face is showing. Move the slider to turn it over.
      </p>
    </Slider>
    <p id="magic-octagon-result" class="font-bold" aria-live="polite" hidden></p>
    <IllusionControls
      name="magic-octagon"
      play={false}
      proofLabel="Show flip axis"
      proof="The red line is the vertical axis used to flip the coin. The back arrow's direction reverses horizontally when the coin turns over. The arrows stay 90° apart on the two faces of the coin."
    />
  </div>
  <Fragment slot="caption">
    A new, two-sided SVG reconstruction of the arrow puzzle. The arrows do not move
    independently: the whole coin turns and flips. Based on the Magic Octagon demonstrated by
    David Masunaga in a{" "}
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      2013 video
    </ExternalLink>
  </Fragment>
</IllustrationFigure>

<script>
  import { bindIllusionProof, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const turnButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-turn]"))
    const answers = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-answer]"))
    const start = find<HTMLElement>(root, "#magic-octagon-start")
    const startFlip = find<HTMLButtonElement>(root, "#magic-octagon-start-flip")
    const startNote = find<HTMLElement>(root, "#magic-octagon-start-note")
    const prediction = find<HTMLElement>(root, "#magic-octagon-prediction")
    const reveal = find<HTMLElement>(root, "#magic-octagon-reveal")
    const slider = find<HTMLInputElement>(root, "#magic-octagon-flip-slider")
    const flip = find<SVGGElement>(root, "#magic-octagon-flip")
    const rotate = find<SVGGElement>(root, "#magic-octagon-turn")
    const front = find<SVGGElement>(root, "#magic-octagon-front")
    const back = find<SVGGElement>(root, "#magic-octagon-back")
    const faceLabel = find<SVGTextElement>(root, "#magic-octagon-face-label")
    const turnLabel = find<SVGTextElement>(root, "#magic-octagon-turn-label")
    const readout = find<HTMLElement>(root, "#magic-octagon-flip-readout")
    const result = find<HTMLElement>(root, "#magic-octagon-result")
    const axisButton = find<HTMLButtonElement>(root, "#magic-octagon-guide-toggle")
    const axisGuides = find<SVGGElement>(root, "#magic-octagon-guides")
    const axisProof = find<HTMLElement>(root, "#magic-octagon-proof")
    let angle = 0
    let guess = ""
    let startingBack = false

    const render = () => {
      const progress = angle === 0 && startingBack ? 100 : Number(slider.value)
      const onBack = progress >= 50
      // Rotate in the plane first, then reflect in a fixed vertical axis. The outer
      // horizontal scaling projects a rigid flip around that axis onto the screen.
      const width = Math.cos((Math.PI * progress) / 100)
      rotate.setAttribute("transform", `rotate(${angle} 240 157)`)
      flip.setAttribute("transform", `translate(240 157) scale(${width} 1) translate(-240 -157)`)
      front.setAttribute("visibility", onBack ? "hidden" : "visible")
      back.setAttribute("visibility", onBack ? "visible" : "hidden")
      faceLabel.textContent = onBack ? "Back" : "Front"

      const direction = angle === 45 ? "down-left" : angle === -45 ? "up-left" : "left"
      const message =
        progress === 0
          ? "Front face. Move the slider to flip around the vertical axis."
          : progress === 100
            ? `Back face. The arrow points ${direction}.`
            : `Coin ${progress}% of the way through its vertical flip.`
      readout.textContent = message
      slider.setAttribute("aria-valuetext", message)
      result.hidden = angle === 0 || progress !== 100
      if (progress === 100) {
        const frontDirection = angle === 45 ? "up-right" : "up-left"
        const relation = angle === 45 ? "in opposite directions" : "in the same direction"
        result.textContent =
          `You chose ${guess}. The back arrow points ${direction}, ${guess === direction ? "so your prediction was right" : "not as you predicted"}. The front points ${frontDirection}: the two arrows point ${relation} when viewed in turn.`
      }
    }

    const resetProof = () => {
      axisButton.setAttribute("aria-pressed", "false")
      axisButton.textContent = "Show flip axis"
      axisGuides.setAttribute("visibility", "hidden")
      axisProof.hidden = true
    }

    startFlip.addEventListener("click", () => {
      startingBack = !startingBack
      startFlip.setAttribute("aria-pressed", String(startingBack))
      startFlip.textContent = startingBack ? "Return to the front" : "Check the starting back"
      startNote.textContent = startingBack
        ? "The starting back arrow points left. Return to the front or choose a 45° turn."
        : "The front arrow points up."
      render()
    })

    for (const button of turnButtons) {
      button.addEventListener("click", () => {
        angle = Number(button.dataset.turn)
        startingBack = false
        start.hidden = true
        guess = ""
        slider.value = "0"
        for (const other of turnButtons)
          other.setAttribute("aria-pressed", String(other === button))
        for (const answer of answers) answer.setAttribute("aria-pressed", "false")
        turnLabel.textContent = angle === 45 ? "Turned 45° clockwise" : "Turned 45° anticlockwise"
        prediction.hidden = false
        reveal.hidden = true
        resetProof()
        render()
      })
    }
    for (const button of answers) {
      button.addEventListener("click", () => {
        guess = button.dataset.answer ?? ""
        for (const answer of answers)
          answer.setAttribute("aria-pressed", String(answer === button))
        slider.value = "0"
        reveal.hidden = false
        resetProof()
        render()
      })
    }
    slider.addEventListener("input", render)
    bindIllusionProof(root, "magic-octagon", "Show flip axis", "Hide flip axis")
    render()
  }
</script>
