---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, series, stroke } from "~/data/palette"

const corners = Array.from({ length: 8 }, (_, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI) / 4
  return (
    (180 + 112 * Math.cos(angle)).toFixed(2) +
    "," +
    (145 + 112 * Math.sin(angle)).toFixed(2)
  )
}).join(" ")
---

<IllustrationFigure name="magic-octagon" lead="Where will the arrow on the back point?">
  <p class="text-base">
    The front starts pointing up. Turn the octagon 45°, predict the back, then
    flip to check. Compare both sides to watch what happens to both arrows.
  </p>

  <div
    id="magic-octagon-views"
    class="mx-auto flex w-full max-w-sm items-start justify-center gap-2 sm:gap-5"
  >
    <div class="min-w-0 flex-1">
      <p id="magic-octagon-face" class="text-center text-base font-bold">Front ↑</p>
      <SvgFigure
        name="magic-octagon-main"
        viewBox="0 0 360 290"
        class="w-full"
        title="A two-sided octagonal coin"
        desc="A coin with a blue arrow on the front, a gold arrow on the back and a dot marking one physical corner. The coin turns and flips. A separate view of the other face can be shown beside it."
      >
        <g id="magic-octagon-flip">
          <g id="magic-octagon-turn">
            <polygon
              points={corners}
              fill={illusionSurface.paper}
              stroke={stroke}
              stroke-width="3"
              stroke-linejoin="round"
            />
            <g
              id="magic-octagon-front"
              fill="none"
              stroke={series.blue}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-back"
              visibility="hidden"
              fill="none"
              stroke={series.gold}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <circle cx="180" cy="47" r="5" fill={stroke} />
          </g>
        </g>
      </SvgFigure>
    </div>

    <div id="magic-octagon-other" class="min-w-0 flex-1" hidden>
      <p id="magic-octagon-other-face" class="text-center text-base font-bold">Back ←</p>
      <SvgFigure
        name="magic-octagon-other-svg"
        viewBox="0 0 360 290"
        class="w-full"
        title="The other face of the octagonal coin"
        desc="A second view of the same octagonal coin, shown as though flipped about the fixed vertical axis. Both views update when either turn button is used."
      >
        <g id="magic-octagon-other-mirror">
          <g id="magic-octagon-other-turn">
            <polygon
              points={corners}
              fill={illusionSurface.paper}
              stroke={stroke}
              stroke-width="3"
              stroke-linejoin="round"
            />
            <g
              id="magic-octagon-other-front"
              visibility="hidden"
              fill="none"
              stroke={series.blue}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-other-back"
              fill="none"
              stroke={series.gold}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <circle cx="180" cy="47" r="5" fill={stroke} />
          </g>
        </g>
      </SvgFigure>
    </div>
  </div>

  <div
    class="mx-auto grid w-full max-w-lg grid-cols-[1fr_1.5fr_1fr] gap-2 sm:gap-3"
    role="group"
    aria-label="Turn or flip the coin"
  >
    <button
      type="button"
      class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-left"
      aria-label="Turn the visible face 45 degrees anticlockwise"
    >
      ↶ 45°
    </button>
    <button
      type="button"
      class="btn min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-flip-button"
      aria-label="Flip the coin to the other face"
      aria-pressed="false"
    >
      Flip the coin
    </button>
    <button
      type="button"
      class="btn-ghost min-w-0 px-2 text-sm sm:px-5 sm:text-base"
      id="magic-octagon-right"
      aria-label="Turn the visible face 45 degrees clockwise"
    >
      45° ↷
    </button>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      class="btn-toggle"
      id="magic-octagon-compare"
      aria-controls="magic-octagon-other"
      aria-pressed="false"
    >
      Compare both sides
    </button>
    <button type="button" class="btn-link" id="magic-octagon-reset">Reset</button>
  </div>

  <p id="magic-octagon-state" class="text-base" aria-live="polite">
    Front arrow: up. Turn, predict, then flip the coin.
  </p>
  <p id="magic-octagon-compare-note" class="text-base" hidden>
    Both views show the same coin, with each side facing you after a flip about
    the fixed vertical axis. As the coin turns, the two arrows rotate in opposite
    directions on screen because one face is mirrored.
  </p>

  <Fragment slot="caption">
    Redrawn for this site after the Magic Octagon demonstrated by David Masunaga in
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      Dan Meyer's 2013 account
    </ExternalLink>
    Both arrows are fixed on the same physical coin.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const views = find<HTMLElement>(root, "#magic-octagon-views")
    const other = find<HTMLElement>(root, "#magic-octagon-other")
    const left = find<HTMLButtonElement>(root, "#magic-octagon-left")
    const right = find<HTMLButtonElement>(root, "#magic-octagon-right")
    const flipButton = find<HTMLButtonElement>(root, "#magic-octagon-flip-button")
    const compareButton = find<HTMLButtonElement>(root, "#magic-octagon-compare")
    const resetButton = find<HTMLButtonElement>(root, "#magic-octagon-reset")
    const faceLabel = find<HTMLElement>(root, "#magic-octagon-face")
    const otherFaceLabel = find<HTMLElement>(root, "#magic-octagon-other-face")
    const status = find<HTMLElement>(root, "#magic-octagon-state")
    const compareNote = find<HTMLElement>(root, "#magic-octagon-compare-note")
    const flipGroup = find<SVGGElement>(root, "#magic-octagon-flip")
    const turnGroup = find<SVGGElement>(root, "#magic-octagon-turn")
    const front = find<SVGGElement>(root, "#magic-octagon-front")
    const back = find<SVGGElement>(root, "#magic-octagon-back")
    const otherMirror = find<SVGGElement>(root, "#magic-octagon-other-mirror")
    const otherTurn = find<SVGGElement>(root, "#magic-octagon-other-turn")
    const otherFront = find<SVGGElement>(root, "#magic-octagon-other-front")
    const otherBack = find<SVGGElement>(root, "#magic-octagon-other-back")

    const directions = [
      "up",
      "up-right",
      "right",
      "down-right",
      "down",
      "down-left",
      "left",
      "up-left",
    ]
    const symbols = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
    const wrap = (value: number) => ((value % 8) + 8) % 8
    const scaleAroundCentre = (factor: number) =>
      "translate(180 145) scale(" + factor + " 1) translate(-180 -145)"

    // Angle is measured on the original front. The back view is its reflection
    // about the fixed vertical axis, not a separately rotated illustration.
    let angle = 0
    let flipped = false
    let comparing = false
    let displayedAngle = 0
    let displayedFlip = 0
    let frame = 0
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    const draw = () => {
      const width = Math.cos((displayedFlip * Math.PI) / 180)
      const showingBack = displayedFlip > 90
      flipGroup.setAttribute("transform", scaleAroundCentre(width))
      turnGroup.setAttribute("transform", "rotate(" + displayedAngle + " 180 145)")
      front.setAttribute("visibility", showingBack ? "hidden" : "visible")
      back.setAttribute("visibility", showingBack ? "visible" : "hidden")

      // The neighbouring view shows the other side facing the reader.
      // Both use the same physical rotation, with a mirror for the back.
      otherMirror.setAttribute("transform", scaleAroundCentre(flipped ? 1 : -1))
      otherTurn.setAttribute("transform", "rotate(" + displayedAngle + " 180 145)")
      otherFront.setAttribute("visibility", flipped ? "visible" : "hidden")
      otherBack.setAttribute("visibility", flipped ? "hidden" : "visible")
    }

    const describe = () => {
      const steps = Math.round(angle / 45)
      const frontIndex = wrap(steps)
      const backIndex = wrap(6 - steps)
      const frontDirection = directions[frontIndex]
      const backDirection = directions[backIndex]
      faceLabel.textContent = flipped
        ? "Back " + symbols[backIndex]
        : "Front " + symbols[frontIndex]
      otherFaceLabel.textContent = flipped
        ? "Front " + symbols[frontIndex]
        : "Back " + symbols[backIndex]
      flipButton.setAttribute("aria-pressed", String(flipped))
      flipButton.setAttribute(
        "aria-label",
        flipped ? "Flip the coin to the front" : "Flip the coin to the back",
      )

      const difference = wrap(backIndex - frontIndex)
      const relation =
        difference === 0
          ? "Both arrows point the same way."
          : difference === 4
            ? "The arrows point in opposite directions."
            : difference === 2 || difference === 6
              ? "The arrows are at right angles in these two views."
              : "The arrows point in different directions."

      if (comparing) {
        status.textContent =
          "Front: " + frontDirection + ". Back: " + backDirection + ". " +
          relation + " The turn controls move both views."
      } else if (flipped) {
        status.textContent =
          "Back arrow: " + backDirection + ". The front pointed " +
          frontDirection + ". " + relation
      } else {
        status.textContent =
          "Front arrow: " + frontDirection +
          ". Predict the back, then flip the coin."
      }
    }

    const animate = (targetAngle: number, targetFlip: number) => {
      cancelAnimationFrame(frame)
      const initialAngle = displayedAngle
      const initialFlip = displayedFlip
      describe()
      if (reducedMotion.matches) {
        displayedAngle = targetAngle
        displayedFlip = targetFlip
        draw()
        return
      }
      const duration = initialFlip !== targetFlip ? 500 : 250
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const fraction = Math.min(1, (now - started) / duration)
        const eased = fraction * fraction * (3 - 2 * fraction)
        displayedAngle = initialAngle + (targetAngle - initialAngle) * eased
        displayedFlip = initialFlip + (targetFlip - initialFlip) * eased
        draw()
        if (fraction < 1) frame = requestAnimationFrame(tick)
      }
      frame = requestAnimationFrame(tick)
    }

    const turn = (amount: number) => {
      // The buttons always rotate the visible face in the stated direction.
      // When showing the back, the original front's angle changes oppositely.
      angle += flipped ? -amount : amount
      animate(angle, flipped ? 180 : 0)
    }

    left.addEventListener("click", () => turn(-45))
    right.addEventListener("click", () => turn(45))
    flipButton.addEventListener("click", () => {
      flipped = !flipped
      animate(angle, flipped ? 180 : 0)
    })
    compareButton.addEventListener("click", () => {
      comparing = !comparing
      other.hidden = !comparing
      compareNote.hidden = !comparing
      views.classList.toggle("max-w-sm", !comparing)
      views.classList.toggle("max-w-2xl", comparing)
      compareButton.setAttribute("aria-pressed", String(comparing))
      compareButton.textContent = comparing ? "Hide comparison" : "Compare both sides"
      draw()
      describe()
    })
    resetButton.addEventListener("click", () => {
      angle = 0
      flipped = false
      comparing = false
      other.hidden = true
      compareNote.hidden = true
      views.classList.add("max-w-sm")
      views.classList.remove("max-w-2xl")
      compareButton.setAttribute("aria-pressed", "false")
      compareButton.textContent = "Compare both sides"
      animate(0, 0)
    })
    draw()
    describe()
  }
</script>
