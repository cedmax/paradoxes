---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import MeasurementGuides from "~/components/illustration-kit/MeasurementGuides.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, series, stroke } from "~/data/palette"

const corners = Array.from({ length: 8 }, (_, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI) / 4
  return (
    (180 + 112 * Math.cos(angle)).toFixed(2) +
    "," +
    (145 + 112 * Math.sin(angle)).toFixed(2)
  )
}).join(" ")
---

<IllustrationFigure
  name="magic-octagon"
  lead="Can you predict where the hidden arrow will point?"
>
  <p class="text-base">
    The front points up. Flip the octagon to see the back, then turn it over again.
    Give it a 45° turn and try to predict the back before flipping once more.
  </p>

  <div class="flex flex-col items-center gap-2">
    <p id="magic-octagon-face" class="font-bold">Front ↑</p>
    <button
      id="magic-octagon-coin"
      type="button"
      class="mx-auto block w-full max-w-sm cursor-pointer bg-transparent p-0"
      aria-label="Flip the octagon to show its back"
      aria-describedby="magic-octagon-hint magic-octagon-state"
      aria-pressed="false"
    >
      <SvgFigure
        name="magic-octagon"
        viewBox="0 0 360 290"
        class="w-full"
        title="A two-sided octagonal coin with an arrow on each face"
        desc="The front has a blue arrow initially pointing up. The back has a gold arrow initially pointing left when flipped towards the viewer about a vertical axis. A small dark dot marks the same corner on both sides. The whole coin turns in 45-degree steps and can be flipped, revealing one face at a time."
      >
        <g id="magic-octagon-flip">
          <g id="magic-octagon-turn">
            <polygon
              points={corners}
              fill={illusionSurface.paper}
              stroke={stroke}
              stroke-width="3"
              stroke-linejoin="round"
            />
            <g
              id="magic-octagon-front"
              fill="none"
              stroke={series.blue}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-back"
              visibility="hidden"
              fill="none"
              stroke={series.gold}
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <g
              id="magic-octagon-ghost-front"
              visibility="hidden"
              fill="none"
              stroke={series.blue}
              stroke-width="5"
              stroke-dasharray="7 6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M180 190 V99 M160 119 L180 99 L200 119" />
            </g>
            <g
              id="magic-octagon-ghost-back"
              visibility="hidden"
              fill="none"
              stroke={series.gold}
              stroke-width="5"
              stroke-dasharray="7 6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M133 145 H227 M206 124 L227 145 L206 166" />
            </g>
            <circle cx="180" cy="47" r="5" fill={stroke} />
          </g>
        </g>
        <MeasurementGuides name="magic-octagon" d="M180 22 V268" />
      </SvgFigure>
    </button>
    <p id="magic-octagon-hint" class="text-base text-center">
      Select the coin to flip it. The dot marks the same corner throughout.
    </p>
  </div>

  <div
    id="magic-octagon-turn-controls"
    class="flex flex-wrap justify-center gap-3"
    role="group"
    aria-label="Turn the front face"
  >
    <button
      type="button"
      class="btn-ghost"
      id="magic-octagon-left"
      aria-label="Turn the front 45 degrees anticlockwise"
    >
      ↶ Turn 45°
    </button>
    <button
      type="button"
      class="btn-ghost"
      id="magic-octagon-right"
      aria-label="Turn the front 45 degrees clockwise"
    >
      Turn 45° ↷
    </button>
  </div>

  <p id="magic-octagon-state" class="text-base" aria-live="polite">
    Front: up. Predict the back, then flip the coin.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <button type="button" class="btn-link" id="magic-octagon-reset">Reset</button>
    <div id="magic-octagon-proof-controls" hidden>
      <IllusionControls
        name="magic-octagon"
        play={false}
        proofLabel="See through the coin"
        proof="The dashed arrow is the arrow on the hidden face, seen through the coin. It is fixed at right angles to the visible arrow. The dot marks one physical corner, and the red line marks the vertical axis used to flip the octagon."
      />
    </div>
  </div>

  <Fragment slot="caption">
    Redrawn for this site after the Magic Octagon demonstrated by David Masunaga in
    <ExternalLink href="https://blog.mrmeyer.com/2013/the-magic-octagon/" after=".">
      Dan Meyer's 2013 account
    </ExternalLink>
    The two arrows are fixed on opposite faces, not independently animated.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindIllusionProof, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("magic-octagon")
  if (root) {
    const coin = find<HTMLButtonElement>(root, "#magic-octagon-coin")
    const left = find<HTMLButtonElement>(root, "#magic-octagon-left")
    const right = find<HTMLButtonElement>(root, "#magic-octagon-right")
    const reset = find<HTMLButtonElement>(root, "#magic-octagon-reset")
    const turnControls = find<HTMLElement>(root, "#magic-octagon-turn-controls")
    const faceLabel = find<HTMLElement>(root, "#magic-octagon-face")
    const status = find<HTMLElement>(root, "#magic-octagon-state")
    const proofControls = find<HTMLElement>(root, "#magic-octagon-proof-controls")
    const proofButton = find<HTMLButtonElement>(root, "#magic-octagon-guide-toggle")
    const flipGroup = find<SVGGElement>(root, "#magic-octagon-flip")
    const turnGroup = find<SVGGElement>(root, "#magic-octagon-turn")
    const front = find<SVGGElement>(root, "#magic-octagon-front")
    const back = find<SVGGElement>(root, "#magic-octagon-back")
    const ghostFront = find<SVGGElement>(root, "#magic-octagon-ghost-front")
    const ghostBack = find<SVGGElement>(root, "#magic-octagon-ghost-back")

    const directions = ["up", "up-right", "right", "down-right", "down", "down-left", "left", "up-left"]
    const arrows = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
    const wrap = (index: number) => ((index % 8) + 8) % 8

    let angle = 0
    let flipped = false
    let displayedAngle = 0
    let displayedFlip = 0
    let frame = 0
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    const show = () => {
      // The inner group turns the physical coin. The outer group projects a flip about
      // the *screen's* vertical axis, so the hidden arrow changes direction correctly.
      const width = Math.cos((displayedFlip * Math.PI) / 180)
      const backVisible = displayedFlip > 90
      const through = proofButton.getAttribute("aria-pressed") === "true"
      turnGroup.setAttribute("transform", "rotate(" + displayedAngle + " 180 145)")
      flipGroup.setAttribute(
        "transform",
        "translate(180 145) scale(" + width + " 1) translate(-180 -145)",
      )
      front.setAttribute("visibility", backVisible ? "hidden" : "visible")
      back.setAttribute("visibility", backVisible ? "visible" : "hidden")
      ghostFront.setAttribute("visibility", through && backVisible ? "visible" : "hidden")
      ghostBack.setAttribute("visibility", through && !backVisible ? "visible" : "hidden")
    }

    const describe = () => {
      const steps = Math.round(angle / 45)
      const frontIndex = wrap(steps)
      const backIndex = wrap(6 - steps)
      const frontDirection = directions[frontIndex]
      const backDirection = directions[backIndex]
      if (flipped) {
        faceLabel.textContent = "Back " + arrows[backIndex]
        const difference = wrap(backIndex - frontIndex)
        const relation =
          difference === 0
            ? "Both arrows now point the same way."
            : difference === 4
              ? "They now point in opposite directions."
              : "They point in different directions."
        status.textContent =
          "The front pointed " +
          frontDirection +
          ". The back points " +
          backDirection +
          ". " +
          relation +
          " Flip back to try another turn."
      } else {
        faceLabel.textContent = "Front " + arrows[frontIndex]
        status.textContent =
          "Front: " +
          frontDirection +
          ". Imagine where the back arrow points, then flip the coin to find out."
      }
      coin.setAttribute(
        "aria-label",
        flipped ? "Flip the octagon back to its front" : "Flip the octagon to show its back",
      )
      coin.setAttribute("aria-pressed", String(flipped))
    }

    const animate = (nextAngle: number, nextFlip: number) => {
      cancelAnimationFrame(frame)
      const startAngle = displayedAngle
      const startFlip = displayedFlip
      if (reducedMotion.matches) {
        displayedAngle = nextAngle
        displayedFlip = nextFlip
        show()
        describe()
        return
      }
      const duration = startFlip !== nextFlip ? 520 : 260
      let started = -1
      const tick = (now: number) => {
        if (started < 0) started = now
        const t = Math.min(1, (now - started) / duration)
        const ease = t * t * (3 - 2 * t)
        displayedAngle = startAngle + (nextAngle - startAngle) * ease
        displayedFlip = startFlip + (nextFlip - startFlip) * ease
        show()
        if (t < 1) {
          frame = requestAnimationFrame(tick)
        } else {
          describe()
        }
      }
      frame = requestAnimationFrame(tick)
    }

    const turn = (amount: number) => {
      if (flipped) return
      angle += amount
      animate(angle, 0)
    }

    coin.addEventListener("click", () => {
      flipped = !flipped
      turnControls.hidden = flipped
      proofControls.hidden = false
      animate(angle, flipped ? 180 : 0)
    })
    left.addEventListener("click", () => turn(-45))
    right.addEventListener("click", () => turn(45))
    reset.addEventListener("click", () => {
      angle = 0
      flipped = false
      turnControls.hidden = false
      animate(0, 0)
    })

    bindIllusionProof(root, "magic-octagon", "See through the coin", "Hide the hidden arrow")
    proofButton.addEventListener("click", show)
    show()
    describe()
  }
</script>
