---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"
import { NOTE_NAMES, TRITONE_ENVELOPES } from "~/scripts/audio-synth"

const names = NOTE_NAMES.map((note) => note.replace("#", "♯"))
// Note names around a clock face, C at the top, a step of one semitone every 30 degrees.
const centre = 160
const radius = 112
const ring = names.map((label, index) => {
  const angle = (index * Math.PI) / 6
  return {
    label,
    x: centre + radius * Math.sin(angle),
    y: centre - radius * Math.cos(angle),
    labelX: centre + (radius + 26) * Math.sin(angle),
    labelY: centre - (radius + 26) * Math.cos(angle) + 5,
  }
})
---

<IllustrationFigure
  name="tritone-paradox"
  lead="Twelve pairs of tones. For each, is the second tone higher or lower than the first?"
>
  <p class="text-base">
    Use headphones or speakers at a comfortable volume, with any spatial or surround effect
    turned off. Each pair lasts one second. Pick the notes in any order, and answer at least
    eight. Try it with someone else if you can, and compare answers.
  </p>
  <div
    id="tritone-paradox-notes"
    role="group"
    aria-label="Pairs, named by the note the first tone is on"
    class="grid grid-cols-4 gap-3 sm:grid-cols-6"
  >
    {names.map((label, index) => (
      <button
        type="button"
        class="btn-ghost"
        data-pc={index}
        data-label={label}
        aria-label={`Play the pair that starts on ${label}`}
      >
        {label}
      </button>
    ))}
  </div>
  <p id="tritone-paradox-unsupported" class="text-base" hidden>
    This browser cannot play the sound. The picture below still shows what the tones are made
    of.
  </p>
  <div id="tritone-paradox-answer" class="flex flex-col gap-3" hidden>
    <p id="tritone-paradox-pair" class="font-bold" aria-live="polite"></p>
    <div role="group" aria-label="Which way did it step?" class="flex flex-wrap gap-3">
      <button type="button" class="btn-toggle" data-answer="up" aria-pressed="false">
        Up: the second tone is higher
      </button>
      <button type="button" class="btn-toggle" data-answer="down" aria-pressed="false">
        Down: the second tone is lower
      </button>
      <button type="button" class="btn-toggle" data-answer="unsure" aria-pressed="false">
        I can't tell
      </button>
      <button id="tritone-paradox-again" type="button" class="btn-ghost">
        Play it again
      </button>
    </div>
  </div>
  <p id="tritone-paradox-progress" class="text-base" aria-live="polite">
    No pairs answered yet.
  </p>
  <button id="tritone-paradox-skip" type="button" class="btn-ghost self-start">
    I can't play or hear this
  </button>
  <div id="tritone-paradox-reveal" class="flex flex-col gap-6" hidden>
    <div class="flex flex-col gap-3">
      <p class="font-bold">Which notes you hear as high</p>
      <SvgFigure
        name="tritone-paradox-ring"
        viewBox="0 0 320 320"
        class="mx-auto w-full max-w-xs"
        title="Twelve note names around a circle, with a large dot on each note you heard as the higher tone of a pair"
        desc="The twelve note names run clockwise from C at the top. For each pair you answered, a filled dot marks the note you heard as higher. If your answers follow a pattern, the dots gather on one side of the circle, and a line points to the note that best fits them."
      >
        <circle
          cx={centre}
          cy={centre}
          r={radius}
          fill="none"
          stroke={stroke}
          stroke-width="1"
          stroke-opacity="0.4"
        ></circle>
        <line
          id="tritone-paradox-peak"
          x1={centre}
          y1={centre}
          x2={centre}
          y2={centre}
          stroke={series.red}
          stroke-width="2"
          stroke-dasharray="5 4"
          visibility="hidden"
        ></line>
        {ring.map(({ label, x, y, labelX, labelY }, index) => (
          <>
            <circle
              cx={x.toFixed(1)}
              cy={y.toFixed(1)}
              r="4"
              fill="none"
              stroke={stroke}
              stroke-width="1.5"
            ></circle>
            <circle
              cx={x.toFixed(1)}
              cy={y.toFixed(1)}
              r="0"
              fill={series.red}
              data-higher={index}
            ></circle>
            <text
              x={labelX.toFixed(1)}
              y={labelY.toFixed(1)}
              font-size="14"
              text-anchor="middle"
              fill={stroke}
            >
              {label}
            </text>
          </>
        ))}
      </SvgFigure>
      <p id="tritone-paradox-result" class="text-base" aria-live="polite"></p>
      <p id="tritone-paradox-readout-answers" class="text-base"></p>
      <p class="text-base">
        The pair starting on F♯ is the pair starting on C played backwards, so if one sounds
        like a rise, the other should sound like a fall.
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <p class="font-bold">What each tone is made of</p>
      <SvgFigure
        name="tritone-paradox"
        viewBox="0 0 600 250"
        class="mx-auto w-full max-w-xl"
        title="Spectrum of the two tones: six octave-spaced components under a bell-shaped loudness hump"
        desc="Frequency runs left to right on a logarithmic scale. Each tone is six vertical bars, one per octave. The curve is the bell-shaped loudness hump that sets their strengths. Both tones use the same hump. The slider moves the hump up or down."
      >
        <line x1="40" y1="200" x2="560" y2="200" stroke={stroke} stroke-width="1"></line>
        <path
          id="tritone-paradox-envelope"
          fill="none"
          stroke={stroke}
          stroke-width="2"
          stroke-dasharray="5 4"
        ></path>
        <g id="tritone-paradox-bars" stroke-width="5">
          <g id="tritone-paradox-first" stroke={series.red}></g>
          <g id="tritone-paradox-second" stroke={series.blue}></g>
        </g>
        <text x="40" y="222" font-size="13" fill={stroke}>
          100 Hz
        </text>
        <text x="236" y="222" font-size="13" fill={stroke}>
          1 kHz
        </text>
        <text x="440" y="222" font-size="13" fill={stroke}>
          5 kHz
        </text>
        <text x="40" y="244" font-size="13" fill={series.red}>
          First tone
        </text>
        <text x="130" y="244" font-size="13" fill={series.blue}>
          Second tone
        </text>
      </SvgFigure>
      <p id="tritone-paradox-which" class="text-base"></p>
      <Slider
        id="tritone-paradox-envelope-slider"
        label="Where the loudness hump sits"
        min={0}
        max={TRITONE_ENVELOPES.length - 1}
        step={1}
        value={2}
        startLabel="Lowest: C4, 262 Hz"
        endLabel="Highest: F#5, 740 Hz"
        describedby="tritone-paradox-readout"
        valuetext="Hump centred on C5, 523 Hz"
      >
        <p id="tritone-paradox-readout" class="text-base" aria-live="polite"></p>
      </Slider>
      <p class="text-base">
        Moving the loudness hump changes which frequencies stand out, but not the note names.
        When you let go of the slider, the pair you last played sounds again with the hump in
        its new place. Answer again: some listeners still hear the same direction, others change
        their answer.
      </p>
    </div>
  </div>
  <Disclosure summary="Exact sound and a text description" slot="after">
    <div class="flex flex-col gap-3 pt-3 text-base">
      <p>
        Each tone is six sine waves, an octave apart, so it has a clear note name but no clear
        octave. Their strengths follow a raised-cosine curve (the loudness hump) on a
        logarithmic frequency scale that covers six octaves, centred on C4, F#4, C5 or F#5. Each
        tone lasts 500 ms, with nothing between the two, and the second tone is a half-octave
        (six semitones) from the first. Both tones have the same loudness, set to match
        Deutsch's recording. Short 5 ms fades at the edges and the join, not in the published
        description, stop the tones clicking.
      </p>
      <p>
        The twelve pairs start on each note name in turn, so you may hear C then F♯, D then G♯,
        and so on. The circle assumes a simple model: one note sounds highest, and the notes
        sound lower the further round the circle they are from it. The line shows the position
        that fits most of your answers. It is a rough fit to what you chose, not a measurement
        of you. Listeners often disagree about the direction, so this page describes the effect
        rather than telling you what you should hear.
      </p>
    </div>
  </Disclosure>
  <Fragment slot="caption">
    Our own synthesis following the published recipe in Deutsch (1986, 1987, 1990, 1991), not a
    recording from her site or her CD. Listen to her original demonstration on her{" "}
    <a
      href="https://deutsch.ucsd.edu/psychology/play.php?i=6206"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      website
    </a>
    .
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"
  import { audioAvailable, playSamples } from "~/scripts/audio"
  import {
    NOTE_NAMES,
    TRITONE_ENVELOPES,
    renderTritonePair,
    tritonePartials,
  } from "~/scripts/audio-synth"

  type Answer = "up" | "down" | "unsure"
  const marks: Record<Answer, string> = { up: "↑", down: "↓", unsure: "?" }
  const MIN_ANSWERS = 8
  const centre = 160

  const root = illustrationRoot("tritone-paradox")
  if (root) {
    const noteButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-pc]"))
    const answerPanel = find<HTMLElement>(root, "#tritone-paradox-answer")
    const pairLabel = find<HTMLElement>(root, "#tritone-paradox-pair")
    const answerButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("button[data-answer]"),
    )
    const again = find<HTMLButtonElement>(root, "#tritone-paradox-again")
    const progress = find<HTMLElement>(root, "#tritone-paradox-progress")
    const skip = find<HTMLButtonElement>(root, "#tritone-paradox-skip")
    const reveal = find<HTMLElement>(root, "#tritone-paradox-reveal")
    const result = find<HTMLElement>(root, "#tritone-paradox-result")
    const answersText = find<HTMLElement>(root, "#tritone-paradox-readout-answers")
    const peakLine = find<SVGLineElement>(root, "#tritone-paradox-peak")
    const which = find<HTMLElement>(root, "#tritone-paradox-which")
    const slider = find<HTMLInputElement>(root, "#tritone-paradox-envelope-slider")
    const readout = find<HTMLElement>(root, "#tritone-paradox-readout")
    const envelopePath = find<SVGPathElement>(root, "#tritone-paradox-envelope")
    const firstBars = find<SVGGElement>(root, "#tritone-paradox-first")
    const secondBars = find<SVGGElement>(root, "#tritone-paradox-second")
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>("circle[data-higher]"))

    const answers = new Map<number, Answer>()
    let current = Math.floor(Math.random() * 12)
    let envelope = 2
    const name = (pc: number) => NOTE_NAMES[((pc % 12) + 12) % 12].replace("#", "♯")
    const pairText = (pc: number) => `${name(pc)} then ${name(pc + 6)}`
    const decided = () => [...answers].filter(([, answer]) => answer !== "unsure")

    // In the simple model, a note sounds higher the nearer it is to the peak on the circle of note
    // names. A pair is a tritone apart, so its notes are only equally far from the peak (and the pair
    // tells us nothing) when the peak sits three semitones from both.
    const circular = (a: number, b: number) => {
      const gap = Math.abs(a - b) % 12
      return Math.min(gap, 12 - gap)
    }
    const fit = () => {
      const scores = Array.from({ length: 12 }, (_, peak) => {
        let agree = 0
        let total = 0
        for (const [pc, answer] of decided()) {
          const near = circular(pc, peak)
          const far = circular(pc + 6, peak)
          if (near === far) continue
          total += 1
          if ((answer === "up") === far < near) agree += 1
        }
        return { agree, total }
      })
      const best = Math.max(...scores.map(({ agree }) => agree))
      const peaks = scores.flatMap(({ agree }, peak) => (agree === best ? [peak] : []))
      return { best, total: scores[peaks[0]].total, peaks }
    }

    const refresh = () => {
      for (const button of noteButtons) {
        const pc = Number(button.dataset.pc)
        const answer = answers.get(pc)
        const label = button.dataset.label ?? ""
        button.textContent = answer ? `${label} ${marks[answer]}` : label
        button.setAttribute(
          "aria-label",
          `Play the pair that starts on ${label}${answer ? `, answered ${answer === "unsure" ? "can't tell" : answer}` : ""}`,
        )
      }
      for (const button of answerButtons) {
        button.setAttribute(
          "aria-pressed",
          String(answers.get(current) === button.dataset.answer),
        )
      }
      const count = decided().length
      progress.textContent =
        count === 0
          ? "No pairs answered yet."
          : `${count} of 12 pairs answered.${count < MIN_ANSWERS ? ` Answer ${MIN_ANSWERS - count} more to see what they show.` : ""}`
      // Dots on the circle: the note heard as higher in each answered pair.
      const higher = new Array<number>(12).fill(0)
      for (const [pc, answer] of decided()) higher[answer === "up" ? (pc + 6) % 12 : pc] += 1
      dots.forEach((dot, index) =>
        dot.setAttribute("r", String(higher[index] ? 5 + higher[index] * 3 : 0)),
      )
      const list = [...answers]
        .sort(([a], [b]) => a - b)
        .map(
          ([pc, answer]) =>
            `${pairText(pc)}: ${answer === "unsure" ? "couldn't tell" : answer}`,
        )
      answersText.textContent = list.length ? `Your answers. ${list.join("; ")}.` : ""
      if (count >= MIN_ANSWERS) {
        showFit()
        reveal.hidden = false
      }
    }

    const showFit = () => {
      const { best, total, peaks } = fit()
      if (peaks.length > 2 || best < total * 0.7) {
        peakLine.setAttribute("visibility", "hidden")
        result.textContent = `Your answers do not point to one clear highest note: the best fit agrees with ${best} of ${total} pairs. That happens, and a one-second pair is a noisy test.`
        return
      }
      // Two equally good notes only share a peak if they sit side by side on the circle,
      // including across the gap between B and C.
      const [first, second] = peaks
      const wraps = peaks.length === 2 && first === 0 && second === 11
      const adjacent = peaks.length === 2 && (second - first === 1 || wraps)
      if (peaks.length === 2 && !adjacent) {
        peakLine.setAttribute("visibility", "hidden")
        result.textContent = `Two notes, ${name(first)} and ${name(second)}, fit your answers equally well (${best} of ${total} pairs), so there is no single highest note to point to.`
        return
      }
      const mid = peaks.length === 1 ? first : wraps ? 11.5 : first + 0.5
      const angle = (mid * Math.PI) / 6
      peakLine.setAttribute("x2", (centre + 96 * Math.sin(angle)).toFixed(1))
      peakLine.setAttribute("y2", (centre - 96 * Math.cos(angle)).toFixed(1))
      peakLine.setAttribute("visibility", "visible")
      const where =
        peaks.length === 1
          ? name(first)
          : wraps
            ? `between ${name(second)} and ${name(0)}`
            : `between ${name(first)} and ${name(second)}`
      result.textContent = `Your answers fit a highest note ${where}, agreeing with ${best} of ${total} pairs. Another listener's line can point somewhere quite different for the same tones. This is a rough fit, not a measurement.`
    }

    const playCurrent = () =>
      audioAvailable()
        ? playSamples((rate) =>
            renderTritonePair(current, TRITONE_ENVELOPES[envelope].semitones, rate),
          )
        : Promise.resolve()

    const select = (pc: number) => {
      current = pc
      answerPanel.hidden = false
      pairLabel.textContent = `Pair starting on ${name(pc)}: ${pairText(pc)}. Which way did it step?`
      void playCurrent()
      refresh()
      draw()
    }
    for (const button of noteButtons)
      button.addEventListener("click", () => select(Number(button.dataset.pc)))
    again.addEventListener("click", () => void playCurrent())
    for (const button of answerButtons) {
      button.addEventListener("click", () => {
        answers.set(current, button.dataset.answer as Answer)
        refresh()
      })
    }
    skip.addEventListener("click", () => {
      reveal.hidden = false
      draw()
    })

    const draw = () => {
      const { semitones, name: envelopeName, hz } = TRITONE_ENVELOPES[envelope]
      const fmin = hz / 8
      const x = (f: number) => 40 + (Math.log2(f / 30) / Math.log2(200)) * 520
      // The bell-shaped envelope across its six octaves.
      const points = Array.from({ length: 61 }, (_, i) => {
        const f = fmin * 2 ** (i / 10)
        const a = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / 60)
        return `${i === 0 ? "M" : "L"}${x(f).toFixed(1)} ${(200 - a * 150).toFixed(1)}`
      })
      envelopePath.setAttribute("d", points.join(" "))
      const bars = (group: SVGGElement, pc: number, shift: number) => {
        group.replaceChildren(
          ...tritonePartials(pc, semitones).map(({ freq, amp }) => {
            const line = document.createElementNS("http://www.w3.org/2000/svg", "line")
            line.setAttribute("x1", String(x(freq) + shift))
            line.setAttribute("x2", String(x(freq) + shift))
            line.setAttribute("y1", "200")
            line.setAttribute("y2", String(200 - amp * 150))
            return line
          }),
        )
      }
      bars(firstBars, current, -3)
      bars(secondBars, current + 6, 3)
      const list = (pc: number) =>
        tritonePartials(pc, semitones)
          .map(({ freq, amp }) => `${Math.round(freq)} Hz (${Math.round(amp * 100)}%)`)
          .join(", ")
      which.textContent = `Showing the pair ${pairText(current)}.`
      readout.textContent = `Hump centred on ${envelopeName} (${hz} Hz). First tone, ${name(current)}: ${list(current)}. Second tone, ${name(current + 6)}: ${list(current + 6)}.`
    }

    if (!audioAvailable()) {
      for (const button of noteButtons) button.disabled = true
      again.disabled = true
      find<HTMLElement>(root, "#tritone-paradox-unsupported").hidden = false
    } else {
      slider.addEventListener("change", () => void playCurrent())
    }

    bindSlider(slider, (value) => {
      envelope = value
      draw()
      return `Hump centred on ${TRITONE_ENVELOPES[value].name}, ${TRITONE_ENVELOPES[value].hz} Hz`
    })
  }
</script>
