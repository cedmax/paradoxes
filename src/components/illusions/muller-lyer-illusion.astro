---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
---

<IllustrationFigure name="muller-lyer-illusion" lead="Which horizontal line looks longer?">
  <SvgFigure
    name="muller-lyer-illusion"
    viewBox="0 0 560 310"
    class="mx-auto w-full max-w-2xl"
    title="Two equal lines with fins that rotate around fixed endpoints"
    desc="Two horizontal lines run from x 104 to x 456, so each is exactly 352 drawing units long. The four pairs of blue fins lean in opposite directions. Rotating the fins can change which line seems longer, but never changes a black segment or its endpoints. Measurement guides show the unchanged lengths."
  >
    <g fill="none" stroke="var(--color-stroke)" stroke-width="5" stroke-linecap="round">
      <path d="M104 92 H456 M104 214 H456" />
    </g>
    <g id="muller-lyer-fins" fill="none" stroke="var(--color-series-blue)" stroke-width="4"
       stroke-linecap="round" stroke-linejoin="round">
      <path id="muller-lyer-upper-fins" d="" />
      <path id="muller-lyer-lower-fins" d="" />
    </g>
    <g id="muller-lyer-guides" visibility="hidden" stroke="var(--color-series-red)"
       stroke-width="2" fill="none">
      <path d="M104 132 V150 M456 132 V150 M104 141 H456 M104 254 V272 M456 254 V272 M104 263 H456" />
      <path d="M104 82 V100 M456 82 V100 M104 204 V222 M456 204 V222" />
    </g>
    <g aria-hidden="true" font-size="14" fill="currentColor" font-family="Arial, sans-serif" text-anchor="middle">
      <text x="280" y="25">The straight lines never move</text>
    </g>
  </SvgFigure>
  <Slider
    id="muller-lyer-fins"
    label="Rotate the arrowheads"
    min={0}
    max={100}
    value={0}
    startLabel="Fins lean inward on top"
    endLabel="Fins lean outward on top"
    describedby="muller-lyer-notice"
    valuetext="Opposing sets of arrowheads"
  >
    <p id="muller-lyer-notice" class="text-base">
      Only the blue fins rotate. The black horizontal segments are fixed.
    </p>
  </Slider>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" id="muller-lyer-play" class="btn-ghost">Play</button>
    <button type="button" id="muller-lyer-guide-toggle" class="btn-toggle" aria-pressed="false">
      Show measurements
    </button>
    <p id="muller-lyer-proof" class="text-base" aria-live="polite" hidden>
      Upper line: 352 SVG units. Lower line: 352 SVG units.
      Both endpoints remain fixed as the blue fins rotate.
    </p>
  </div>
  <Fragment slot="caption">
    Rotate the arrowheads to change the apparent lengths. The red guides measure the same unchanged line segments.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("muller-lyer-illusion")
  if (root) {
    const input = find<HTMLInputElement>(root, "#muller-lyer-fins")
    const upper = find<SVGPathElement>(root, "#muller-lyer-upper-fins")
    const lower = find<SVGPathElement>(root, "#muller-lyer-lower-fins")
    const guides = find<SVGGElement>(root, "#muller-lyer-guides")
    const proof = find<HTMLElement>(root, "#muller-lyer-proof")
    const guideButton = find<HTMLButtonElement>(root, "#muller-lyer-guide-toggle")
    const play = find<HTMLButtonElement>(root, "#muller-lyer-play")
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    let frame = 0
    let running = false
    let lastTime: number | null = null
    let direction = 1
    let position = Number(input.value)

    // Each blue fin has constant length 52 and rotates about a fixed line endpoint.
    const fins = (y: number, horizontal: number, vertical: number) => {
      const left = 104 + horizontal
      const right = 456 - horizontal
      return (
        "M104 " + y + " L" + left + " " + (y - vertical) +
        " M104 " + y + " L" + left + " " + (y + vertical) +
        " M456 " + y + " L" + right + " " + (y - vertical) +
        " M456 " + y + " L" + right + " " + (y + vertical)
      )
    }
    const render = (value: number) => {
      const angle = (Math.PI * (0.25 + 0.5 * value / 100))
      const dx = 52 * Math.cos(angle)
      const dy = 52 * Math.sin(angle)
      upper.setAttribute("d", fins(92, dx, dy))
      lower.setAttribute("d", fins(214, -dx, dy))
      if (value === 50) return "Both pairs of fins stand upright; the straight lines are unchanged"
      if (value < 50) return "Top fins lean inward, bottom fins lean outward"
      return "Top fins lean outward, bottom fins lean inward"
    }
    bindSlider(input, (value) => {
      position = value
      return render(value)
    })

    const stop = () => {
      running = false
      cancelAnimationFrame(frame)
      lastTime = null
      play.textContent = "Play"
      play.setAttribute("aria-pressed", "false")
    }
    const tick = (now: number) => {
      if (!running) return
      if (lastTime !== null) {
        position += (now - lastTime) * direction * (100 / 2600)
        if (position >= 100) {
          position = 100
          direction = -1
        } else if (position <= 0) {
          position = 0
          direction = 1
        }
      }
      lastTime = now
      input.value = String(Math.round(position))
      input.setAttribute("aria-valuetext", render(position))
      frame = requestAnimationFrame(tick)
    }
    play.addEventListener("click", () => {
      if (running) {
        stop()
        return
      }
      if (reducedMotion.matches) return
      running = true
      lastTime = null
      play.textContent = "Pause"
      play.setAttribute("aria-pressed", "true")
      frame = requestAnimationFrame(tick)
    })
    input.addEventListener("input", stop)
    guideButton.addEventListener("click", () => {
      const revealed = guideButton.getAttribute("aria-pressed") !== "true"
      guideButton.setAttribute("aria-pressed", String(revealed))
      guideButton.textContent = revealed ? "Hide measurements" : "Show measurements"
      guides.setAttribute("visibility", revealed ? "visible" : "hidden")
      proof.hidden = !revealed
    })
    const motionChanged = () => {
      stop()
      play.disabled = reducedMotion.matches
      play.title = reducedMotion.matches ? "Use the slider to rotate without animation" : ""
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop()
    })
    reducedMotion.addEventListener("change", motionChanged)
    motionChanged()
  }
</script>
