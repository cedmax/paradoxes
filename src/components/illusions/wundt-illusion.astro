---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import { series, stroke } from "~/data/palette"

// Unlike Hering's single hub, Wundt's familiar horizontal-line figure uses two
// distinct fan centres. Keep the target parallels fixed while removing the fans.
const points = Array.from({ length: 39 }, (_, index) => 20 + index * 15)
---

<IllustrationFigure
  name="wundt-illusion"
  lead="Do the two horizontal red lines seem to bend towards each other?"
>
  <SvgFigure
    name="wundt-illusion"
    viewBox="0 0 620 420"
    class="mx-auto w-full max-w-2xl"
    title="Wundt illusion with two dense fans of black rays and two red horizontal parallels"
    desc="Two horizontal, parallel red target lines lie across black diagonal rays converging separately at a point above and a point below their middle. The lines can appear bowed inwards but are perfectly straight."
  >
    <g id="wundt-fans" stroke={stroke} stroke-width="1.4" fill="none">
      {points.map((x) => (
        <>
          <line x1={x} y1="20" x2="310" y2="158" />
          <line x1={x} y1="400" x2="310" y2="262" />
        </>
      ))}
    </g>
    <path
      d="M42 180 H578 M42 240 H578"
      fill="none"
      stroke={series.red}
      stroke-width="5"
    />
  </SvgFigure>
  <Slider
    id="wundt-illusion-diagonals"
    label="Remove the two fans of lines"
    min={0}
    max={100}
    value={0}
    startLabel="Two dense fans"
    endLabel="Parallel red lines only"
    describedby="wundt-illusion-note"
    valuetext="Two converging fans behind two fixed horizontal red lines"
  >
    <p id="wundt-illusion-note" class="text-base">
      The black background disappears, but the two red lines stay horizontal and 60 units apart.
    </p>
  </Slider>
  <IllusionControls name="wundt-illusion" />
  <Fragment slot="caption">
    Redrawn using the two-centre arrangement of the Wundt illusion, rather than the
    Hering single-centre pattern.{" "}
    <a
      href="https://mathworld.wolfram.com/WundtIllusion.html"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Reference figure and description
    </a>.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSliderPlayback, find, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("wundt-illusion")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#wundt-illusion-diagonals")
    const play = find<HTMLButtonElement>(root, "#wundt-illusion-play")
    const fans = find<SVGGElement>(root, "#wundt-fans")
    bindSliderPlayback(slider, play, (value) => {
      fans.setAttribute("opacity", String(1 - value / 100))
      return value === 100
        ? "Two straight, parallel horizontal lines remain"
        : "Two fans of lines fade; the red parallels stay unchanged"
    })
  }
</script>
