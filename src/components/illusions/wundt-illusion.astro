---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import { series } from "~/data/palette"

// Classic Wundt diamond: rays extend from the left and right tips to successive
// points along the centre axis. Neither red line changes its position or length.
const fan = Array.from({ length: 53 }, (_, index) => 14 + index * 7.5)
---

<IllustrationFigure name="wundt-illusion" lead="Do the two red lines appear to bend inwards?">
  <SvgFigure
    name="wundt-illusion"
    viewBox="0 0 620 420"
    class="mx-auto w-full max-w-2xl"
    title="Wundt illusion: two straight red vertical lines across dense blue diamond fans"
    desc="A blue diamond of tightly packed chevrons extends from sharp left and right points towards the centre axis. Two straight and parallel red vertical lines cross the blue chevrons. The slider hides only the chevrons, exposing the two unchanged red lines."
  >
    <g id="wundt-fans" fill="none" stroke={series.blue} stroke-width="1.4">
      {fan.map((y) => (
        <path d={`M20 210 L310 ${y} L600 210`} />
      ))}
    </g>
    <path
      d="M255 25 V395 M365 25 V395"
      fill="none"
      stroke={series.red}
      stroke-width="4.5"
    />
  </SvgFigure>
  <Slider
    id="wundt-illusion-diagonals"
    label="Remove the blue background"
    min={0}
    max={100}
    value={0}
    startLabel="Blue diamond visible"
    endLabel="Only the two red lines"
    describedby="wundt-illusion-note"
    valuetext="Dense blue chevrons surrounding two fixed red parallel lines"
  >
    <p id="wundt-illusion-note" class="text-base">
      The blue chevrons disappear; both red lines remain straight and 110 units apart.
    </p>
  </Slider>
  <Fragment slot="caption">
    Newly drawn after the classic Wundt diamond arrangement, with blue chevrons and red
    parallels.{" "}
    <a
      href="https://www.illusionsindex.org/i/wundt-illusion"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Wundt illusion reference
    </a>
    .
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("wundt-illusion")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#wundt-illusion-diagonals")
    const fans = find<SVGGElement>(root, "#wundt-fans")
    bindSlider(slider, (value) => {
      fans.setAttribute("opacity", String(1 - value / 100))
      return value === 100
        ? "Only two straight, parallel red lines remain"
        : "The blue background becomes fainter; red lines stay straight"
    })
  }
</script>
