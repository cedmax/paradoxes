---
import Disclosure from "~/components/illustration-kit/Disclosure.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import ListenerChoice from "~/components/illustration-kit/ListenerChoice.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"
import { RISSET, RISSET_LOOP_SECONDS, rissetClicks, rissetStartHz } from "~/scripts/audio-synth"

// One row of ticks per layer, across one loop. Tick strength is the layer's weight at that moment.
const left = 70
const width = 500
const layers = Array.from({ length: RISSET.layers }, (_, k) => ({
  k,
  y: 24 + k * 30,
  clicks: rissetClicks(k).map(({ time, weight }) => ({
    x: left + (time / RISSET_LOOP_SECONDS) * width,
    weight,
  })),
}))
const seconds = RISSET_LOOP_SECONDS.toFixed(1)
const layerWord = ["", "one", "two", "three", "four", "five", "six"][RISSET.layers]
const axisY = 24 + RISSET.layers * 30
---

<IllustrationFigure
  name="risset-rhythm"
  lead="Press Play and listen for half a minute. What does the beat do?"
>
  <p class="text-base">
    A steady stream of clicks. Use headphones or speakers at a comfortable volume, and stop
    whenever you like.
  </p>
  <div class="flex flex-wrap items-center gap-3">
    <button id="risset-rhythm-play" type="button" class="btn-ghost" aria-pressed="false">
      Play
    </button>
  </div>
  <p id="risset-rhythm-unsupported" class="text-base" hidden>
    This browser cannot play the sound. The picture below still shows how it is built.
  </p>
  <ListenerChoice
    name="risset-rhythm"
    question="What does the beat do?"
    options={[
      { value: "faster", label: "It keeps getting faster" },
      { value: "resets", label: "It speeds up, then seems to start over" },
    ]}
  />
  <div id="risset-rhythm-reveal" class="flex flex-col gap-4" hidden>
    <SvgFigure
      name="risset-rhythm"
      viewBox={`0 0 600 ${axisY + 24}`}
      class="mx-auto w-full max-w-xl"
      title={`Click times of ${layerWord} layers over one loop, each fading in and out`}
      desc={`Time runs left to right over one ${seconds} second loop. Each row is one layer of clicks. Within a row the clicks come closer together, because the layer speeds up. A darker mark is a louder click. A layer starts quiet and slow, grows, then fades as it becomes fast, and the next layer takes over at the speed where it ended.`}
    >
      {layers.map(({ k, y, clicks }) => (
        <g data-layer={k}>
          <text x="4" y={y + 4} font-size="13" fill={stroke}>
            {`Layer ${k + 1}`}
          </text>
          {clicks.map(({ x, weight }) => (
            <line
              x1={x.toFixed(1)}
              x2={x.toFixed(1)}
              y1={y - 10}
              y2={y + 10}
              stroke={series.red}
              stroke-width="1.5"
              stroke-opacity={weight.toFixed(3)}
            ></line>
          ))}
        </g>
      ))}
      <line
        x1={left}
        y1={axisY}
        x2={left + width}
        y2={axisY}
        stroke={stroke}
        stroke-width="1"
      ></line>
      <text x={left} y={axisY + 18} font-size="13" fill={stroke}>
        {`0 s`}
      </text>
      <text x={left + width - 60} y={axisY + 18} font-size="13" fill={stroke}>
        {`${seconds} s, then it repeats`}
      </text>
    </SvgFigure>
    <Slider
      id="risset-rhythm-layers"
      label="Layers you hear"
      min={0}
      max={RISSET.layers}
      step={1}
      value={0}
      startLabel={`All ${layerWord} together`}
      endLabel={`Layer ${RISSET.layers} alone`}
      describedby="risset-rhythm-readout"
      valuetext={`All ${layerWord} layers`}
    >
      <p id="risset-rhythm-readout" class="text-base" aria-live="polite"></p>
    </Slider>
    <p class="text-base">
      A single layer does speed up, then jumps back to its starting speed when the loop
      restarts. Together, each layer is replaced just as it becomes fast. If the sound is
      playing, it restarts when you move the slider.
    </p>
  </div>
  <Disclosure summary="Exact sound and a text description" slot="after">
    <div class="flex flex-col gap-3 pt-3 text-base">
      <p>
        {RISSET.layers} layers of short thumps, each a {RISSET.bodyHz} Hz tone with a brief
        bright tick on top. Layer 1 starts at {rissetStartHz(0)}
        clicks a second. Each later layer starts at double the speed of the one before, up to
        {rissetStartHz(RISSET.layers - 1)} clicks a second for layer {RISSET.layers}. Every
        layer doubles its speed smoothly over {seconds} s, which is the whole loop, and the loop
        then repeats exactly. Each layer's loudness follows a raised-cosine curve over its place
        in the range of speeds, so it fades in when slow and out when fast.
      </p>
      <p>
        The result is an endless acceleration that never gets anywhere: the same set of tempi
        returns every {seconds} seconds. Many listeners hear it keep speeding up for a while and
        then notice the pattern has not changed. How strongly you hear it depends on you.
      </p>
    </div>
  </Disclosure>
  <Fragment slot="caption">
    Our own synthesis, built on the principle described for Jean-Claude Risset's accelerating
    rhythm, the rhythmic counterpart of the Shepard tone. It is not a recording of his work. The
    loudness curve and click sound are our choices.
  </Fragment>
</IllustrationFigure>

<script>
  import {
    bindListenerChoice,
    bindSlider,
    find,
    illustrationRoot,
  } from "~/scripts/illustration"
  import { audioAvailable, playSamples, stopAudio } from "~/scripts/audio"
  import {
    RISSET,
    RISSET_LOOP_SECONDS,
    renderRisset,
    rissetStartHz,
  } from "~/scripts/audio-synth"

  const name = "risset-rhythm"
  const root = illustrationRoot(name)
  if (root) {
    const play = find<HTMLButtonElement>(root, `#${name}-play`)
    const reveal = find<HTMLElement>(root, `#${name}-reveal`)
    const slider = find<HTMLInputElement>(root, `#${name}-layers`)
    const readout = find<HTMLElement>(root, `#${name}-readout`)
    const rows = Array.from(root.querySelectorAll<SVGGElement>("g[data-layer]"))
    let solo: number | null = null
    const seconds = RISSET_LOOP_SECONDS.toFixed(1)
    const hz = (value: number) => String(Math.round(value * 100) / 100)
    const layerWord = ["", "one", "two", "three", "four", "five", "six"][RISSET.layers]

    const setPlaying = (on: boolean) => {
      play.textContent = on ? "Stop" : "Play"
      play.setAttribute("aria-pressed", String(on))
    }
    const start = async () => {
      const started = await playSamples((rate) => renderRisset(rate, solo), {
        loop: true,
        onStop: () => setPlaying(false),
      })
      if (started) setPlaying(true)
    }

    const choices = bindListenerChoice(root, name, (value) => {
      reveal.hidden = false
      return {
        faster:
          "Hearing it keep speeding up is the illusion. The pattern is the same every loop, so its overall speed never changes.",
        resets:
          "Noticing the start-over is a valid result. Many listeners hear the acceleration for a while and then notice it has not gone anywhere. Try the layers below.",
        skip: "The picture and slider below still show how it is built.",
      }[value]
    })

    if (audioAvailable()) {
      play.addEventListener("click", () => {
        if (play.getAttribute("aria-pressed") === "true") stopAudio()
        else {
          void start()
          choices.enable()
        }
      })
    } else {
      play.disabled = true
      find<HTMLElement>(root, `#${name}-unsupported`).hidden = false
    }

    bindSlider(slider, (value) => {
      solo = value === 0 ? null : value - 1
      for (const row of rows) {
        row.setAttribute(
          "opacity",
          solo === null || Number(row.dataset.layer) === solo ? "1" : "0.15",
        )
      }
      const text =
        solo === null
          ? `All ${layerWord} layers. Layer 1 goes from ${hz(rissetStartHz(0))} to ${hz(rissetStartHz(1))} clicks a second while the others do the same one octave up each, to layer ${RISSET.layers}, which goes from ${hz(rissetStartHz(RISSET.layers - 1))} to ${hz(rissetStartHz(RISSET.layers))}. The whole pattern repeats exactly every ${seconds} seconds.`
          : `Layer ${solo + 1} alone: it speeds up from ${hz(rissetStartHz(solo))} to ${hz(rissetStartHz(solo + 1))} clicks a second over ${seconds} seconds, then starts again.`
      readout.textContent = text
      return solo === null ? `All ${layerWord} layers` : `Layer ${solo + 1} alone`
    })
    slider.addEventListener("input", () => {
      if (play.getAttribute("aria-pressed") === "true") void start()
    })
  }
</script>
