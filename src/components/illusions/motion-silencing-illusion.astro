---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import ListenerChoice from "~/components/illustration-kit/ListenerChoice.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, stroke } from "~/data/palette"

const count = 64
const dots = Array.from({ length: count }, (_, index) => {
  const angle = (2 * Math.PI * index) / count
  const hue = (index * 137.5) % 360
  return { index, x: 280 + 126 * Math.cos(angle), y: 190 + 126 * Math.sin(angle), hue }
})
---

<IllustrationFigure
  name="motion-silencing-illusion"
  lead="Do the changing dots seem to become steady when the ring starts turning?"
>
  <p class="text-base">
    Start the colour changes while the ring is still, watching the central cross. Then make the
    ring turn. Compare what you notice. Stop if motion is uncomfortable.
  </p>
  <SvgFigure
    name="motion-silencing-illusion"
    viewBox="0 0 560 380"
    class="mx-auto w-full max-w-xl"
    title="A ring of coloured dots with a central fixation cross"
    desc="Sixty-four dots arranged around a ring continuously cycle through hues after Play is pressed. The ring can then rotate while the individual colour changes continue. Stopping rotation makes the changes easier to notice for many viewers."
  >
    <rect x="12" y="12" width="536" height="356" fill={illusionSurface.neutral} />
    <g id="motion-silencing-illusion-ring">
      {dots.map(({ index, x, y, hue }) => (
        <circle cx={x} cy={y} r="5.2" fill={`hsl(${hue} 65% 55%)`} data-dot={index} />
      ))}
    </g>
    <path d="M270 190 H290 M280 180 V200" stroke={stroke} stroke-width="3" />
  </SvgFigure>
  <div class="flex flex-wrap gap-3">
    <button
      id="motion-silencing-illusion-play"
      class="btn-ghost"
      type="button"
      aria-pressed="false"
    >
      Start changing colours
    </button>
    <button
      id="motion-silencing-illusion-turn"
      class="btn-ghost"
      type="button"
      aria-pressed="false"
      disabled
    >
      Start turning the ring
    </button>
  </div>
  <p id="motion-silencing-illusion-status" class="text-base" aria-live="polite">
    At rest. Press Start to begin colour changes.
  </p>
  <ListenerChoice
    name="motion-silencing-illusion"
    question="When the ring turned, what happened to the colour changes?"
    options={[
      { value: "stopped", label: "They seemed to stop" },
      { value: "continued", label: "They still changed" },
      { value: "unsure", label: "Couldn't tell" },
    ]}
    skipLabel="I cannot watch the motion"
  />
  <div id="motion-silencing-illusion-reveal" class="space-y-3" hidden>
    <p class="text-base">
      While the animation runs, the dots keep changing hue even when the ring turns. Motion
      can make those changes seem to stop.
    </p>
    <IllusionControls
      name="motion-silencing-illusion"
      play={false}
      proof="Each dot follows the same hue cycle whether the ring is turning or still. While the animation is running, freezing the ring's rotation does not freeze those colour changes."
      proofLabel="Freeze rotation to check"
    />
  </div>
  <Fragment slot="caption">
    Original browser-generated stimulus after Suchow and Alvarez (2011). The changing hues are
    stimulus data rather than decorative palette colours.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindListenerChoice, find, illustrationRoot } from "~/scripts/illustration"

  const name = "motion-silencing-illusion"
  const root = illustrationRoot(name)
  if (root) {
    const dots = Array.from(root.querySelectorAll<SVGCircleElement>("[data-dot]"))
    const ring = find<SVGGElement>(root, `#${name}-ring`)
    const play = find<HTMLButtonElement>(root, `#${name}-play`)
    const turn = find<HTMLButtonElement>(root, `#${name}-turn`)
    const proof = find<HTMLButtonElement>(root, `#${name}-guide-toggle`)
    const proofText = find<HTMLElement>(root, `#${name}-proof`)
    const reveal = find<HTMLElement>(root, `#${name}-reveal`)
    const status = find<HTMLElement>(root, `#${name}-status`)
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")
    const answers = Array.from(
      root.querySelectorAll<HTMLButtonElement>(
        `#${name}-choices button[data-choice]:not([data-choice="skip"])`,
      ),
    )
    const answerAfterMs = 2000
    let running = false
    let turning = false
    let frame = 0
    let last: number | undefined
    let elapsed = 0
    let rotation = 0
    let turningElapsed = 0
    let canAnswer = false
    let turningBeforeProof = false

    const updateTurn = () => {
      turn.textContent = turning ? "Stop turning the ring" : "Start turning the ring"
      turn.setAttribute("aria-pressed", String(turning))
      turn.disabled = !running || reduced.matches || proof.getAttribute("aria-pressed") === "true"
    }
    const stop = () => {
      running = false
      turning = false
      cancelAnimationFrame(frame)
      last = undefined
      play.textContent = "Start changing colours"
      play.setAttribute("aria-pressed", "false")
      proof.disabled = true
      updateTurn()
    }
    const choices = bindListenerChoice(root, name, (value) => {
      if (value === "skip") {
        stop()
        choices.reset()
        for (const button of answers) button.disabled = true
        canAnswer = false
        turningElapsed = 0
        turningBeforeProof = false
        proof.hidden = true
        proof.setAttribute("aria-pressed", "false")
        proof.textContent = "Freeze rotation to check"
        proofText.hidden = true
        status.textContent = "Moving patterns skipped. The explanation is below."
      } else {
        proof.hidden = false
        proof.disabled = !running
        status.textContent = running
          ? "Judgement recorded. Freeze the rotation to check."
          : "Judgement recorded. The explanation is below."
      }
      reveal.hidden = false
      return value === "skip"
        ? "The explanation is available without watching the animation."
        : "The explanation is below; freeze the rotation to compare if it is still running."
    })
    const resetAttempt = () => {
      reveal.hidden = true
      choices.reset()
      for (const button of answers) button.disabled = true
      proof.hidden = false
      proof.disabled = true
      proof.setAttribute("aria-pressed", "false")
      proof.textContent = "Freeze rotation to check"
      proofText.hidden = true
      turningBeforeProof = false
      turningElapsed = 0
      canAnswer = false
      turning = false
      updateTurn()
    }
    const render = () => {
      dots.forEach((dot, index) => {
        const hue = (index * 137.5 + elapsed / 25) % 360
        dot.setAttribute("fill", `hsl(${hue.toFixed(1)} 65% 55%)`)
      })
      ring.setAttribute("transform", `rotate(${rotation.toFixed(2)} 280 190)`)
    }
    const tick = (now: number) => {
      if (!running) return
      const delta = last === undefined ? 0 : Math.min(70, Math.max(0, now - last))
      last = now
      elapsed += delta
      if (turning) {
        rotation += delta * 0.12
        turningElapsed += delta
        if (!canAnswer && turningElapsed >= answerAfterMs) {
          canAnswer = true
          choices.enable()
          status.textContent = "The ring has been turning. What did you notice?"
        }
      }
      render()
      frame = requestAnimationFrame(tick)
    }
    play.addEventListener("click", () => {
      if (running) {
        stop()
        status.textContent = reveal.hidden
          ? "Animation stopped. Start again to compare."
          : "Animation stopped. The explanation remains below."
        return
      }
      if (reduced.matches) return
      resetAttempt()
      running = true
      last = undefined
      play.textContent = "Stop"
      play.setAttribute("aria-pressed", "true")
      updateTurn()
      status.textContent = "Watch the ring while it is still. Keep your gaze on the cross."
      frame = requestAnimationFrame(tick)
    })
    turn.addEventListener("click", () => {
      if (!running || proof.getAttribute("aria-pressed") === "true") return
      turning = !turning
      updateTurn()
      status.textContent = turning
        ? "The ring is turning. Keep your gaze on the cross."
        : "The ring is still. Look at the dots."
    })
    proof.addEventListener("click", () => {
      if (!running || proof.hidden) return
      const shown = proof.getAttribute("aria-pressed") !== "true"
      if (shown) {
        turningBeforeProof = turning
        turning = false
      } else {
        turning = turningBeforeProof
        turningBeforeProof = false
      }
      proof.setAttribute("aria-pressed", String(shown))
      proof.textContent = shown ? "Return to the experiment" : "Freeze rotation to check"
      proofText.hidden = !shown
      updateTurn()
      status.textContent = shown
        ? "Rotation is paused. The colour changes continue."
        : turning
          ? "The ring is turning again. Compare what you notice."
          : "The ring remains still. You can turn it again."
    })
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && running) {
        stop()
        status.textContent = "Animation stopped when the tab was hidden."
      }
    })
    const motionChanged = () => {
      if (reduced.matches) {
        if (running) stop()
        for (const button of answers) button.disabled = true
      }
      play.disabled = reduced.matches
      play.title = reduced.matches
        ? "Moving patterns are disabled; choose the opt-out for the explanation"
        : ""
      updateTurn()
      if (reduced.matches) {
        status.textContent =
          "Motion is disabled in your settings. Choose the opt-out to read the explanation."
      } else if (!running) {
        status.textContent = reveal.hidden
          ? "At rest. Press Start to begin colour changes."
          : "The animation is stopped. The explanation is below."
      }
    }
    reduced.addEventListener("change", motionChanged)
    motionChanged()
  }
</script>
