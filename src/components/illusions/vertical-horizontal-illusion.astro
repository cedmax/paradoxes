---
import ExternalLink from "~/components/ExternalLink.astro"
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import MeasurementGuides from "~/components/illustration-kit/MeasurementGuides.astro"
import { series, stroke } from "~/data/palette"
---

<IllustrationFigure
  name="vertical-horizontal-illusion"
  lead="Which is longer: the upright or the full horizontal line?"
>
  <SvgFigure
    name="vertical-horizontal-illusion"
    viewBox="0 0 600 430"
    class="mx-auto w-full max-w-xl"
    title="Inverted T with a horizontal copy rotating around its fixed left endpoint"
    desc="An upside-down T has a 300-unit upright and a 300-unit horizontal line. Compare lengths reveals a translucent gold quarter-circle centred at the horizontal line’s left endpoint and a red copy of the full horizontal line. The slider rotates this copy around its fixed left endpoint from horizontal to vertical. Its right endpoint follows the gold arc, reaching the same height as the black upright at 90 degrees."
  >
    <g id="vertical-horizontal-sector" visibility="hidden" aria-hidden="true">
      <path d="M150 345 H450 A300 300 0 0 0 150 45 Z" fill={series.gold} fill-opacity="0.24" />
      <path
        d="M450 345 A300 300 0 0 0 150 45"
        fill="none"
        stroke={series.gold}
        stroke-width="2"
      />
    </g>
    <path
      d="M150 345 H450 M300 45 V345"
      fill="none"
      stroke={stroke}
      stroke-width="5"
      stroke-linecap="butt"
    />
    <MeasurementGuides name="vertical-horizontal-illusion" d="M150 345 H450" width={4} />
  </SvgFigure>
  <IllusionControls
    name="vertical-horizontal-illusion"
    play={false}
    proofLabel="Compare lengths"
    proof="Both black lines are 300 units long. The red copy pivots at the horizontal line’s left endpoint and sweeps a gold quarter-circle of radius 300. At 90 degrees it reaches the same height as the upright, without moving sideways."
  />
  <div id="vertical-horizontal-comparison" hidden>
    <Slider
      id="vertical-horizontal-rotation"
      label="Rotate the red copy around its left endpoint"
      min={0}
      max={100}
      value={0}
      startLabel="Lies on the horizontal"
      endLabel="Vertical, level with the upright"
      describedby="vertical-horizontal-note"
      valuetext="Red 300-unit copy lies over the horizontal line with its left endpoint fixed"
    >
      <p id="vertical-horizontal-note" class="text-base">
        Only the red copy rotates around the left endpoint. The black inverted T does not
        change.
      </p>
    </Slider>
  </div>
  <Fragment slot="caption">
    In this reversed T, the horizontal means its complete width, not just one arm.{" "}
    <ExternalLink
      href="https://www.esa.int/ESA_Multimedia/Images/2004/06/The_reversed_T_illusion"
      after="."
    >
      Reversed-T illustration
    </ExternalLink>
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, bindIllusionProof, find, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("vertical-horizontal-illusion")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#vertical-horizontal-rotation")
    const comparison = find<HTMLElement>(root, "#vertical-horizontal-comparison")
    const guides = find<SVGPathElement>(root, "#vertical-horizontal-illusion-guides path")
    const sector = find<SVGGElement>(root, "#vertical-horizontal-sector")
    const toggle = find<HTMLButtonElement>(root, "#vertical-horizontal-illusion-guide-toggle")
    bindSlider(slider, (value) => {
      const t = value / 100
      const theta = (Math.PI * t) / 2
      const endX = value === 100 ? 150 : 150 + 300 * Math.cos(theta)
      const endY = value === 100 ? 45 : 345 - 300 * Math.sin(theta)
      guides.setAttribute("d", `M150 345 L${endX} ${endY}`)
      return value === 100
        ? "At 90 degrees the 300-unit red line reaches the same height as the upright"
        : `The 300-unit red line is rotated ${Math.round(90 * t)} degrees around its fixed left endpoint`
    })
    bindIllusionProof(
      root,
      "vertical-horizontal-illusion",
      "Compare lengths",
      "Hide comparison",
    )
    toggle.addEventListener("click", () => {
      const shown = toggle.getAttribute("aria-pressed") === "true"
      comparison.hidden = !shown
      sector.setAttribute("visibility", shown ? "visible" : "hidden")
    })
  }
</script>
