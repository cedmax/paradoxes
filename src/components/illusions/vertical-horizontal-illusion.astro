---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import MeasurementGuides from "~/components/illustration-kit/MeasurementGuides.astro"
import { stroke } from "~/data/palette"
---

<IllustrationFigure
  name="vertical-horizontal-illusion"
  lead="Which is longer: the upright or the full horizontal line?"
>
  <SvgFigure
    name="vertical-horizontal-illusion"
    viewBox="0 0 600 430"
    class="mx-auto w-full max-w-xl"
    title="Inverted T with equal upright and full horizontal lengths"
    desc="A vertical 300-unit black line joins the exact middle of a 300-unit horizontal line, making an upside-down T. The vertical looks longer to many observers. Red guides, shown on request, mark the two equal measurements."
  >
    <path
      d="M150 345 H450 M300 45 V345"
      fill="none"
      stroke={stroke}
      stroke-width="5"
      stroke-linecap="butt"
    />
    <MeasurementGuides
      name="vertical-horizontal-illusion"
      d="M115 45 V345 M105 45 H125 M105 345 H125 M150 375 H450 M150 365 V385 M450 365 V385"
    />
  </SvgFigure>
  <IllusionControls
    name="vertical-horizontal-illusion"
    play={false}
    proof="The upright measures 300 units. The entire horizontal line measures 300 units, from left end to right end. The upright joins at its midpoint."
  />
  <Fragment slot="caption">
    This is the inverted-T arrangement, not two arms forming an L.{" "}
    <a
      href="https://www.esa.int/ESA_Multimedia/Images/2004/06/The_reversed_T_illusion"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      ESA's reversed-T demonstration
    </a>
    .
  </Fragment>
</IllustrationFigure>

<script>
  import { bindIllusionProof, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("vertical-horizontal-illusion")
  if (root) bindIllusionProof(root, "vertical-horizontal-illusion")
</script>
