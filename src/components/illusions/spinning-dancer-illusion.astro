---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import ListenerChoice from "~/components/illustration-kit/ListenerChoice.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { illusionSurface, series, stroke } from "~/data/palette"
---

<IllustrationFigure
  name="spinning-dancer-illusion"
  lead="Which way does the dancer turn? Does the direction ever seem to switch?"
>
  <SvgFigure
    name="spinning-dancer-illusion"
    viewBox="0 0 560 380"
    class="mx-auto w-full max-w-md"
    title="An original silhouette of a turning dancer with raised arms and an outstretched leg"
    desc="A simplified dancer with head, torso, triangular skirt, two arms and two legs rotates around a vertical axis. Its silhouette has no front or back colour cues. A reveal adds an orientation reference and colours the near and far parts to make the actual turning easier to see."
  >
    <rect x="15" y="10" width="530" height="350" fill={illusionSurface.neutral} />
    <g id="spinning-dancer-illusion-shape" fill={stroke} stroke={stroke} stroke-linecap="round" stroke-linejoin="round">
      <line id="spinning-dancer-illusion-backarm" x1="264" y1="145" x2="224" y2="133" stroke-width="15" />
      <line id="spinning-dancer-illusion-frontarm" x1="296" y1="145" x2="339" y2="117" stroke-width="15" />
      <line id="spinning-dancer-illusion-backleg" x1="268" y1="237" x2="262" y2="305" stroke-width="20" />
      <line id="spinning-dancer-illusion-frontleg" x1="292" y1="237" x2="347" y2="258" stroke-width="20" />
      <path id="spinning-dancer-illusion-torso" d="M259 132 L301 132 L295 205 L265 205 Z" />
      <path id="spinning-dancer-illusion-skirt" d="M265 200 L295 200 L321 250 L239 250 Z" />
      <circle id="spinning-dancer-illusion-head" cx="280" cy="89" r="18" />
      <circle id="spinning-dancer-illusion-bun" cx="264" cy="79" r="9" />
      <path id="spinning-dancer-illusion-neck" d="M272 101 L288 101 L290 133 L270 133 Z" />
    </g>
    <g id="spinning-dancer-illusion-guides" visibility="hidden">
      <ellipse cx="280" cy="328" rx="80" ry="15" fill="none" stroke={series.red} stroke-width="2" stroke-dasharray="5 4" />
      <line id="spinning-dancer-illusion-direction" x1="280" y1="328" x2="340" y2="328" stroke={series.red} stroke-width="4" />
      <circle id="spinning-dancer-illusion-front" cx="340" cy="328" r="6" fill={series.red} />
      <text x="372" y="333" font-size="13" fill={stroke}>Top view</text>
    </g>
  </SvgFigure>
  <Slider
    id="spinning-dancer-illusion-angle"
    label="Turn by hand"
    min={0}
    max={359}
    step={1}
    value={0}
    startLabel="Start"
    endLabel="Full turn"
    describedby="spinning-dancer-illusion-readout"
    valuetext="0 degrees"
  >
    <p id="spinning-dancer-illusion-readout" class="text-base" aria-live="polite">
      A complete turn always moves in one direction in the underlying model.
    </p>
  </Slider>
  <IllusionControls name="spinning-dancer-illusion" proof={undefined} />
  <ListenerChoice
    name="spinning-dancer-illusion"
    question="Which direction did the dancer seem to turn?"
    options={[
      { value: "clockwise", label: "Clockwise" },
      { value: "counterclockwise", label: "Counterclockwise" },
      { value: "both", label: "It switched, or I could see both" },
    ]}
    skipLabel="I cannot see the animation"
  />
  <div id="spinning-dancer-illusion-reveal" hidden>
    <IllusionControls
      name="spinning-dancer-illusion"
      play={false}
      proof="The top view traces a continuous 360-degree turn. Red parts belong to the nearer half of the original three-dimensional construction and blue parts to the farther half. The silhouette itself contains no such front/back clues."
      proofLabel="Show which side is nearer"
    />
  </div>
  <Fragment slot="caption">
    Original rotating vector figure, not Nobuyuki Kayahara's animation or silhouette.
    Inspired by his 2003 bistable dancer demonstration.
  </Fragment>
</IllustrationFigure>

<script>
  import {
    bindListenerChoice,
    bindSliderLoopPlayback,
    find,
    illustrationRoot,
  } from "~/scripts/illustration"

  const name = "spinning-dancer-illusion"
  const root = illustrationRoot(name)
  if (root) {
    const slider = find<HTMLInputElement>(root, `#${name}-angle`)
    const play = find<HTMLButtonElement>(root, `#${name}-play`)
    const readout = find<HTMLElement>(root, `#${name}-readout`)
    const reveal = find<HTMLElement>(root, `#${name}-reveal`)
    const proof = find<HTMLButtonElement>(root, `#${name}-guide-toggle`)
    const proofText = find<HTMLElement>(root, `#${name}-proof`)
    const guides = find<SVGGElement>(root, `#${name}-guides`)
    const direction = find<SVGLineElement>(root, `#${name}-direction`)
    const front = find<SVGCircleElement>(root, `#${name}-front`)
    const parts = {
      backarm: find<SVGLineElement>(root, `#${name}-backarm`),
      frontarm: find<SVGLineElement>(root, `#${name}-frontarm`),
      backleg: find<SVGLineElement>(root, `#${name}-backleg`),
      frontleg: find<SVGLineElement>(root, `#${name}-frontleg`),
    }
    const torso = find<SVGPathElement>(root, `#${name}-torso`)
    const skirt = find<SVGPathElement>(root, `#${name}-skirt`)
    const head = find<SVGCircleElement>(root, `#${name}-head`)
    const bun = find<SVGCircleElement>(root, `#${name}-bun`)
    const neck = find<SVGPathElement>(root, `#${name}-neck`)
    const choices = bindListenerChoice(root, name, (value) => {
      reveal.hidden = false
      return value === "skip"
        ? "The model and its orientation cues are described in text."
        : "The projected figure always turns in one direction. Depth cues can reduce ambiguity."
    })
    const coord = (x: number, y: number, z: number, theta: number) => {
      const rotated = x * Math.cos(theta) + z * Math.sin(theta)
      const depth = z * Math.cos(theta) - x * Math.sin(theta)
      return { x: 280 + rotated, y: 190 + y, depth }
    }
    const point = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`
    const segment = (element: SVGLineElement, a: number[], b: number[], theta: number, shown: boolean) => {
      const p = coord(a[0], a[1], a[2], theta)
      const q = coord(b[0], b[1], b[2], theta)
      element.setAttribute("x1", String(p.x))
      element.setAttribute("y1", String(p.y))
      element.setAttribute("x2", String(q.x))
      element.setAttribute("y2", String(q.y))
      element.setAttribute("stroke", shown ? (p.depth + q.depth > 0 ? "var(--color-series-red)" : "var(--color-series-blue)") : "var(--color-stroke)")
    }
    const polygon = (element: SVGPathElement, vertices: number[][], theta: number) => {
      element.setAttribute("d", `M${vertices.map(([x, y, z]) => point(coord(x, y, z, theta))).join(" L")} Z`)
    }
    const show = (angle: number) => {
      const theta = (angle * Math.PI) / 180
      const shown = proof.getAttribute("aria-pressed") === "true"
      segment(parts.backarm, [-22, -48, -10], [-73, -62, -38], theta, shown)
      segment(parts.frontarm, [22, -48, 10], [75, -80, 38], theta, shown)
      segment(parts.backleg, [-10, 47, -10], [-17, 123, -14], theta, shown)
      segment(parts.frontleg, [10, 47, 10], [78, 65, 36], theta, shown)
      polygon(torso, [[-23, -67, 0], [23, -67, 0], [16, 18, 0], [-16, 18, 0]], theta)
      polygon(skirt, [[-16, 10, 0], [16, 10, 0], [49, 62, 0], [-49, 62, 0]], theta)
      polygon(neck, [[-9, -89, 0], [9, -89, 0], [10, -60, 0], [-10, -60, 0]], theta)
      const centre = coord(0, -107, 0, theta)
      head.setAttribute("cx", String(centre.x))
      head.setAttribute("cy", String(centre.y))
      const hair = coord(-15, -116, -2, theta)
      bun.setAttribute("cx", String(hair.x))
      bun.setAttribute("cy", String(hair.y))
      const dx = 60 * Math.cos(theta)
      const dy = 12 * Math.sin(theta)
      direction.setAttribute("x2", String(280 + dx))
      direction.setAttribute("y2", String(328 + dy))
      front.setAttribute("cx", String(280 + dx))
      front.setAttribute("cy", String(328 + dy))
      return `Angle ${angle} degrees`
    }
    bindSliderLoopPlayback(slider, play, (value) => {
      readout.textContent = `Angle ${value} degrees. The underlying direction is continuous.`
      return show(value)
    }, 28)
    play.addEventListener("click", () => choices.enable())
    slider.addEventListener("input", () => choices.enable())
    proof.addEventListener("click", () => {
      const shown = proof.getAttribute("aria-pressed") !== "true"
      proof.setAttribute("aria-pressed", String(shown))
      proof.textContent = shown ? "Hide depth cues" : "Show which side is nearer"
      proofText.hidden = !shown
      guides.setAttribute("visibility", shown ? "visible" : "hidden")
      show(Number(slider.value))
    })
  }
</script>
