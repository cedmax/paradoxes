---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import { illusionSurface } from "~/data/palette"

// White's classic effect: equal grey bars replace alternating sections of
// different horizontal stripes, rather than covering vertical stripes.
const stripes = Array.from({ length: 12 }, (_, index) => ({
  y: 52 + index * 24,
  black: index % 2 === 0,
}))
---

<IllustrationFigure
  name="whites-illusion"
  lead="Do the grey patches in A and B look equally light?"
>
  <SvgFigure
    name="whites-illusion"
    viewBox="0 0 620 385"
    class="mx-auto w-full max-w-2xl"
    title="White's illusion: identical grey bars interrupt different black and white horizontal stripes"
    desc="A background of horizontal black and white bands holds two columns, A and B, of identical grey bars. A's grey bars replace white bands and B's replace black bands. The slider removes the black-and-white striped background, showing that every grey bar is unchanged and exactly RGB 128, 128, 128."
  >
    <rect x="25" y="52" width="570" height="288" fill={illusionSurface.paper} />
    <g id="whites-stripes" fill={illusionSurface.ink}>
      {stripes
        .filter(({ black }) => black)
        .map(({ y }) => (
          <rect x="25" y={y} width="570" height="24" />
        ))}
    </g>
    <g fill={illusionSurface.midGrey}>
      {stripes.map(({ y, black }) => (
        <rect x={black ? 384 : 166} y={y} width="70" height="24" />
      ))}
    </g>
    <g fill={illusionSurface.ink} font-size="20" font-weight="700" text-anchor="middle">
      <text x="201" y="35">
        A
      </text>
      <text x="419" y="35">
        B
      </text>
    </g>
  </SvgFigure>
  <Slider
    id="whites-illusion-slider"
    label="Remove the striped background"
    min={0}
    max={100}
    value={0}
    startLabel="Black and white stripes"
    endLabel="Same grey on white"
    valuetext="Both groups of patches are RGB 128, 128, 128"
    describedby="whites-illusion-note"
  >
    <p id="whites-illusion-note" class="text-base">
      The stripes fade away. All the grey rectangles stay exactly the same grey (RGB 128, 128,
      128).
    </p>
  </Slider>
  <Fragment slot="caption">
    The grey rectangles are all identical. Only their place within the striped pattern changes
    their apparent brightness. Redrawn after Michael White (1979).{" "}
    <a
      href="https://michaelbach.de/ot/lum-white/"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Original effect and explanation
    </a>
    .
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("whites-illusion")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#whites-illusion-slider")
    const stripes = find<SVGGElement>(root, "#whites-stripes")
    bindSlider(slider, (value) => {
      stripes.setAttribute("opacity", String(1 - value / 100))
      return value === 100
        ? "All the grey patches remain RGB 128, 128, 128 on white"
        : "The black stripes fade; grey patches remain unchanged"
    })
  }
</script>
