---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"

// The first 24 GIF frames, unchanged and stored losslessly in a self-hosted 6x4 sprite.
// Frame 23 shows the checkerboard; frame 0 isolates A and B without context.
---

<IllustrationFigure
  name="checker-shadow-illusion"
  lead="Look at squares A and B. Does one look darker?"
>
  <div
    id="checker-frame"
    class="mx-auto w-full max-w-xl"
    style="aspect-ratio: 9 / 7; background-image: url('/illustrations/checker-shadow-scrub-frames.png'); background-size: 600% 400%; background-position: 100% 100%; background-repeat: no-repeat;"
    role="img"
    aria-label="A checkerboard partly shaded by a cylinder. Squares A and B appear different, although both are the same grey. Moving the slider removes the surroundings until they form a single uniform grey rectangle."
  ></div>
  <Slider
    id="checker-reveal"
    label="Remove the surroundings"
    min={0}
    max={23}
    step={1}
    value={0}
    startLabel="Checkerboard"
    endLabel="Only A and B"
    describedby="checker-reveal-note"
    valuetext="Checkerboard visible; A and B look different"
  >
    <p id="checker-reveal-note" class="text-base">
      Move the slider in either direction. A and B are both RGB 120, 120, 120; only the surrounding
      scene changes.
    </p>
  </Slider>
  <Fragment slot="caption">
    Original illusion by{" "}
    <a
      href="https://persci.mit.edu/gallery/checkershadow/"
      class="font-bold underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Edward H. Adelson (1995)
    </a>
    . Interactive frames from the{" "}
    <a
      href="https://commons.wikimedia.org/wiki/File:Optical_illusion_greysquares.gif"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      freely reusable animation by (3ucky(3all
    </a>
    . The image and every frame are hosted on Logic Benders.
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("checker-shadow-illusion")
  if (root) {
    const scene = find<HTMLElement>(root, "#checker-frame")
    const input = find<HTMLInputElement>(root, "#checker-reveal")

    bindSlider(input, (value) => {
      // Scrub the 24 kept frames in reverse through a 6×4 sprite.
      const frame = 23 - value
      const x = (frame % 6) * 20
      const y = Math.floor(frame / 6) * (100 / 3)
      scene.style.backgroundPosition = String(x) + "% " + String(y) + "%"

      if (value === 0) return "Checkerboard visible; A and B look different"
      if (value === 23) return "Only A and B remain: one uniform grey rectangle"
      return "Surrounding checkerboard partially removed; A and B keep the same grey"
    })
  }
</script>
