---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"

// All figures are self-hosted. The original 1995 figure is unaltered;
// the freely reusable Commons GIF animates the proof without overlaying gradients.
const original = "/illustrations/checker-shadow-original.png"
const animatedProof = "/illustrations/checker-shadow-proof.gif"
const stillProof = "/illustrations/checker-shadow-proof-still.png"
---

<IllustrationFigure
  name="checker-shadow-illusion"
  lead="Look at the squares marked A and B. Does one look darker?"
>
  <div class="mx-auto w-full max-w-xl">
    <img
      id="checker-original"
      src={original}
      width="1078"
      height="838"
      class="block h-auto w-full"
      alt="Adelson's original checkerboard: A is a dark square outside the cylinder's shadow; B is a light square within it."
    />
    <img
      id="checker-proof-animation"
      width="540"
      height="420"
      class="block h-auto w-full"
      alt="Animation: A and B begin as one uniform grey rectangle. The rest of the checkerboard and its green cylinder gradually reassemble around them, making the two parts appear different."
      hidden
    />
    <img
      id="checker-proof-still"
      src={stillProof}
      width="540"
      height="420"
      class="block h-auto w-full"
      alt="A and B are adjacent parts of one solid grey rectangle. Without the checkerboard and shadow, they look identical."
      hidden
    />
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" id="checker-compare" class="btn-toggle" aria-pressed="false">
      Show the proof
    </button>
    <button type="button" id="checker-replay" class="btn-ghost" hidden>
      Replay animation
    </button>
  </div>
  <p id="checker-values" class="text-base" aria-live="polite" hidden>
    A and B have exactly the same grey value: RGB 120, 120, 120.
    The animation removes and rebuilds the surrounding scene to reveal why they seem different.
  </p>
  <Fragment slot="caption">
    Original illusion by{" "}
    <a
      href="https://persci.mit.edu/gallery/checkershadow/"
      class="font-bold underline"
      target="_blank"
      rel="noopener noreferrer"
    >Edward H. Adelson (1995)</a>.
    Proof animation by{" "}
    <a
      href="https://commons.wikimedia.org/wiki/File:Optical_illusion_greysquares.gif"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >(3ucky(3all, via Wikimedia Commons</a>
    (freely reusable). Both images are hosted on Logic Benders.
  </Fragment>
</IllustrationFigure>

<script>
  import { find, illustrationRoot } from "~/scripts/illustration"

  const root = illustrationRoot("checker-shadow-illusion")
  if (root) {
    const toggle = find<HTMLButtonElement>(root, "#checker-compare")
    const replay = find<HTMLButtonElement>(root, "#checker-replay")
    const original = find<HTMLImageElement>(root, "#checker-original")
    const animated = find<HTMLImageElement>(root, "#checker-proof-animation")
    const still = find<HTMLImageElement>(root, "#checker-proof-still")
    const values = find<HTMLElement>(root, "#checker-values")
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    const proofPath = "/illustrations/checker-shadow-proof.gif"
    let playCount = 0

    const play = () => {
      still.hidden = true
      animated.hidden = false
      // A fresh same-origin URL makes the GIF begin at its first frame on replay.
      animated.src = proofPath + "?replay=" + ++playCount
      replay.textContent = "Replay animation"
    }

    const showStill = () => {
      animated.hidden = true
      animated.removeAttribute("src")
      still.hidden = false
      replay.textContent = "Play animation"
    }

    const render = (shown: boolean) => {
      toggle.setAttribute("aria-pressed", String(shown))
      toggle.textContent = shown ? "Hide the proof" : "Show the proof"
      original.hidden = shown
      replay.hidden = !shown
      values.hidden = !shown
      if (!shown) {
        animated.hidden = true
        animated.removeAttribute("src")
        still.hidden = true
      } else if (reducedMotion.matches) {
        showStill()
      } else {
        play()
      }
    }

    toggle.addEventListener("click", () => {
      render(toggle.getAttribute("aria-pressed") !== "true")
    })
    replay.addEventListener("click", play)
    reducedMotion.addEventListener("change", () => {
      if (toggle.getAttribute("aria-pressed") === "true") {
        if (reducedMotion.matches) showStill()
        else play()
      }
    })
  }
</script>
