---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import IllusionControls from "~/components/illustration-kit/IllusionControls.astro"
import ListenerChoice from "~/components/illustration-kit/ListenerChoice.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import { series, stroke } from "~/data/palette"
---

<IllustrationFigure
  name="ames-window"
  lead="Watch the window turn. Does it keep rotating or swing back and forth?"
>
  <SvgFigure
    name="ames-window"
    viewBox="0 0 600 380"
    class="mx-auto w-full max-w-xl"
    title="A flat trapezoidal window, drawn in perspective as it rotates around a vertical axis"
    desc="The left vertical edge is taller than the right. The window's plane rotates in one continuous direction. Perspective sometimes makes it seem to reverse direction. A top-down orientation indicator can be revealed below the window."
  >
    <g
      id="ames-window-frame"
      fill="none"
      stroke={stroke}
      stroke-width="8"
      stroke-linejoin="round"
    >
      <path id="ames-window-outline" d="M190 92 L410 150 L410 230 L190 288 Z"></path>
      <path id="ames-window-bar" d="M190 190 L410 190" stroke-width="5"></path>
      <path id="ames-window-mid" d="M300 121 L300 259" stroke-width="5"></path>
    </g>
    <g id="ames-window-guides" visibility="hidden">
      <circle cx="300" cy="334" r="30" fill="none" stroke={stroke} stroke-width="1.5" />
      <line x1="264" y1="334" x2="336" y2="334" stroke={stroke} stroke-dasharray="3 5" />
      <line
        id="ames-window-axis"
        x1="270"
        y1="334"
        x2="330"
        y2="334"
        stroke={series.red}
        stroke-width="4"
      />
      <circle id="ames-window-near" cx="330" cy="334" r="5" fill={series.red} />
      <text x="342" y="338" font-size="13" fill={stroke}>
        Top view
      </text>
    </g>
  </SvgFigure>
  <Slider
    id="ames-window-angle"
    label="Turn by hand"
    min={0}
    max={359}
    step={1}
    value={0}
    startLabel="0 degrees"
    endLabel="359 degrees"
    describedby="ames-window-readout"
    valuetext="Angle 0 degrees"
  >
    <p id="ames-window-readout" class="text-base" aria-live="polite">
      Position: 0 degrees.
    </p>
  </Slider>
  <button id="ames-window-play" type="button" class="btn-ghost self-start" aria-pressed="false">
    Play
  </button>
  <ListenerChoice
    name="ames-window"
    question="When the window moves, what does it seem to do?"
    options={[
      { value: "turns", label: "Keeps turning" },
      { value: "swings", label: "Swings back" },
      { value: "unsure", label: "Not sure" },
    ]}
    skipLabel="I cannot watch moving patterns"
  />
  <div id="ames-window-reveal" hidden>
    <IllusionControls
      name="ames-window"
      play={false}
      proof="The top view shows the window's orientation. The red endpoint follows the same circle through a full 360 degrees without reversing."
      proofLabel="Show the top view"
    />
  </div>
  <Fragment slot="caption">
    Original vector demonstration of the Ames window, after Braunstein and Payne (1968). The
    rotating shape is a flat trapezoid, not a rectangular window.
  </Fragment>
</IllustrationFigure>

<script>
  import {
    bindIllusionProof,
    bindListenerChoice,
    bindSliderLoopPlayback,
    find,
    illustrationRoot,
  } from "~/scripts/illustration"

  const name = "ames-window"
  const root = illustrationRoot(name)
  if (root) {
    const slider = find<HTMLInputElement>(root, "#ames-window-angle")
    const play = find<HTMLButtonElement>(root, "#ames-window-play")
    const outline = find<SVGPathElement>(root, "#ames-window-outline")
    const bar = find<SVGPathElement>(root, "#ames-window-bar")
    const mid = find<SVGPathElement>(root, "#ames-window-mid")
    const axis = find<SVGLineElement>(root, "#ames-window-axis")
    const near = find<SVGCircleElement>(root, "#ames-window-near")
    const readout = find<HTMLElement>(root, "#ames-window-readout")
    const reveal = find<HTMLElement>(root, "#ames-window-reveal")
    const choices = bindListenerChoice(root, name, (value) => {
      reveal.hidden = false
      return value === "skip"
        ? "The top view can be inspected without watching the rotation."
        : "Now use the top view to check which way the window really turns."
    })
    // Four corners are coplanar. Left edge is 2.4 times the height of the right.
    const project = (x: number, y: number, angle: number) => {
      const a = (angle * Math.PI) / 180
      const xr = x * Math.cos(a)
      const depth = x * Math.sin(a)
      const scale = 760 / (900 - depth)
      return [300 + xr * scale, 190 - y * scale]
    }
    const pos = (xy: number[]) => xy.map((value) => value.toFixed(2)).join(" ")
    const render = (angle: number) => {
      const corners = [
        project(-125, 115, angle),
        project(125, 48, angle),
        project(125, -48, angle),
        project(-125, -115, angle),
      ]
      outline.setAttribute("d", `M${corners.map(pos).join(" L")} Z`)
      const sides = [project(-125, 0, angle), project(125, 0, angle)]
      bar.setAttribute("d", `M${sides.map(pos).join(" L")}`)
      const centres = [project(0, 81.5, angle), project(0, -81.5, angle)]
      mid.setAttribute("d", `M${centres.map(pos).join(" L")}`)
      const a = (angle * Math.PI) / 180
      const dx = 30 * Math.cos(a)
      const dy = 30 * Math.sin(a)
      axis.setAttribute("x1", String(300 - dx))
      axis.setAttribute("y1", String(334 - dy))
      axis.setAttribute("x2", String(300 + dx))
      axis.setAttribute("y2", String(334 + dy))
      near.setAttribute("cx", String(300 + dx))
      near.setAttribute("cy", String(334 + dy))
      readout.textContent = `Position: ${angle} degrees.`
      return `Angle ${angle} degrees`
    }
    bindSliderLoopPlayback(slider, play, render, 32)
    slider.addEventListener("input", () => choices.enable())
    play.addEventListener("click", () => choices.enable())
    bindIllusionProof(root, name, "Show the top view", "Hide the top view")
  }
</script>
