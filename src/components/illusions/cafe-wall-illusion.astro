---
import IllustrationFigure from "~/components/illustration-kit/IllustrationFigure.astro"
import SvgFigure from "~/components/illustration-kit/SvgFigure.astro"
import Slider from "~/components/illustration-kit/Slider.astro"
import { illusionSurface } from "~/data/palette"

const rows = Array.from({ length: 10 }, (_, index) => index)
const columns = Array.from({ length: 13 }, (_, index) => index - 2)
---

<IllustrationFigure
  name="cafe-wall-illusion"
  lead="Do the horizontal grey mortar lines look slanted?"
>
  <SvgFigure
    name="cafe-wall-illusion"
    viewBox="0 0 620 390"
    class="mx-auto w-full max-w-2xl"
    title="Staggered black and white rectangular tiles separated by straight grey mortar"
    desc="Ten rows of wide black and white rectangular tiles are staggered by half a tile. Narrow grey mortar lines seem to tilt, although each one is straight and horizontal. The slider aligns alternate rows without moving the mortar."
  >
    <defs>
      <clipPath id="cafe-wall-window">
        <rect x="20" y="18" width="580" height="340" />
      </clipPath>
    </defs>
    <rect x="20" y="18" width="580" height="340" fill={illusionSurface.neutral} />
    <g clip-path="url(#cafe-wall-window)">
      {rows.map((row) => (
        <g data-cafe-row={row} transform={row % 2 ? "translate(30 0)" : undefined}>
          {columns.map((column) => (
            <rect
              x={20 + column * 60}
              y={18 + row * 34}
              width="60"
              height="32"
              fill={column % 2 ? illusionSurface.paper : illusionSurface.ink}
            />
          ))}
        </g>
      ))}
    </g>
  </SvgFigure>
  <Slider
    id="cafe-wall-illusion-shift"
    label="Align the alternate rows"
    min={0}
    max={100}
    value={0}
    startLabel="Staggered rectangles"
    endLabel="Aligned rectangles"
    describedby="cafe-wall-illusion-note"
    valuetext="Staggered rectangles with parallel grey mortar"
  >
    <p id="cafe-wall-illusion-note" class="text-base">
      The rectangles slide sideways. The grey lines between them stay perfectly horizontal.
    </p>
  </Slider>
  <Fragment slot="caption">
    The grey mortar is two drawing units high and stays parallel throughout. Redrawn after
    Gregory and Heard's 1979 study.{" "}
    <a
      href="https://pubmed.ncbi.nlm.nih.gov/503767/"
      class="underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Original study
    </a>
    .
  </Fragment>
</IllustrationFigure>

<script>
  import { bindSlider, find, illustrationRoot } from "~/scripts/illustration"
  const root = illustrationRoot("cafe-wall-illusion")
  if (root) {
    const slider = find<HTMLInputElement>(root, "#cafe-wall-illusion-shift")
    const rows = Array.from(root.querySelectorAll<SVGGElement>("[data-cafe-row]"))
    bindSlider(slider, (value) => {
      const offset = 30 * (1 - value / 100)
      for (const row of rows) {
        if (Number(row.dataset.cafeRow) % 2 === 1) {
          row.setAttribute("transform", `translate(${offset} 0)`)
        }
      }
      return value === 100
        ? "Tiles aligned; mortar lines remain parallel"
        : "Alternate rectangular tiles shift; mortar lines stay horizontal"
    })
  }
</script>
