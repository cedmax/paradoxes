---
import "../styles/global.css"
import StructuredData from "~/components/StructuredData.astro"

interface Props {
  title: string
  description?: string
  noindex?: boolean
  structuredData?: Record<string, unknown>[]
  // Path of the Open Graph image and its alt text. Pages without their own use /og.png.
  image?: string
  imageAlt?: string
}

const {
  title,
  description = "Paradoxes in plain words. Each starts with a problem and two claims that sound right but can't both be true.",
  structuredData = [],
  noindex: pageNoindex = false,
  image = "/og.png",
  imageAlt = "Logic Benders. It can't be true. It can't be false.",
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const noindex = pageNoindex || import.meta.env.SITE_INDEXING === "noindex"
const data = [
  ...(Astro.url.pathname === "/"
    ? [
        {
          "@type": "WebSite",
          "@id": new URL("/#website", Astro.site).href,
          name: "Logic Benders",
          url: Astro.site?.href,
          description,
          inLanguage: "en-GB",
        },
      ]
    : []),
  ...structuredData,
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Logic Benders" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <StructuredData data={data} />
  </head>
  <body>
    <header class="px-gutter flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b-2 border-ink py-3">
      <a
        class="font-display py-2.5 text-2xl font-extrabold tracking-tight no-underline"
        href="/"
      >
        Logic Benders
      </a>
      <nav class="flex flex-wrap gap-x-7 gap-y-1 font-semibold" aria-label="Main">
        <a class="inline-flex min-h-11 items-center no-underline hover:text-accent" href="/">
          Index
        </a>
        <a
          class="inline-flex min-h-11 items-center no-underline hover:text-accent"
          href="/about/"
        >
          How we write these
        </a>
      </nav>
    </header>
    <slot />
    <footer class="px-gutter flex flex-wrap justify-between gap-4 border-t-2 border-ink pt-7 pb-10 text-sm">
      <div>Logic Benders.</div>
      <a class="inline-flex items-center underline" href="/corrections/">
        Report a correction
      </a>
      <div>
        This site was not made by{" "}
        <a class="underline" href="https://cedmax.net">
          cedmax
        </a>
        .
      </div>
    </footer>
  </body>
</html>
