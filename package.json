{
  "name": "paradoxes",
  "description": "Paradoxes in plain words",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "cedmax",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "NODE_ENV=production astro telemetry disable && astro build",
    "preview": "astro preview --host",
    "check": "astro check",
    "check:seo": "node scripts/check-seo.mjs",
    "format": "prettier --write .",
    "lint": "eslint src scripts && stylelint \"src/**/*.{css,astro}\"",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,json,md,ts}": [
      "eslint",
      "prettier --write"
    ],
    "*.css": [
      "stylelint",
      "prettier --write"
    ],
    "*.astro": [
      "eslint",
      "stylelint",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "netlify-cli": "^27.12.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
